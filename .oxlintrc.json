{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "env": { "browser": true, "es2024": true },
  "overrides": [
    {
      // The browser's Request and Response (their headers are changed through methods) cannot be
      // made readonly, and openapi-fetch hands its middleware one mutable request. Only the API
      // client handles them, and the tests' session that hands the client's requests to Playwright;
      // every other parameter type is still checked.
      "files": ["web/packages/api-client/**", "web/app/e2e/support/api.ts"],
      "rules": {
        "typescript/prefer-readonly-parameter-types": [
          "error",
          {
            "allow": [
              { "from": "lib", "name": ["Request", "Response"] },
              {
                "from": "package",
                "package": "openapi-fetch",
                "name": ["MiddlewareCallbackParams"]
              },
              { "from": "package", "package": "playwright-core", "name": ["APIRequestContext"] }
            ]
          }
        ]
      }
    },
    {
      // `cargo xtask gen api` writes the types of the whole API into this one file, longer with
      // every route. Nobody edits it, and a file over about 400 lines needs a reason
      // (coding-standards section 2): this is it.
      "files": ["web/packages/api-client/src/schema.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      // `cargo xtask gen messages` writes one line per message of the catalog into these files,
      // longer with every screen. Nobody edits them, and a file over about 400 lines needs a reason
      // (coding-standards section 2): this is it.
      "files": ["web/packages/messages/src/generated/*.ts"],
      "rules": { "max-lines": "off", "import/max-dependencies": "off" }
    },
    {
      // `cargo xtask gen theme` writes the names of the tokens, the parts and the words of each
      // part into this one file, longer with every component. Nobody edits it, and a file over
      // about 400 lines needs a reason (coding-standards section 2): this is it.
      "files": ["web/packages/ui/src/tokens.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      // The app, the shared components and the messages never talk to the server themselves:
      // only @bugaboo/api-client does (ADR-0008). ARCH-WEB-API checks the same in xtask.
      "files": ["web/app/src/**", "web/packages/ui/**", "web/packages/messages/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "Use @bugaboo/api-client." },
          { "name": "XMLHttpRequest", "message": "Use @bugaboo/api-client." },
          { "name": "WebSocket", "message": "Use @bugaboo/api-client." },
          { "name": "EventSource", "message": "Use @bugaboo/api-client." }
        ]
      }
    },
    {
      // Vite, Vitest, Playwright, stylelint and html-validate read the default export of their config.
      "files": ["**/*.config.ts", "**/*.config.mjs"],
      "rules": { "import/no-default-export": "off" }
    }
  ],
  "rules": {
    // Named exports only (coding-standards section 4); the config override above is the exception.
    "import/no-default-export": "error",
    // A comment next to code is not allowed, except the marker that the secret scan reads on the
    // line of a fake test credential (coding-standards section 3: it needs a reason, and
    // META-SUPPRESS counts it).
    "no-inline-comments": ["error", { "ignorePattern": "gitleaks:allow" }], // lets the marker stand next to a fake credential, SEC-16
    // Playwright's own fixture types (page, context ...) cannot be made readonly; every other
    // parameter type is still checked. The API client has its own, narrower list (overrides).
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "allow": [
          // React's own types cannot be made readonly: what a component shows between its tags is
          // any React content (a mutable union), and the event of a form is React's event object.
          { "from": "package", "package": "react", "name": ["ReactNode", "FormEvent"] },
          // The keyboard event of the browser is its own object; the shortcuts read a few fields of it.
          // A window (UX §6.3) reads the size of its element and the keys and pointer of its edges.
          { "from": "lib", "name": ["KeyboardEvent"] },
          { "from": "package", "package": "react", "name": ["KeyboardEvent", "PointerEvent"] },
          {
            "from": "package",
            "package": "playwright",
            "name": [
              "BrowserContext",
              "Page",
              "PlaywrightTestArgs",
              "PlaywrightTestOptions",
              "PlaywrightWorkerArgs",
              "PlaywrightWorkerOptions",
              "TestInfo",
              "WorkerInfo"
            ]
          },
          {
            "from": "package",
            "package": "playwright-core",
            "name": [
              "APIRequestContext",
              "APIResponse",
              "Route",
              "Browser",
              "BrowserContext",
              "BrowserContextOptions",
              "Locator",
              "Page",
              "Response",
              "WebError"
            ]
          }
        ]
      }
    ],
    // The way to send somebody to another page from a route is to throw a `redirect` of TanStack
    // Router. It is no error, and the router catches it.
    "typescript/only-throw-error": [
      "error",
      { "allow": [{ "from": "package", "package": "@tanstack/router-core", "name": ["Redirect"] }] }
    ],
    // `console.error` is how the app reports a defect of the build that a person must not see, such
    // as a message text that is not loaded (ADR-0028); the end-to-end tests fail on it. Every other
    // use of the console is still an error.
    "no-console": ["error", { "allow": ["error"] }],
    "no-eval": "error",
    "no-new-func": "error",
    "no-implied-eval": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "react/no-danger": "error",
    // Component files export only components, so hot reload keeps component state.
    "react/only-export-components": "error",
    // No literal text in JSX children, string expressions or attributes (title, aria-label, alt,
    // placeholder ...): all words come from the message catalog (coding-standards section 4).
    // Only the input type values listed here are not text.
    "react/jsx-no-literals": ["error", { "noStrings": true, "allowedStrings": ["radio"] }],
    // Inline styles are not allowed; styles are rules of design/theme.kdl (ADR-0026). THEME-ONLY
    // forbids every other way to style from code.
    "react/forbid-dom-props": ["error", { "forbid": ["style"] }],
    // Two narrow exceptions to the categories above (see docs/third-party and WP-02):
    // the modern JSX transform (tsconfig "jsx": "react-jsx") needs no React in scope, and
    // the one style sheet (generated from design/theme.kdl) is imported only for its effect.
    "react/react-in-jsx-scope": "off",
    // The same for the message parts: an area imports its part for the texts it registers (UX-07),
    // and the messages package imports the part of the first page (or every part, for Node).
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          // The part of an area, imported by that area's index.ts (one file per feature folder,
          // written by `cargo xtask gen messages`; TXT-CATALOG checks the import).
          "@bugaboo/messages/parts/*",
          // The first page's part, imported by the messages package (written by `cargo xtask gen messages`).
          "./generated/shared.ts",
          // Every part, for Node (written by `cargo xtask gen messages`: see ALL_OUTPUT in xtask/src/gen/messages.rs).
          "./generated/all.ts"
        ]
      }
    ]
  }
}
