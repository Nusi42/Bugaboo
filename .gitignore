# Rust
/target/
**/target/

# Node / frontend
node_modules/
dist/
*.tsbuildinfo
.vite/
coverage/

# Local runtime data — never commit databases, attachments, keys or secrets
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.pem
*.key
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Machine-local Cargo settings (included optionally by .cargo/config.toml, ADR-0024)
.cargo/config.local.toml

# Pinned external tools installed by `cargo xtask setup` (tools/dev/tools.toml)
/.tools/

# A work folder's own logs, notes, helper scripts and pictures (04-milestones, Working in a folder)
/.work/

# Browser app build output and test reports (WP-02)
/test-results/
/playwright-report/

# Local Claude Code settings (per machine; points the agent memory to bugaboo.win1/.claude/memory)
.claude/settings.local.json

# The WebAssembly module and its glue, made by `cargo xtask wasm` (ADR-0011)
/web/packages/wasm/generated/
/web/packages/wasm-search/generated/
