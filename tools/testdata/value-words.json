    {
      "name": "day, day first",
      "kind": "date",
      "value": "2026-10-05",
      "region": "german",
      "expected": "05.10.2026"
    },
    {
      "name": "day, month first, west of Greenwich",
      "kind": "date",
      "value": "2026-10-05",
      "region": "american",
      "expected": "10/05/2026"
    },
    {
      "name": "not a day",
      "kind": "date",
      "value": "someday",
      "region": "usual",
      "expected": null
    },
    {
      "name": "moment in UTC",
      "kind": "date-time",
      "value": "2026-10-05T07:30:00Z",
      "region": "usual",
      "expected": "2026-10-05, 7:30 AM"
    },
    {
      "name": "moment in Berlin in summer",
      "kind": "date-time",
      "value": "2026-10-05T07:30:00Z",
      "region": "german",
      "expected": "05.10.2026, 9:30 AM"
    },
    {
      "name": "moment in Berlin in winter",
      "kind": "date-time",
      "value": "2026-12-05T07:30:00Z",
      "region": "german",
      "expected": "05.12.2026, 8:30 AM"
    },
    {
      "name": "moment that is the next day in Berlin",
      "kind": "date-time",
      "value": "2026-10-05T23:30:00Z",
      "region": "german",
      "expected": "06.10.2026, 1:30 AM"
    },
    {
      "name": "moment at noon",
      "kind": "date-time",
      "value": "2026-10-05T12:05:00Z",
      "region": "usual",
      "expected": "2026-10-05, 12:05 PM"
    },
    {
      "name": "moment at midnight",
      "kind": "date-time",
      "value": "2026-10-05T00:00:00Z",
      "region": "usual",
      "expected": "2026-10-05, 12:00 AM"
    },
    {
      "name": "moment that is the day before in Los Angeles",
      "kind": "date-time",
      "value": "2026-10-05T03:15:00Z",
      "region": "american",
      "expected": "10/04/2026, 8:15 PM"
    },
    {
      "name": "not a moment",
      "kind": "date-time",
      "value": "later",
      "region": "usual",
      "expected": null
    },
    {
      "name": "short text",
      "kind": "text",
      "value": "hello",
      "region": "usual",
      "expected": "hello"
    },
    {
      "name": "web address",
      "kind": "web-address",
      "value": "https://example.com",
      "region": "usual",
      "expected": "https://example.com"
    }
  ]
}
