{
  "about": "How the value of an own field is worded for a person. The e-mail (crates/bb-app/src/notifications/value_words.rs) and the screen (web/app/src/shared/own-value-text.ts) must give the expected words for every case; both tests read this file (M4-F141). A null expected means the value has no words for its kind. Only choices the server can know are here: not device.",
  "regions": {
    "usual": { "dateFormat": "year-month-day", "numberFormat": "point", "timeZone": "UTC" },
    "german": {
      "dateFormat": "day-month-year",
      "numberFormat": "comma",
      "timeZone": "Europe/Berlin"
    },
    "american": {
      "dateFormat": "month-day-year",
      "numberFormat": "point",
      "timeZone": "America/Los_Angeles"
    },
    "french": { "dateFormat": "year-month-day", "numberFormat": "space", "timeZone": "UTC" }
  },
  "cases": [
    { "name": "yes", "kind": "yes-no", "value": true, "region": "usual", "expected": "Yes" },
    { "name": "no", "kind": "yes-no", "value": false, "region": "german", "expected": "No" },
    {
      "name": "yes-no given text",
      "kind": "yes-no",
      "value": "maybe",
      "region": "usual",
      "expected": null
    },
    {
      "name": "hours and minutes",
      "kind": "duration",
      "value": 7500,
      "region": "usual",
      "expected": "2h 5m"
    },
    {
      "name": "minutes only",
      "kind": "duration",
      "value": 2700,
      "region": "usual",
      "expected": "45m"
    },
    {
      "name": "whole hours",
      "kind": "duration",
      "value": 7200,
      "region": "usual",
      "expected": "2h"
    },
    {
      "name": "under a minute",
      "kind": "duration",
      "value": 30,
      "region": "usual",
      "expected": "0m"
    },
    {
      "name": "duration given yes",
      "kind": "duration",
      "value": true,
      "region": "usual",
      "expected": null
    },
    {
      "name": "whole number with a point",
      "kind": "whole-number",
      "value": 1234567,
      "region": "usual",
      "expected": "1,234,567"
    },
    {
      "name": "whole number with a comma",
      "kind": "whole-number",
      "value": 1234567,
      "region": "german",
      "expected": "1.234.567"
    },
    {
      "name": "whole number with a space",
      "kind": "whole-number",
      "value": 1234567,
      "region": "french",
      "expected": "1 234 567"
    },
    {
      "name": "small whole number",
      "kind": "whole-number",
      "value": 12,
      "region": "usual",
      "expected": "12"
    },
    {
      "name": "negative whole number",
      "kind": "whole-number",
      "value": -1234,
      "region": "usual",
      "expected": "-1,234"
    },
    {
      "name": "decimal with a point",
      "kind": "decimal",
      "value": 1234.5,
      "region": "usual",
      "expected": "1,234.5"
    },
    {
      "name": "decimal with a comma",
      "kind": "decimal",
      "value": 1234.5,
      "region": "german",
      "expected": "1.234,5"
    },
    {
      "name": "decimal with a space",
      "kind": "decimal",
      "value": 1234.5,
      "region": "french",
      "expected": "1 234,5"
    },
    {
      "name": "decimal rounded to three places",
      "kind": "decimal",
      "value": 1234.5678,
      "region": "usual",
      "expected": "1,234.568"
    },
    {
      "name": "decimal below one",
      "kind": "decimal",
      "value": 0.25,
      "region": "german",
      "expected": "0,25"
    },
    {
      "name": "day, year first",
