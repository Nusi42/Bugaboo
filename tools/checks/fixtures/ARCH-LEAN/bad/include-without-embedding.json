            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/PersonRef"
          }
        }
      },
      "PersonRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
