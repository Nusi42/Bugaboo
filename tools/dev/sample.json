      "backend": "Backend",
      "frontend": "Frontend",
      "mobile": "Mobile",
      "qa": "QA",
      "support": "Support",
      "docs": "Docs",
      "management": "Management",
      "external": "External"
    },
    "roles": {
      "support-agent": "Support agent",
      "security-reviewer": "Security reviewer"
    },
    "projects": [
      {
        "shortName": "APP",
