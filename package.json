{
  "name": "bugaboo",
  "private": true,
  "description": "Bugaboo browser app workspace (ADR-0009). Tool versions are pinned exactly (architecture section 9).",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "web/app",
    "web/packages/ui",
    "web/packages/messages",
    "web/packages/api-client",
    "web/packages/wasm",
    "web/packages/wasm-search"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "cargo xtask wasm",
    "build": "vite build --config web/tooling/vite.config.ts",
    "preview": "vite preview --config web/tooling/vite.config.ts",
    "predev": "cargo xtask wasm",
    "dev": "vite --config web/tooling/vite.config.ts",
    "pretest": "cargo xtask wasm",
    "test": "vitest run --config web/tooling/vitest.config.ts",
    "test:e2e": "playwright test --config web/tooling/playwright.config.ts",
    "readme-media": "node web/tooling/readme-media.ts",
    "typecheck": "cargo xtask check only LINT-TYPES"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "binaryen": "132.0.0",
    "gifenc": "1.0.3",
    "html-validate": "11.16.2",
    "jscpd": "5.4.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "stylelint": "17.16.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
