        display flex
        align-items center
        overflow hidden
        white-space nowrap
        cursor pointer
        border 0
    }

    rule ".bar.ns" {
        background "$fg-subtle"
    }

    rule ".bar.done" {
        background "$st-done"
    }

    rule ".bar.goal" {
        background "$accent"
        height "$doc-space-10"
        top "$doc-space-14"
        border-radius "$doc-space-3"
    }

    rule ".bar.goal .prog" {
