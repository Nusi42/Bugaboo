        flex-wrap wrap
        gap "$space-2"
        align-items center
    }

    rule ".fact" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        border "$border-width solid $border"
        background "$bg-raised"
        border-radius "$doc-r-pill"
        padding "$doc-space-3 $doc-space-10"
