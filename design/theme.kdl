        width "100%"
        height auto
        background "$bg-surface"
    }

    rule ".edge" {
        fill none
        stroke-width "$doc-stroke-width"
        transition "opacity $motion-fast,stroke-width $motion-fast"
    }

    rule ".k-blocks" {
        stroke "$warning"
    }

    rule ".k-causes" {
        stroke "$danger"
    }

    rule ".k-dup" {
        stroke "$fg-subtle"
        stroke-dasharray 5 4
    }

    rule ".k-rel" {
        stroke "$fg-muted"
    }

    rule ".k-part" {
        stroke "$accent"
    }

    rule ".elabel" {
        font-size "$doc-font-11"
        fill "$fg-muted"
        paint-order stroke
        stroke "$bg-surface"
        stroke-width "$space-1"
        stroke-linejoin round
        font-family "$font-ui"
    }

    rule ".node" {
        cursor pointer
        transition "opacity $motion-fast"
    }

    rule ".node rect" {
        fill "$bg-raised"
        stroke "$border"
        stroke-width "$doc-stroke-1-2"
    }

    rule ".node:hover rect" ".node:focus rect" {
        stroke "$accent"
        stroke-width "$doc-stroke-width"
    }

    rule ".node:focus" {
        outline none
    }

    rule ".node.center rect" {
        fill "$accent-soft"
        stroke "$accent"
        stroke-width "$doc-stroke-2-5"
    }

    rule ".nkey" {
