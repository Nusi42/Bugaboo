    }

    rule ".doc-tree" {
        border-right "$border-width solid $border"
        padding "$doc-space-14 $doc-space-10"
        background "$bg-surface"
        display flex
        flex-direction column
        gap "$doc-space-2"
    }

    rule ".doc-tree .nav-item" {
        font-size "$fs-sm"
    }

    rule ".doc-page" {
        padding "$doc-space-28 $doc-space-36 $doc-space-48"
        min-width 0
    }

    rule ".doc-page h1" {
        font-size "$doc-font-30"
        margin "$space-1 0 $doc-space-6"
        text-wrap balance
    }

    rule ".doc-page h2" {
        font-size "$fs-lg"
        margin "$space-5 0 $space-2"
    }

    rule ".doc-page p" ".doc-page li" {
        max-width "$doc-measure-lede"
        line-height "$doc-lh-reading"
    }

    rule ".doc-toolbar" {
        display flex
        gap "$space-1"
        flex-wrap wrap
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$space-1"
        margin "$space-3 0 $doc-space-20"
        width max-content
        max-width "100%"
        background "$bg-surface"
    }

    rule ".doc-toolbar button:hover" {
        background "$bg-hover"
    }

    rule ".live-chip" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-2 $space-2 $doc-space-2 $doc-space-6"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        vertical-align "$doc-space-1"
        font-size "$fs-sm"
    }

    rule ".doc-side" {
        border-left "$border-width solid $border"
        padding "$space-4 $doc-space-14"
        display flex
        flex-direction column
        gap "$doc-space-18"
        font-size "$fs-sm"
    }

    rule ".ver" {
        display flex
        gap "$space-2"
        align-items center
        padding "$space-1 0"
    }

    rule ".lockbadge" {
        display inline-flex
        gap "$space-1"
        align-items center
        font-size "$fs-xs"
        color "$warning"
        margin-left auto
    }

    rule ".ts-wrap" {
        overflow-x auto
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
    }

    rule ".ts" {
        border-collapse collapse
        width "100%"
        min-width "$doc-space-720"
    }

    rule ".ts th.today" {
        color "$accent-fg"
    }

    rule ".ts input" {
        width "$doc-space-64"
        padding "$doc-space-6"
        text-align center
        border "$border-width solid $border-subtle"
        border-radius "$r-ctl"
        background "$bg-canvas"
        font-family "$font-mono"
    }

    rule ".ts input:focus" {
        border-color "$accent"
    }

    rule ".ts input.bad" {
        border-color "$danger"
        background "$danger-soft"
    }

    rule ".perm" {
        border-collapse collapse
        width "100%"
        min-width "$doc-space-640"
    }

    rule ".perm select" {
        padding "$doc-space-5 $space-2"
        border-radius "$r-ctl"
        border "$border-width solid $border"
        background "$bg-raised"
        font-size "$fs-sm"
    }

    rule ".perm select.hid" {
        color "$fg-subtle"
    }

    rule ".perm select.see" {
        color "$st-ip"
    }

    rule ".perm select.chg" {
        color "$success"
        font-weight "$doc-weight-semibold"
    }

    rule ".explain" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        line-height "$lh-loose"
    }

    rule ".wf" {
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".wf-row" {
        display flex
        gap "$doc-space-10"
        align-items center
        flex-wrap wrap
        padding "$space-3 $doc-space-14"
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
    }

    rule ".wf-row .arrow" {
        color "$fg-subtle"
    }

    rule ".themes" {
        display grid
        grid-template-columns "repeat(auto-fill, minmax($doc-space-200, 1fr))"
        gap "$doc-space-14"
    }

    rule ".theme-card" {
        border "$doc-space-2 solid $border"
        border-radius "$r-card"
        padding 0
        overflow hidden
        background none
        text-align left
    }

    rule ".theme-card[aria-pressed=\"true\"]" {
        border-color "$accent"
    }

    rule ".theme-card .pv" {
        height "$doc-space-96"
        display grid
        grid-template-columns "30% 1fr"
    }

    rule ".theme-card .pv i" {
        display block
    }

    rule ".theme-card .pv .s" {
        padding "$space-2 $doc-space-6"
        display flex
        flex-direction column
        gap "$doc-space-5"
    }

    rule ".theme-card .pv .m" {
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".theme-card .pv span" {
        display block
        height "$doc-space-6"
        border-radius "$doc-space-3"
    }

    rule ".theme-card .cap" {
        padding "$space-2 $doc-space-10"
        display flex
        flex-direction column
        background "$bg-raised"
    }

    rule ".pop-item small" {
        color "$fg-muted"
        margin-left auto
    }

    rule ".theme-card .cap small" {
