        border-radius "$space-2"
        font-size "$doc-font-12-5"
    }

    rule ".savestate" {
        display flex
        gap "$space-2"
        align-items center
        font-size "$doc-font-12-5"
        color "$fg-muted"
    }

    rule ".ss-dot" {
        width "$space-2"
        height "$space-2"
        border-radius "50%"
        display inline-block
    }

    rule ".ss-dot.ip" {
        background "$st-ip"
    }

    rule ".ss-dot.ok" {
        background "$success"
    }

    rule ".fv" {
        display grid
        grid-template-columns "$doc-space-44 $doc-space-170 minmax(0, 1fr)"
        min-height "$doc-space-330"
    }

    rule ".fv-icons" {
        background "$bg-surface"
        border-right "$border-width solid $border"
        display flex
        flex-direction column
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-10 0"
    }

    rule ".fv-ic" {
        width "$doc-space-30"
        height "$doc-space-30"
        border-radius "$r-ctl"
        display grid
        place-items center
        color "$fg-muted"
    }

    rule ".fv-ic.on" {
        background "$bg-selected"
        color "$accent-fg"
    }

    rule ".fv-rail" {
        border-right "$border-width solid $border"
        background "$bg-surface"
        font-size "$doc-font-12"
    }

    rule ".fv-rh" {
        display flex
        padding "$space-2 $doc-space-9"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".fv-ri" {
        display flex
        flex-direction column
        gap "$doc-space-1"
        padding "$doc-space-6 $doc-space-9"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".fv-ri.on" {
        background "$bg-selected"
    }

    rule ".fv-main" {
        display flex
        flex-direction column
        min-width 0
    }

    rule ".fv-h" {
        display flex
        gap "$space-2"
        align-items center
        padding "$doc-space-7 $space-3"
        border-bottom "$border-width solid $border-subtle"
        font-size "$doc-font-12"
    }

    rule ".fv-body" {
        display grid
        grid-template-columns "minmax(0, 1fr) $doc-space-150"
    }

    rule ".fv-col" {
        padding "$doc-space-14 $doc-space-18"
        display flex
        flex-direction column
        gap "$doc-space-10"
        min-width 0
    }

    rule ".fv-det" {
