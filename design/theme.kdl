    }

    rule ".nd-ip" {
        fill "$st-ip"
    }

    rule ".nd-dn" {
        fill "$st-done"
    }

    rule ".map-svg.hl-on .edge:not(.hl)" ".map-svg.hl-on .elabel:not(.hl)" ".map-svg.hl-on .node:not(.hl)" {
        opacity "$doc-opacity-0-2"
    }

    rule ".map-svg .edge.hl" {
        stroke-width "$doc-stroke-3-4"
    }

    rule ".map-svg.hide-blocks .k-blocks" ".map-svg.hide-blocks .l-blocks" ".map-svg.hide-causes .k-causes" ".map-svg.hide-causes .l-causes" ".map-svg.hide-dup .k-dup" ".map-svg.hide-dup .l-dup" ".map-svg.hide-rel .k-rel" ".map-svg.hide-rel .l-rel" ".map-svg.hide-part .k-part" ".map-svg.hide-part .l-part" {
