        flex-direction column
        gap "$space-3"
    }

    rule ".map-ctl" {
        display flex
        flex-wrap wrap
        gap "$space-2"
        align-items center
    }

    rule ".chip.kind-chip" {
        padding "$space-1 $doc-space-10"
        gap "$space-2"
    }

    rule ".kind-chip[aria-pressed=\"false\"]" {
        opacity "$doc-opacity-0-55"
    }

    rule ".kind-chip[aria-pressed=\"false\"] .lbl" {
        text-decoration line-through
    }

    rule ".sw" {
        width "$doc-space-20"
        height 0
        border-top "$doc-space-3 solid $fg-muted"
        display inline-block
    }

    rule ".sw.k-blocks" {
        border-color "$warning"
    }

    rule ".sw.k-cause" {
        border-color "$danger"
    }

    rule ".sw.k-dup" {
        border-top-style dashed
        border-color "$fg-subtle"
    }

    rule ".sw.k-rel" {
        border-color "$fg-muted"
    }

    rule ".sw.k-part" {
        border-color "$accent"
    }

    rule ".map-canvas" {
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-surface"
        overflow auto
    }

    rule ".map-canvas svg" {
        display block
        width "100%"
        min-width "$doc-space-620"
        height auto
        max-height "$doc-vh-72"
    }

    rule ".edge" {
        stroke-width "$doc-stroke-width"
        fill none
        transition "opacity $motion-fast,stroke-width $motion-fast"
    }

    rule ".edge.k-blocks" {
        stroke "$warning"
    }

    rule ".edge.k-cause" {
        stroke "$danger"
    }

    rule ".edge.k-dup" {
        stroke "$fg-subtle"
        stroke-dasharray 6 5
    }

    rule ".edge.k-rel" {
        stroke "$fg-muted"
    }

    rule ".edge.k-part" {
        stroke "$accent"
    }

    rule ".mk-blocks" {
        fill "$warning"
    }

    rule ".mk-cause" {
        fill "$danger"
    }

    rule ".mk-dup" {
        fill "$fg-subtle"
    }

    rule ".mk-part" {
        fill "$accent"
    }

    rule ".elabel" {
        font-size "$doc-font-12"
        fill "$fg-muted"
        paint-order stroke
        stroke "$bg-surface"
        stroke-width "$doc-space-5"
        stroke-linejoin round
        font-family "$font-ui"
        transition "opacity $motion-fast"
    }

    rule ".node" {
        cursor pointer
        transition "opacity $motion-fast"
    }

    rule ".node rect" {
        fill "$bg-raised"
        stroke "$border"
        stroke-width "$doc-stroke-1-2"
    }

    rule ".node:hover rect" ".node:focus rect" {
        stroke "$accent"
        stroke-width "$doc-stroke-2-2"
    }

    rule ".node:focus" {
        outline none
    }

    rule ".node.center rect" {
        fill "$accent-soft"
        stroke "$accent"
        stroke-width "$doc-stroke-2-5"
    }

    rule ".nkey" {
        font-family "$font-mono"
        font-size "$doc-font-12"
        fill "$fg-muted"
    }

    rule ".ntitle" {
        font-family "$font-ui"
        font-size "$doc-font-13"
        font-weight "$doc-weight-semibold"
        fill "$fg"
    }

    rule ".nd-ns" {
        fill "$st-ns"
    }

    rule ".nd-ip" {
        fill "$st-ip"
    }

    rule ".nd-done" {
        fill "$st-done"
    }

    rule ".map-canvas.hl-on .edge:not(.hl)" ".map-canvas.hl-on .elabel:not(.hl)" ".map-canvas.hl-on .node:not(.hl)" {
        opacity "$doc-opacity-0-2"
    }

    rule ".edge.hl" {
        stroke-width "$doc-stroke-3-5"
    }

    rule ".map-info" {
