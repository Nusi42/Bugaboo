// Bugaboo theme: the one file for everything about how the app looks (ADR-0026).
//
// Read only by `cargo xtask gen theme`, which writes the one static style sheet
// (web/packages/ui/src/theme.css), the TypeScript names (tokens.ts), the Rust theme
// choices of the settings and the copy for the design pages. Neither the server nor the
// browser reads this file.
//
// What is in here, in this order:
//   1. themes and the choices that change token values (spacing, text size, motion),
//   2. tokens: every value, with its variants for each mode on one line,
//   3. contrast: the rules that every theme must keep (STY-CONTRAST),
//   4. mixins, keyframes and part rules: the look of every component, using tokens only.
//
// Components carry no style values and no class names. They emit `data-part`, `data-state`
// and `data-variant`, and React Aria's own `data-*` state attributes. THEME-ONLY checks it.

// The two themes that "Match my device" starts with.
defaults light="daylight" dark="dusk"

// The attributes of the page frame (<html>): `look` carries the theme on the page, `mode` is the
// light or dark mode that the design pages force, `preview` marks a sample of a theme inside the
// page. Written once: the style sheets, the TypeScript (`pageAttributes`) and the browser tests
// read the names from here.
frame look="data-look" mode="data-theme" preview="data-preview-look"

// The built-in themes. `kind` decides the browser's own controls and scrollbars.
themes {
    theme "daylight" kind="light"
    theme "paper" kind="light"
    theme "dusk" kind="dark"
    theme "midnight" kind="dark"
}

// Choices of a person that change token values without changing the theme. Each is an
// attribute on <html>; a token names the variant as a property (`density` below has
// `compact=`). `media` switches the variant on from the device setting too.
variants {
    variant "compact" attribute="data-spacing" value="compact"
    variant "larger-text" attribute="data-text" value="larger"
    variant "less-motion" attribute="data-motion" value="less" media="(prefers-reduced-motion: reduce)"
    // Choices the device makes: a touch screen (fingers need 44 px, UX §7.4) and a phone (text 16).
    variant "touch" media="(pointer: coarse), (width < $bp-tablet)"
    variant "phone" media="(width < $bp-tablet)"
}

// Tokens. The first value (unnamed) is the same in every theme. A color has one value per
// theme, `<theme>-more=` replaces it when the device asks for more contrast, `forced=`
// replaces it while forced colors are on, and `<variant>=` is the value while that choice is on.
tokens {
    // Fonts
    font "font" "Atkinson Hyperlegible Next" "system-ui" "-apple-system" "Segoe UI" "Roboto" "sans-serif"
    font "mono" "Atkinson Hyperlegible Mono" "ui-monospace" "Cascadia Mono" "Consolas" "monospace"

    // Corners
    size "r-ctl" "6px"
    size "r-card" "10px"
    size "r-pill" "999px"

    // Text sizes (times the text size choice)
    size "fs-xs" "calc(12px * $text-scale)"
    size "fs-sm" "calc(13px * $text-scale)"
    size "fs-base" "calc(14px * $text-scale)"
    size "fs-md" "calc(16px * $text-scale)"
    size "fs-lg" "calc(20px * $text-scale)"
    size "fs-xl" "calc(24px * $text-scale)"
    // The text of rows, fields and buttons: 14 on a computer, 16 on a phone (UX §7.3).
    size "fs-ui" "calc(14px * $text-scale)" phone="calc(16px * $text-scale)"

    // Spacing (times the spacing choice)
    size "space-1" "calc(4px * $density)"
    size "space-2" "calc(8px * $density)"
    size "space-3" "calc(12px * $density)"
    size "space-4" "calc(16px * $density)"
    size "space-5" "calc(24px * $density)"
    size "space-6" "calc(32px * $density)"
    size "space-7" "calc(48px * $density)"

    // Padding per container (UX §7.4, R2, R3): inside a control 12, a box, a row or a panel 16, a
    // dialog or a page 24; between fields 20, between sections 28.
    size "pad-control" "$space-3"
    size "pad-box" "$space-4"
    size "pad-dialog" "$space-5"
    size "gap-fields" "calc(20px * $density)"
    size "gap-sections" "calc(28px * $density)"

    // Sizes
    size "size-content" "640px"
    size "size-page" "960px"
    size "size-menu" "240px"
    size "size-form" "$size-dialog"
    size "size-qr" "200px"
    size "size-code" "220px"
    // The square in the row of a file: its preview, or the sign of its type (M4 WP-05).
    size "size-file-tile" "64px" phone="56px"
    // A quiet button that stands under text on a phone (*Download* and *Delete* under a file, the
    // button of the note under the buttons of a window) hangs back by its padding, so its text
    // starts where the text above starts (R1, the mixin `hang-start`). Beside the text, on a
    // computer, nothing hangs back.
    size "size-phone-hang" "0px" phone="calc(-1 * $pad-control)"
    // How big a control is (UX §7.4): 36 with a mouse and 44 for a finger. WCAG 2.2 AA asks for 24 at
    // least, so no control is smaller (a test holds the tokens to it).
    size "size-target-least" "24px"
    size "size-control" "36px" touch="44px"
    size "size-control-small" "28px" touch="44px"
    // A row of a list: 44 with a mouse and 64 for a finger.
    size "size-row" "44px" touch="64px"
    // The coloured edge of a row for its priority.
    size "size-edge" "4px"
    // The name of a value in the details: 112 on a computer, 120 on a phone.
    size "size-name" "112px" phone="120px"
    // The columns of a list row (UX §4.2): the icon columns, the ID, the priority, the person.
    size "size-col-icon" "24px"
    // The two columns of buttons at the end of a status change in the workflow editor: the same width in every row.
    size "size-col-rules" "64px"
    size "size-col-remove" "80px"
    size "size-col-key" "96px"
    size "size-col-short" "64px"
    size "size-col-place" "112px"
    size "size-col-priority" "96px"
    size "size-col-person" "144px"
    size "size-col-labels" "160px"
    size "size-col-changed" "120px"
    // A window (UX §6.3): it starts 760 wide and as tall as its content, the smallest is 480 wide and, when a person makes it smaller, 360 high (the code holds that height, so a short window is not made taller), and the form follows its own width.
    size "size-window" "760px"
    size "size-window-width-min" "480px"
    size "size-window-height-min" "360px"
    size "size-window-button" "46px"
    // The places to drag at the edges of a window.
    size "size-window-handle" "8px"
    // The size of the window right now: the code sets these two variables while the person drags,
    // and nothing else sets a style at run time.
    size "window-width" "$size-window" run-time="true"
    size "window-height" "auto" run-time="true"
    size "bp-window-side" "880px"
    size "bp-window-wide" "1200px"
    // The width of one day on the timeline at the week zoom.
    size "size-day-week" "16px"

    // Focus ring
    size "ring-width" "2px"
    size "ring-offset" "2px"

    // Where the layout changes
    size "bp-tablet" "768px"
    size "bp-computer" "1280px"
    size "size-sidebar" "264px"
    size "size-sidebar-narrow" "72px"
    size "size-panel" "420px"
    size "size-bar" "56px"
    size "size-viewport" "100dvh"
    // A question is a small fixed dialog, 440 wide (R10); the palette of quick search is wider.
    size "size-dialog" "440px"
    size "size-palette" "560px"
    size "size-icon" "20px"
    size "size-icon-small" "16px"
    size "size-list" "300px"
    size "size-details" "340px"
    size "size-reading" "75ch"
    size "size-main" "780px"
    size "size-sheet-share" "85%"
    // Wide enough for the longest level ("Can change") in its box, so no word is cut; more roles than fit scroll.
    size "size-matrix-cell" "calc($size-control * 4)"
    size "size-list-tall" "calc($size-list * 2)"
    // Placeholder lines and the sample of a theme: how much of the width a shorter line takes.
    size "size-line-medium" "80%"
    size "size-line-short" "55%"
    size "size-sample-short" "60%"
    // Turns: the tick of a checkbox, and the arrow of a tree branch that is open.
    size "angle-tick" "45deg"
    size "angle-open" "90deg"
    // Where the skip link waits, out of sight above the page.
    size "skip-offset" "-300%"

    // Motion
    duration "motion-fast" "120ms" less-motion="0ms"
    duration "motion-base" "200ms" less-motion="0ms"
    duration "motion-pulse" "calc($motion-base * 8)" less-motion="0ms"

    // The choices as numbers
    number "density" 1 compact=0.75
    number "text-scale" 1 larger-text=1.25

    // Font weights
    weight "weight-regular" 400
    weight "weight-bold" 700

    // Line heights
    line-height "lh-tight" 1.2
    line-height "lh-snug" 1.25
    line-height "lh-body" 1.4
    line-height "lh-text" 1.5
    line-height "lh-loose" 1.6

    // The width of a line: borders and dividers
    border-width "border-width" "1px"

    // Layers (z-index), from the lowest, each named for what uses it. The overlay is above everything
    // that sticks to the page.
    // z-raised: the corner of the levels table, above the cells that scroll under it.
    layer "z-raised" 1
    // z-sticky: the top bar of a page, which stays while the page scrolls.
    layer "z-sticky" 5
    // z-bar: the question of a confirm dialog.
    layer "z-bar" 10
    // z-panel: what floats over the page at its edge (the offers to undo), and the header of the design pages.
    layer "z-panel" 20
    // z-overlay: sheets, menus and quick search.
    layer "z-overlay" 30
    // z-top: the skip link when it has the focus: above everything.
    layer "z-top" 40

    // Opacity. The scrim is the dimmed page behind a sheet; forced colors make it fainter.
    opacity "opacity-faint" 0.5
    opacity "opacity-disabled" 0.6
    // A control that waits for an answer is seen by people while it waits, so its text keeps AA (4.5:1)
    // on its own fill; a disabled control is exempt, a busy one is not. Held by the test of the busy Save.
    opacity "opacity-busy" 0.85
    opacity "opacity-scrim" 0.8 forced=0.6

    // Easing, for the animations
    easing "ease-in" "ease-in"
    easing "ease-out" "ease-out"
    easing "ease-in-out" "ease-in-out"

    // How much a pressed or hovered primary button brightens
    number "hover-brightness" 1.12

    // Colors
    color "bg-canvas" daylight="#ffffff" paper="#fbf8f3" dusk="#1d2027" midnight="#000000"
    color "bg-surface" daylight="#f6f7f9" paper="#f4efe7" dusk="#252932" midnight="#0c0d10"
    color "bg-raised" daylight="#ffffff" paper="#fffdf9" dusk="#2d323c" midnight="#16181d"
    color "bg-sunken" daylight="#eef0f3" paper="#ede6da" dusk="#191b21" midnight="#050506"
    color "bg-hover" daylight="#eceef2" paper="#ede6db" dusk="#333945" midnight="#1e2127"
    color "bg-selected" daylight="#ebe7fb" paper="#dce3eb" dusk="#3c375d" midnight="#242046"
    color "border" daylight="#dfe3e9" paper="#e1d8ca" dusk="#3b414d" midnight="#272a31" daylight-more="#6d6f72" paper-more="#6e6a63" dusk-more="#999ca2" midnight-more="#828388" forced="ButtonText"
    // The edge of a control that is drawn by its edge (a box to tick, the track of a switch): a line a
    // person has to see, so it reaches 3:1 against every surface (WCAG 1.4.11, checked by the `lines` rule of the contrast rules), unlike the dividers.
    color "border-control" daylight="#80838b" paper="#7a7366" dusk="#7d8696" midnight="#757a85" forced="ButtonText"
    color "border-subtle" daylight="#eaedf1" paper="#eae3d7" dusk="#313641" midnight="#1a1c21" daylight-more="#8c8e91" paper-more="#8c8881" dusk-more="#797c84" midnight-more="#66676a"
    color "fg" daylight="#16181d" paper="#2b2620" dusk="#e5e8ed" midnight="#f2f3f5"
    color "fg-muted" daylight="#5a6170" paper="#6a6157" dusk="#a3aab7" midnight="#9ca3af" daylight-more="#464c57" paper-more="#4d4740" dusk-more="#cbcfd6" midnight-more="#b2b7c1"
    color "fg-subtle" daylight="#636879" paper="#6b635a" dusk="#a0a6b1" midnight="#8c939f" daylight-more="#484c58" paper-more="#4d4741" dusk-more="#cccfd5" midnight-more="#afb4bd"
    color "accent" daylight="#5b3fd9" paper="#2f5d8a" dusk="#a495ff" midnight="#9483ff" daylight-more="#573cd0" paper-more="#2e5b87" dusk-more="#a697ff" midnight-more="#9b8cff" forced="Highlight"
    color "accent-soft" daylight="#eeeafd" paper="#e4ecf4" dusk="#37325a" midnight="#221d47"
    color "accent-fg" daylight="#4a2fc4" paper="#284f75" dusk="#c2b8ff" midnight="#b7abff" daylight-more="#492ec0" paper-more="#264a6e" dusk-more="#d0c8ff"
    color "on-accent" daylight="#ffffff" paper="#ffffff" dusk="#1a1530" midnight="#0b0820" forced="HighlightText"
    color "danger" daylight="#c62f2f" paper="#b23a2e" dusk="#ff8a80" midnight="#ff7a70" daylight-more="#912222" paper-more="#802a21" dusk-more="#ffbfb9" midnight-more="#ff928a"
    color "danger-soft" daylight="#fdecec" paper="#f8e6e1" dusk="#4a2a2c" midnight="#3a1414"
    color "warning" daylight="#aa4e09" paper="#925611" dusk="#f5b65b" midnight="#ffb547" daylight-more="#7c3907" paper-more="#693e0c" dusk-more="#f7c781"
    color "warning-soft" daylight="#fef3e2" paper="#f6ead5" dusk="#47391f" midnight="#382810"
    color "success" daylight="#1f784c" paper="#3f6e3a" dusk="#6fd39a" midnight="#5fd38f" daylight-more="#165637" paper-more="#2e502a" dusk-more="#96dfb5"
    color "success-soft" daylight="#e6f4ec" paper="#e5eedf" dusk="#213d31" midnight="#0f2e1e"
    color "st-ns" daylight="#5a6170" paper="#6a6157" dusk="#a3aab7" midnight="#9ca3af" daylight-more="#464c57" paper-more="#4d4740" dusk-more="#cbcfd6" midnight-more="#abb1bb"
    color "st-ns-soft" daylight="#eef0f3" paper="#ece5da" dusk="#343944" midnight="#262a31" midnight-more="#1a1c21"
    color "st-ip" daylight="#1d5fd1" paper="#1d6b80" dusk="#7fb0ff" midnight="#74a8ff" daylight-more="#16489f" paper-more="#14495a" dusk-more="#b3d0ff" midnight-more="#82b1ff"
    color "st-ip-soft" daylight="#e7effc" paper="#dfeef1" dusk="#24365a" midnight="#10244a"
    color "st-done" daylight="#1f784c" paper="#3f6e3a" dusk="#6fd39a" midnight="#5fd38f" daylight-more="#165637" paper-more="#2e502a" dusk-more="#96dfb5"
    color "st-done-soft" daylight="#e6f4ec" paper="#e5eedf" dusk="#213d31" midnight="#0f2e1e"
    // The tint of a row by its status group: the group's soft color mixed into the raised surface.
    // The hovered and the selected row keep the hue and move away from the tint by the same step as
    // the plain rows do, so the state stays visible on every tint (the `distinct` rules below).
    color "tint-ip" daylight="#f5f9fe" paper="#f2f7f6" dusk="#293448" midnight="#131e34"
    color "tint-ip-hover" daylight="#eef2f9" paper="#edf0ed" dusk="#2c384d" midnight="#18233a"
    color "tint-ip-selected" daylight="#eaebfc" paper="#e2ebf0" dusk="#34385f" midnight="#1c234f" midnight-more="#1b224b"
    color "tint-done" daylight="#f5fbf7" paper="#f5f7ef" dusk="#283638" midnight="#12231e"
    color "tint-done-hover" daylight="#eef4f2" paper="#f0f0e6" dusk="#2c3a3d" midnight="#162824"
    color "tint-done-selected" daylight="#eaedf5" paper="#e5ebe9" dusk="#333a50" midnight="#1c293a" midnight-more="#192734"
    color "cat1-bg" daylight="#fde7ef" paper="#f6e1e4" dusk="#4a2638" midnight="#3a1428"
    color "cat1-fg" daylight="#a3195b" paper="#97304a" dusk="#ff9cc8" midnight="#ff92c2"
    color "cat2-bg" daylight="#e3f1ff" paper="#e0eaf3" dusk="#213a5c" midnight="#10294a"
    color "cat2-fg" daylight="#1556a8" paper="#2c5680" dusk="#8ec3ff" midnight="#86bdff"
    color "cat3-bg" daylight="#e4f5ea" paper="#e3eddd" dusk="#1f4030" midnight="#0f3020"
    color "cat3-fg" daylight="#1c6b3c" paper="#3d6534" dusk="#8fe0ae" midnight="#84dca6"
    color "cat4-bg" daylight="#fff1dc" paper="#f5e6cf" dusk="#4a3519" midnight="#3a2608"
    color "cat4-fg" daylight="#8a4b00" paper="#86501a" dusk="#ffc277" midnight="#ffbc6b"
    color "cat5-bg" daylight="#efe9ff" paper="#ece3f1" dusk="#382d5e" midnight="#261c4f"
    color "cat5-fg" daylight="#5532b8" paper="#674184" dusk="#c6b5ff" midnight="#bfaeff"
    color "cat6-bg" daylight="#ddf5f3" paper="#dcede9" dusk="#173f3d" midnight="#0a302e"
    color "cat6-fg" daylight="#0e6560" paper="#2d6559" dusk="#7dddd3" midnight="#72d8cd"
    color "cat7-bg" daylight="#fbdbda" paper="#efd9d9" dusk="#4b2220" midnight="#3b1311" daylight-more="#fce2e1" paper-more="#f0dddd"
    color "cat7-fg" daylight="#781511" paper="#682927" dusk="#f98e8b" midnight="#f88581"
    color "cat8-bg" daylight="#fbf4da" paper="#eeead8" dusk="#473f1e" midnight="#3b3311" dusk-more="#443c1d" midnight-more="#322b0e"
    color "cat8-fg" daylight="#786411" paper="#685b27" dusk="#f9e38b" midnight="#f8e181"
    color "cat9-bg" daylight="#daf5fb" paper="#d8eaee" dusk="#20444b" midnight="#11343b" dusk-more="#1f4148" midnight-more="#0f2f36"
    color "cat9-fg" daylight="#116778" paper="#275d68" dusk="#8be7f9" midnight="#81e4f8"
    color "cat10-bg" daylight="#eefbda" paper="#e5eed8" dusk="#35441d" midnight="#2a3b11" dusk-more="#32411c" midnight-more="#222f0e"
    color "cat10-fg" daylight="#4c7411" paper="#4e6827" dusk="#cdf98b" midnight="#c9f881"
    color "cat11-bg" daylight="#e6eaf0" paper="#e0e2e6" dusk="#2e3642" midnight="#1d2735"
    color "cat11-fg" daylight="#2e4360" paper="#3a475a" dusk="#a9beda" midnight="#9cb9e2"
    color "cat12-bg" daylight="#fbe4da" paper="#eeded8" dusk="#4b2d20" midnight="#3b1e11"
    color "cat12-fg" daylight="#783011" paper="#683b27" dusk="#f9ac8b" midnight="#f8a581"

    // The shadow of things that float
    shadow "shadow" daylight="0 1px 2px 0 #16181d0f, 0 6px 20px 0 #16181d14" paper="0 1px 2px 0 #3c2d190f, 0 6px 20px 0 #3c2d1914" dusk="0 1px 2px 0 #0000004d, 0 8px 24px 0 #00000059" midnight="0 0 0 1px #272a31, 0 8px 24px 0 #00000099"
}

// Contrast rules (WCAG, THM-03, UX-04, THM-06). Every text color is checked on every
// background in every theme, except the pairs that are never used, each with its reason.
contrast min=4.5 {
    text "fg" "fg-muted" "fg-subtle" "accent-fg" "on-accent" "danger" "warning" "success" "st-ns" "st-ip" "st-done" "cat1-fg" "cat2-fg" "cat3-fg" "cat4-fg" "cat5-fg" "cat6-fg" "cat7-fg" "cat8-fg" "cat9-fg" "cat10-fg" "cat11-fg" "cat12-fg"
    backgrounds "bg-canvas" "bg-surface" "bg-raised" "bg-sunken" "bg-hover" "bg-selected" "accent" "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-ip-soft" "st-done-soft" "tint-ip" "tint-ip-hover" "tint-ip-selected" "tint-done" "tint-done-hover" "tint-done-selected" "cat1-bg" "cat2-bg" "cat3-bg" "cat4-bg" "cat5-bg" "cat6-bg" "cat7-bg" "cat8-bg" "cat9-bg" "cat10-bg" "cat11-bg" "cat12-bg"
    restricted "on-accent" on="accent danger" reason="On-accent text is only ever drawn on the accent fill, and on the red of the Close button of a window."
    restricted "cat1-fg" on="cat1-bg" reason="Category 1 text is only ever drawn on its own category 1 background."
    restricted "cat2-fg" on="cat2-bg" reason="Category 2 text is only ever drawn on its own category 2 background."
    restricted "cat3-fg" on="cat3-bg" reason="Category 3 text is only ever drawn on its own category 3 background."
    restricted "cat4-fg" on="cat4-bg" reason="Category 4 text is only ever drawn on its own category 4 background."
    restricted "cat5-fg" on="cat5-bg" reason="Category 5 text is only ever drawn on its own category 5 background."
    restricted "cat6-fg" on="cat6-bg" reason="Category 6 text is only ever drawn on its own category 6 background."
    restricted "cat7-fg" on="cat7-bg" reason="Category 7 text is only ever drawn on its own category 7 background."
    restricted "cat8-fg" on="cat8-bg" reason="Category 8 text is only ever drawn on its own category 8 background."
    restricted "cat9-fg" on="cat9-bg" reason="Category 9 text is only ever drawn on its own category 9 background."
    restricted "cat10-fg" on="cat10-bg" reason="Category 10 text is only ever drawn on its own category 10 background."
    restricted "cat11-fg" on="cat11-bg" reason="Category 11 text is only ever drawn on its own category 11 background."
    restricted "cat12-fg" on="cat12-bg" reason="Category 12 text is only ever drawn on its own category 12 background."

    exclude reason="The accent fill carries only on-accent text." {
        text "fg" "fg-*" "accent-fg" "danger" "warning" "success" "st-ns" "st-ip" "st-done"
        on "accent"
    }
    exclude reason="Hint text sits on plain surfaces, never on tinted backgrounds." {
        text "fg-subtle"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Accent text sits on plain surfaces or the accent tint, not on status or category tints." {
        text "accent-fg"
        on "danger-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Danger text sits on plain surfaces or the danger tint." {
        text "danger"
        on "accent-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Warning text sits on plain surfaces or the warning tint." {
        text "warning"
        on "accent-soft" "danger-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Success text sits on plain surfaces or the success tint." {
        text "success"
        on "accent-soft" "danger-soft" "warning-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-ns"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ip-soft" "st-done-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-ip"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-done-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-done"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-ip-soft" "cat*-bg"
    }

    non-text "border" "border-subtle" reason="Borders and dividers are decorative lines, not text; they are not part of the text contrast rules."
    non-text "border-control" reason="The edge of a control is a line, not text; it is kept at 3:1 by the `lines` rule below."
    lines min=3 reason="The edge of a box to tick and of the track of a switch is a line a person has to see: WCAG 1.4.11 asks 3:1 against every surface in every theme." {
        colors "border-control"
        on "bg-canvas" "bg-surface" "bg-raised" "bg-sunken"
    }

    lines min=2 faded-by="opacity-disabled" reason="The edge of a button that cannot be pressed is drawn in the color of quiet words and faded by the opacity of a disabled control: as it is seen it stays 2:1 against every plain surface in every theme (a disabled control is exempt from WCAG 1.4.11, but its frame must not vanish; the final check of M4 found 1.24:1)." {
        colors "fg-muted"
        on "bg-canvas" "bg-surface" "bg-raised" "bg-sunken"
    }

    // With the device setting for more contrast.
    more min-text=7 min-line=3 reason="With the device setting for more contrast, the listed text colors reach 7:1 (WCAG AAA) on every background they are used on, and the listed lines reach 3:1 (WCAG 1.4.11) on the plain surfaces. The other text colors, the category colors, keep their AA ratio: they carry words, never meaning alone." {
        text "fg" "fg-muted" "fg-subtle" "accent-fg" "danger" "warning" "success" "st-ns" "st-ip" "st-done" "on-accent"
        lines "border" "border-subtle"
        line-on "bg-canvas" "bg-surface" "bg-raised"
    }
}

// Hovered and selected rows must stay visible.
distinct min-against-surfaces=1.08 min-between-states=1.04 reason="Hovered and selected rows must stay visible: they differ from every surface by at least 1.08:1, and from each other by at least 1.04:1, in every theme." {
    states "bg-hover" "bg-selected"
    surfaces "bg-canvas" "bg-surface" "bg-raised"
}

distinct min-against-surfaces=1.06 min-between-states=1.04 reason="On a row tinted by its status group, the hovered and the selected row differ from the tint by at least 1.06:1, and from each other by at least 1.04:1, in every theme. A selected row also draws a ring inside its edge, so it never relies on the fill alone." {
    group {
        states "tint-ip-hover" "tint-ip-selected"
        surfaces "tint-ip"
    }
    group {
        states "tint-done-hover" "tint-done-selected"
        surfaces "tint-done"
    }
}


// ───────────── Mixins ─────────────
//
// Lines that several rules share. `use "name"` puts them in the place of the line.

// The line of the ring: the width and the color of every outline that says "here".
mixin "ring-line" {
    outline "$ring-width solid $accent"
}

// The ring around what has the focus: the one definition of how the focus looks.
mixin "ring" {
    use "ring-line"
    outline-offset "$ring-offset"
}

// Words that are less important than their neighbours.
mixin "quiet-text" {
    color "$fg-muted"
    font-size "$fs-base"
}

// A control that is waiting for an answer.
mixin "busy" {
    cursor progress
    opacity "$opacity-busy"
}

// The fill of a box or a track that is switched on.
mixin "chosen" {
    border-color "$accent"
    background "$accent"
}

// The ring drawn inside the edge of what has the focus, for rows that fill their box.
mixin "ring-inside" {
    use "ring-line"
    outline-offset "calc($ring-width * -1)"
}

// The page of the menu or tree that is open now.
mixin "current-item" {
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

// The chosen or current item: forced colors drop fills, so the item gets an outline to be seen.
mixin "marked" {
    forced {
        use "ring-line"
    }
}

// The edge of anything that is pressed or typed in: a touch target with a line and a raised fill.
mixin "control-box" {
    box-sizing border-box
    min-height "$size-control"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
}

// A box that is typed in: the field, the box that takes a key, the search box.
mixin "input-box" {
    use "control-box"
    width "100%"
    padding "$space-2 $pad-control"
    color "$fg"
    font-family "$font"
    font-size "$fs-ui"
}

// A row of a list that is picked from: the people, the results of quick search.
mixin "pick-row" {
    display flex
    flex-direction column
    gap "$space-1"
    box-sizing border-box
    min-height "$size-control"
    padding "$space-2 $space-3"
    color "$fg"
    text-decoration none
    cursor pointer
}

// The words of a button, a menu item or a branch of the tree.
mixin "menu-text" {
    color "$fg"
    font-size "$fs-ui"
    font-weight "$weight-bold"
    text-decoration none
}

// What floats over or stands out of the page: a card, a sheet, a panel, an offer.
mixin "floating-box" {
    box-sizing border-box
    border "$border-width solid $border"
    background "$bg-raised"
    box-shadow "$shadow"
}

// A quiet box on a surface: an item of a list.
mixin "surface-box" {
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}

// A box that is sunk into the page: a key, a code, a sample.
mixin "sunken-box" {
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-sunken"
}

// A group of fields without the browser's frame.
mixin "fieldset-reset" {
    min-width 0
    margin 0
    padding 0
    border 0
}

// A list without bullets and without the browser's indent.
mixin "list-reset" {
    margin 0
    padding 0
    list-style none
}

// Words and details under each other, which break anywhere when they are long.
mixin "column-wrap" {
    use "column-tight"
    overflow-wrap anywhere
}

// A row that is pressed: a mark or an icon and its words, as high as a finger.
mixin "touch-row" {
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-control"
    cursor pointer
}

// A link that is a target a finger can hit, and still reads as a link in a line of text.
mixin "touch-link" {
    display inline-flex
    align-items center
    min-height "$size-control"
}

// The name of a tab of a row of tabs: the editor of text, the sections of a form.
mixin "tab-label" {
    padding "$space-2 $space-3"
    min-height "$size-control"
    box-sizing border-box
    color "$fg-muted"
    font-size "$fs-md"
    font-weight "$weight-bold"
    cursor pointer
    border-bottom "$space-1 solid transparent"
}

// A button that is only its words.
mixin "bare-button" {
    border 0
    background transparent
    font-family "$font"
    cursor pointer
}

// A few lines of words in a box.
mixin "note-box" {
    display flex
    flex-direction column
    gap "$space-1"
    margin 0
    padding "$space-3"
}

// Lines under each other with a little room between them.
mixin "column-tight" {
    display flex
    flex-direction column
    gap "$space-1"
    min-width 0
}

// Sentences or details under each other, in the line height of body text.
mixin "quiet-column" {
    display flex
    flex-direction column
    gap "$space-2"
    margin 0
    line-height "$lh-body"
}

// A button that holds text hangs back by its own padding, so its text stands on the start edge of
// the text around it (R1). Every such button has the padding `pad-control`.
mixin "hang-start" {
    margin-inline-start "calc(-1 * $pad-control)"
}

// The buttons that answer a question or end a form (R6): quiet buttons stand on the start edge
// (R1), the one filled button at the end. On a phone they are stacked, the main one first.
mixin "answer-row" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content flex-end
    gap "$space-3"
}

// Text for screen readers only: out of sight, still read.
mixin "hidden-text" {
    position absolute
    width "$border-width"
    height "$border-width"
    margin "calc($border-width * -1)"
    padding 0
    overflow hidden
    border 0
    clip-path "inset(50%)"
    white-space nowrap
}

// ───────────── Animations ─────────────

keyframes "fade" {
    from {
        opacity 0
    }
}

keyframes "from-bottom" {
    from {
        transform "translateY(100%)"
    }
}

keyframes "from-start" {
    from {
        transform "translateX(-100%)"
    }
}

// The placeholder lines pulse while the text is on its way.
keyframes "pulse" {
    from {
        opacity "$opacity-faint"
    }
}

// ───────────── The page ─────────────
//
// `base` rules style elements of the page frame. Everything else is a `part`.

// The page frame is at least as high as the window, so its footer sits at the bottom.
base "html, body, #root" {
    height "100%"
}

base "body" {
    margin 0
    background "$bg-canvas"
    color "$fg"
    font-family "$font"
    font-size "$fs-md"
}

// The rule React Aria would add itself: pressing a control does not wait for a double tap.
base "[data-react-aria-pressable]" {
    touch-action "pan-x pan-y pinch-zoom"
}

base ":focus-visible" {
    use "ring"
}

// ───────────── Muted text ─────────────

// Text that is less important than its neighbours: a hint, an empty list.
part "muted" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
    line-height "$lh-body"
}

// Words for screen readers only: the name of a column that holds only an icon.
part "visually-hidden" {
    use "hidden-text"
}

// ───────────── Button (packages/ui: Button, IconButton) ─────────────
//
// The variants come before the states, so that a hovered quiet button is hovered.

part "button" {
    display inline-flex
    align-items center
    justify-content center
    gap "$space-2"
    use "control-box"
    padding 0 "$pad-control"
    use "menu-text"
    font-family "$font"
    line-height "$lh-tight"
    text-align center
    cursor pointer
}

// The edge of a button that cannot be pressed is drawn in the color of quiet words, so that it can be
// seen on every page in every theme, even after the fading (STY-CONTRAST holds the ratio). It comes
// before the looks and has no more weight than they: a look without an edge (quiet, item) keeps none.
part "button[disabled]" {
    opacity "$opacity-disabled"
    border-color "$fg-muted"
    cursor default
    forced {
        border-color GrayText
    }
}

part "button[variant=wide]" {
    width "100%"
}

// A button with only an icon: as wide as it is high.
part "button[variant=square]" {
    width "$size-control"
    padding 0
}

part "icon-button.hit" {
    display inline-flex
    align-items center
    justify-content center
}

part "button[variant=primary]" {
    border-color "$accent"
    background "$accent"
    color "$on-accent"
}

part "button[variant=quiet]" {
    border-color transparent
    background transparent
    color "$accent-fg"
    use "hang-start"
}

// One start edge (R1) and one end edge: a text button hangs back by its own padding, so its words
// stand on the edge of the text around it wherever the button is: first in a row, alone on a line
// that wrapped, or under another button. Where it ends a row it hangs over the end edge by the
// same amount (the review of M4, A3). A row that stands beside text on a computer takes the hang
// away from its quiet buttons (the rule below). This is the one rule; no screen hangs a button back
// by itself.
part "button[variant=quiet]:last-child" {
    margin-inline-end "calc(-1 * $pad-control)"
}

// An icon has no padding to hang back by.
part "button[variant=quiet][variant=square]" {
    margin-inline 0
}

// Where the buttons stand under text on a phone and beside it on a computer (a file, an item of a list):
// a quiet one hangs back by its padding on a phone only.
part "files.actions button[variant=quiet]" "item.actions button[variant=quiet]" {
    margin-inline-start "$size-phone-hang"
}

// An entry of a list of actions (the status list, *More*): its words start at the start edge, and it
// has no box until it is pointed at.
part "button[variant=item]" {
    justify-content flex-start
    border-color transparent
    background transparent
    color "$fg"
    text-align start
}

part "button[variant=danger]" {
    border-color "$danger"
    color "$danger"
}

part "button[hovered]" {
    background "$bg-hover"
}

part "button[pressed]" {
    background "$bg-selected"
}

// A main button that cannot be pressed yet looks like any button that cannot be pressed: the same
// edge, the same fill and the same pale words as a disabled secondary button, not a pale copy of the
// filled one, whose white words are hard to read (the review of M4, A14). The dashed edge belongs to
// the places to drop things on and to *Not started*.
part "button[variant=primary][disabled]" {
    border-color "$fg-muted"
    background "$bg-raised"
    color "$fg"
}

part "button[state=busy]" {
    use "busy"
}

part "button[focus-visible]" {
    use "ring"
}

part "button[variant=primary][hovered]" "button[variant=primary][pressed]" {
    background "$accent"
    filter "brightness($hover-brightness)"
}

part "button[variant=danger][hovered]" "button[variant=danger][pressed]" {
    background "$danger-soft"
}

// ───────────── Fields (TextField, SearchField, SelectField) ─────────────

part "field" {
    use "column-tight"
}

part "field.label" {
    font-size "$fs-md"
    font-weight "$weight-bold"
    color "$fg"
}

part "field.description" {
    font-size "$fs-base"
    color "$fg-muted"
    line-height "$lh-body"
}

// A value longer than its box ends in an ellipsis instead of running under the edge of the box (the
// review of M4: "Alder Street Baker|y" in the Details).
// One height for a box of one line and a choice (a select ignores the line height and would be 2 px
// taller): labels and boxes side by side line up (the review of M4).
part "field.input" {
    use "input-box"
    height "$size-control"
    padding-block 0
    line-height "$lh-body"
    text-overflow ellipsis
}

part "field.input[variant=multiline]" {
    height auto
    padding-block "$space-2"
    resize vertical
}

part "field.input[focused]" "field.input:focus-visible" {
    use "ring-line"
    outline-offset 0
    border-color "$accent"
}

part "field.input[invalid]" {
    border-color "$danger"
}

part "field.input[state=busy]" {
    use "busy"
}

part "field.input[disabled]" {
    opacity "$opacity-disabled"
}

part "field.error" {
    font-size "$fs-base"
    color "$danger"
    line-height "$lh-body"
}

// ───────────── Alert ─────────────

part "alert" {
    box-sizing border-box
    padding "$space-3 $space-4"
    border "$border-width solid $border"
    border-left-width "$space-1"
    border-radius "$r-ctl"
    background "$bg-surface"
    color "$fg"
    font-size "$fs-md"
    line-height "$lh-text"
    overflow-wrap anywhere
}

part "alert[variant=danger]" {
    border-color "$danger"
    background "$danger-soft"
}

part "alert[variant=success]" {
    border-color "$success"
    background "$success-soft"
}

part "alert[variant=warning]" {
    border-color "$warning"
    background "$warning-soft"
}

part "alert[variant=info]" {
    border-color "$accent"
    background "$accent-soft"
}

// ───────────── Link ─────────────

part "link" {
    color "$accent-fg"
    font-weight "$weight-bold"
    text-decoration underline
    text-underline-offset "$space-1"
    cursor pointer
    forced {
        color LinkText
    }
}

part "link[hovered]" {
    text-decoration-thickness "$ring-width"
}

part "link[focus-visible]" {
    use "ring"
}

part "link[current]" {
    color "$fg"
    text-decoration none
}

// ───────────── Switch ─────────────

part "switch" {
    use "touch-row"
    color "$fg"
    font-size "$fs-md"
    font-weight "$weight-bold"
}

part "switch.track" {
    flex none
    box-sizing border-box
    width "calc($space-4 * 2 + $space-1 * 2)"
    height "$space-5"
    padding "$space-1"
    border "$border-width solid $border-control"
    border-radius "$r-card"
    background "$bg-sunken"
}

part "switch.thumb" {
    display block
    width "$space-4"
    height "$space-4"
    border-radius "$r-card"
    background "$fg-muted"
    transform "translateX(0)"
    forced {
        background ButtonText
    }
}

part "switch[selected] switch.track" {
    use "chosen"
}

part "switch[selected] switch.thumb" {
    background "$on-accent"
    transform "translateX($space-4)"
}

part "switch[focus-visible] switch.track" {
    use "ring"
}

// ───────────── Checkbox ─────────────

part "checkbox" {
    use "touch-row"
    color "$fg"
    font-size "$fs-md"
}

part "checkbox.box" {
    position relative
    flex none
    box-sizing border-box
    width "$space-5"
    height "$space-5"
    border "$border-width solid $border-control"
    border-radius "$r-ctl"
    background "$bg-raised"
}

part "checkbox[hovered] checkbox.box" {
    background "$bg-hover"
}

part "checkbox[selected] checkbox.box" {
    use "chosen"
}

// The tick: two sides of a box, turned.
part "checkbox[selected] checkbox.box::after" {
    content "\"\""
    position absolute
    top "$space-1"
    left "$space-2"
    width "$space-1"
    height "$space-3"
    border solid "$on-accent"
    border-width 0 "$ring-width" "$ring-width" 0
    transform "rotate($angle-tick)"
}

part "checkbox[focus-visible] checkbox.box" {
    use "ring"
}

part "checkbox[disabled]" {
    opacity "$opacity-disabled"
    cursor default
}

part "checkbox.label" {
    min-width 0
    overflow-wrap anywhere
}

// ───────────── ChoiceGroup ─────────────

part "choice-group" {
    use "fieldset-reset"
}

part "choice-group.legend" {
    padding 0
    margin-bottom "$space-2"
    font-size "$fs-md"
    font-weight "$weight-bold"
    color "$fg"
}

part "choice-group.choices" {
    display flex
    flex-wrap wrap
    gap "$space-2"
}

part "choice-group.choice" {
    position relative
    display inline-flex
}

part "choice-group.input" {
    position absolute
    inset 0
    margin 0
    opacity 0
    cursor pointer
}

part "choice-group.label" {
    display inline-flex
    align-items center
    min-height "$size-control"
    padding 0 "$space-4"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-md"
}

// The tile of the theme picker (a sample and a name) is chosen, pointed at and focused like a label.
part "theme-picker.tile" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-2"
    border "$border-width solid $border"
    border-radius "$r-card"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-md"
}

// Forced colors drop background colors, so the chosen one needs an outline to be seen.
part "choice-group.input:checked + choice-group.label" "choice-group.input:checked + theme-picker.tile" {
    border-color "$accent"
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

part "choice-group.input:hover + choice-group.label" "choice-group.input:hover + theme-picker.tile" {
    background "$bg-hover"
}

part "choice-group.input:focus-visible + choice-group.label" "choice-group.input:focus-visible + theme-picker.tile" {
    use "ring"
}

// Long words (how a connection is protected) stand under each other on a phone, as wide as the screen,
// and not as ragged buttons side by side.
part "app-layout[variant=phone] choice-group.choices[variant=stacked]" {
    flex-direction column
    align-items stretch
}

part "app-layout[variant=phone] choice-group.choices[variant=stacked] choice-group.label" {
    flex 1
}

// ───────────── Overlay (sheets, menus, quick search) ─────────────
//
// The variant says where it opens from: center, bottom, start or top.

part "overlay" {
    position fixed
    inset 0
    z-index "$z-overlay"
    display flex
    overflow hidden
}

// The page behind stays in sight but dimmed, so a sheet is clearly a layer above it.
part "overlay::before" {
    content "\"\""
    position absolute
    inset 0
    background "$bg-sunken"
    opacity "$opacity-scrim"
    forced {
        background Canvas
    }
}

part "overlay[variant=center]" {
    align-items flex-start
    justify-content center
    padding "$space-6 $space-4"
}

part "overlay[variant=bottom]" {
    align-items flex-end
}

// A question that needs an answer, and a form that takes the whole screen of a phone.
part "overlay[variant=question]" {
    align-items center
    justify-content center
    padding "$space-4"
    overflow-y auto
}

part "overlay[variant=full]" {
    align-items stretch
}

part "overlay[variant=start]" {
    justify-content flex-start
}

part "overlay[variant=top]" {
    align-items flex-start
}

part "overlay.modal" {
    position relative
    use "floating-box"
    display flex
    flex-direction column
    min-width 0
    color "$fg"
}

part "overlay.modal[variant=center]" {
    width "100%"
    max-width "$size-palette"
    max-height "100%"
    border-radius "$r-card"
}

part "overlay.modal[variant=question]" {
    width "100%"
    max-width "$size-dialog"
    border-radius "$r-card"
}

part "overlay.modal[variant=full]" {
    width "100%"
    max-width none
    border 0
    border-radius 0
}

part "overlay.modal[variant=bottom]" {
    width "100%"
    max-height "$size-sheet-share"
    border-radius "$r-card $r-card 0 0"
}

part "overlay.modal[variant=start]" {
    width "$size-sidebar"
    max-width "$size-sheet-share"
    height "100%"
    border-radius "0 $r-card $r-card 0"
}

part "overlay.modal[variant=top]" {
    width "100%"
    max-height "100%"
    border-radius "0 0 $r-card $r-card"
}

part "overlay.dialog" {
    display flex
    flex 1
    flex-direction column
    min-height 0
    overflow-y auto
    outline none
}

part "overlay[entering]::before" {
    animation "fade $motion-base $ease-out"
}

part "overlay[exiting]::before" {
    animation "fade $motion-base $ease-in reverse"
}

part "overlay.modal[variant=bottom][entering]" {
    animation "from-bottom $motion-base $ease-out"
}

part "overlay.modal[variant=bottom][exiting]" {
    animation "from-bottom $motion-base $ease-in reverse"
}

part "overlay.modal[variant=start][entering]" {
    animation "from-start $motion-base $ease-out"
}

part "overlay.modal[variant=start][exiting]" {
    animation "from-start $motion-base $ease-in reverse"
}

part "overlay.modal[variant=center][entering]" "overlay.modal[variant=top][entering]" "overlay.modal[variant=question][entering]" "overlay.modal[variant=full][entering]" {
    animation "fade $motion-fast $ease-out"
}

part "overlay.modal[variant=center][exiting]" "overlay.modal[variant=top][exiting]" "overlay.modal[variant=question][exiting]" "overlay.modal[variant=full][exiting]" {
    animation "fade $motion-fast $ease-in reverse"
}

// ───────────── SearchPicker ─────────────
//
// Two looks, set on each part as its variant: `list` (plain rows that scroll) and `boxed` (every
// choice a bordered box).

part "picker" {
    display flex
    flex-direction column
    gap "$space-3"
    use "fieldset-reset"
}

part "picker.legend[variant=list]" {
    margin-block-end "$space-3"
    padding 0
    font-weight "$weight-bold"
}

part "picker.legend[variant=boxed]" {
    padding 0
    font-size "$fs-md"
    font-weight "$weight-bold"
    color "$fg"
}

part "picker.options[variant=list]" {
    display flex
    flex-direction column
    gap "$space-1"
    max-height "$size-list"
    margin 0
    // Room for the focus ring: a list that scrolls clips what is outside it.
    padding "calc($ring-width + $ring-offset)"
    list-style none
    overflow-y auto
}

part "picker.option[variant=list]" {
    use "touch-row"
    padding 0 "$space-2"
    border-radius "$r-ctl"
}

part "picker.option[variant=list]:hover" {
    background "$bg-hover"
}

part "picker.option[variant=list]:has(picker.input:focus-visible)" {
    use "ring"
}

part "picker.option[variant=boxed]" {
    use "touch-row"
    padding "$space-1 $space-3"
    use "surface-box"
}

part "picker.input[variant=boxed]" {
    flex none
}

part "picker.row" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2 $space-3"
    min-height "$size-control"
    padding 0 "$space-2"
    border-radius "$r-ctl"
}

part "picker.row:hover" {
    background "$bg-hover"
}

part "picker.name[variant=list]" {
    flex 1
    min-width 0
    overflow-wrap anywhere
}

part "picker.name[variant=boxed]" {
    font-weight "$weight-bold"
    color "$fg"
    overflow-wrap anywhere
}

part "picker.hint" {
    color "$fg-muted"
    font-size "$fs-sm"
}

// ───────────── Status and priority (R4, R5, UX §7.2) ─────────────
//
// A status belongs to a status group. The group gives the color and the icon, the status gives
// the word. A priority has its own icon. Color is never alone: the icon and the word, or the
// word as the accessible name, are always there.

part "status-icon" {
    flex none
    width "$size-icon"
    height "$size-icon"
}

part "status-icon[variant=small]" {
    width "$size-icon-small"
    height "$size-icon-small"
}

part "status-icon[variant=not-started]" {
    color "$st-ns"
}

part "status-icon[variant=in-progress]" {
    color "$st-ip"
}

part "status-icon[variant=done]" {
    color "$st-done"
}

// The small pill that shows a status in lists and in text.
part "status-pill" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding "$space-1 $pad-control"
    border-radius "$r-pill"
    font-size "$fs-sm"
    font-weight "$weight-bold"
    line-height "$lh-tight"
    white-space nowrap
}

part "status-pill[variant=not-started]" {
    background "$st-ns-soft"
    color "$st-ns"
}

part "status-pill[variant=in-progress]" {
    background "$st-ip-soft"
    color "$st-ip"
}

part "status-pill[variant=done]" {
    background "$st-done-soft"
    color "$st-done"
}

// The big button of the issue page: the status with its group's icon and color, and an arrow that
// says it can be changed.
part "status-button" {
    display inline-flex
    align-items center
    gap "$space-2"
    use "control-box"
    padding 0 "$pad-control"
    border-color currentColor
    font-family "$font"
    font-size "$fs-ui"
    font-weight "$weight-bold"
    line-height "$lh-tight"
    cursor pointer
}

part "status-button[variant=not-started]" {
    background "$st-ns-soft"
    color "$st-ns"
}

part "status-button[variant=in-progress]" {
    background "$st-ip-soft"
    color "$st-ip"
}

part "status-button[variant=done]" {
    background "$st-done-soft"
    color "$st-done"
}

part "status-button[hovered]" {
    filter "brightness($hover-brightness)"
}

part "status-button[disabled]" {
    opacity "$opacity-disabled"
    cursor default
}

part "status-button[focus-visible]" {
    use "ring"
}

part "priority" {
    display inline-flex
    align-items center
    gap "$space-1"
    font-size "$fs-ui"
    white-space nowrap
}

part "priority[variant=critical]" {
    color "$danger"
    font-weight "$weight-bold"
}

part "priority[variant=high]" {
    color "$warning"
    font-weight "$weight-bold"
}

part "priority[variant=normal]" {
    color "$fg-muted"
}

part "priority[variant=low]" {
    color "$fg-subtle"
}

part "priority-icon" {
    flex none
    width "$size-icon-small"
    height "$size-icon-small"
}

// ───────────── Rows that carry their state (R4) ─────────────
//
// Any row can carry the state of its status group (a tint) and of its priority (an edge of 4 px at
// its start), by the words of `rowStates`. A row of the list, an issue row and a bar of the
// timeline are the rows that do. Hovered and selected rows keep the hue of their tint and stay
// distinct from it (`distinct` above). The rules come after the rows' own, so they win.

// A selected row is also ringed inside its edge, so it never relies on the fill alone.
part "issue-row[state=selected]" "timeline-bar[state=selected]" {
    background "$bg-selected"
    use "ring-inside"
}

part "list-row[state=group-in-progress]" "issue-row[state=group-in-progress]" "timeline-bar[state=group-in-progress]" {
    background "$tint-ip"
}

part "list-row[state=group-in-progress]:hover" "issue-row[state=group-in-progress]:hover" "timeline-bar[state=group-in-progress]:hover" {
    background "$tint-ip-hover"
}

part "list-row[state=group-in-progress][state=selected]" "issue-row[state=group-in-progress][state=selected]" "timeline-bar[state=group-in-progress][state=selected]" {
    background "$tint-ip-selected"
}

part "list-row[state=group-done]" "issue-row[state=group-done]" "timeline-bar[state=group-done]" {
    background "$tint-done"
}

part "list-row[state=group-done]:hover" "issue-row[state=group-done]:hover" "timeline-bar[state=group-done]:hover" {
    background "$tint-done-hover"
}

part "list-row[state=group-done][state=selected]" "issue-row[state=group-done][state=selected]" "timeline-bar[state=group-done][state=selected]" {
    background "$tint-done-selected"
}

part "list-row[state=priority-critical]" "issue-row[state=priority-critical]" "timeline-bar[state=priority-critical]" {
    border-inline-start "$size-edge solid $danger"
}

part "list-row[state=priority-high]" "issue-row[state=priority-high]" "timeline-bar[state=priority-high]" {
    border-inline-start "$size-edge solid $warning"
}

// ───────────── The grid of the issue list (UX §4.2) ─────────────
//
// One grid with fixed columns (R1, R9): tick box, status icon, ID, type icon, title, labels,
// priority, assigned person, changed. The header, the rows and the phone's rows are the same part,
// so the columns line up. A column is named by the variant of its cell.

part "list-grid" {
    display flex
    flex-direction column
    min-width 0
}

part "list-row" {
    position relative
    box-sizing border-box
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-row"
    padding 0 "$pad-box"
    border-inline-start "$size-edge solid transparent"
    border-bottom "$border-width solid $border-subtle"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-ui"
}

part "list-row:hover" {
    background "$bg-hover"
}

part "list-row[state=selected]" {
    background "$bg-selected"
    use "ring-inside"
}

// The issue that is open next to the list.
part "list-row[state=current]" {
    use "current-item"
}

// The column names above the rows.
part "list-row[variant=head]" {
    min-height "$size-control"
    background "$bg-surface"
    color "$fg-muted"
    font-size "$fs-sm"
    font-weight "$weight-bold"
}

part "list-row[variant=head]:hover" {
    background "$bg-surface"
}

part "list-row.cell" {
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
}

part "list-row.cell[variant=select]" {
    flex none
    display flex
    align-items center
    justify-content center
    width "$size-control"
}

part "list-row.cell[variant=status]" "list-row.cell[variant=type]" {
    flex none
    display flex
    align-items center
    justify-content center
    width "$size-col-icon"
}

part "list-row.cell[variant=key]" {
    flex none
    width "$size-col-key"
    color "$fg-muted"
    font-family "$mono"
}

part "list-row.cell[variant=title]" {
    flex 1
}

// Only the IDs are in the code font; the name of the column is in the font of the interface.
part "list-row[variant=head] list-row.cell[variant=key]" {
    font-family "$font"
}

part "list-row.cell[variant=labels]" {
    flex none
    width "$size-col-labels"
}

part "list-row.cell[variant=priority]" {
    flex none
    width "$size-col-priority"
}

part "list-row.cell[variant=person]" {
    flex none
    width "$size-col-person"
}

part "list-row.cell[variant=changed]" {
    flex none
    width "$size-col-changed"
    color "$fg-muted"
    font-size "$fs-sm"
}

// The buttons of a row: they take the room they need, at the end.
part "list-row.cell[variant=action]" {
    flex none
    display flex
    align-items center
    justify-content flex-end
}

// A done issue's title turns muted in lists.
part "list-row[state=group-done] list-row.cell[variant=title]" {
    color "$fg-muted"
}

// The whole row is the target of its title (R8): the title is not underlined and not a link color,
// and the link reaches over the row.
part "list-row.cell link" {
    color inherit
    font-weight "$weight-regular"
    text-decoration none
}

part "list-row.cell[variant=title] link::after" {
    content "\"\""
    position absolute
    inset 0
}

part "list-row.cell[variant=title] link[focus-visible]::after" {
    use "ring-inside"
}

// The checkbox and the buttons of a row stay above the link that reaches over it; every other cell is
// part of the row's target.
part "list-row.cell[variant=select]" "list-row.cell[variant=action]" {
    position relative
    z-index "$z-raised"
}

// On a phone the row has two lines: status, ID and priority, then the title, then the person and
// the day (R9: the same order). The other columns are left out.
part "list-row[variant=phone]" "list-row[variant=slim]" {
    display grid
    grid-template-columns "$size-control $size-col-icon $size-col-key minmax(0, 1fr)"
    grid-template-areas "\"select status key priority\" \"select title title title\" \"select person person changed\""
    align-items center
    gap "$space-1 $space-3"
    padding "$space-3 $pad-box"
    min-height "$size-row"
}

part "list-row[variant=phone] list-row.cell[variant=type]" "list-row[variant=phone] list-row.cell[variant=labels]" {
    display none
}

part "list-row[variant=phone] list-row.cell" "list-row[variant=slim] list-row.cell" {
    width auto
}

part "list-row[variant=phone] list-row.cell[variant=select]" {
    grid-area select
}

part "list-row[variant=phone] list-row.cell[variant=status]" "list-row[variant=slim] list-row.cell[variant=status]" {
    grid-area status
}

part "list-row[variant=phone] list-row.cell[variant=key]" "list-row[variant=slim] list-row.cell[variant=key]" {
    grid-area key
}

part "list-row[variant=phone] list-row.cell[variant=priority]" "list-row[variant=slim] list-row.cell[variant=priority]" {
    grid-area priority
    justify-self end
}

part "list-row[variant=phone] list-row.cell[variant=title]" "list-row[variant=slim] list-row.cell[variant=title]" {
    grid-area title
    white-space normal
    overflow-wrap anywhere
}

part "list-row[variant=phone] list-row.cell[variant=person]" {
    grid-area person
}

part "list-row[variant=phone] list-row.cell[variant=action]" {
    grid-area changed
    justify-self end
}

part "list-row[variant=phone] list-row.cell[variant=changed]" {
    grid-area changed
    justify-self end
}

// The slim list beside the open issue (UX §3.4): the two lines of a phone, without the tick box.
part "list-row[variant=slim]" {
    grid-template-columns "$size-col-icon $size-col-key minmax(0, 1fr)"
    grid-template-areas "\"status key priority\" \"title title title\""
}

// The header of a group of rows: the group's icon and color, its name and how many issues it holds.
part "list-group" {
    box-sizing border-box
    display flex
    align-items center
    gap "$space-2"
    min-height "$size-control"
    padding 0 "$pad-box"
    border-bottom "$border-width solid $border-subtle"
    background "$bg-surface"
    font-size "$fs-ui"
    font-weight "$weight-bold"
}

part "list-group.count" {
    color "$fg-muted"
    font-weight "$weight-regular"
}

// A bar of the timeline (UX §4.7): the same tint and edge as the row of the list.
part "timeline-bar" {
    box-sizing border-box
    display flex
    align-items center
    gap "$space-2"
    min-height "$size-control-small"
    padding 0 "$pad-control"
    border "$border-width solid $border"
    border-inline-start "$size-edge solid transparent"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-sm"
}

// ───────────── Name and value (Details, UX §4.4) ─────────────

// The rows of the Details share two columns: the names, as wide as the longest name (never wider than
// `size-name`), and the values, which have all the rest (the review of M4: the values had 142 px).
part "name-values" {
    display grid
    grid-template-columns "fit-content($size-name) minmax(0, 1fr)"
    column-gap "$space-3"
    margin 0
}

part "name-value" {
    display grid
    grid-column "1 / -1"
    grid-template-columns subgrid
    align-items start
    min-height "$size-control"
    padding "$space-1 0"
}

// The name stands at the height of the first line of its value: both are as high as a control and
// centered in it (R1, the review of M4: the names sat above the middle of their values).
part "name-value.name" {
    display flex
    align-items center
    min-height "$size-control"
    margin 0
    color "$fg-muted"
    font-size "$fs-sm"
}

part "name-value.value" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    min-width 0
    min-height "$size-control"
    margin 0
    font-size "$fs-ui"
}

// A text of the value that runs over more than one line ("This project has no labels yet.") stands
// so that its first line is centered in the height of a control, like the name and like a value of
// one line, and the lines after it follow (the review of M4, B Details).
part "name-value.value > muted" {
    padding "calc(($size-control - $fs-base * $lh-body) / 2) 0"
}

// The *Followers* row is one line on a computer and on a phone: the count (or the words *You follow it*
// where there is no count) and the button for turning it round (the review of M4: *Stop following*
// dropped under the words).
part "followers-line" {
    display flex
    flex-wrap nowrap
    align-items center
    gap "$space-2"
    min-width 0
}

// The button never breaks its words, so *Stop following* stays one line.
part "followers-line button" {
    white-space nowrap
}

// The count and the words stay together on one line.
part "followers-state" {
    display inline-flex
    align-items center
    white-space nowrap
}

// The words *You follow it* are the size of the count.
part "followers-state.words" {
    color "$fg-muted"
    font-size "$fs-ui"
}

// *Website · Offered* with its sign: the sign stays beside the first line of the words, whatever
// the words do.
part "offer-state" {
    display inline-flex
    align-items center
    gap "$space-2"
    min-width 0
}

// A priority is as high as a control, so it is level with the name of its row like the other values.
part "name-value.value > priority" {
    min-height "$size-control"
}

// Why a value cannot be changed stands under the value, on its own line, so the value itself stays
// level with its name whatever length the reason has (the review of M4, demo 07).
part "name-value.reason" {
    display inline-flex
    flex-basis "100%"
    align-items flex-start
    gap "$space-1"
    use "quiet-text"
}

// *Saved* and *Undo* where the change happened (R7).
part "name-value.saved" {
    display inline-flex
    align-items center
    gap "$space-1"
}

// ───────────── Legend ─────────────
//
// The Legend, a small list beside the toolbar: what the row color and the edge mean (UX §4.2, §4.7).

part "legend" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-4"
    margin 0
    padding 0
    color "$fg-muted"
    font-size "$fs-sm"
    list-style none
}

part "legend.item" {
    display inline-flex
    align-items center
    gap "$space-2"
}

part "legend.swatch" {
    flex none
    box-sizing border-box
    width "$size-icon-small"
    height "$size-icon-small"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
}

part "legend.swatch[variant=in-progress]" {
    border-color "$st-ip"
    background "$tint-ip"
}

part "legend.swatch[variant=done]" {
    border-color "$st-done"
    background "$tint-done"
}

part "legend.swatch[variant=critical]" {
    border-inline-start "$size-edge solid $danger"
}

part "legend.swatch[variant=high]" {
    border-inline-start "$size-edge solid $warning"
}

// The row above a list: its main button, what is ticked, and the Legend at the end.
part "list-toolbar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3" "$space-5"
}

part "list-toolbar legend" {
    margin-inline-start auto
}

// ───────────── Window (UX §6.3, R10) ─────────────
//
// A form opens as a window over the page, in the one overlay (variant `window`). It can be
// minimized to a bar at the bottom, maximized, and resized at its edges. Its size is two variables
// that the code sets while the person drags (`--window-width`, `--window-height`, the tokens of the
// same names). The form follows the window's own width (container queries), not the screen's.

part "overlay[variant=window]" {
    align-items center
    justify-content center
    padding "$space-4"
}

part "overlay[variant=window][state=maximized]" {
    padding 0
}

part "overlay.modal[variant=window]" {
    container-type inline-size
    width "min($window-width, 100%)"
    height "$window-height"
    min-width "min($size-window-width-min, 100%)"
    max-height "100%"
    border-radius "$r-card"
}

part "overlay.modal[variant=window][state=maximized]" {
    width "100%"
    height "100%"
    border-radius 0
}

part "window" {
    display flex
    flex 1
    flex-direction column
    min-height 0
    outline none
}

// Everything inside the dialog: the keys of the keyboard are heard here.
part "window.content" {
    display flex
    flex 1
    flex-direction column
    min-height 0
}

part "window.title-bar" {
    display flex
    flex none
    align-items stretch
    min-height "$size-control"
    border-bottom "$border-width solid $border"
    border-radius "$r-card $r-card 0 0"
    background "$bg-surface"
}

part "window.title" {
    flex 1
    min-width 0
    margin 0
    padding "0 $pad-box"
    overflow hidden
    font-size "$fs-lg"
    line-height "$size-control"
    text-overflow ellipsis
    white-space nowrap
}

part "window.control" {
    display inline-flex
    flex none
    align-items center
    justify-content center
    width "$size-window-button"
    min-height "$size-control"
    padding 0
    border 0
    background transparent
    color "$fg"
    cursor pointer
}

part "window.control[hovered]" {
    background "$bg-hover"
}

part "window.control[pressed]" {
    background "$bg-selected"
}

part "window.control[variant=close][hovered]" "window.control[variant=close][pressed]" {
    background "$danger"
    color "$on-accent"
}

part "window.control[variant=close]" {
    border-start-end-radius "$r-card"
}

// *Back* stands at the start of the title bar, as on a page (R1, UX review of M4, A10).
part "window.control[variant=back]" {
    order -1
    width auto
    padding 0 "$pad-control"
    gap "$space-1"
}

part "window.control[focus-visible]" {
    use "ring-inside"
}

// The scrolling part is the form; the title bar and the footer stay in place.
part "window.body" {
    flex 1
    min-height 0
    padding "$pad-dialog"
    overflow-y auto
}

// Rows: what is missing (it comes and goes), the buttons in one row at the right, the main one last
// (R6), then the note below them (that the draft is kept, and what belongs to the form; UX §4.5).
part "window.footer" {
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    padding "$pad-box $pad-dialog"
    border-top "$border-width solid $border"
}

part "window.footer-note" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-3"
    use "quiet-text"
}

// The quiet button of the note stands under its text on a phone, so it hangs back by its padding
// and its text starts where the text of the note starts (R1); beside the note it does not.
part "window.footer-note button[variant=quiet]" {
    margin-inline-start "$size-phone-hang"
}

part "window.footer-actions" {
    use "answer-row"
}

// The places to drag: the four edges and the four corners.
part "window.handle" {
    position absolute
    z-index "$z-raised"
    touch-action none
}

part "window.handle[variant=e]" {
    inset-block "$size-window-handle"
    inset-inline-end 0
    width "$size-window-handle"
    cursor ew-resize
}

part "window.handle[variant=w]" {
    inset-block "$size-window-handle"
    inset-inline-start 0
    width "$size-window-handle"
    cursor ew-resize
}

part "window.handle[variant=s]" {
    inset-inline "$size-window-handle"
    bottom 0
    height "$size-window-handle"
    cursor ns-resize
}

part "window.handle[variant=n]" {
    inset-inline "$size-window-handle"
    top 0
    height "$size-window-handle"
    cursor ns-resize
}

part "window.handle[variant=se]" {
    right 0
    bottom 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nwse-resize
}

part "window.handle[variant=nw]" {
    top 0
    left 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nwse-resize
}

part "window.handle[variant=ne]" {
    top 0
    right 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nesw-resize
}

part "window.handle[variant=sw]" {
    bottom 0
    left 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nesw-resize
}

// The form inside: one column below 880, the fields at the side from 880, the text centered with a
// readable width from 1200 (R10).
part "window-layout" {
    display grid
    grid-template-columns "minmax(0, 1fr)"
    gap "$gap-sections" "$space-5"
    container "(min-width: $bp-window-side)" {
        grid-template-columns "minmax(0, 1fr) $size-details"
        align-items start
    }
    container "(min-width: $bp-window-wide)" {
        grid-template-columns "minmax(0, $size-reading) $size-details"
        justify-content center
    }
}

part "window-layout.text" {
    display flex
    flex-direction column
    gap "$gap-fields"
    min-width 0
}

part "window-layout.fields" {
    display flex
    flex-direction column
    gap "$gap-fields"
    min-width 0
}

// A window that is minimized is a bar at the bottom of the page with its title and what it keeps.
part "window-dock" {
    position fixed
    inset-inline-start "$space-4"
    bottom 0
    z-index "$z-panel"
    box-sizing border-box
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-control"
    max-width "calc(100% - $space-4 * 2)"
    padding 0 "$pad-box"
    border "$border-width solid $border"
    border-bottom 0
    border-radius "$r-card $r-card 0 0"
    background "$bg-raised"
    box-shadow "$shadow"
    color "$fg"
    font-family "$font"
    font-size "$fs-ui"
    cursor pointer
}

// On a computer the dock stands in the main area, after the menu, so it never covers it.
part "app-layout[variant=side] window-dock" {
    inset-inline-start "calc($size-sidebar + $space-4)"
    max-width "calc(100% - $size-sidebar - $space-4 * 2)"
}

part "app-layout[variant=side-narrow] window-dock" {
    inset-inline-start "calc($size-sidebar-narrow + $space-4)"
    max-width "calc(100% - $size-sidebar-narrow - $space-4 * 2)"
}

part "window-dock[hovered]" {
    background "$bg-hover"
}

part "window-dock[focus-visible]" {
    use "ring"
}

part "window-dock.title" {
    overflow hidden
    font-weight "$weight-bold"
    text-overflow ellipsis
    white-space nowrap
}

part "window-dock.note" {
    use "quiet-text"
    white-space nowrap
}

// ───────────── Shared layout parts ─────────────
//
// What several screens say the same way: a column with a gap, a line of text, a row that wraps,
// a list without bullets.

part "stack" {
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
}

// Things under each other on the start edge, with text buttons among them: a button that stands
// in the column hangs back by its padding, so its text starts where the text above starts (R1).
part "start-column" {
    display flex
    flex-direction column
    align-items flex-start
    gap "$space-1"
    min-width 0
}

// A value of a row of the Details that is a column (the people of *Assigned to*): each line is as
// high as a control, so the first one is level with its name.
part "start-column.line" {
    display flex
    align-items center
    min-height "$size-control"
}

part "text" {
    margin 0
    font-size "$fs-md"
    line-height "$lh-text"
}

part "row" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
}

// A row whose items are as high as the row.
part "row[variant=stretch]" {
    align-items stretch
}

part "list" {
    display flex
    flex-direction column
    gap "$space-3"
    use "list-reset"
}

part "list[variant=loose]" {
    gap "$space-4"
}

// What several screens share: an item of a list, facts, a heading, a hint.

part "item" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-3"
    padding "$space-3"
    use "surface-box"
}

// An item whose words and buttons keep more room between them, one that is slim, one whose words
// break anywhere.
part "item[variant=spread]" {
    gap "$space-2 $space-4"
}

part "item[variant=slim]" {
    padding "$space-1 $space-3"
}

part "item[variant=wrap]" {
    overflow-wrap anywhere
}

part "item.text" {
    use "column-wrap"
}

// The words of an item that has a button beside them: they take the room that is left and break
// inside their own box, so the button stays beside them on every line of a list.
part "item.main" {
    use "column-wrap"
    flex "1 1 $size-name"
}

// The buttons of an item whose words are `item.main`: on a phone they stand under the words, so a
// quiet one hangs back by its own padding and its text starts where the words start (R1); beside
// the words, on a computer, it does not. The row itself does not move: a button that is not quiet
// stands where its box begins.
part "item.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "item.title" {
    font-weight "$weight-bold"
}

part "facts" {
    display grid
    grid-template-columns "minmax(0, 1fr)"
    gap "$space-3"
    margin 0
}

part "fact" {
    use "column-wrap"
    padding-bottom "$space-3"
    border-bottom "$border-width solid $border-subtle"
}

part "term" {
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

part "definition" {
    margin 0
    font-size "$fs-md"
}

part "key-box" {
    display block
    padding "$space-3"
    use "sunken-box"
    font-family "$mono"
    font-size "$fs-md"
    // A key has no spaces: it breaks anywhere, in lines of one length, so that a few letters never stand
    // alone on the last one.
    word-break break-all
    text-wrap balance
}

part "key-box[variant=small]" {
    font-size "$fs-base"
}

part "box" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    use "surface-box"
    min-width 0
}

part "strong" {
    font-weight "$weight-bold"
    color "$fg"
}

part "hint" {
    use "quiet-text"
}

part "column" {
    display flex
    flex-direction column
    gap "$space-1"
}

part "column[variant=snug]" {
    gap "$space-2"
}

part "list[variant=tight]" {
    gap "$space-1"
}

part "list[variant=inset]" {
    padding-inline-start "$space-4"
}

part "list[variant=snug]" {
    gap "$space-2"
}

part "wrap" {
    min-width 0
    overflow-wrap anywhere
}

// ───────────── Card, Form, Icon, OrDivider, SaveStatus, Skeleton (packages/ui) ─────────────

part "card" {
    use "floating-box"
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
    padding "$space-5"
    border-radius "$r-card"
    color "$fg"
}

// On a phone a list goes with one gutter: a card of this look has no frame and no padding there.
part "app-layout[variant=phone] card[variant=open-on-phone]" {
    padding 0
    border-width 0
    border-radius 0
    background transparent
    box-shadow none
}

// The heading and, at the end of its row, what can be done with the card (R6: at the end of the header).
part "card.header" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-4"
}

part "card.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "card.heading" {
    margin 0
    font-size "$fs-lg"
    line-height "$lh-snug"
    color "$fg"
}

part "card.heading:focus" {
    outline none
}

part "icon" {
    flex none
    width "$size-icon"
    height "$size-icon"
}

part "icon[variant=small]" {
    width "$size-icon-small"
    height "$size-icon-small"
}

part "or-divider" {
    display flex
    align-items center
    gap "$space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

part "or-divider::before" "or-divider::after" {
    content "\"\""
    flex 1
    border-top "$border-width solid $border"
}

// The words that say whether the last change reached the server. Its own part: a change of the
// hint must not reach it.
part "save-status" {
    use "quiet-text"
}

// Red means something did not happen (R4); a change that is not saved yet only says so.
part "save-status[state=not-saved]" {
    color "$fg"
    font-weight "$weight-bold"
}

// The bar under an editor: the plain buttons at the start, the one filled button at the end (R6).
part "save-bar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
}

part "save-bar button[variant=primary]" {
    margin-inline-start auto
}

part "skeleton.line" {
    display block
    height "$space-4"
    border-radius "$r-ctl"
    background "$bg-sunken"
    animation "pulse $motion-pulse $ease-in-out infinite alternate"
}

part "skeleton.line[variant=medium]" {
    width "$size-line-medium"
}

// The last line is the shortest, also when it is an even one.
part "skeleton.line[variant=short]" {
    width "$size-line-short"
}

// ───────────── SearchField and SelectField ─────────────

part "search-field.box" {
    display flex
    align-items center
    gap "$space-2"
    use "control-box"
    padding "0 $space-3"
    color "$fg-muted"
}

part "search-field.box:focus-within" {
    use "ring"
}

part "search-field.input" {
    flex 1
    min-width 0
    padding "$space-2 0"
    border 0
    background transparent
    color "$fg"
    font-family "$font"
    font-size "$fs-md"
}

part "search-field.input:focus" {
    outline none
}

part "search-field.input::placeholder" {
    color "$fg-muted"
    opacity 1
}

// The browser's own clear mark would be a second one.
part "search-field.input::-webkit-search-cancel-button" {
    display none
}

// ───────────── ConfirmDialog (packages/ui) ─────────────
//
// The layer around a question is the one overlay part (the variant `question`, or `full` on a
// phone); only what is inside it has parts of its own.

part "confirm.dialog" {
    display flex
    flex-direction column
    gap "$space-4"
    padding "$space-5"
    outline none
}

// What the question says and asks for scrolls by itself where the screen is not tall enough (a phone), so
// the answers below it never leave the screen (the review of M4, A1).
part "confirm.body" {
    display flex
    flex-direction column
    flex 1
    gap "$space-4"
    min-height 0
}

part "overlay.modal[variant=full] confirm.body" {
    overflow-y auto
}

part "confirm.title" {
    margin 0
    font-size "$fs-lg"
    line-height "$lh-snug"
}

part "confirm.actions" {
    use "answer-row"
}

// The text buttons of an answer row stand on the start edge, the others at the end.
part "window.footer-actions button[variant=quiet]:first-child" "confirm.actions button[variant=quiet]:first-child" {
    margin-inline-end auto
}

// On a phone the question starts at the top and its answers are at the bottom, one under the
// other and as wide as the screen, the main one first (the thumb reaches it).
part "overlay.modal[variant=full] confirm.dialog" {
    flex 1
    min-height 0
}

part "overlay.modal[variant=full] confirm.actions" {
    margin-top auto
}

part "overlay[variant=full] confirm.actions" "overlay[variant=full] window.footer-actions" {
    flex-direction column-reverse
    align-items stretch
}

part "overlay[variant=full] confirm.actions button[variant=quiet]:first-child" "overlay[variant=full] window.footer-actions button[variant=quiet]:first-child" {
    margin-inline 0
}

// ───────────── Setup ─────────────

part "setup.progress" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
}

// ───────────── Sign-in ─────────────

// ───────────── Admin (the status page) ─────────────

part "admin.detail" {
    use "quiet-column"
    font-size "$fs-md"
}

// ───────────── Account ─────────────

part "account.codes" {
    display grid
    grid-template-columns "repeat(auto-fill, minmax(min(100%, $size-code), 1fr))"
    gap "$space-2"
    margin 0
    padding "$space-3"
    use "sunken-box"
    font-family "$mono"
    font-size "$fs-md"
    list-style none
}

part "account.qr" {
    align-self center
    width "$size-qr"
    height "$size-qr"
    max-width "100%"
    border "$border-width solid $border"
    background "$bg-raised"
    image-rendering pixelated
}

// ───────────── Settings ─────────────

part "settings.source" {
    margin 0
    color "$fg-muted"
    font-size "$fs-sm"
}

part "settings.locked" {
    use "note-box"
    use "sunken-box"
}

part "settings.locked-value" {
    color "$fg"
}

// ───────────── Access ─────────────

part "access.subheading" {
    margin 0
    font-size "$fs-md"
    font-weight "$weight-bold"
    color "$fg"
}

// The matrix: a table of roles by fields that scrolls by itself when the roles do not fit.
part "access.scroll" {
    // The names of the lists that only screen readers read are positioned boxes: this keeps them in the region.
    position relative
    overflow-x auto
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}

part "access.scroll:focus-visible" {
    use "ring-line"
    outline-offset 0
}

part "access.matrix" {
    border-collapse separate
    border-spacing 0
    width "100%"
}

part "access.matrix-cell" {
    padding "$space-2 $space-3"
    border-bottom "$border-width solid $border-subtle"
    text-align start
    vertical-align top
}

// The column heads stay at the top, the row heads (the name of the field) at the start.
part "access.matrix-cell[variant=head]" {
    position sticky
    top 0
    background "$bg-sunken"
    color "$fg"
    font-weight "$weight-bold"
    min-width "$size-matrix-cell"
}

part "access.matrix-cell[variant=row]" {
    position sticky
    inset-inline-start 0
    background "$bg-surface"
    color "$fg"
    font-weight "$weight-bold"
    min-width "$size-matrix-cell"
}

part "access.matrix-cell[variant=head]:first-child" {
    inset-inline-start 0
    z-index "$z-raised"
}

part "access.matrix-row:last-child access.matrix-cell" {
    border-bottom 0
}

part "access.cell" {
    use "column-tight"
    align-items flex-start
}

part "access.cell > field" {
    width "100%"
}

part "access.preview-line" {
    font-size "$fs-md"
    color "$fg"
}

part "access.answer" {
    use "column-wrap"
    padding "$space-3"
    use "surface-box"
}

part "access.answer-head" {
    display flex
    flex-wrap wrap
    align-items baseline
    gap "$space-1 $space-3"
}

// The answer *Yes.* or *No.* in front of the reasons.
part "access.answer-verdict" {
    margin-inline-end "$space-1"
}

part "access.answer-verdict[variant=yes]" {
    color "$success"
}

part "access.answer-verdict[variant=no]" {
    color "$danger"
}

part "access.reasons" {
    margin 0
    color "$fg"
    font-size "$fs-base"
    line-height "$lh-text"
}

// A heading inside a card, below its own heading (a topic of access, a form that makes something).
part "access.topic" "card.topic" {
    margin 0
    font-size "$fs-md"
    font-weight "$weight-bold"
    color "$fg"
}

// ───────────── People ─────────────

part "people" {
    display block
    max-block-size "$size-list-tall"
    margin 0
    padding "$ring-width"
    overflow-y auto
    use "surface-box"
}

part "people.person" {
    use "pick-row"
    border-bottom "$border-width solid $border-subtle"
}

part "people.person[hovered]" {
    background "$bg-hover"
}

part "people.person[focus-visible]" {
    use "ring-inside"
}

part "people.person-name" {
    font-weight "$weight-bold"
    color "$accent-fg"
    text-decoration underline
    text-underline-offset "$space-1"
    overflow-wrap anywhere
}

part "people.person-facts" {
    color "$fg-muted"
    font-size "$fs-base"
    overflow-wrap anywhere
}

// ───────────── Roles ─────────────

part "roles.no-access" {
    margin 0
    color "$danger"
    font-size "$fs-base"
    font-weight "$weight-bold"
    line-height "$lh-body"
}

part "roles.topic" {
    display flex
    flex-direction column
    gap "$space-2"
    use "fieldset-reset"
}

part "roles.legend" {
    margin-block-end "$space-2"
    padding 0
    font-weight "$weight-bold"
}

part "roles.note" {
    padding-inline-start "calc($space-5 + $space-3)"
    color "$fg-muted"
    font-size "$fs-sm"
}

// ───────────── Projects ─────────────

// The short name and the place of a project after its name. The short name has a column of its own,
// as wide as ten capitals need at most; the place stands beside it where there is room and under it
// where there is not, so no word is broken in the middle.
part "projects.details" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    min-width 0
    font-weight "$weight-bold"
    overflow-wrap break-word
}

part "projects.short" {
    flex "0 0 auto"
    min-width "$size-col-short"
}

part "projects.place" {
    flex "1 1 $size-col-place"
    min-width 0
}

part "projects.preview" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "projects.alert-line" {
    margin 0
}

// ───────────── Long previews (M2C-F80) ─────────────

// The preview of a change that touches many things: the sentence on top, then the things grouped
// by issue or by person, a few at a time, with *Show all*.
part "long-preview" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "long-preview.summary" {
    display block
    margin 0
    font-weight "$weight-bold"
}

part "long-preview.groups" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-2"
}

part "long-preview.group" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-2" "$space-3"
    min-width 0
}

part "long-preview.group[state=skipped]" {
    background "$bg-sunken"
}

part "long-preview.group-head" {
    display flex
    flex-wrap wrap
    align-items baseline
    gap "$space-1" "$space-3"
    min-width 0
    overflow-wrap anywhere
}

part "long-preview.lines" {
    use "quiet-column"
    padding-inline-start "$space-4"
}

// ───────────── Tags and labels, and changing many issues ─────────────

// The tags and labels of an issue, side by side.
part "chips" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    use "list-reset"
}

// A tag or label with the button that takes it off.
part "chip" {
    display inline-flex
    align-items center
    gap "$space-1"
}

// The bar of the list that acts on the issues ticked.
part "many-change-bar" {
    use "surface-box"
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
    padding "$space-2" "$space-3"
}

// How far a change that goes on in the background is.
part "many-change-progress" {
    display flex
    flex-direction column
    gap "$space-2"
}

// ───────────── Project tree (sidebar) ─────────────

// What is inside a project stands a little in from it.
part "project-tree.row" {
    display flex
    align-items center
    gap "$space-1"
}

part "project-tree.toggle" "project-tree.spacer" {
    display inline-flex
    flex none
    align-items center
    justify-content center
    box-sizing border-box
    width "$size-control"
    min-height "$size-control"
}

part "project-tree.toggle" {
    padding 0
    border 0
    border-radius "$r-ctl"
    background transparent
    color "$fg"
    cursor pointer
}

part "project-tree.toggle[hovered]" {
    background "$bg-hover"
}

part "project-tree.toggle[focus-visible]" {
    use "ring"
}

// The arrow points down while what is inside is open.
part "project-tree.toggle[state=open] icon" {
    transform "rotate($angle-open)"
}

part "project-tree.link" {
    display flex
    flex 1
    align-items center
    justify-content space-between
    gap "$space-2"
    box-sizing border-box
    min-width 0
    min-height "$size-control"
    padding "0 $space-3"
    border-radius "$r-ctl"
    use "menu-text"
}

part "project-tree.link[hovered]" {
    background "$bg-hover"
}

part "project-tree.link[focus-visible]" {
    use "ring"
}

part "project-tree.link[current]" {
    use "current-item"
}

part "project-tree.short" {
    flex none
    color "$fg-muted"
    font-size "$fs-sm"
    font-weight "$weight-regular"
}

part "project-tree.link[current] project-tree.short" {
    color "$accent-fg"
}

part "project-tree.note" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

// ───────────── My settings ─────────────

part "region-page.example" {
    use "note-box"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-base"
}

part "theme-picker.name" {
    text-align center
}

part "theme-preview" {
    display flex
    flex-direction column
    gap "$space-1"
    box-sizing border-box
    width "calc($space-6 * 3)"
    padding "$space-2"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-canvas"
}

part "theme-preview.bar" {
    height "$space-2"
    border-radius "$r-ctl"
    background "$accent"
}

part "theme-preview.card" {
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-2"
    use "surface-box"
}

part "theme-preview.line" {
    height "$space-1"
    border-radius "$r-ctl"
    background "$fg-muted"
}

part "theme-preview.line[variant=short]" {
    width "$size-sample-short"
}

part "access-keys.item-text" {
    use "column-wrap"
    flex "1 1 $size-list"
}

part "access-keys.prefix" {
    font-family "$mono"
    font-size "$fs-base"
}

part "access-keys.expired" {
    color "$danger"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

part "access-keys.more" {
    padding "$space-3"
    use "surface-box"
}

part "access-keys.more-title" {
    min-height "$size-control"
    display flex
    align-items center
    font-weight "$weight-bold"
    cursor pointer
}

part "access-keys.more-body" {
    display flex
    flex-direction column
    gap "$space-4"
    margin-top "$space-3"
}

part "access-keys.group" {
    display flex
    flex-direction column
    gap "$space-1"
    use "fieldset-reset"
}

part "access-keys.legend" {
    padding 0
    margin-bottom "$space-1"
    font-size "$fs-md"
    font-weight "$weight-bold"
}

// ───────────── Shell ─────────────

// What the sheets, the menus and the panels of the shell have in common.

part "shell.content" {
    display flex
    flex 1
    flex-direction column
    gap "$space-4"
    min-width 0
}

part "shell.section-heading" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

// In the sheet *More* the heading starts where the line *Signed in as* above it starts: the sheet has
// its own padding, and the heading needs none of the one that lines it up with the items of the menu.
part "shell.sheet shell.section-heading" {
    padding-inline 0
}

part "shell.fill" {
    flex 1
    min-width 0
}

part "shell.sheet" {
    display flex
    flex-direction column
    gap "$space-3"
    padding "$space-4"
}

part "shell.sheet-head" {
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
}

part "shell.title" {
    margin 0
    font-size "$fs-lg"
}

part "shell.page" {
    box-sizing border-box
    display flex
    flex-direction column
    gap "$space-5"
    min-height "100%"
    width "100%"
    max-width "$size-content"
    margin 0 auto
    padding "$space-4"
}

part "shell.header" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-4"
}

part "shell.brand" {
    font-size "$fs-lg"
    font-weight "$weight-bold"
    color "$accent-fg"
}

part "shell.content:focus" {
    outline none
}

// The narrow content of the pages before sign-in starts on the same edge as the name of the product
// above it and the choice of theme below it (R1), not centered between them.
part "shell.narrow" {
    width "100%"
    max-width "$size-form"
}

part "shell.footer" {
    padding-top "$space-4"
    border-top "$border-width solid $border-subtle"
}

part "app-layout" {
    display flex
    min-height "100%"
    background "$bg-canvas"
}

part "app-layout.column" {
    display flex
    flex 1
    flex-direction column
    min-width 0
}

// The page scrolls inside this frame. It is also where the hidden parts (the box of a switch, a
// choice) are placed, so that one far down the page does not make the document itself taller.
part "app-layout.main" {
    position relative
    display flex
    flex 1
    flex-direction column
    min-width 0
    padding "$space-4"
}

// What a phone shows under the page and above the bar of the app: the bar of the open issue. It is
// a part of the column, not drawn over the page, so no part of the page is ever under it.
part "app-layout.bar-slot" {
    display flex
    flex-direction column
}

part "app-layout.main:focus" {
    outline none
}

part "app-layout.inner" {
    display flex
    flex-direction column
    gap "$space-4"
    width "100%"
    max-width "$size-page"
    min-width 0
    margin 0 auto
}

// The focus view (M2C-F81) takes the whole width that the narrowed sidebar leaves.
part "app-layout.inner[variant=wide]" {
    max-width none
}

// The link that jumps to the content, in the app and before sign-in: out of sight until it has the focus.
part "skip" {
    position absolute
    left "$space-2"
    top "$space-2"
    z-index "$z-top"
    padding "$space-2 $space-3"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$accent-fg"
    font-weight "$weight-bold"
    transform "translateY($skip-offset)"
}

part "skip:focus" {
    transform "translateY(0)"
}

part "app-layout[variant=phone]" {
    height "100%"
    min-height 0
}

part "app-layout[variant=phone] app-layout.column" {
    height "100%"
}

part "app-layout[variant=phone] app-layout.main" {
    min-height 0
    overflow-y auto
}

part "sidebar" {
    position sticky
    top 0
    align-self flex-start
    box-sizing border-box
    display flex
    flex none
    flex-direction column
    gap "$space-4"
    width "$size-sidebar"
    height "$size-viewport"
    overflow-y auto
    padding "$space-3"
    border-right "$border-width solid $border"
    background "$bg-surface"
}

part "sidebar[variant=narrow]" {
    width "$size-sidebar-narrow"
    align-items center
}

part "sidebar[variant=drawer]" {
    position static
    height auto
    overflow-y visible
    width "100%"
    border-right 0
    background transparent
}

part "sidebar.brand" {
    padding "$space-2 $space-3"
    color "$accent-fg"
    font-size "$fs-lg"
    font-weight "$weight-bold"
}

part "sidebar.brand[variant=narrow]" {
    padding "$space-2 0"
    font-size "$fs-base"
}

part "sidebar.list" "sidebar.bottom" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
    use "list-reset"
}

part "sidebar.bottom" {
    margin-top auto
}

part "sidebar.section" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
}

part "sidebar.person" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
    padding-top "$space-3"
    border-top "$border-width solid $border-subtle"
}

part "sidebar.who" {
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    overflow-wrap anywhere
}

part "nav-item" {
    position relative
    use "touch-row"
    box-sizing border-box
    width "100%"
    padding "0 $space-3"
    border 0
    border-radius "$r-ctl"
    background transparent
    use "menu-text"
    font-family "$font"
    text-align start
}

part "nav-item[hovered]" {
    background "$bg-hover"
}

part "nav-item[pressed]" {
    background "$bg-selected"
}

part "nav-item[current]" {
    use "current-item"
}

part "nav-item[focus-visible]" {
    use "ring"
}

part "nav-item[state=busy]" {
    use "busy"
}

part "nav-item.label" {
    flex 1
    min-width 0
    overflow-wrap anywhere
}

part "nav-item.tooltip" {
    padding "$space-1 $space-3"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
    box-shadow "$shadow"
    color "$fg"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

part "bottom-bar" {
    border-top "$border-width solid $border"
    background "$bg-surface"
    padding-bottom "env(safe-area-inset-bottom)"
}

part "bottom-bar.tabs" {
    display flex
    use "list-reset"
}

// A tab is as wide as its words need and shares the rest of the bar: the five tabs of a small phone
// do not have the same width, because *Notifications* is longer than *New*.
part "bottom-bar.tab" {
    display flex
    flex "1 1 auto"
    min-width min-content
}

part "bottom-bar.item" {
    use "column-tight"
    flex 1
    align-items center
    justify-content center
    box-sizing border-box
    min-height "$size-bar"
    padding "$space-2 $space-1"
    use "bare-button"
    color "$fg"
    font-size "$fs-base"
    font-weight "$weight-bold"
    text-decoration none
}

part "bottom-bar.item[hovered]" {
    background "$bg-hover"
}

part "bottom-bar.item[current]" {
    use "current-item"
}

part "bottom-bar.item[focus-visible]" {
    use "ring-inside"
}

// A word is never broken inside: a tab is at least as wide as its longest word (five tabs, larger text,
// a small phone), and the words of a tab that has several wrap between words only.
part "bottom-bar.label" {
    max-width "100%"
    overflow-wrap normal
    hyphens manual
    text-align center
}

part "top-bar" {
    position sticky
    top 0
    z-index "$z-sticky"
    display flex
    align-items center
    gap "$space-3"
    box-sizing border-box
    min-height "$size-bar"
    padding "calc($space-2 + env(safe-area-inset-top)) $space-4 $space-2"
    border-bottom "$border-width solid $border"
    background "$bg-canvas"
}

part "top-bar.crumbs" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-1"
    use "list-reset"
}

part "top-bar.crumb" {
    display inline-flex
    align-items center
    gap "$space-1"
    color "$fg-muted"
}

part "top-bar.up" {
    color "$accent-fg"
    font-weight "$weight-bold"
    text-decoration underline
    text-underline-offset "$space-1"
}

part "top-bar.up[focus-visible]" {
    use "ring"
}

part "top-bar.title" {
    flex 1
    min-width 0
    overflow hidden
    font-size "$fs-lg"
    font-weight "$weight-bold"
    text-overflow ellipsis
    white-space nowrap
}

part "side-panel" {
    use "floating-box"
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    width "$size-panel"
    max-width "100%"
    padding "$space-4"
    border-radius "$r-card"
}

part "side-panel.head" {
    display flex
    align-items center
    gap "$space-3"
}

part "side-panel.title" {
    flex 1
    min-width 0
    margin 0
    font-size "$fs-lg"
    overflow-wrap anywhere
}

part "side-panel.title:focus" {
    outline none
}

part "more-sheet.who" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
    overflow-wrap anywhere
}

part "quick-search" {
    display flex
    flex-direction column
    gap "$space-3"
    min-height 0
    padding "$space-4"
}

part "quick-search.head" {
    display flex
    align-items flex-end
    gap "$space-2"
}

part "quick-search.results" {
    display flex
    flex-direction column
    gap "$space-2"
    margin 0
    padding 0
    outline none
}

part "quick-search.heading" {
    padding "$space-1 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

part "quick-search.item" {
    use "pick-row"
    border-radius "$r-ctl"
    outline none
}

part "quick-search.item[hovered]" {
    background "$bg-hover"
}

part "quick-search.item[focused]" {
    background "$bg-selected"
    use "ring-inside"
}

part "quick-search.title" {
    font-size "$fs-md"
    font-weight "$weight-bold"
}

part "quick-search.empty" {
    margin 0
    padding "$space-3"
    color "$fg-muted"
}

part "quick-search.quiet" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

part "settings-frame" {
    display flex
    align-items flex-start
    gap "$space-5"
}

part "settings-frame.menu" {
    flex none
    width "$size-menu"
}

part "settings-frame.groups" "settings-frame.topics" {
    display flex
    flex-direction column
    use "list-reset"
}

part "settings-frame.groups" {
    gap "$space-4"
}

part "settings-frame.topics" {
    gap "$space-1"
}

part "settings-frame.heading" {
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

// The offers float over the page at the bottom, in the middle of the window: the end is where the
// Details of an issue end, and a corner is where the menu ends.
part "undo-host" {
    position fixed
    right "$space-4"
    bottom "$space-4"
    left "$space-4"
    z-index "$z-panel"
    display flex
    flex-direction column
    align-items center
    gap "$space-2"
    pointer-events none
}

part "undo-host.offer" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
    use "floating-box"
    max-width "100%"
    padding "$space-3 $space-4"
    border-radius "$r-card"
    pointer-events auto
}

// On a phone the offers are not drawn over the page: they stand in the column of the app between the
// page and the bars at the bottom, so they cover neither the page nor a bar, and the page above
// them is a little shorter while there is one.
part "undo-host[variant=in-flow]" {
    position static
    z-index auto
    align-items stretch
    gap 0
}

part "undo-host[variant=in-flow] undo-host.offer" {
    margin "$space-2 $space-4 0"
    max-width none
}

part "focus-view" {
    display flex
    align-items flex-start
    gap "$space-4"
    min-width 0
}

part "focus-view.list" {
    display flex
    flex none
    flex-direction column
    gap "$space-2"
    box-sizing border-box
    width "$size-list"
    max-width "100%"
}

part "focus-view.bar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// ───────────── Issues (features/issues, packages/ui: InPlaceText, ActionMenu) ─────────────
//
// The issue page (UX §4.4) and the list of a project's issues (UX §4.2). The layout of the page
// (focus view, side panel, phone) is chosen by the app; the variants here only say which.

// A value that is changed where it stands: it looks like the text around it until it is pressed.
part "in-place.text" {
    font-family inherit
    font-size inherit
    overflow-wrap anywhere
}

part "in-place.button" {
    use "bare-button"
    use "hang-start"
    box-sizing border-box
    max-width "100%"
    min-height "$size-control"
    padding 0 "$pad-control"
    border-radius "$r-ctl"
    color inherit
    font-size inherit
    text-align start
    overflow-wrap anywhere
}

part "in-place.button:hover" {
    background "$bg-hover"
}

part "in-place.button:focus-visible" {
    use "ring"
}

part "in-place.input" {
    use "input-box"
}

part "in-place.input:focus" {
    use "ring"
}

// The list of actions that opens from a button, inside the one overlay.
// The list of an action menu on a computer opens under its button.
part "popover" {
    use "floating-box"
    min-width "$size-name"
    padding "$space-2"
    border-radius "$r-card"
    color "$fg"
}

// Starts where the icon of an entry starts: the entry has a border of its own besides its padding.
part "action-menu.title" {
    margin 0
    padding "$space-2 calc($pad-control + $border-width)"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
}

part "action-menu" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-1"
}

part "issue-page" {
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
}

part "issue-head" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

part "issue-head.kind" {
    display inline-flex
    align-items center
    gap "$space-2"
    color "$fg-muted"
    font-size "$fs-md"
}

part "issue-head.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    margin-inline-start auto
}

part "issue-title" {
    width "100%"
    margin 0
    font-size "$fs-xl"
    line-height "$lh-snug"
}

// The big status button under the title, and what stands beside it.
part "issue-status-line" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// On a smaller screen the Details sit behind a button that still says the main values.
part "issue-details-toggle" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// What the closed button says (who it is assigned to, the priority): one size for the words and the
// priority beside them, which are the size of every row (the review of M4, B issue page).
part "issue-details-summary" {
    display inline-flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    color "$fg-muted"
    font-size "$fs-ui"
}

part "issue-body" {
    display flex
    align-items flex-start
    gap "$space-5"
}

part "issue-body[variant=stacked]" {
    flex-direction column
    align-items stretch
}

part "issue-main" {
    display flex
    flex 1
    flex-direction column
    gap "$space-5"
    min-width 0
    max-width "$size-main"
}

// Details on wide screens keep their own scroll bar, so long details never push the description away.
part "issue-details" {
    use "surface-box"
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    box-sizing border-box
    width "$size-details"
    max-height "$size-viewport"
    // Room at the sides for the focus ring of a button that hangs back (the box scrolls, so it clips).
    padding "$space-3 $space-4"
    overflow-y auto
}

part "issue-details[variant=stacked]" {
    width "100%"
    max-height none
    overflow-y visible
}

part "issue-details.heading" {
    margin 0
    font-size "$fs-lg"
}

part "issue-section" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "issue-section.head" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2"
}

part "issue-section.title" {
    margin 0
    font-size "$fs-lg"
}

part "issue-section.reading" {
    max-width "$size-reading"
    min-width 0
}

part "issue-section.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// The draft a refused save left (`draft-note`) stands like the other notes of the issue.
part "issue-note" "draft-note" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// The two texts of *Compare and save* side by side, paragraph by paragraph.
part "issue-compare" {
    display flex
    flex-direction column
    gap "$space-3"
}

part "issue-compare.row" {
    use "fieldset-reset"
    display grid
    grid-template-columns "repeat(2, minmax(0, 1fr))"
    gap "$space-3"
}

part "issue-compare.row[variant=stacked]" {
    grid-template-columns "minmax(0, 1fr)"
}

part "issue-compare.choice" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
}

part "issue-compare.choice[variant=full]" {
    grid-column "1 / -1"
}

part "issue-compare.paragraph" {
    margin 0
    overflow-wrap anywhere
    white-space pre-wrap
}

// The words that the other text does not have (M3-F54): a fill and an underline, so they are not
// told by color alone.
part "issue-compare.changed" {
    background "$warning-soft"
    color "$fg"
    text-decoration underline
    text-underline-offset "$space-1"
    use "marked"
}

part "issue-row" {
    use "surface-box"
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
    padding "$space-2" "$space-3"
}

part "issue-row[variant=current]" {
    use "current-item"
}

// The way to the field permissions next to the note is a target a finger can hit.
part "layout-field.limited link" {
    use "touch-link"
}

// On a phone: the bar with the most used actions of an issue, in the slot above the bar of the app.
part "issue-bar" {
    display flex
    gap "$space-2"
    padding "$space-2"
    border-top "$border-width solid $border"
    background "$bg-raised"
}

part "issue-bar.item" {
    flex 1
}

part "key-capture-field.label" {
    font-size "$fs-md"
    font-weight "$weight-bold"
}

part "key-capture-field.box" {
    use "input-box"
    cursor text
}

part "key-capture-field.box:focus" {
    use "ring"
}

// The keys of one shortcut never break inside their combination: "G then H" is one thing.
part "keys" {
    display inline-flex
    align-items center
    gap "$space-1"
    white-space nowrap
}

part "keys.chord" {
    display inline-flex
    align-items center
    gap "$space-1"
}

part "keys.then" {
    color "$fg-muted"
    font-size "$fs-sm"
}

part "keys.key" {
    display inline-block
    min-width "$space-5"
    padding "0 $space-2"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-surface"
    color "$fg"
    font-family "$font"
    font-size "$fs-base"
    line-height "$lh-loose"
    text-align center
}

part "list-editor" {
    display flex
    flex-wrap wrap
    align-items flex-start
    gap "$space-4"
}

part "list-editor.list" {
    display flex
    flex 1
    flex-direction column
    gap "$space-3"
    min-width 0
}

// A row of the list is one button: pointing at it, or having it open, shows it (R8: a whole row is
// clickable and is not underlined; R4: the open one is marked).
part "list-editor.open" {
    use "surface-box"
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
    box-sizing border-box
    width "100%"
    min-height "$size-row"
    padding 0 "$pad-box"
    color "$fg"
    font-family "$font"
    font-size "$fs-md"
    text-align start
    cursor pointer
}

// The name breaks only between its words, and inside a word only when the word alone is wider than its
// column (the review of M4: "Web-site" cut in two). The same two columns in every row line the details up.
// A list whose rows have several columns of their own (the projects: the name, the short name and
// the place) gives the rows the same two columns, so the details line up from row to row.
part "list-editor.open[variant=columns]" {
    display grid
    grid-template-columns "minmax(0, 1fr) minmax(0, 1.5fr)"
}

part "list-editor.name" {
    min-width 0
    font-weight "$weight-bold"
    overflow-wrap break-word
}

part "list-editor.details" {
    display inline-flex
    align-items center
    gap "$space-2"
}

part "list-editor.open[hovered]" {
    background "$bg-hover"
}

part "list-editor.open[focus-visible]" {
    use "ring"
}

part "list-editor.open[state=open]" {
    border-color "$accent"
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

part "list-editor.nothing" {
    margin 0
    color "$fg-muted"
}

// The browser hides an element with the attribute, but the part here would show it again.
part "list-editor.list[state=hidden]" {
    display none
}

part "shell-overlays" {
    display flex
    flex-direction column
    align-items flex-end
    gap "$space-2"
    padding "$space-2"
}

part "shortcut-editor.row" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    margin 0
}

// Wide enough for the longer of the two labels, so the keys of both rows start on one edge.
part "shortcut-editor.label" {
    min-width "calc($size-control * 2.5)"
    margin-inline-end "$space-2"
    font-weight "$weight-bold"
}

part "shortcut-help.intro" {
    margin 0
    color "$fg-muted"
}

part "shortcut-help.change" {
    align-self flex-start
    color "$accent-fg"
    font-weight "$weight-bold"
    text-decoration underline
    text-underline-offset "$space-1"
}

part "shortcut-help.change[focus-visible]" {
    use "ring"
}

part "shortcut-list.what" {
    use "column-tight"
    flex 1
}

part "shortcut-list.name" {
    font-weight "$weight-bold"
}

part "shortcut-list.keys" {
    display inline-flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "shortcut-list.alternative" {
    display inline-flex
    align-items center
    gap "$space-2"
}

part "shortcuts-page.intro" {
    margin 0
    color "$fg-muted"
    line-height "$lh-body"
}

part "shortcuts-page.keys" {
    display inline-flex
    flex none
    align-items center
    justify-content flex-end
    gap "$space-2"
    white-space nowrap
}


// ───────────── Markdown (packages/ui: MarkdownView, MarkdownEditor) ─────────────
//
// The text of a person is HTML that `bb-markdown` wrote (ADR-0011): plain elements, a `span` for
// each issue ID and mention, and no class names. `markdown` is the part that holds it; the rules
// below style what the renderer writes inside it, with tokens only.

part "markdown" {
    min-width 0
    color "$fg"
    font-size "$fs-md"
    line-height "$lh-text"
    overflow-wrap anywhere
}

base "[data-part=markdown] p" "[data-part=markdown] ul" "[data-part=markdown] ol" "[data-part=markdown] pre" "[data-part=markdown] blockquote" "[data-part=markdown] table" "[data-part=markdown] hr" "[data-part=markdown] h1" "[data-part=markdown] h2" "[data-part=markdown] h3" "[data-part=markdown] h4" "[data-part=markdown] h5" "[data-part=markdown] h6" {
    margin 0 0 "$space-3"
}

base "[data-part=markdown] > :last-child" {
    margin-bottom 0
}

base "[data-part=markdown] h1" "[data-part=markdown] h2" "[data-part=markdown] h3" "[data-part=markdown] h4" "[data-part=markdown] h5" "[data-part=markdown] h6" {
    font-size "$fs-md"
    font-weight "$weight-bold"
    line-height "$lh-snug"
}

base "[data-part=markdown] h1" {
    font-size "$fs-xl"
}

base "[data-part=markdown] h2" {
    font-size "$fs-lg"
}

base "[data-part=markdown] ul" "[data-part=markdown] ol" {
    padding-left "$space-5"
}

base "[data-part=markdown] a" {
    color "$accent-fg"
    text-decoration underline
    text-underline-offset "$space-1"
}

base "[data-part=markdown] code" {
    font-family "$mono"
    font-size "$fs-base"
    padding 0 "$space-1"
    border-radius "$r-ctl"
    background "$bg-sunken"
}

base "[data-part=markdown] pre" {
    use "sunken-box"
    padding "$space-3"
    overflow-x auto
}

base "[data-part=markdown] pre code" {
    padding 0
    background none
}

base "[data-part=markdown] blockquote" {
    margin-left 0
    padding-left "$space-3"
    border-left "$space-1 solid $border"
    color "$fg-muted"
}

base "[data-part=markdown] table" {
    border-collapse collapse
}

base "[data-part=markdown] th" "[data-part=markdown] td" {
    padding "$space-1 $space-3"
    border "$border-width solid $border"
    text-align left
}

base "[data-part=markdown] hr" {
    border 0
    border-top "$border-width solid $border"
}

base "[data-part=markdown] img" {
    max-width "100%"
    height auto
}

// An issue ID or a mention. The server resolves it with the viewer's rights and the page shows it
// as a chip; until then, and where it cannot be resolved, it is marked text.
base "[data-part=markdown] [data-token]" {
    padding 0 "$space-1"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$accent-soft"
    color "$accent-fg"
    font-weight "$weight-bold"
    white-space nowrap
}

part "markdown.editor" {
    display flex
    flex-direction column
    gap "$space-2"
    min-width 0
}

// The row of formatting buttons wraps where it is too narrow: nothing is cut off or hidden at the
// edge (the review of M4, B issue page).
part "markdown.toolbar" {
    display flex
    flex-wrap wrap
    gap 0
}

part "markdown.preview" {
    use "surface-box"
    min-height "$size-control"
    padding "$space-3"
}

// ───────────── Sub-issues, related issues, history and followers (M3 WP-07) ─────────────
//
// The blocks of the issue page that WP-07 adds: a line for an issue with its status, how far the
// sub-issues are, the tabs of the history and one entry of it. The rest uses the shared parts.

part "issue-ref" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    min-width 0
}

// How far the sub-issues are: the browser's own bar, in the accent color.
part "progress" {
    inline-size "$size-line-medium"
    max-inline-size "100%"
    accent-color "$accent"
}

// One entry of the history: who, when, and what happened.
part "history.entry" {
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-3"
    use "surface-box"
}

part "history.entry[variant=comment]" {
    background "$bg-raised"
}

part "history.when" {
    use "quiet-text"
}

// ───────────── Files (features/files, M4 WP-05) ─────────────
//
// The Files block of the issue page and the files under a comment (UX §4.4): the place that takes
// files dropped on it, a row for each file and for each upload on its way, and the larger preview. The
// rest uses the shared parts (buttons, alerts, the bar of `progress`).

part "files.drop" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    padding "$space-3"
    border "$border-width dashed $border"
    border-radius "$r-card"
    color "$fg-muted"
    font-size "$fs-md"
}

// Files are being dragged over the place (React Aria marks it `drop-target`): it says "here" in the color of what is chosen.
part "files.drop[drop-target]" {
    border-color "$accent"
    background "$accent-soft"
    color "$accent-fg"
    use "marked"
}

part "files.row" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    padding "$space-3"
    min-width 0
    use "surface-box"
}

part "files.tile" {
    display flex
    align-items center
    justify-content center
    flex-shrink 0
    box-sizing border-box
    inline-size "$size-file-tile"
    block-size "$size-file-tile"
    overflow hidden
    padding 0
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-bold"
    text-transform uppercase
    use "sunken-box"
}

part "files.tile[variant=picture]" {
    cursor zoom-in
}

part "files.tile[hovered]" {
    background "$bg-hover"
}

part "files.tile[focus-visible]" {
    use "ring"
}

// The whole picture in the square, never cropped: a page of a PDF has its heading at the edge.
part "files.picture" {
    display block
    inline-size "100%"
    block-size "100%"
    object-fit contain
}

part "files.info" {
    display flex
    flex-direction column
    gap "$space-1"
    flex "1 1 $size-col-labels"
    min-width 0
    overflow-wrap anywhere
}

// A word that never breaks at a hyphen: it goes to the next line as a whole, and is cut anywhere only
// where it is longer than the line itself (file names, like an issue ID).
part "unbroken-word" {
    display inline-block
    max-width "100%"
    word-break break-all
}

part "files.name" {
    font-weight "$weight-bold"
    font-size "$fs-md"
}

part "files.meta" {
    use "quiet-text"
}

// The words of a refusal and its buttons: side by side when they fit, the buttons at the end like in
// the rows of files; when they do not, the buttons come under the words, at their left edge.
part "files.refusal" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2 $space-4"
}

// The bar of an upload: as wide as the row lets it be, with the words about it after it when they
// fit and under it when they do not, so it never stops short on a narrow screen.
part "files.progress" {
    flex "1 1 $size-line-medium"
    min-inline-size 0
    accent-color "$accent"
}

part "files.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// The larger preview: as big as it is, never wider than the window.
part "files.large" {
    display block
    max-inline-size "100%"
    block-size auto
    margin-inline auto
    border-radius "$r-ctl"
}

// ───────────── Own fields (features/fields, packages/ui: FieldValue) ─────────────
//
// How the value of an own field is shown (CF-04): a badge, a pill, plain text, a progress bar or an
// avatar. A choice carries one of the twelve category colors as its variant (`cat1`…`cat12`); each
// pair is a text color on its own background, which STY-CONTRAST checks in every theme.

part "field-badge" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding 0 "$space-2"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
    font-weight "$weight-bold"
    line-height "$lh-snug"
    white-space nowrap
}

part "field-pill" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding 0 "$space-3"
    border-radius "$r-pill"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
    line-height "$lh-snug"
    white-space nowrap
}

part "field-text" {
    margin 0
    color "$fg"
    overflow-wrap anywhere
}

part "field-progress" {
    display flex
    align-items center
    gap "$space-2"
    min-width "$size-sample-short"
}

part "field-progress.bar" {
    flex 1
    width "100%"
    accent-color "$accent"
}

part "field-avatar" {
    display inline-flex
    align-items center
    gap "$space-2"
    color "$fg"
}

part "field-avatar.face" {
    display inline-flex
    align-items center
    justify-content center
    width "$space-5"
    height "$space-5"
    border-radius "$r-pill"
    background "$accent-soft"
    color "$accent-fg"
    font-size "$fs-xs"
    font-weight "$weight-bold"
}

part "field-swatch" {
    display inline-flex
    align-items center
    justify-content center
    min-width "$size-control"
    min-height "$size-control"
    padding 0 "$space-2"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
}

part "choice-group.input:checked + field-swatch" {
    border "$border-width solid $accent"
    box-shadow "0 0 0 $border-width $accent"
    font-weight "$weight-bold"
}

part "choice-group.input:focus-visible + field-swatch" {
    use "ring"
}

part "field-sample" {
    use "fieldset-reset"
    display flex
    flex-wrap wrap
    gap "$space-3"
}

part "field-sample.theme" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-canvas"
    color "$fg"
    font-size "$fs-sm"
}

part "field-choice" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    padding "$space-2"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}


part "field-badge[variant=cat1]" "field-pill[variant=cat1]" "field-swatch[variant=cat1]" {
    background "$cat1-bg"
    color "$cat1-fg"
}

part "field-badge[variant=cat2]" "field-pill[variant=cat2]" "field-swatch[variant=cat2]" {
    background "$cat2-bg"
    color "$cat2-fg"
}

part "field-badge[variant=cat3]" "field-pill[variant=cat3]" "field-swatch[variant=cat3]" {
    background "$cat3-bg"
    color "$cat3-fg"
}

part "field-badge[variant=cat4]" "field-pill[variant=cat4]" "field-swatch[variant=cat4]" {
    background "$cat4-bg"
    color "$cat4-fg"
}

part "field-badge[variant=cat5]" "field-pill[variant=cat5]" "field-swatch[variant=cat5]" {
    background "$cat5-bg"
    color "$cat5-fg"
}

part "field-badge[variant=cat6]" "field-pill[variant=cat6]" "field-swatch[variant=cat6]" {
    background "$cat6-bg"
    color "$cat6-fg"
}

part "field-badge[variant=cat7]" "field-pill[variant=cat7]" "field-swatch[variant=cat7]" {
    background "$cat7-bg"
    color "$cat7-fg"
}

part "field-badge[variant=cat8]" "field-pill[variant=cat8]" "field-swatch[variant=cat8]" {
    background "$cat8-bg"
    color "$cat8-fg"
}

part "field-badge[variant=cat9]" "field-pill[variant=cat9]" "field-swatch[variant=cat9]" {
    background "$cat9-bg"
    color "$cat9-fg"
}

part "field-badge[variant=cat10]" "field-pill[variant=cat10]" "field-swatch[variant=cat10]" {
    background "$cat10-bg"
    color "$cat10-fg"
}

part "field-badge[variant=cat11]" "field-pill[variant=cat11]" "field-swatch[variant=cat11]" {
    background "$cat11-bg"
    color "$cat11-fg"
}

part "field-badge[variant=cat12]" "field-pill[variant=cat12]" "field-swatch[variant=cat12]" {
    background "$cat12-bg"
    color "$cat12-fg"
}

// ───────────── The design pages (docs/design) ─────────────
//
// `docs/design/components.css` and `docs/design/docpage.css` style the documents and mockups in
// `docs/`, not the app. They are written here as `rule`s with plain CSS selectors (the pages use
// class names and elements) and use tokens only. Their own tokens are named `doc-…` and are written
// to `docs/design/theme.css` only: `doc-space-N` is a length of N pixels on the scale of the pages.
// With less motion (the device setting, or the person's choice) the motion tokens are 0, so the one
// animation of the pages stops without a rule of its own.

docs "components" description="Bugaboo shared components: base elements, buttons, chips, status pills, tags, people and fields. Used by every design page and mockup; needs theme.css." {
    tokens {
        line-height "doc-lh-page" "1.45"
        number "doc-brightness-down" 0.97
        number "doc-brightness-up" 1.08
        number "doc-stroke-width" 2
        opacity "doc-opacity-pulse" 0.35
        size "doc-font-11" "11px"
        size "doc-r-pill" "999px"
        size "doc-r-small" "4px"
        size "doc-space-1" "1px"
        size "doc-space-10" "10px"
        size "doc-space-110" "110px"
        size "doc-space-130" "130px"
        size "doc-space-18" "18px"
        size "doc-space-2" "2px"
        size "doc-space-20" "20px"
        size "doc-space-22" "22px"
        size "doc-space-5" "5px"
        size "doc-space-6" "6px"
        size "doc-space-7" "7px"
        size "doc-space-9" "9px"
        weight "doc-weight-medium" 500
        weight "doc-weight-semibold" 600
    }

    rule "html" {
        box-sizing border-box
    }

    rule "*" "*::before" "*::after" {
        box-sizing inherit
    }

    rule "body" {
        margin 0
        background "$bg-canvas"
        color "$fg"
        font-family "$font"
        font-size "$fs-base"
        line-height "$doc-lh-page"
        -webkit-font-smoothing antialiased
    }

    rule "button" "input" "select" "textarea" {
        font-family inherit
        font-size inherit
        font-weight inherit
        font-style inherit
        line-height inherit
        color inherit
    }

    rule "button" {
        cursor pointer
    }

    rule ":focus-visible" {
        use "ring"
    }

    rule ".ico" {
        width "$space-4"
        height "$space-4"
        flex none
        fill none
        stroke currentColor
        stroke-width "$doc-stroke-width"
        stroke-linecap round
        stroke-linejoin round
    }

    rule ".ico.lg" {
        width "$doc-space-20"
        height "$doc-space-20"
    }

    rule ".mono" {
        font-family "$mono"
        font-variant-numeric tabular-nums
    }

    rule ".num" {
        font-variant-numeric tabular-nums
    }

    rule ".muted" {
        color "$fg-muted"
    }

    rule ".sr" {
        position absolute
        width "$doc-space-1"
        height "$doc-space-1"
        overflow hidden
        clip-path "inset(50%)"
        white-space nowrap
    }

    rule ".subtle" {
        color "$fg-subtle"
    }

    rule "kbd" {
        font-family "$mono"
        font-size "$doc-font-11"
        padding "$doc-space-1 $doc-space-5"
        border "$border-width solid $border"
        border-bottom-width "$doc-space-2"
        border-radius "$doc-r-small"
        color "$fg-muted"
        background "$bg-surface"
    }

    rule ".dot-live" {
        width "$space-2"
        height "$space-2"
        border-radius "50%"
        background "$accent"
        animation "doc-pulse $motion-pulse infinite"
    }

    keyframes "doc-pulse" {
        "50%" {
            opacity "$doc-opacity-pulse"
        }
    }

    rule ".btn" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-7 $space-3"
        border-radius "$r-ctl"
        border "$border-width solid $border"
        background "$bg-raised"
        color "$fg"
        font-weight "$doc-weight-medium"
        white-space nowrap
    }

    rule ".btn:hover" {
        background "$bg-hover"
    }

    rule ".btn.primary" {
        background "$accent"
        border-color "$accent"
        color "$on-accent"
    }

    rule ".btn.primary:hover" {
        filter "brightness($doc-brightness-up)"
    }

    rule ".btn.ghost" {
        border-color transparent
        background transparent
    }

    rule ".btn.ghost:hover" {
        background "$bg-hover"
    }

    rule ".btn.sm" {
        padding "$space-1 $doc-space-9"
        font-size "$fs-sm"
    }

    rule ".btn.danger" {
        color "$danger"
    }

    rule ".seg" {
        display inline-flex
        border "$border-width solid $border"
        border-radius "$r-ctl"
        overflow hidden
        background "$bg-surface"
    }

    rule ".seg button" {
        border 0
        background none
        padding "$doc-space-6 $space-3"
        display flex
        align-items center
        gap "$doc-space-6"
        color "$fg-muted"
    }

    rule ".seg button[aria-pressed=\"true\"]" {
        background "$bg-raised"
        color "$fg"
        font-weight "$doc-weight-semibold"
        box-shadow "inset 0 calc($doc-space-2 * -1) 0 $accent"
    }

    rule ".chips" {
        display flex
        flex-wrap wrap
        gap "$doc-space-6"
        flex 1
        min-width 0
    }

    rule ".chip" {
        display inline-flex
        align-items center
        gap "$space-1"
        padding "$space-1 $space-1 $space-1 $doc-space-10"
        border-radius "$doc-r-pill"
        border "$border-width solid $border"
        background "$bg-surface"
        font-size "$fs-sm"
    }

    rule ".chip > button" {
        border 0
        background none
        padding 0
        display inline-flex
        align-items center
        gap "$space-1"
    }

    rule ".chip .x" {
        width "$doc-space-22"
        height "$doc-space-22"
        border-radius "50%"
        justify-content center
        color "$fg-muted"
    }

    rule ".chip .x:hover" {
        background "$bg-hover"
        color "$fg"
    }

    rule ".chip b" {
        font-weight "$doc-weight-semibold"
    }

    rule ".chip.raw" {
        font-family "$mono"
        background "$bg-sunken"
        border-style dashed
    }

    rule ".chip.add" {
        padding "$space-1 $doc-space-10"
        border-style dashed
        color "$fg-muted"
        background transparent
    }

    rule ".key" {
        font-family "$mono"
        font-size "$fs-sm"
        color "$fg-muted"
        white-space nowrap
    }

    rule ".pill" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-2 $doc-space-9"
        border-radius "$doc-r-pill"
        font-size "$fs-sm"
        font-weight "$doc-weight-semibold"
        border 0
        white-space nowrap
    }

    rule ".pill::before" {
        content "\"\""
        width "$doc-space-7"
        height "$doc-space-7"
        border-radius "50%"
        background currentColor
    }

    rule ".st-ns" {
        background "$st-ns-soft"
        color "$st-ns"
    }

    rule ".st-ip" {
        background "$st-ip-soft"
        color "$st-ip"
    }

    rule ".st-done" {
        background "$st-done-soft"
        color "$st-done"
    }

    rule "button.pill:hover" {
        filter "brightness($doc-brightness-down)"
        box-shadow "0 0 0 $border-width currentColor"
    }

    rule ".prio" {
        display inline-flex
        align-items center
        gap "$doc-space-5"
        white-space nowrap
    }

    rule ".prio.Critical" {
        color "$danger"
        font-weight "$doc-weight-semibold"
    }

    rule ".prio.High" {
        color "$warning"
        font-weight "$doc-weight-semibold"
    }

    rule ".prio.Medium" {
        color "$fg-muted"
    }

    rule ".prio.Low" {
        color "$fg-subtle"
    }

    rule ".tag" {
        display inline-block
        padding "$doc-space-1 $space-2"
        border-radius "$doc-r-pill"
        font-size "$fs-xs"
        font-weight "$doc-weight-semibold"
        margin-right "$space-1"
    }

    rule ".c1" {
        background "$cat1-bg"
        color "$cat1-fg"
    }

    rule ".c2" {
        background "$cat2-bg"
        color "$cat2-fg"
    }

    rule ".c3" {
        background "$cat3-bg"
        color "$cat3-fg"
    }

    rule ".c4" {
        background "$cat4-bg"
        color "$cat4-fg"
    }

    rule ".c5" {
        background "$cat5-bg"
        color "$cat5-fg"
    }

    rule ".c6" {
        background "$cat6-bg"
        color "$cat6-fg"
    }

    rule ".who" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        white-space nowrap
    }

    rule ".av" {
        width "$doc-space-22"
        height "$doc-space-22"
        border-radius "50%"
        display inline-grid
        place-items center
        font-size "$doc-font-11"
        font-weight "$weight-bold"
        flex none
    }

    rule ".type" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
    }

    rule ".type.bug" {
        color "$danger"
    }

    rule ".type.task" {
        color "$st-ip"
    }

    rule ".type.feature" {
        color "$success"
    }

    rule ".type.goal" {
        color "$accent-fg"
    }

    rule ".cb" {
        width "$doc-space-18"
        height "$doc-space-18"
        accent-color "$accent"
    }

    rule ".fields" {
        display grid
        grid-template-columns "$doc-space-130 minmax(0, 1fr)"
        gap "$doc-space-2 $doc-space-10"
        align-items center
    }

    rule ".fields dt" {
        color "$fg-muted"
        font-size "$fs-sm"
        padding "$doc-space-6 0"
    }

    rule ".fields dd" {
        margin 0
        min-width 0
    }

    rule ".tabs" {
        display flex
        gap "$space-1"
        border-bottom "$border-width solid $border"
        margin-bottom "$doc-space-10"
        overflow-x auto
    }

    rule ".tabs button" {
        border 0
        background none
        padding "$doc-space-6 $doc-space-10"
        color "$fg-muted"
        border-bottom "$doc-space-2 solid transparent"
        white-space nowrap
    }

    rule ".tabs button[aria-selected=\"true\"]" {
        color "$fg"
        border-bottom-color "$accent"
        font-weight "$doc-weight-semibold"
    }

    rule ".field" {
        display flex
        flex-direction column
        gap "$doc-space-5"
    }

    rule ".field label" {
        font-weight "$doc-weight-semibold"
        font-size "$fs-sm"
    }

    rule ".field .req" {
        font-weight "$weight-regular"
        color "$fg-muted"
    }

    rule ".field input" ".field select" ".field textarea" {
        padding "$doc-space-9 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-canvas"
    }

    rule ".field textarea" {
        min-height "$doc-space-110"
        resize vertical
        line-height "$lh-text"
    }
}

docs "docpage" description="Bugaboo document pages: header, contents, section numbers, reading type and tables. Shared by every design document; needs theme.css and components.css." {
    tokens {
        layer "doc-z-copied" 50
        line-height "doc-lh-code" "1.55"
        line-height "doc-lh-reading" "1.65"
        line-height "doc-lh-title" "1.15"
        line-height "doc-lh-toc" "1.35"
        size "doc-bp-narrow" "1023px"
        size "doc-bp-phone" "600px"
        size "doc-font-12" "12px"
        size "doc-font-12-5" "12.5px"
        size "doc-font-18" "18px"
        size "doc-font-21" "21px"
        size "doc-font-28" "28px"
        size "doc-font-34" "34px"
        size "doc-font-inline-code" "0.92em"
        size "doc-measure-body" "70ch"
        size "doc-measure-lede" "68ch"
        size "doc-measure-note" "72ch"
        size "doc-menu-height" "60vh"
        size "doc-popup-width" "calc(100vw - 32px)"
        size "doc-safe-top" "env(safe-area-inset-top, 0px)"
        size "doc-space-1260" "1260px"
        size "doc-space-14" "14px"
        size "doc-space-230" "230px"
        size "doc-space-28" "28px"
        size "doc-space-3" "3px"
        size "doc-space-30" "30px"
        size "doc-space-36" "36px"
        size "doc-space-44" "44px"
        size "doc-space-56" "56px"
        size "doc-space-64" "64px"
        size "doc-space-72" "72px"
        size "doc-space-96" "96px"
        size "doc-toc-height" "calc(100vh - 80px)"
        size "doc-tracking-mid" "0.05em"
        size "doc-tracking-tight" "-0.01em"
        size "doc-tracking-wide" "0.07em"
    }

    rule "html" {
        scroll-padding-top "$doc-space-72"
    }

    rule "a" {
        color "$accent-fg"
    }

    rule ".top" {
        position sticky
        top "$doc-safe-top"
        z-index "$z-panel"
        background "$bg-canvas"
        border-bottom "$border-width solid $border"
    }

    rule ".top-in" {
        max-width "$doc-space-1260"
        margin 0 auto
        padding "$doc-space-10 $space-4"
        display flex
        align-items center
        gap "$space-3"
        flex-wrap wrap
    }

    rule ".brand" {
        display flex
        align-items center
        gap "$space-2"
        font-weight "$weight-bold"
        font-size "$fs-md"
    }

    rule ".brand svg" {
        width "$space-5"
        height "$space-5"
    }

    rule ".brand small" {
        font-weight "$doc-weight-medium"
        color "$fg-muted"
        font-size "$fs-sm"
    }

    rule ".look-pick" {
        margin-left auto
        display flex
        align-items center
        gap "$doc-space-6"
        font-size "$fs-sm"
        color "$fg-muted"
    }

    rule ".look-pick select" {
        padding "$doc-space-6 $space-2"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".layout" {
        max-width "$doc-space-1260"
        margin 0 auto
        padding "0 $space-4"
        display grid
        grid-template-columns "$doc-space-230 minmax(0, 1fr)"
        gap "$doc-space-44"
    }

    rule ".toc" {
        position sticky
        top "$doc-space-64"
        align-self start
        max-height "$doc-toc-height"
        overflow auto
        padding "$doc-space-28 0 $space-5"
        font-size "$fs-sm"
    }

    rule ".toc-h" {
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        font-weight "$weight-bold"
        padding "0 $space-2 $doc-space-6"
    }

    rule ".toc a" {
        display flex
        gap "$doc-space-6"
        padding "$space-1 $space-2"
        border-radius "$r-ctl"
        color "$fg-muted"
        text-decoration none
        line-height "$doc-lh-toc"
    }

    rule ".toc a:hover" {
        background "$bg-hover"
        color "$fg"
    }

    rule ".toc a.on" {
        color "$accent-fg"
        background "$bg-selected"
        font-weight "$doc-weight-semibold"
    }

    rule ".toc a .n" {
        font-family "$mono"
        font-size "$doc-font-11"
        min-width "$doc-space-30"
        color "$fg-subtle"
    }

    rule ".toc a.l3" {
        padding-left "$doc-space-18"
    }

    rule ".toc-phone" {
        display none
        margin "$space-4 0 0"
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-surface"
    }

    rule ".toc-phone summary" {
        padding "$space-3 $doc-space-14"
        font-weight "$weight-bold"
        cursor pointer
    }

    rule ".toc-phone nav" {
        padding "0 $doc-space-6 $doc-space-10"
        max-height "$doc-menu-height"
        overflow auto
    }

    rule ".doc" {
        padding "$doc-space-28 0 $doc-space-96"
        min-width 0
    }

    rule ".layout" {
        media "(max-width: $doc-bp-narrow)" {
            grid-template-columns "minmax(0, 1fr)"
        }
    }

    rule ".toc" {
        media "(max-width: $doc-bp-narrow)" {
            display none
        }
    }

    rule ".toc-phone" {
        media "(max-width: $doc-bp-narrow)" {
            display block
        }
    }

    rule ".doc h1" {
        font-size "$doc-font-34"
        line-height "$doc-lh-title"
        margin "$space-1 0 $space-2"
        text-wrap balance
        letter-spacing "$doc-tracking-tight"
    }

    rule ".doc h2" {
        font-size "$fs-xl"
        margin "$doc-space-56 0 $space-3"
        padding-top "$doc-space-20"
        border-top "$border-width solid $border"
        text-wrap balance
    }

    rule ".doc h3" {
        font-size "$doc-font-18"
        margin "$doc-space-36 0 $space-2"
        text-wrap balance
    }

    rule ".doc h4" {
        font-size "$fs-md"
        margin "$doc-space-22 0 $doc-space-6"
    }

    rule ".doc p" ".doc li" {
        line-height "$doc-lh-reading"
        max-width "$doc-measure-body"
    }

    rule ".doc ul" ".doc ol" {
        padding-left "$doc-space-22"
    }

    rule ".doc li" {
        margin "$space-1 0"
    }

    rule ".doc code" {
        font-family "$mono"
        font-size "$doc-font-inline-code"
        background "$bg-sunken"
        padding "$doc-space-1 $doc-space-5"
        border-radius "$doc-r-small"
    }

    rule ".lede" {
        font-size "$fs-md"
        color "$fg-muted"
        max-width "$doc-measure-lede"
    }

    rule ".status-line" {
        font-size "$fs-sm"
        color "$fg-muted"
        display flex
        gap "$space-2"
        flex-wrap wrap
        align-items center
    }

    rule ".sec" {
        font-family "$mono"
        font-size "$doc-font-12"
        font-weight "$doc-weight-semibold"
        color "$accent-fg"
        background "$accent-soft"
        padding "$doc-space-2 $space-2"
        border-radius "$doc-r-pill"
        text-decoration none
        vertical-align "$space-1"
        margin-right "$space-2"
        border 0
        cursor pointer
        white-space nowrap
    }

    rule ".sec:hover" {
        box-shadow "0 0 0 $border-width $accent"
    }

    rule ".ids" {
        font-family "$mono"
        font-size "$doc-font-11"
        color "$fg-subtle"
        font-weight "$weight-regular"
        margin-left "$doc-space-6"
        vertical-align "$doc-space-3"
    }

    rule ".note" {
        border "$border-width solid $border"
        background "$bg-surface"
        border-radius "$r-card"
        padding "$doc-space-14 $space-4"
        margin "$doc-space-18 0"
        max-width "$doc-measure-note"
    }

    rule ".note.feedback" {
        border-color "$accent"
        background "$accent-soft"
    }

    rule ".note b:first-child" {
        display block
        margin-bottom "$space-1"
    }

    rule ".tbl-wrap" {
        overflow-x auto
        margin "$doc-space-14 0"
        border "$border-width solid $border"
        border-radius "$r-card"
    }

    rule ".dtable" {
        border-collapse collapse
        width "100%"
        font-size "$fs-sm"
    }

    rule ".dtable th" ".dtable td" {
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
        text-align left
        vertical-align top
    }

    rule ".dtable th" {
        background "$bg-surface"
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-muted"
    }

    rule ".dtable tr:last-child td" {
        border-bottom 0
    }

    rule ".copied" {
        position fixed
        left "50%"
        bottom "$space-5"
        transform "translateX(-50%)"
        z-index "$doc-z-copied"
        background "$fg"
        color "$bg-canvas"
        border-radius "$r-card"
        padding "$doc-space-10 $doc-space-14"
        font-size "$fs-sm"
        box-shadow "$shadow"
        max-width "$doc-popup-width"
    }

    rule ".doc h1" {
        media "(max-width: $doc-bp-phone)" {
            font-size "$doc-font-28"
        }
    }

    rule ".doc h2" {
        media "(max-width: $doc-bp-phone)" {
            font-size "$doc-font-21"
            margin-top "$doc-space-44"
        }
    }

    rule ".doc pre" {
        background "$bg-sunken"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        overflow-x auto
        font-family "$mono"
        font-size "$doc-font-12-5"
        line-height "$doc-lh-code"
    }

    rule ".doc pre code" {
        background none
        padding 0
    }

    rule ".doc pre.mermaid" {
        background "$bg-raised"
        text-align center
        font-family "$font"
    }

    rule ".doc blockquote" {
        margin "$doc-space-14 0"
        padding "$doc-space-6 $doc-space-14"
        border-left "$doc-space-3 solid $accent"
        color "$fg-muted"
    }

    // The logo of the page header, and what the page builder used to write as inline styles.
    rule ".logo-fill-accent" {
        fill "$accent"
    }

    rule ".logo-fill-canvas" {
        fill "$bg-canvas"
    }

    rule ".logo-stroke-accent" {
        stroke "$accent"
    }

    rule ".logo-stroke-canvas" {
        stroke "$bg-canvas"
    }

    // The list of contents inside the page on a phone: it is not the rail of the wide layout.
    rule ".toc-phone .toc" {
        display block
        position static
        max-height none
        padding 0
    }

    rule ".feedback .sec" {
        vertical-align 0
    }

    // The alignment of a column of a table.
    rule ".dtable .align-left" {
        text-align left
    }

    rule ".dtable .align-center" {
        text-align center
    }

    rule ".dtable .align-right" {
        text-align right
    }
}

docs "ux-design" description="The design page of the user experience: its reading type, the demo frames, the mini screens and the diagrams. Needs theme.css, components.css and docpage.css." {
    tokens {
        line-height "doc-lh-1-1" "1.1"
        line-height "doc-lh-1-3" "1.3"
        number "doc-stroke-1-2" 1.2
        number "doc-stroke-2-5" 2.5
        number "doc-stroke-3-4" 3.4
        opacity "doc-opacity-0-2" 0.2
        opacity "doc-opacity-0-4" 0.4
        size "doc-deg-45" "45deg"
        size "doc-deg-n2" "-2deg"
        size "doc-em-0-06" "0.06em"
        size "doc-font-10" "10px"
        size "doc-font-10-5" "10.5px"
        size "doc-font-11-5" "11.5px"
        size "doc-font-13" "13px"
        size "doc-font-15" "15px"
        size "doc-font-16" "16px"
        size "doc-font-19" "19px"
        size "doc-font-20" "20px"
        size "doc-font-30" "30px"
        size "doc-space-13" "13px"
        size "doc-space-15" "15px"
        size "doc-space-150" "150px"
        size "doc-space-160" "160px"
        size "doc-space-17" "17px"
        size "doc-space-170" "170px"
        size "doc-space-190" "190px"
        size "doc-space-200" "200px"
        size "doc-space-220" "220px"
        size "doc-space-240" "240px"
        size "doc-space-26" "26px"
        size "doc-space-260" "260px"
        size "doc-space-280" "280px"
        size "doc-space-300" "300px"
        size "doc-space-31" "31px"
        size "doc-space-320" "320px"
        size "doc-space-330" "330px"
        size "doc-space-340" "340px"
        size "doc-space-360" "360px"
        size "doc-space-46" "46px"
        size "doc-space-460" "460px"
        size "doc-space-48" "48px"
        size "doc-space-520" "520px"
        size "doc-space-560" "560px"
        size "doc-space-600" "600px"
        size "doc-space-640" "640px"
        size "doc-space-1040" "1040px"
        size "doc-space-70" "70px"
        size "doc-space-78" "78px"
        size "doc-space-80" "80px"
        size "doc-space-90" "90px"
        size "doc-space-n10" "-10px"
        size "doc-space-n2" "-2px"
        size "doc-space-n6" "-6px"
    }

    rule ".target" {
        border-left "$doc-space-3 solid $accent"
        padding "$space-1 0 $space-1 $doc-space-14"
        margin "$doc-space-20 0"
        max-width "$doc-measure-body"
    }

    rule ".doc .principles" {
        list-style none
        padding 0
        display grid
        grid-template-columns "repeat(auto-fill, minmax($doc-space-260, 1fr))"
        gap "$space-3"
        counter-reset p
    }

    rule ".principles li" {
        counter-increment p
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14 $space-3 $doc-space-46"
        position relative
        background "$bg-raised"
        margin 0
        max-width none
    }

    rule ".principles li::before" {
        content "counter(p)"
        position absolute
        left "$space-3"
        top "$space-3"
        width "$space-5"
        height "$space-5"
        border-radius "50%"
        background "$accent-soft"
        color "$accent-fg"
        font-weight "$weight-bold"
        font-size "$doc-font-12"
        display grid
        place-items center
        font-family "$mono"
    }

    rule ".doc .tree" {
        list-style none
        font-size "$fs-sm"
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        background "$bg-surface"
        max-width "$doc-space-560"
    }

    rule ".tree ul" {
        list-style none
        padding-left "$doc-space-18"
        border-left "$border-width dashed $border"
        margin "$doc-space-2 0 $doc-space-2 $doc-space-7"
    }

    rule ".tree li" {
        display block
        margin "$doc-space-3 0"
        max-width none
    }

    rule ".tree .lbl" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        font-weight "$doc-weight-semibold"
    }

    rule ".tree .d" {
        color "$fg-muted"
        font-weight "$weight-regular"
    }

    rule ".demo" {
        margin "$doc-space-18 0 $doc-space-22"
        display flex
        gap "$space-4"
        flex-wrap wrap
        align-items flex-start
    }

    rule ".frame" {
        border "$border-width solid $border"
        border-radius "$space-3"
        background "$bg-canvas"
        box-shadow "$shadow"
        overflow hidden
        min-width 0
        flex "1 1 $doc-space-520"
        max-width "100%"
    }

    rule ".frame-cap" {
        font-size "$doc-font-11"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        font-weight "$weight-bold"
        padding "$doc-space-6 $space-3"
        border-bottom "$border-width solid $border-subtle"
        background "$bg-surface"
        display flex
        gap "$space-2"
        align-items center
    }

    rule ".frame-body" {
        overflow-x auto
    }

    rule ".scr" {
        font-size "$doc-font-13"
        background "$bg-canvas"
        color "$fg"
    }

    rule ".frame-body > .scr" {
        min-width "$doc-space-640"
    }

    // The issue list has fixed columns that need room; the frame scrolls when the page is narrower.
    rule ".frame-body > .scr.wide" {
        min-width "$doc-space-1040"
    }

    // The page behind a window in the pictures. The window is the part of the app, drawn in place.
    rule ".win-stage" {
        display flex
        flex-direction column
        align-items center
        gap "$space-4"
        padding "$space-4"
        background "$bg-sunken"
    }

    rule ".win-stage .win-wide" {
        width "min(calc($size-window * 1.2), 100%)"
    }

    // The issue page: the text, and the Details at the side (300 to 340).
    rule ".issue-grid" {
        display grid
        grid-template-columns "minmax(0, 1fr) $size-details"
    }

    rule ".win-stage .dock-flat" {
        position static
    }

    rule ".frame.phone" {
        flex "0 0 $doc-space-300"
        border-radius "$doc-space-28"
        border "$doc-space-7 solid $border"
    }

    rule ".frame.phone .frame-body > .scr" {
        min-width 0
    }

    rule ".frame.narrow" {
        flex "1 1 $doc-space-340"
    }

    rule ".frame.narrow .frame-body > .scr" {
        min-width 0
    }

    rule ".cap-note" {
        font-size "$fs-sm"
        color "$fg-muted"
        margin "$doc-space-n10 0 $doc-space-18"
        max-width "$doc-measure-body"
    }

    rule ".scr .btn" {
        padding "$doc-space-5 $doc-space-10"
        font-size "$doc-font-12-5"
    }

    rule ".scr .btn.sm" {
        padding "$doc-space-3 $space-2"
        font-size "$doc-font-12"
    }

    rule ".scr .seg button" {
        padding "$space-1 $doc-space-9"
        font-size "$doc-font-12"
    }

    rule ".scr .pill" {
        font-size "$doc-font-12"
        padding "$doc-space-1 $space-2"
    }

    rule ".scr .key" {
        font-size "$doc-font-12"
    }

    rule ".scr .chip" {
        font-size "$doc-font-12"
        padding "$doc-space-3 $doc-space-3 $doc-space-3 $doc-space-9"
    }

    rule ".scr .chip.add" {
        padding "$doc-space-3 $doc-space-9"
    }

    rule ".app3" {
        display grid
        grid-template-columns "$doc-space-150 minmax(0, 1fr) $doc-space-230"
        min-height "$doc-space-320"
    }

    rule ".app2" {
        display grid
        grid-template-columns "$doc-space-150 minmax(0, 1fr)"
        min-height "$doc-space-280"
    }

    rule ".sb" {
        background "$bg-surface"
        border-right "$border-width solid $border"
        padding "$doc-space-10 $space-2"
        display flex
        flex-direction column
        gap "$doc-space-1"
    }

    rule ".sb .ttl" {
        display flex
        align-items center
        gap "$doc-space-6"
        font-weight "$weight-bold"
        padding "$doc-space-2 $doc-space-6 $space-2"
    }

    rule ".ni" {
        display flex
        align-items center
        gap "$doc-space-7"
        padding "$doc-space-5 $doc-space-7"
        border-radius "$r-ctl"
    }

    rule ".ni.on" {
        background "$bg-selected"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
    }

    rule ".ni .cnt" {
        margin-left auto
        font-size "$doc-font-10"
        background "$accent"
        color "$on-accent"
        border-radius "$doc-r-pill"
        padding "0 $doc-space-6"
        font-weight "$weight-bold"
    }

    rule ".nl" {
        font-size "$doc-font-10"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        padding "$space-2 $doc-space-7 $doc-space-2"
        font-weight "$weight-bold"
    }

    rule ".timer-mini" {
        margin-top auto
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-6 $space-2"
        border-radius "$r-ctl"
        background "$accent-soft"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
        font-size "$doc-font-12"
    }

    rule ".mainc" {
        display flex
        flex-direction column
        min-width 0
    }

    rule ".tb" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $space-3"
        border-bottom "$border-width solid $border"
        flex-wrap wrap
    }

    rule ".tb .crumb" {
        color "$fg-muted"
    }

    rule ".dodont b" {
        display block
        font-size "$doc-font-11"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        margin-bottom "$space-1"
    }

    rule ".cards-pick b" {
        display block
        font-size "$doc-font-12-5"
    }

    rule ".tb .crumb b" {
        color "$fg"
    }

    rule ".sbar" {
        display flex
        gap "$doc-space-6"
        padding "$space-2 $space-3"
        border-bottom "$border-width solid $border-subtle"
        flex-wrap wrap
        align-items center
    }

    rule ".r" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-7 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".r .t" {
        flex 1
        min-width 0
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
        font-weight "$doc-weight-medium"
    }

    rule ".r.sel" {
        background "$bg-selected"
    }

    rule ".r.hd" {
        background "$bg-surface"
        font-size "$doc-font-11"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-subtle"
        font-weight "$weight-bold"
    }

    rule ".pn" {
        border-left "$border-width solid $border"
        padding "$space-3"
        display flex
        flex-direction column
        gap "$doc-space-10"
        min-width 0
    }

    rule ".pn h5" {
        margin 0
        font-size "$doc-font-15"
        line-height "$doc-lh-1-3"
    }

    rule ".mini-fields" {
        display grid
        grid-template-columns "auto minmax(0, 1fr)"
        gap "$space-1 $doc-space-10"
        font-size "$doc-font-12"
        align-items center
    }

    rule ".mini-fields dt" {
        color "$fg-muted"
    }

    rule ".mini-fields dd" {
        margin 0
        min-width 0
    }

    rule ".sh" {
        font-size "$doc-font-10-5"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-muted"
        font-weight "$weight-bold"
        margin "$space-1 0 $space-1"
    }

    rule ".blk" {
        border "$border-width solid $border"
        border-radius "$space-2"
        overflow hidden
    }

    rule ".blk .r:last-child" {
        border-bottom 0
    }

    rule ".rel-kind" {
        min-width "$doc-space-96"
        color "$fg-muted"
        font-size "$doc-font-12"
    }

    rule ".ph-top" {
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-10 $space-3"
        border-bottom "$border-width solid $border"
        font-weight "$doc-weight-semibold"
    }

    rule ".ph-body" {
        min-height "$doc-space-300"
    }

    rule ".bb" {
        display grid
        grid-template-columns "repeat(5, 1fr)"
        border-top "$border-width solid $border"
        background "$bg-surface"
    }

    rule ".bb span" {
        display flex
        flex-direction column
        align-items center
        font-size "$doc-font-10"
        padding "$doc-space-6 0 $space-2"
        color "$fg-muted"
        gap "$doc-space-2"
    }

    rule ".bb .on" {
        color "$accent-fg"
        font-weight "$weight-bold"
    }

    rule ".bb .new .ico" {
        background "$accent"
        color "$on-accent"
        border-radius "50%"
        padding "$doc-space-3"
        width "$doc-space-22"
        height "$doc-space-22"
    }

    rule ".actbar" {
        display grid
        grid-template-columns "repeat(4, 1fr)"
        border-top "$border-width solid $border"
        background "$bg-surface"
        text-align center
        font-size "$doc-font-11"
    }

    rule ".actbar span" {
        padding "$space-2 0"
        display flex
        flex-direction column
        align-items center
        gap "$doc-space-2"
    }

    rule ".lrow" {
        padding "$doc-space-10 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".lrow .t" {
        font-weight "$doc-weight-semibold"
        margin "$doc-space-2 0 $space-1"
    }

    rule ".lrow .m" {
        display flex
        gap "$space-2"
        flex-wrap wrap
        align-items center
        font-size "$doc-font-12"
        color "$fg-muted"
    }

    rule ".banner" {
        display flex
        gap "$space-2"
        align-items center
        flex-wrap wrap
        padding "$space-2 $doc-space-10"
        border-radius "$space-2"
        background "$warning-soft"
        color "$fg"
        border "$border-width solid $warning"
        font-size "$doc-font-12"
    }

    rule ".bubble" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$doc-space-7 $doc-space-10"
        font-size "$doc-font-12"
    }

    rule ".box" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
    }

    rule ".box-h" {
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
        font-weight "$weight-bold"
    }

    rule ".box-h .muted" {
        margin-left auto
        font-weight "$weight-regular"
        font-size "$doc-font-11"
    }

    rule ".grid2" {
        display grid
        grid-template-columns "repeat(2, minmax(0, 1fr))"
        gap "$space-3"
        padding "$space-3"
    }

    rule ".timer-card" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$doc-space-10 $space-3"
        border "$border-width solid $accent"
        background "$accent-soft"
        border-radius "$r-card"
        margin "$space-3 $space-3 0"
        flex-wrap wrap
    }

    rule ".timer-card .clock" {
        font-family "$mono"
        font-size "$doc-font-20"
        font-weight "$doc-weight-semibold"
        color "$accent-fg"
    }

    rule ".checklist" {
        display flex
        gap "$doc-space-10"
        flex-wrap wrap
        align-items center
        margin "$space-3 $space-3 0"
        padding "$doc-space-10 $space-3"
        border "$border-width dashed $border"
        border-radius "$r-card"
    }

    rule ".okmark" {
        width "$doc-space-18"
        height "$doc-space-18"
        border-radius "50%"
        background "$success"
        color "$bg-canvas"
        display inline-grid
        place-items center
        font-size "$doc-font-11"
        font-weight "$weight-bold"
    }

    rule ".many-change" {
        display flex
        gap "$doc-space-6"
        flex-wrap wrap
        align-items center
        margin "$doc-space-10 auto"
        width max-content
        max-width "calc(100% - $space-5)"
        background "$bg-raised"
        border "$border-width solid $border"
        box-shadow "$shadow"
        border-radius "$r-card"
        padding "$doc-space-7 $doc-space-9"
    }

    rule ".preview-msg" {
        margin "0 $space-3 $space-3"
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$doc-space-10 $space-3"
        background "$bg-raised"
        font-size "$doc-font-12-5"
    }

    rule ".adv-box" {
        font-family "$mono"
        font-size "$doc-font-12-5"
        line-height "$lh-loose"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$space-2 $doc-space-10"
        background "$bg-raised"
        white-space pre-wrap
    }

    rule ".adv-box .err" {
        text-decoration "underline wavy $danger"
        text-underline-offset "$doc-space-3"
    }

    rule ".errline" {
        color "$danger"
        font-size "$doc-font-12"
        display flex
        gap "$doc-space-6"
        align-items center
        margin-top "$doc-space-6"
    }

    rule ".ask-res" {
        border "$border-width solid $border"
        background "$accent-soft"
        border-radius "$r-ctl"
        padding "$space-2 $doc-space-10"
        display flex
        flex-wrap wrap
        gap "$space-2"
        align-items center
        font-size "$doc-font-12"
    }

    rule ".ask-res code" {
        flex 1
        min-width 0
        font-family "$mono"
    }

    rule ".pop-demo" {
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
        box-shadow "$shadow"
        padding "$doc-space-5"
        min-width "$doc-space-200"
        font-size "$doc-font-12-5"
    }

    rule ".pop-demo .h" {
        font-size "$doc-font-10-5"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        font-weight "$weight-bold"
        padding "$doc-space-5 $space-2 $doc-space-3"
    }

    rule ".pop-demo .it" {
        display flex
        gap "$space-2"
        align-items center
        padding "$doc-space-6 $space-2"
        border-radius "$r-ctl"
    }

    rule ".pop-demo .it.on" {
        background "$bg-hover"
    }

    rule ".pop-demo input" {
        width "100%"
        padding "$doc-space-6 $space-2"
        border "$border-width solid $accent"
        border-radius "$r-ctl"
        background "$bg-canvas"
        margin "$doc-space-2 0 $space-1"
        font-size "$doc-font-12-5"
    }

    rule ".flow" {
        display flex
        gap "$space-3"
        flex-wrap wrap
        align-items flex-start
    }

    rule ".flow .step" {
        display flex
        flex-direction column
        gap "$doc-space-6"
        flex "1 1 $doc-space-200"
        min-width 0
    }

    rule ".scale span" {
        display flex
        flex-direction column
        align-items center
        gap "$space-1"
        font-size "$doc-font-11"
        color "$fg-muted"
        font-family "$mono"
    }

    rule ".tbtn span" {
        padding "$doc-space-2 $doc-space-6"
        border-radius "$doc-r-small"
    }

    rule ".flow .step > span" {
        font-size "$fs-xs"
        font-weight "$weight-bold"
        color "$fg-muted"
    }

    rule ".toast-demo" {
        display inline-flex
        gap "$doc-space-10"
        align-items center
        background "$fg"
        color "$bg-canvas"
        border-radius "$r-card"
        padding "$space-2 $space-3"
        font-size "$doc-font-12-5"
    }

    rule ".toast-demo u" {
        font-weight "$weight-bold"
    }

    rule ".dialog-demo" {
        border "$border-width solid $border"
        border-radius "$doc-space-14"
        background "$bg-raised"
        box-shadow "$shadow"
        max-width "$doc-space-460"
        margin "$doc-space-14 auto"
    }

    rule ".dialog-demo .dh" {
        display flex
        align-items center
        padding "$doc-space-10 $doc-space-14"
        border-bottom "$border-width solid $border-subtle"
        font-weight "$weight-bold"
    }

    rule ".dialog-demo .db" {
        padding "$space-3 $doc-space-14"
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".dialog-demo .df" {
        padding "$doc-space-10 $doc-space-14"
        border-top "$border-width solid $border-subtle"
        display flex
        gap "$doc-space-6"
        justify-content flex-end
        flex-wrap wrap
    }

    rule ".perm select" {
        padding "$space-1 $doc-space-6"
        border-radius "$r-ctl"
        border "$border-width solid $border"
        background "$bg-raised"
        font-size "$doc-font-12"
    }

    rule ".scr .field input" ".scr .field select" ".scr .field textarea" {
        padding "$doc-space-6 $doc-space-9"
        font-size "$doc-font-12-5"
    }

    rule ".scr .field textarea" {
        min-height "$doc-space-56"
    }

    rule ".board" {
        display grid
        grid-template-columns "repeat(4, minmax($doc-space-150, 1fr))"
        gap "$doc-space-10"
        padding "$space-3"
    }

    rule ".col" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding-bottom "$space-2"
        display flex
        flex-direction column
        gap "$doc-space-7"
    }

    rule ".col.fade" {
        opacity "$doc-opacity-0-4"
    }

    rule ".col.ok" {
        outline "$doc-space-2 dashed $accent"
        outline-offset "$doc-space-n2"
    }

    rule ".col-h" {
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$space-2 $doc-space-9 $doc-space-2"
        font-weight "$doc-weight-semibold"
    }

    rule ".col-h .lim" {
        margin-left auto
        font-size "$doc-font-11"
        color "$fg-muted"
    }

    rule ".col-h .lim.over" {
        color "$warning"
        font-weight "$weight-bold"
    }

    rule ".card" {
        margin "0 $space-2"
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$space-2"
        padding "$space-2"
        display flex
        flex-direction column
        gap "$doc-space-6"
        font-size "$doc-font-12"
    }

    rule ".card .t" {
        font-weight "$doc-weight-medium"
        font-size "$doc-font-12-5"
    }

    rule ".card .m" {
        display flex
        gap "$doc-space-6"
        align-items center
        flex-wrap wrap
    }

    rule ".card.drag" {
        transform "rotate($doc-deg-n2)"
        box-shadow "$shadow"
        border-color "$accent"
    }

    rule ".tl" {
        display grid
        grid-template-columns "$doc-space-190 1fr"
        font-size "$doc-font-12"
    }

    rule ".tl .hdr" {
        background "$bg-surface"
        border-bottom "$border-width solid $border"
        padding "$doc-space-6 $space-2"
        color "$fg-muted"
        font-weight "$doc-weight-semibold"
        font-size "$doc-font-11"
    }

    rule ".tl .wk" {
        display grid
        grid-template-columns "repeat(5, 1fr)"
        padding 0
    }

    rule ".tl .wk span" {
        padding "$doc-space-6 $space-2"
        border-left "$border-width solid $border-subtle"
    }

    rule ".tl .nm" {
        padding "$doc-space-6 $space-2"
        border-bottom "$border-width solid $border-subtle"
        display flex
        gap "$doc-space-6"
        align-items center
        white-space nowrap
        overflow hidden
    }

    rule ".tl .nm.child" {
        padding-left "$doc-space-22"
    }

    rule ".tl .ln" {
        position relative
        border-bottom "$border-width solid $border-subtle"
        min-height "calc($size-control-small + $space-2)"
        background-image "repeating-linear-gradient(to right, transparent 0, transparent calc(20% - $doc-space-1), $border-subtle calc(20% - $doc-space-1), $border-subtle 20%)"
    }

    // A bar of the timeline is the part `timeline-bar` (its tint and its edge); this only places it.
    rule ".bar" {
        position absolute
        top "$space-1"
        font-family "$mono"
        white-space nowrap
        overflow hidden
    }

    rule ".bar.goal" {
        background "$accent"
        height "$space-2"
        top "$space-3"
        border-radius "$doc-r-small"
    }

    rule ".ms" {
        position absolute
        top "$doc-space-9"
        width "$doc-space-13"
        height "$doc-space-13"
        transform "translateX($doc-space-n6) rotate($doc-deg-45)"
        background "$warning"
        border-radius "$doc-space-2"
    }

    // Today is an accent line with a label; it is no longer red, because red means Critical.
    rule ".today" {
        position absolute
        top 0
        bottom 0
        width "$doc-space-2"
        background "$accent"
    }

    rule ".today-label" {
        position absolute
        top 0
        left "$doc-space-5"
        padding "0 $doc-space-5"
        border-radius "$doc-r-small"
        background "$accent"
        color "$on-accent"
        font-size "$doc-font-10"
        font-weight "$weight-bold"
        white-space nowrap
    }

    rule ".dep" {
        position absolute
        height "$doc-space-2"
        background "$fg-muted"
        top "$doc-space-15"
    }

    rule ".docs3" {
        display grid
        grid-template-columns "$doc-space-150 minmax(0, 1fr) $doc-space-150"
        min-height "$doc-space-280"
    }

    rule ".doc-page" {
        padding "$doc-space-14 $doc-space-18"
        min-width 0
    }

    rule ".doc-page h5" {
        font-size "$doc-font-20"
        margin "$space-1 0 $space-2"
    }

    rule ".doc-page p" {
        font-size "$doc-font-12-5"
        line-height "$lh-loose"
        margin "$doc-space-6 0"
    }

    rule ".tbtn" {
        display flex
        gap "$doc-space-2"
        flex-wrap wrap
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$doc-space-3"
        background "$bg-surface"
        width max-content
        max-width "100%"
        font-size "$doc-font-11-5"
    }

    rule ".live" {
        display inline-flex
        gap "$doc-space-5"
        align-items center
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$doc-space-1 $doc-space-6"
        background "$bg-raised"
    }

    rule ".dside" {
        border-left "$border-width solid $border"
        padding "$space-3 $doc-space-10"
        font-size "$doc-font-12"
        display flex
        flex-direction column
        gap "$space-3"
    }

    rule ".lockb" {
        margin-left auto
        display inline-flex
        gap "$doc-space-3"
        align-items center
        font-size "$doc-font-10-5"
        color "$warning"
    }

    rule ".ts" {
        border-collapse collapse
        width "100%"
        font-size "$doc-font-12"
    }

    rule ".ts th" ".ts td" {
        padding "$doc-space-6"
        border-bottom "$border-width solid $border-subtle"
        text-align center
        font-variant-numeric tabular-nums
    }

    rule ".ts th" {
        background "$bg-surface"
        color "$fg-muted"
        font-size "$doc-font-11"
    }

    rule ".perm th" {
        background "$bg-surface"
        font-size "$doc-font-10-5"
        color "$fg-muted"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
    }

    rule ".perm th" ".perm td" {
        padding "$space-2 $doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        text-align left
    }

    rule ".ts tfoot td" {
        font-weight "$weight-bold"
        background "$bg-surface"
    }

    rule ".ts td:first-child" ".ts th:first-child" {
        text-align left
    }

    rule ".ts .cell" {
        display inline-block
        min-width "$doc-space-44"
        padding "$doc-space-3 $space-1"
        border "$border-width solid $border-subtle"
        border-radius "$doc-space-5"
        font-family "$mono"
        background "$bg-canvas"
    }

    rule ".ts .cell.focus" {
        border-color "$accent"
        box-shadow "0 0 0 $doc-space-2 $accent-soft"
    }

    rule ".ts th.today" {
        color "$accent-fg"
    }

    rule ".bars" {
        display flex
        flex-direction column
        gap "$doc-space-6"
        padding "$space-3"
        font-size "$doc-font-12"
    }

    rule ".bars div" {
        display grid
        grid-template-columns "$doc-space-70 1fr $doc-space-30"
        gap "$space-2"
        align-items center
    }

    rule ".bars i" {
        display block
        height "$doc-space-10"
        border-radius "$doc-space-3"
    }

    rule ".msg" {
        max-width "92%"
        padding "$space-2 $doc-space-10"
        border-radius "$r-card"
        line-height "$lh-text"
        font-size "$doc-font-12-5"
    }

    rule ".msg.me" {
        align-self flex-end
        background "$accent"
        color "$on-accent"
    }

    rule ".msg.ai" {
        align-self flex-start
        background "$bg-surface"
        border "$border-width solid $border-subtle"
    }

    rule ".ai-l" {
        font-size "$doc-font-10-5"
        color "$fg-subtle"
        display flex
        gap "$space-1"
        align-items center
    }

    rule ".prop" {
        border "$border-width solid $accent"
        border-radius "$r-card"
        padding "$doc-space-10"
        background "$bg-raised"
        display flex
        flex-direction column
        gap "$space-2"
        font-size "$doc-font-12-5"
    }

    rule ".prop .old" {
        text-decoration line-through
        color "$fg-muted"
    }

    rule ".src" {
        font-size "$doc-font-12"
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-ctl"
        padding "$doc-space-6 $doc-space-9"
    }

    rule ".cards-pick" {
        display grid
        grid-template-columns "repeat(auto-fill, minmax($doc-space-150, 1fr))"
        gap "$space-2"
        padding "$space-3"
    }

    rule ".cards-pick div" {
        border "$border-width solid $border"
        border-radius "$space-2"
        padding "$space-2 $doc-space-10"
        background "$bg-raised"
        font-size "$doc-font-12"
    }

    rule ".cards-pick div.on" {
        border-color "$accent"
        box-shadow "0 0 0 $doc-space-2 $accent-soft"
    }

    rule ".perm" {
        border-collapse collapse
        width "100%"
        font-size "$doc-font-12-5"
    }

    rule ".perm select.hid" {
        color "$fg-subtle"
    }

    rule ".perm select.see" {
        color "$st-ip"
    }

    rule ".perm select.chg" {
        color "$success"
        font-weight "$doc-weight-semibold"
    }

    rule ".explain" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$doc-space-10 $space-3"
        line-height "$lh-loose"
        font-size "$doc-font-12-5"
        margin "$space-3"
    }

    rule ".wfrow" {
        display flex
        gap "$space-2"
        align-items center
        flex-wrap wrap
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".te" {
        display grid
        grid-template-columns "$doc-space-200 minmax(0, 1fr)"
        min-height "$doc-space-260"
    }

    rule ".te-l" {
        border-right "$border-width solid $border"
        padding "$doc-space-10"
        font-size "$doc-font-12"
        display flex
        flex-direction column
        gap "$space-1"
        background "$bg-surface"
    }

    rule ".te-l .g" {
        font-weight "$weight-bold"
        margin-top "$doc-space-6"
    }

    rule ".te-l .row" {
        display flex
        align-items center
        gap "$doc-space-6"
    }

    rule ".sw" {
        width "$doc-space-14"
        height "$doc-space-14"
        border-radius "$doc-r-small"
        border "$border-width solid $border"
        display inline-block
        flex none
    }

    rule ".rd" {
        margin-left auto
        font-size "$doc-font-10-5"
        font-weight "$weight-bold"
    }

    rule ".rd.ok" {
        color "$success"
    }

    rule ".rd.bad" {
        color "$danger"
    }

    rule ".te-r" {
        padding "$space-3"
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".doc .stepper" {
        list-style none
        padding 0
        counter-reset s
        display flex
        flex-direction column
        gap "$space-2"
    }

    rule ".stepper li" {
        counter-increment s
        display grid
        grid-template-columns "$doc-space-28 minmax(0, 1fr)"
        gap "$doc-space-10"
        margin 0
        align-items start
    }

    rule ".stepper li::before" {
        content "counter(s)"
        width "$doc-space-26"
        height "$doc-space-26"
        border-radius "50%"
        border "$doc-space-2 solid $accent"
        color "$accent-fg"
        display grid
        place-items center
        font-weight "$weight-bold"
        font-size "$doc-font-12"
        font-family "$mono"
    }

    rule ".signin" {
        max-width "$doc-space-320"
        margin "$doc-space-14 auto"
        display flex
        flex-direction column
        gap "$space-2"
        padding "$space-4"
        border "$border-width solid $border"
        border-radius "$doc-space-14"
        background "$bg-raised"
    }

    rule ".signin .or" {
        text-align center
        font-size "$doc-font-11"
        color "$fg-subtle"
    }

    rule ".state" {
        border "$border-width dashed $border"
        border-radius "$r-card"
        padding "$doc-space-14"
        text-align center
        font-size "$doc-font-13"
        flex "1 1 $doc-space-220"
    }

    rule ".offline" {
        background "$warning-soft"
        color "$fg"
        border-bottom "$border-width solid $warning"
        padding "$doc-space-6 $doc-space-10"
        font-size "$doc-font-12"
    }

    rule ".wd" {
        display flex
        align-items center
        gap "$space-2"
        flex-wrap wrap
        padding "$space-2 $doc-space-10"
        border "$border-width solid $success"
        background "$success-soft"
        border-radius "$r-card"
        font-size "$doc-font-12-5"
    }

    rule ".ts .cell.warnc" {
        border-color "$warning"
        background "$warning-soft"
    }

    rule ".ts .warnt" {
        color "$warning"
    }

    rule ".ts tr.wh td" {
        background "$bg-surface"
    }

    rule ".editing-note" {
        display flex
        gap "$space-2"
        align-items center
        padding "$doc-space-7 $doc-space-10"
        border "$border-width dashed $accent"
        background "$accent-soft"
        border-radius "$space-2"
        font-size "$doc-font-12-5"
    }

    rule ".savestate" {
        display flex
        gap "$space-2"
        align-items center
        font-size "$doc-font-12-5"
        color "$fg-muted"
    }

    rule ".ss-dot" {
        width "$space-2"
        height "$space-2"
        border-radius "50%"
        display inline-block
    }

    rule ".ss-dot.ip" {
        background "$st-ip"
    }

    rule ".ss-dot.ok" {
        background "$success"
    }

    rule ".fv" {
        display grid
        grid-template-columns "$doc-space-44 $doc-space-170 minmax(0, 1fr)"
        min-height "$doc-space-330"
    }

    rule ".fv-icons" {
        background "$bg-surface"
        border-right "$border-width solid $border"
        display flex
        flex-direction column
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-10 0"
    }

    rule ".fv-ic" {
        width "$doc-space-30"
        height "$doc-space-30"
        border-radius "$r-ctl"
        display grid
        place-items center
        color "$fg-muted"
    }

    rule ".fv-ic.on" {
        background "$bg-selected"
        color "$accent-fg"
    }

