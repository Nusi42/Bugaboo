        flex-direction column
        gap "$doc-space-10"
    }

    rule ".doc .stepper" {
        list-style none
        padding 0
        counter-reset s
        display flex
        flex-direction column
        gap "$space-2"
    }

    rule ".stepper li" {
        counter-increment s
