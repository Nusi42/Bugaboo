        grid-template-columns "$doc-space-150 minmax(0, 1fr) $doc-space-150"
        min-height "$doc-space-280"
    }

    rule ".doc-page" {
        padding "$doc-space-14 $doc-space-18"
        min-width 0
    }

    rule ".doc-page h5" {
        font-size "$doc-font-20"
        margin "$space-1 0 $space-2"
    }

    rule ".doc-page p" {
        font-size "$doc-font-12-5"
        line-height "$lh-loose"
        margin "$doc-space-6 0"
    }

    rule ".tbtn" {
