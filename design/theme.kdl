// Bugaboo theme: the one file for everything about how the app looks (ADR-0026).
//
// Read only by `cargo xtask gen theme`, which writes the one static style sheet
// (web/packages/ui/src/theme.css), the TypeScript names (tokens.ts), the Rust theme
// choices of the settings and the copy for the design pages. Neither the server nor the
// browser reads this file.
//
// What is in here, in this order:
//   1. themes and the choices that change token values (spacing, text size, motion),
//   2. tokens: every value, with its variants for each mode on one line,
//   3. contrast: the rules that every theme must keep (STY-CONTRAST),
//   4. mixins, keyframes and part rules: the look of every component, using tokens only.
//
// Components carry no style values and no class names. They emit `data-part`, `data-state`
// and `data-variant`, and React Aria's own `data-*` state attributes. THEME-ONLY checks it.

// The two themes that "Match my device" starts with.
defaults light="daylight" dark="dusk"

// The attributes of the page frame (<html>): `look` carries the theme on the page, `mode` is the
// light or dark mode that the design pages force, `preview` marks a sample of a theme inside the
// page. Written once: the style sheets, the TypeScript (`pageAttributes`) and the browser tests
// read the names from here.
frame look="data-look" mode="data-theme" preview="data-preview-look"

// The built-in themes. `kind` decides the browser's own controls and scrollbars.
themes {
    theme "daylight" kind="light"
    theme "paper" kind="light"
    theme "dusk" kind="dark"
    theme "midnight" kind="dark"
}

// Choices of a person that change token values without changing the theme. Each is an
// attribute on <html>; a token names the variant as a property (`density` below has
// `compact=`). `media` switches the variant on from the device setting too.
variants {
    variant "compact" attribute="data-spacing" value="compact"
    variant "larger-text" attribute="data-text" value="larger"
    variant "less-motion" attribute="data-motion" value="less" media="(prefers-reduced-motion: reduce)"
    // Choices the device makes: a touch screen (fingers need 44 px, UX §7.4) and a phone (text 16).
    variant "touch" media="(pointer: coarse), (width < $bp-tablet)"
    variant "phone" media="(width < $bp-tablet)"
}

// Tokens. The first value (unnamed) is the same in every theme. A color has one value per
// theme, `<theme>-more=` replaces it when the device asks for more contrast, `forced=`
// replaces it while forced colors are on, and `<variant>=` is the value while that choice is on.
tokens {
    // Fonts: the system font stacks of the sister project, word for word; no font file is shipped (ADR-0026).
    // `font-ui` is the text of the app, `font-display` its titles and headings, `font-reader` what a person reads at
    // length (a description, a comment, the help), `font-mono` code and issue IDs.
    font "font-ui" "Segoe UI Variable Text" "Segoe UI" "system-ui" "sans-serif"
    font "font-display" "Segoe UI Variable Display" "Segoe UI" "system-ui" "sans-serif"
    font "font-reader" "Segoe UI Variable Text" "Segoe UI" "system-ui" "sans-serif"
    font "font-mono" "Cascadia Mono" "Consolas" "ui-monospace" "monospace"

    // Corners
    size "r-ctl" "6px"
    size "r-card" "10px"
    size "r-pill" "999px"

    // Text sizes (times the text size choice)
    size "fs-xs" "calc(12px * $text-scale)"
    size "fs-sm" "calc(13px * $text-scale)"
    size "fs-base" "calc(14px * $text-scale)"
    size "fs-md" "calc(16px * $text-scale)"
    size "fs-lg" "calc(20px * $text-scale)"
    size "fs-xl" "calc(24px * $text-scale)"
    // The text of rows, fields and buttons: 14 on a computer, 16 on a phone (UX §7.3).
    size "fs-ui" "calc(14px * $text-scale)" phone="calc(16px * $text-scale)"

    // Spacing (times the spacing choice)
    size "space-1" "calc(4px * $density)"
    size "space-2" "calc(8px * $density)"
    size "space-3" "calc(12px * $density)"
    size "space-4" "calc(16px * $density)"
    size "space-5" "calc(24px * $density)"
    size "space-6" "calc(32px * $density)"
    size "space-7" "calc(48px * $density)"

    // Padding per container (UX §7.4, R2, R3): inside a control 12, a box, a row or a panel 16, a
    // dialog or a page 24; between fields 20, between sections 28.
    size "pad-control" "$space-3"
    size "pad-box" "$space-4"
    size "pad-dialog" "$space-5"
    size "gap-fields" "calc(20px * $density)"
    size "gap-sections" "calc(28px * $density)"

    // Sizes
    size "size-content" "640px"
    size "size-page" "960px"
    size "size-menu" "240px"
    size "size-form" "$size-dialog"
    size "size-qr" "200px"
    size "size-code" "220px"
    // The square in the row of a file: its preview, or the sign of its type (M4 WP-05).
    size "size-file-tile" "64px" phone="56px"
    // A quiet button that stands under text on a phone (*Download* and *Delete* under a file, the
    // button of the note under the buttons of a window) hangs back by its padding, so its text
    // starts where the text above starts (R1, the mixin `hang-start`). Beside the text, on a
    // computer, nothing hangs back.
    size "size-phone-hang" "0px" phone="calc(-1 * $pad-control)"
    // How big a control is (UX §7.4): 36 with a mouse and 44 for a finger. WCAG 2.2 AA asks for 24 at
    // least, so no control is smaller (a test holds the tokens to it).
    size "size-target-least" "24px"
    // What a small target of a list is at the least: 24 for a pointer (WCAG 2.5.8), a finger's 44 on touch (UX §7.4).
    size "size-target-compact" "24px" touch="44px"
    size "size-control" "36px" touch="44px"
    size "size-control-small" "28px" touch="44px"
    // A row of a list: 44 with a mouse and 64 for a finger.
    size "size-row" "44px" touch="64px"
    // The same row with *Spacing: Compact*.
    size "size-row-compact" "28px" touch="44px"
    // The sentence of an empty list stands in from the list's edge on a computer and on the edge itself on a phone (R1).
    size "pad-nothing" "$pad-box" phone="0px"
    // How tall the list of people may be before it scrolls inside the page (the issue lists take the rest of the window).
    size "size-list-scroll" "70dvh"
    // The least the box of the rows of an issue list is high, where the page above it takes most of the window.
    size "size-list-scroll-least" "120px"
    // The coloured edge of a row for its priority.
    size "size-edge" "4px"
    // The name of a value in the details: 112 on a computer, 120 on a phone.
    size "size-name" "112px" phone="120px"
    // The columns of a list row (UX §4.2): the icon columns, the ID, the priority, the person.
    size "size-col-icon" "24px"
    // The two columns of buttons at the end of a status change in the workflow editor: the same width in every row.
    size "size-col-rules" "64px"
    size "size-col-remove" "80px"
    // The ID column is as wide as the longest ID the list draws (its characters times the width of one character of the code font), and at least what its head needs: the name and the handle. Phone cards size their ID from what it says.
    size "size-col-key" "calc(80px * $text-scale)"
    // The width of one character of the code font, as the browser draws it: the code measures a probe in the code font once and sets it (run-time); the value here is only what stands until it has, 0.6 of the text size of the ID cells (`fs-ui`, 14px on a computer).
    size "size-code-char" "calc(8.4px * $text-scale)" run-time="true"
    size "size-col-short" "64px"
    size "size-col-place" "112px"
    size "size-col-priority" "72px"
    size "size-col-person" "96px"
    size "size-col-labels" "96px"
    size "size-col-project" "96px"
    // How a row gives out its width (the browser gives the fixed columns their token before the
    // title grows): where the box is narrower than the tokens, the title gives up room first, down to
    // this least; then the columns of fields (assigned to, changed, project, labels, an own field) give
    // up theirs, down to the least width; then the list scrolls sideways, head and rows together. A
    // column that is only an icon, the ID and the priority keep their width. A column a person drags
    // is no narrower than the least and moves by the step with the arrow keys.
    size "size-col-title-least" "160px"
    size "size-col-least" "48px"
    size "size-col-most" "800px"
    size "size-col-step" "16px"
    size "size-col-value" "96px"
    size "size-col-changed" "80px"
    // A window (UX §6.3): it starts 760 wide and as tall as its content, the smallest is 560 wide and, when a person makes it smaller, 360 high (the code holds that height, so a short window is not made taller), and the form follows its own width.
    size "size-window" "760px"
    size "size-window-width-min" "560px"
    size "size-window-height-min" "360px"
    size "size-window-button" "46px"
    // The places to drag at the edges of a window.
    size "size-window-handle" "8px"
    // The size of the window right now: the code sets these two variables while the person drags,
    // and nothing else sets a style at run time.
    size "window-width" "$size-window" run-time="true"
    size "window-height" "auto" run-time="true"
    // The columns of the issue list while it is drawn: one width for each, the same in the head and in every row.
    size "list-columns" "auto" run-time="true"
    // The width of the scroll bar the rows of the list have now (none while they fit): the head keeps the same room at its end, so the columns stand over each other and the list meets the edge of its card.
    size "list-gutter" "0px" run-time="true"
    // The width of the head of the list as the browser measured it (its columns at their least, at least the frame): the code gives it to the virtualized rows, which have no width of their own, so a list wider than its box scrolls sideways, head and rows together; none where there is no head.
    size "list-width" "0px" run-time="true"
    size "bp-window-side" "880px"
    // Narrower than this the list has no room for Customize beside it: the panel stands under the list, as high as its
    // columns, and the list takes the rest. It is size-list-main + space-4 (the gap of list-body) + size-list, written out
    // because a container query cannot read tokens; a test of the theme file (theme_file/tests.rs) holds them together.
    size "bp-list-beside" "876px"
    size "bp-window-wide" "1200px"
    // The width of one day on the timeline at the week zoom.
    size "size-day-week" "16px"

    // Focus ring
    size "ring-width" "2px"
    size "ring-offset" "2px"
    size "ring-room" "calc($ring-width + $ring-offset)"

    // Where the layout changes
    size "bp-tablet" "768px"
    size "bp-computer" "1280px"
    size "size-sidebar" "264px"
    size "size-sidebar-narrow" "72px"
    size "size-panel" "420px"
    size "size-bar" "56px"
    size "size-viewport" "100dvh"
    // A question is a small fixed dialog, 440 wide (R10); the palette of quick search is wider.
    size "size-dialog" "440px"
    size "size-palette" "560px"
    size "size-icon" "20px"
    size "size-icon-small" "16px"
    // The least width of a swatch of a color with its name (the longest, "Sky blue") and the tick of the chosen one.
    size "size-swatch" "calc(96px * $text-scale)"
    size "size-list" "300px"
    // The room the list asks for beside Customize: with this much left over, the panel stands beside the list (UX §4.2); with less it stands under it.
    size "size-list-main" "560px"
    // The least width of an item of the Customize checklist: as many columns as fit.
    size "size-list-item" "240px"
    // Where the Legend stands at the end of the row above a list: at the far end of a computer, at the start edge on a phone, where it has a line of its own.
    size "legend-start" "auto" phone="0px"
    size "size-details" "340px"
    // The gap between the text of an issue and its Details, and the room both take at the end of the
    // column: the offers to undo keep out of it (one rule for the page and for the offers).
    size "gap-details" "$space-5"
    size "size-details-room" "calc($size-details + $gap-details)"
    size "size-reading" "75ch"
    size "size-main" "780px"
    size "size-sheet-share" "85%"
    // A panel at the end of the screen, beside the page (the help of the search bar): about 30 rem.
    size "size-side-panel" "30rem"
    // The sheet of the search bar on a phone is always this high, so what is under a finger does not
    // move when the offers under the box come and go.
    size "size-bar-sheet" "80dvh"
    // The bar of the issues ticked, in the column of a phone, is never taller than this, and scrolls inside.
    size "size-bar-ticked" "40dvh"
    // Wide enough for the longest level ("Can change") in its box, so no word is cut; more roles than fit scroll.
    size "size-matrix-cell" "calc($size-control * 4)"
    // The gap between the rows of a list in a picker: the box, its height and the lines at its ends use it.
    size "size-option-gap" "$space-1"
    // The gap between the things in the body of the question Move: the shadow lines at its ends take it back.
    size "size-body-gap" "$space-4"
    // The room between the edge of the screen or of a column and what stands in the page: the same for the page, and for
    // the strip of a minimized window, so the strip starts where the page column starts.
    size "size-page-gutter" "$space-4"
    // The room above and below the bar of a minimized window inside its strip, and the strip: bar and room.
    size "size-dock-gap" "$space-3"
    size "size-dock-strip" "calc($size-control + 2 * $size-dock-gap)"
    // A row of the people list as tall as a name and three lines of small text need: the box of the list is five of them.
    size "size-person-row" "calc(2 * $space-2 + 2 * $space-1 + $fs-md * $lh-body + 3 * $fs-base * $lh-body + $border-width)"
    size "size-list-tall" "calc($size-list * 2)"
    // Placeholder lines and the sample of a theme: how much of the width a shorter line takes.
    size "size-line-medium" "80%"
    size "size-line-short" "55%"
    size "size-sample-short" "60%"
    // Turns: the tick of a checkbox, and the arrow of a tree branch that is open.
    size "angle-tick" "45deg"
    size "angle-open" "90deg"
    // Where the skip link waits, out of sight above the page.
    size "skip-offset" "-300%"

    // Motion
    duration "motion-fast" "120ms" less-motion="0ms"
    duration "motion-base" "200ms" less-motion="0ms"
    duration "motion-pulse" "calc($motion-base * 8)" less-motion="0ms"

    // The choices as numbers
    number "density" 1 compact=0.75
    number "text-scale" 1 larger-text=1.25

    // Font weights
    weight "weight-regular" 400
    weight "weight-bold" 700

    // Line heights
    line-height "lh-tight" 1.2
    line-height "lh-snug" 1.25
    line-height "lh-body" 1.4
    line-height "lh-text" 1.5
    line-height "lh-loose" 1.6

    // The width of a line: borders and dividers
    border-width "border-width" "1px"

    // Layers (z-index), from the lowest, each named for what uses it. The overlay is above everything
    // that sticks to the page.
    // z-raised: the corner of the levels table, above the cells that scroll under it.
    layer "z-raised" 1
    // z-sticky: the top bar of a page, which stays while the page scrolls.
    layer "z-sticky" 5
    // z-bar: the question of a confirm dialog.
    layer "z-bar" 10
    // z-panel: what floats over the page at its edge (the offers to undo), and the header of the design pages.
    layer "z-panel" 20
    // z-overlay: sheets, menus and quick search.
    layer "z-overlay" 30
    // z-top: the skip link when it has the focus: above everything.
    layer "z-top" 40

    // Opacity. The scrim is the dimmed page behind a sheet; forced colors make it fainter.
    opacity "opacity-faint" 0.5
    opacity "opacity-disabled" 0.6
    // A control that waits for an answer is seen by people while it waits, so its text keeps AA (4.5:1)
    // on its own fill; a disabled control is exempt, a busy one is not. Held by the test of the busy Save.
    opacity "opacity-busy" 0.85
    opacity "opacity-scrim" 0.9 forced=0.6

    // Easing, for the animations
    easing "ease-in" "ease-in"
    easing "ease-out" "ease-out"
    easing "ease-in-out" "ease-in-out"

    // How much a pressed or hovered primary button brightens
    number "hover-brightness" 1.12

    // Colors
    color "bg-canvas" daylight="#ffffff" paper="#fbf8f3" dusk="#1d2027" midnight="#000000"
    color "bg-surface" daylight="#f6f7f9" paper="#f4efe7" dusk="#252932" midnight="#0c0d10"
    color "bg-raised" daylight="#ffffff" paper="#fffdf9" dusk="#2d323c" midnight="#16181d"
    color "bg-sunken" daylight="#eef0f3" paper="#ede6da" dusk="#191b21" midnight="#050506"
    color "bg-hover" daylight="#eceef2" paper="#ede6db" dusk="#333945" midnight="#1e2127"
    color "bg-selected" daylight="#ebe7fb" paper="#dce3eb" dusk="#3c375d" midnight="#242046"
    color "border" daylight="#dfe3e9" paper="#e1d8ca" dusk="#3b414d" midnight="#272a31" daylight-more="#6d6f72" paper-more="#6e6a63" dusk-more="#999ca2" midnight-more="#828388" forced="ButtonText"
    // The edge of a control that is drawn by its edge (a box to tick, the track of a switch): a line a
    // person has to see, so it reaches 3:1 against every surface (WCAG 1.4.11, checked by the `lines` rule of the contrast rules), unlike the dividers.
    color "border-control" daylight="#80838b" paper="#7a7366" dusk="#7d8696" midnight="#757a85" daylight-more="#6d6f72" paper-more="#6e6a63" dusk-more="#999ca2" midnight-more="#828388" forced="ButtonText"
    // The shadow at the end of a scrolling box that has more behind it: it must be seen in every theme (the `distinct` rule
    // below keeps it so), a dark shade on the light themes and a light one on the dark themes, where the shade of a dark box has nothing to darken.
    color "cue" daylight="#4b5160" paper="#4f4638" dusk="#aab3c5" midnight="#9aa2b3"
    color "border-subtle" daylight="#eaedf1" paper="#eae3d7" dusk="#313641" midnight="#1a1c21" daylight-more="#8c8e91" paper-more="#8c8881" dusk-more="#797c84" midnight-more="#66676a"
    color "divider" daylight="#a9b0bc" paper="#b2a795" dusk="#5a6272" midnight="#454b57" daylight-more="#6d6f72" paper-more="#6e6a63" dusk-more="#999ca2" midnight-more="#828388" forced="ButtonText"
    color "fg" daylight="#16181d" paper="#2b2620" dusk="#e5e8ed" midnight="#f2f3f5"
    color "fg-muted" daylight="#565d6b" paper="#5f564d" dusk="#aeb5c1" midnight="#9ca3af" daylight-more="#464c57" paper-more="#4d4740" dusk-more="#cbcfd6" midnight-more="#b2b7c1"
    color "fg-subtle" daylight="#5c6172" paper="#645b51" dusk="#a9afbb" midnight="#9198a4" daylight-more="#484c58" paper-more="#4d4741" dusk-more="#cccfd5" midnight-more="#afb4bd"
    color "accent" daylight="#5b3fd9" paper="#2f5d8a" dusk="#a495ff" midnight="#9483ff" daylight-more="#4a30b8" paper-more="#244b78" dusk-more="#a697ff" midnight-more="#9b8cff" forced="Highlight"
    color "accent-soft" daylight="#eeeafd" paper="#e4ecf4" dusk="#37325a" midnight="#221d47"
    color "accent-fg" daylight="#4a2fc4" paper="#284f75" dusk="#c2b8ff" midnight="#b7abff" daylight-more="#492ec0" paper-more="#264a6e" dusk-more="#d0c8ff"
    // The grey chip of a main button that cannot be pressed yet, and its words: a fill and words of their own, so that
    // more contrast and forced colors can change them without touching the dividers (M5 exit, O-gate B1, S7).
    color "disabled-fill" daylight="#d7dbe1" paper="#d3d1ce" dusk="#434955" midnight="#30333a" forced="ButtonFace"
    color "on-disabled" daylight="#4d5461" paper="#564e45" dusk="#c0c6d1" midnight="#9ca3af" daylight-more="#333843" paper-more="#3d3731" dusk-more="#e6e9ef" midnight-more="#c4c9d2" forced="GrayText"
    color "on-accent" daylight="#ffffff" paper="#ffffff" dusk="#1a1530" midnight="#0b0820" forced="HighlightText"
    color "danger" daylight="#c62f2f" paper="#b23a2e" dusk="#ff8a80" midnight="#ff7a70" daylight-more="#912222" paper-more="#802a21" dusk-more="#ffbfb9" midnight-more="#ff928a"
    color "danger-soft" daylight="#fdecec" paper="#f8e6e1" dusk="#4a2a2c" midnight="#3a1414"
    color "warning" daylight="#aa4e09" paper="#925611" dusk="#f5b65b" midnight="#ffb547" daylight-more="#7c3907" paper-more="#693e0c" dusk-more="#f7c781"
    color "warning-soft" daylight="#fef3e2" paper="#f6ead5" dusk="#47391f" midnight="#382810"
    color "success" daylight="#1f784c" paper="#3f6e3a" dusk="#6fd39a" midnight="#5fd38f" daylight-more="#165637" paper-more="#2e502a" dusk-more="#96dfb5"
    color "success-soft" daylight="#e6f4ec" paper="#e5eedf" dusk="#213d31" midnight="#0f2e1e"
    // The value of `fg-muted` on purpose, written twice: there is no alias between tokens, and the two are named
    // for what they say (a status, a quiet word) so one may change without the other.
    color "st-ns" daylight="#565d6b" paper="#5f564d" dusk="#aeb5c1" midnight="#9ca3af" daylight-more="#464c57" paper-more="#4d4740" dusk-more="#cbcfd6" midnight-more="#abb1bb"
    color "st-ns-soft" daylight="#eef0f3" paper="#ece5da" dusk="#343944" midnight="#262a31" midnight-more="#1a1c21"
    color "st-ip" daylight="#1d5fd1" paper="#1d6b80" dusk="#7fb0ff" midnight="#74a8ff" daylight-more="#16489f" paper-more="#14495a" dusk-more="#b3d0ff" midnight-more="#82b1ff"
    color "st-ip-soft" daylight="#e7effc" paper="#dfeef1" dusk="#24365a" midnight="#10244a"
    color "st-done" daylight="#1f784c" paper="#3f6e3a" dusk="#6fd39a" midnight="#5fd38f" daylight-more="#165637" paper-more="#2e502a" dusk-more="#96dfb5"
    color "st-done-soft" daylight="#e6f4ec" paper="#e5eedf" dusk="#213d31" midnight="#0f2e1e"
    // The tint of a row by its status group, one for each of the three groups (Not started, In progress,
    // Done): the group's hue at the lightness where every text color of a row still reaches 4.5:1
    // (7:1 with more contrast), so the tint is as strong as the contrast rules allow. A row keeps its
    // tint in every state: hovered, selected (ring and ticked box) and current (ring) only add to it.
    color "tint-ns" daylight="#e9e9ec" paper="#e3e1dd" dusk="#3b3b3b" midnight="#252525"
    color "tint-ip" daylight="#d2eefe" paper="#c4e9ef" dusk="#1f3b68" midnight="#0a2350"
    color "tint-done" daylight="#c8f3de" paper="#cdeabf" dusk="#17442d" midnight="#082b1a"
    // The edge of a row by its priority (UX §4.2): Critical is the red of `danger`, High is a clear orange, as
    // far from that red as the contrast rules ask (the brown of the text color `warning` was 28 from it in
    // Daylight) and a line to see (3:1) on every tint and surface.
    color "edge-high" daylight="#cf6a00" paper="#cb6300" dusk="#f5b65b" midnight="#ffb547" forced="CanvasText"
    // The thin line just inside a row that is pointed at: the edge of a control in the light themes, a step
    // stronger in the dark ones, where the edge of a control was barely seen on the tints of Dusk.
    // A token of its own, though three themes give it the value of `border-control`: the two are set apart by
    // what they draw, and the dark themes already differ. A token that says "the same as" another is not in
    // the file (tokens have no alias); a follow-up may add one.
    color "hover-line" daylight="#80838b" paper="#7a7366" dusk="#a0a8b6" midnight="#8e95a2" daylight-more="#6d6f72" paper-more="#6e6a63" dusk-more="#b0b4bb" midnight-more="#9a9ca2" forced="ButtonText"
    // The dimmed page behind a sheet, a menu or Quick search. Dark in every theme: in the light themes the old
    // fill (the sunken surface at 80%) left the text under the panel readable.
    color "scrim" daylight="#1c2029" paper="#2a2826" dusk="#101217" midnight="#000000" forced="Canvas"
    // The twelve colors of choices, labels and tags (UX §7.1), each a fill and its text, with plain names in the catalog
    // (`choice-color.cat1` Pink … `cat12` Sand). The fills are told apart at a glance in every theme (the `distinct`
    // rule below), and the text color, the edge of a swatch, is seen on every surface (the `lines` rule).
    color "cat1-bg" daylight="#ffc8da" paper="#ffe1ef" dusk="#5e2943" midnight="#4d1934" daylight-more="#ffe1ed" paper-more="#ffe1ef" dusk-more="#5e2943" midnight-more="#491831"
    color "cat1-fg" daylight="#7b4a5c" paper="#83586e" dusk="#d798b3" midnight="#c487a2"
    color "cat2-bg" daylight="#c0d9fe" paper="#bdd8ff" dusk="#033e67" midnight="#022e4f" daylight-more="#dbebff" paper-more="#d0e4ff" dusk-more="#033e67" midnight-more="#052c4b"
    color "cat2-fg" daylight="#3e5c7e" paper="#375b81" dusk="#88aee1" midnight="#749bcd"
    color "cat3-bg" daylight="#b5edc2" paper="#b5edc2" dusk="#034120" midnight="#002b15" daylight-more="#c5f4cf" paper-more="#bbefc7" dusk-more="#034120" midnight-more="#002b15"
    color "cat3-fg" daylight="#366945" paper="#366945" dusk="#7bb28b" midnight="#6f9a7d"
    color "cat4-bg" daylight="#ffccaa" paper="#ffc39d" dusk="#5d3818" midnight="#532a01" daylight-more="#ffe5cf" paper-more="#ffdbc2" dusk-more="#543419" midnight-more="#422305"
    color "cat4-fg" daylight="#7f4c26" paper="#7b4722" dusk="#daa984" midnight="#c99873"
    color "cat5-bg" daylight="#eed5ff" paper="#ecd2ff" dusk="#422e59" midnight="#311f49" daylight-more="#f6e2ff" paper-more="#f1daff" dusk-more="#422e59" midnight-more="#311f49"
    color "cat5-fg" daylight="#6c557d" paper="#6a537d" dusk="#b59ccf" midnight="#a289bc"
    color "cat6-bg" daylight="#b5ebe4" paper="#abe8e3" dusk="#124d49" midnight="#0a3e3a" daylight-more="#c5f2ec" paper-more="#b7ece8" dusk-more="#19423f" midnight-more="#102f2c"
    color "cat6-fg" daylight="#366864" paper="#2b6663" dusk="#8ac3bd" midnight="#7daea8"
    color "cat7-bg" daylight="#ffe2df" paper="#ffc5c0" dusk="#561f1a" midnight="#4a160f" daylight-more="#ffe2df" paper-more="#ffdad6" dusk-more="#561f1a" midnight-more="#4a160f"
    color "cat7-fg" daylight="#905450" paper="#844541" dusk="#d18b81" midnight="#c58275"
    color "cat8-bg" daylight="#f8e7a4" paper="#ffe99c" dusk="#433905" midnight="#403507" daylight-more="#faeaab" paper-more="#ffe99c" dusk-more="#433905" midnight-more="#332a0a"
    color "cat8-fg" daylight="#6f6427" paper="#736518" dusk="#b7a771" midnight="#b4a270"
    color "cat9-bg" daylight="#97e3fc" paper="#91e2fd" dusk="#003543" midnight="#012631" daylight-more="#bff1ff" paper-more="#b2ecff" dusk-more="#003543" midnight-more="#012631"
    color "cat9-fg" daylight="#056277" paper="#016176" dusk="#74a3b5" midnight="#5297b1"
    color "cat10-bg" daylight="#dcf7b6" paper="#e9febe" dusk="#364916" midnight="#2a3e0f" daylight-more="#dcf7b6" paper-more="#e9febe" dusk-more="#324118" midnight-more="#222e10"
    color "cat10-fg" daylight="#556f35" paper="#60733c" dusk="#aabd86" midnight="#99ae78"
    color "cat11-bg" daylight="#d0d7dd" paper="#cdd5db" dusk="#454647" midnight="#38393a" daylight-more="#e4e9ed" paper-more="#dde3e7" dusk-more="#3b3c3d" midnight-more="#2a2b2b"
    color "cat11-fg" daylight="#53595e" paper="#51575c" dusk="#b8b9bb" midnight="#a7a8aa"
    color "cat12-bg" daylight="#e5d7ba" paper="#e7d6bc" dusk="#3b2e19" midnight="#2c2009" daylight-more="#f3e8d4" paper-more="#eee0cb" dusk-more="#3b2e19" midnight-more="#2c2009"
    color "cat12-fg" daylight="#655940" paper="#655741" dusk="#ac9a81" midnight="#9d8b73"

    // The shadow of things that float
    shadow "shadow" daylight="0 1px 2px 0 #16181d0f, 0 6px 20px 0 #16181d14" paper="0 1px 2px 0 #3c2d190f, 0 6px 20px 0 #3c2d1914" dusk="0 1px 2px 0 #0000004d, 0 8px 24px 0 #00000059" midnight="0 0 0 1px #272a31, 0 8px 24px 0 #00000099"
}

// Contrast rules (WCAG, THM-03, UX-04, THM-06). Every text color is checked on every
// background in every theme, except the pairs that are never used, each with its reason.
contrast min=4.5 {
    text "fg" "fg-muted" "fg-subtle" "accent-fg" "on-accent" "on-disabled" "danger" "warning" "success" "st-ns" "st-ip" "st-done" "cat1-fg" "cat2-fg" "cat3-fg" "cat4-fg" "cat5-fg" "cat6-fg" "cat7-fg" "cat8-fg" "cat9-fg" "cat10-fg" "cat11-fg" "cat12-fg"
    backgrounds "bg-canvas" "bg-surface" "bg-raised" "bg-sunken" "bg-hover" "bg-selected" "accent" "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-ip-soft" "st-done-soft" "tint-ns" "tint-ip" "tint-done" "disabled-fill" "cat1-bg" "cat2-bg" "cat3-bg" "cat4-bg" "cat5-bg" "cat6-bg" "cat7-bg" "cat8-bg" "cat9-bg" "cat10-bg" "cat11-bg" "cat12-bg"
    restricted "on-disabled" on="disabled-fill" reason="The words of a main button that cannot be pressed are only ever drawn on its grey fill."
    restricted "on-accent" on="accent danger" reason="On-accent text is only ever drawn on the accent fill, and on the red of the Close button of a window."
    restricted "cat1-fg" on="cat1-bg" reason="Category 1 text is only ever drawn on its own category 1 background."
    restricted "cat2-fg" on="cat2-bg" reason="Category 2 text is only ever drawn on its own category 2 background."
    restricted "cat3-fg" on="cat3-bg" reason="Category 3 text is only ever drawn on its own category 3 background."
    restricted "cat4-fg" on="cat4-bg" reason="Category 4 text is only ever drawn on its own category 4 background."
    restricted "cat5-fg" on="cat5-bg" reason="Category 5 text is only ever drawn on its own category 5 background."
    restricted "cat6-fg" on="cat6-bg" reason="Category 6 text is only ever drawn on its own category 6 background."
    restricted "cat7-fg" on="cat7-bg" reason="Category 7 text is only ever drawn on its own category 7 background."
    restricted "cat8-fg" on="cat8-bg" reason="Category 8 text is only ever drawn on its own category 8 background."
    restricted "cat9-fg" on="cat9-bg" reason="Category 9 text is only ever drawn on its own category 9 background."
    restricted "cat10-fg" on="cat10-bg" reason="Category 10 text is only ever drawn on its own category 10 background."
    restricted "cat11-fg" on="cat11-bg" reason="Category 11 text is only ever drawn on its own category 11 background."
    restricted "cat12-fg" on="cat12-bg" reason="Category 12 text is only ever drawn on its own category 12 background."

    exclude reason="The accent fill carries only on-accent text." {
        text "fg" "fg-*" "accent-fg" "danger" "warning" "success" "st-ns" "st-ip" "st-done"
        on "accent"
    }
    exclude reason="The grey fill of a main button that cannot be pressed carries only its own words, on-disabled." {
        text "fg" "fg-*" "accent-fg" "danger" "warning" "success" "st-ns" "st-ip" "st-done"
        on "disabled-fill"
    }
    exclude reason="Hint text sits on plain surfaces, never on tinted backgrounds." {
        text "fg-subtle"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Accent text sits on plain surfaces or the accent tint, not on status or category tints." {
        text "accent-fg"
        on "danger-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Danger text sits on plain surfaces or the danger tint." {
        text "danger"
        on "accent-soft" "warning-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Warning text sits on plain surfaces or the warning tint." {
        text "warning"
        on "accent-soft" "danger-soft" "success-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Success text sits on plain surfaces or the success tint." {
        text "success"
        on "accent-soft" "danger-soft" "warning-soft" "st-*-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-ns"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ip-soft" "st-done-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-ip"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-done-soft" "cat*-bg"
    }
    exclude reason="Status text sits on plain surfaces or its own status tint." {
        text "st-done"
        on "accent-soft" "danger-soft" "warning-soft" "success-soft" "st-ns-soft" "st-ip-soft" "cat*-bg"
    }

    non-text "border" "border-subtle" "divider" reason="Borders and dividers are decorative lines, not text; they are not part of the text contrast rules."
    non-text "border-control" reason="The edge of a control is a line, not text; it is kept at 3:1 by the `lines` rule below."
    lines min=3 reason="The edge of a box to tick and of the track of a switch is a line a person has to see: WCAG 1.4.11 asks 3:1 against every surface in every theme." {
        colors "border-control"
        on "bg-canvas" "bg-surface" "bg-raised" "bg-sunken"
    }

    non-text "cue" reason="The shadow at the end of a scrolling box is a shade, not text; it is kept clear by the `distinct` rule below and measured in the browser (edge-cue-strength.spec.ts)."
    non-text "edge-high" "hover-line" "scrim" reason="The edge of High, the line of a hovered row and the dimmed page behind a sheet are lines and fills, not text; the lines are kept at 3:1 by the `lines` rules below, the dimmed page by the `dimmed` rule below."

    lines min=3 reason="The ring of a selected or focused row, the line of a hovered row and the edge of its priority carry state on the tint of the row's status group: WCAG 1.4.11 asks 3:1 against it, in every theme and with more contrast." {
        colors "accent" "border-control" "hover-line" "edge-high" "danger"
        on "tint-ns" "tint-ip" "tint-done"
    }

    lines min=1.5 reason="The line under the title of a question and above its answers ends what scrolls between them: it is seen in every theme on the plain surfaces (a line of 1.1:1 was lost in Dusk and Midnight, M5 exit), without being as strong as the edge of a control." {
        colors "divider"
        on "bg-canvas" "bg-surface" "bg-raised" "tint-ns" "tint-ip" "tint-done"
    }

    lines min=3 reason="The edge of High and the line of a hovered row stand on the raised and plain surfaces too (a row of no group, a card of the phone): WCAG 1.4.11 asks 3:1 against every surface." {
        colors "edge-high" "hover-line"
        on "bg-canvas" "bg-surface" "bg-raised"
    }

    lines min=3 reason="The knob of a switch (the quiet words color) stands on its track, the sunken surface: it is seen at 3:1 in every theme, so the off state is no dark knob on a dark track (M5 exit)." {
        colors "fg-muted"
        on "bg-sunken"
    }

    hovered brightness="hover-brightness" min=4.5 min-more=7 reason="A hovered or pressed main button is brightened (`filter: brightness`), which takes contrast away from a light fill and its words: as it is seen then it still reaches 4.5:1, and 7:1 with more contrast (M5 exit, A5)." {
        text "on-accent"
        on "accent"
    }

    stronger min=5 reason="The ID, the hint and the quiet words of a row are small and thin and are read on the tints all day: they reach 5:1 there, not only the 4.5:1 that every text color has (M5 exit, L23: sampled in a picture the ID of a row looked like 4.2:1). With the device setting for more contrast every text color already asks 7:1 (the `more` rule)." {
        text "fg-muted" "fg-subtle"
        on "tint-ns" "tint-ip" "tint-done"
    }

    dimmed scrim="scrim" opacity="opacity-scrim" page="bg-canvas" text="fg" sheet="bg-raised" min-sheet-light=4 min-sheet-dark=1.1 max-text=1.5 reason="Behind a sheet, a menu or Quick search the page is dimmed by the scrim as it is drawn: the sheet stands out from the page (4:1 darker in a light theme, still darker in a dark one, where a black page leaves little to dim) and the text of the page is dim against it (at most 1.5:1), so it cannot be read under the panel (M5 exit, R4)."

    lines min=3 reason="The edge of a swatch of a choice color is drawn in its text color: it is seen at 3:1 on every surface it stands on, in every theme, so a pale fill is never lost on the card (M5 exit)." {
        colors "cat1-fg" "cat2-fg" "cat3-fg" "cat4-fg" "cat5-fg" "cat6-fg" "cat7-fg" "cat8-fg" "cat9-fg" "cat10-fg" "cat11-fg" "cat12-fg"
        on "bg-canvas" "bg-surface" "bg-raised"
    }

    // With the device setting for more contrast.
    more min-text=7 min-line=3 reason="With the device setting for more contrast, the listed text colors reach 7:1 (WCAG AAA) on every background they are used on, and the listed lines reach 3:1 (WCAG 1.4.11) on the plain surfaces. The other text colors, the category colors, keep their AA ratio: they carry words, never meaning alone." {
        text "fg" "fg-muted" "fg-subtle" "accent-fg" "danger" "warning" "success" "st-ns" "st-ip" "st-done" "on-accent" "on-disabled"
        lines "border" "border-subtle"
        line-on "bg-canvas" "bg-surface" "bg-raised"
    }
}

// The three status groups must be told apart at a glance (UX §4.2, R5): the tints differ from each other
// and from the raised card they stand on by a clear difference in color. The contrast ratio only knows
// brightness, and every tint has about the same brightness, because every text color has to be read on it;
// the difference of color is what tells them apart (M5 exit, A7, A8).
distinct min-delta-e-between-states=11 min-delta-e-against-surfaces=7.5 reason="The tints of Not started, In progress and Done differ from each other by at least 11 (delta E) and from the plain card by at least 7.5, in every theme." {
    states "tint-ns" "tint-ip" "tint-done"
    surfaces "bg-canvas" "bg-raised"
}

// Not started is a neutral grey in every theme (UX §4.2): a tint with a hue of its own read as a second blue beside In
// progress in Dusk and Midnight (M5 exit F-A4). Its chroma (C*ab) stays as low as the greys of Daylight and Paper.
distinct max-chroma-of-states=3 reason="The tint of Not started is a neutral grey, not a pale blue next to In progress, in every theme (UX §4.2, M5 exit F-A4)." {
    states "tint-ns"
    surfaces "bg-raised"
}

// A button with a box that cannot be pressed is a grey chip that is told from every surface it stands on (the page, the
// panel, the card, the sunken boxes) and from the fills of a chosen thing (a selected segment, the soft accent) by a clear
// difference of color, in every theme. It is the grey of its theme (Paper's tan chip read as a button to press).
distinct min-delta-e-against-surfaces=7.5 reason="The fill of a button with a box that cannot be pressed differs from the page, the panel, the card and the sunken surface, the selected fill and the soft accent fill by at least 7.5 (delta E), in every theme (M5 exit, F-A9)." {
    states "disabled-fill"
    surfaces "bg-canvas" "bg-surface" "bg-raised" "bg-selected" "accent-soft" "bg-sunken"
}

// The twelve colors of choices, labels and tags are told apart at a glance in every theme, and from the card they stand on:
// the pinks, reds and browns, and blue, sky and gray, were nearly the same fill (M5 exit). The muted text stays readable on
// every fill (cf_04), so the light fills stay light: the warm ones are named for what they look like, Coral and Sand.
distinct min-delta-e-between-states=15 min-delta-e-against-surfaces=7.5 reason="The fills of the twelve choice colors differ from each other by at least 15 (delta E) and from the plain surfaces by at least 7.5, in every theme (M5 exit)." {
    states "cat1-bg" "cat2-bg" "cat3-bg" "cat4-bg" "cat5-bg" "cat6-bg" "cat7-bg" "cat8-bg" "cat9-bg" "cat10-bg" "cat11-bg" "cat12-bg"
    surfaces "bg-canvas" "bg-surface" "bg-raised"
}

// The edge of High is told from the edge of Critical (the red of `danger`) at a glance.
distinct min-delta-e-between-states=31 min-delta-e-against-surfaces=30 reason="The orange edge of High differs from the red edge of Critical by at least 31 (delta E), and each differs from the plain page by at least 30, in every theme (M5 exit, L24)." {
    states "danger" "edge-high"
    surfaces "bg-canvas"
}

// The shadow at the end of a scrolling box (the color it is cast in) is far from the plain surfaces it falls on, in every theme.
distinct min-delta-e-against-surfaces=25 reason="The color of the shadow at the end of a scrolling box differs from the plain surfaces it falls on by at least 25 (delta E), in every theme, so it cannot fade to nothing in Dusk and Midnight again (M5 exit, round 8)." {
    states "cue"
    surfaces "bg-canvas" "bg-surface" "bg-raised"
}

// Hovered and selected rows must stay visible.
distinct min-against-surfaces=1.08 min-between-states=1.04 reason="Hovered and selected rows must stay visible: they differ from every surface by at least 1.08:1, and from each other by at least 1.04:1, in every theme." {
    states "bg-hover" "bg-selected"
    surfaces "bg-canvas" "bg-surface" "bg-raised"
}

// Bold (UX §7.3, STY-BOLD): only these rules may set `$weight-bold`, one line for each selector. A role is
// what the bold says: `issue-title` (24), `title` (the title of a page, a window or a card, 20), `section`
// (the heading of a part of a page, 16), `priority` (the word of a Critical or High priority), `own`
// (what a person wrote in bold in a text). A new bold needs a role from this list, and a role needs UX §7.3.
bold reason="Bold is kept for the titles, the headings of sections, the words of the two highest priorities and what a person wrote in bold (UX §7.3); everything else is regular, so bold still means something." {
    selector "issue-title" role="issue-title"
    selector "window.title" role="title"
    selector "confirm.title" role="title"
    selector "shell.title" role="title"
    selector "side-panel.title" role="title"
    selector "top-bar.title" role="title"
    selector "card.heading" role="title"
    selector "bottom-sheet.title" role="title"
    selector "issue-details.heading" role="section"
    selector "issue-section.title" role="section"
    selector "form-section.title" role="section"
    selector "list-panel.title" role="section"
    selector "access.topic" role="section"
    selector "card.topic" role="section"
    selector "notification-group.head" role="section"
    selector "search-help.title" role="section"
    selector "priority[variant=critical]" role="priority"
    selector "priority[variant=high]" role="priority"
    selector "[data-part=markdown] h1" role="own"
    selector "[data-part=markdown] h2" role="own"
    selector "[data-part=markdown] h3" role="own"
    selector "[data-part=markdown] h4" role="own"
    selector "[data-part=markdown] h5" role="own"
    selector "[data-part=markdown] h6" role="own"
    selector "[data-part=markdown] strong" role="own"
    selector "[data-part=markdown] b" role="own"
}

// ───────────── Mixins ─────────────
//
// Lines that several rules share. `use "name"` puts them in the place of the line.

// The line of the ring: the width and the color of every outline that says "here".
mixin "ring-line" {
    outline "$ring-width solid $accent"
}

// The soft fill and the text color of a status group: the one block that the status pill, the big
// status button, the box of the workflow drawing and the docs' pills all use (M4-F70).
mixin "status-soft-not-started" {
    background "$st-ns-soft"
    color "$st-ns"
}

mixin "status-soft-in-progress" {
    background "$st-ip-soft"
    color "$st-ip"
}

mixin "status-soft-done" {
    background "$st-done-soft"
    color "$st-done"
}

// The clear outline inside the edge that both ring mixins of a row share, written once.
mixin "ring-clear" {
    outline "$ring-width solid transparent"
    outline-offset "calc($ring-width * -1)"
}

// The ring of a row that is selected or current: inside the edge, drawn by a shadow, so it is even on all
// four sides and the colored edge of a priority stays whole. The clear outline is for forced colors, which
// drop shadows and show an outline in a color of the system; it also stops the outline of the focus that
// the whole page has from being drawn outside the row. A shadow list cannot be put together from two
// mixins, so the accent ring is written here and again in `ring-keyboard`.
mixin "ring-row" {
    box-shadow "inset 0 0 0 $ring-width $accent"
    use "ring-clear"
}

// The keyboard focus on a row: the accent ring and, inside it, a second ring in the text color, so the focus
// is told from a selected or a current row on every tint, and between them a gap of one line in the color of
// the raised surface, so the two do not read as one heavy box (M5 exit, L26). All are shadows, even on all four sides.
mixin "ring-keyboard" {
    box-shadow "inset 0 0 0 $ring-width $accent, inset 0 0 0 calc($ring-width + $border-width) $bg-raised, inset 0 0 0 calc($ring-width * 2 + $border-width) $fg"
    use "ring-clear"
    // Forced colors drop the shadows: the focus is a double outline inside the edge of the row (M5 exit, A16).
    forced {
        outline-style double
        outline-width "calc($ring-width * 2)"
        outline-offset "calc($ring-width * -2)"
    }
}

// The ring around what has the focus: the one definition of how the focus looks.
mixin "ring" {
    use "ring-line"
    outline-offset "$ring-offset"
    // Forced colors draw the focus as a double outline: it is two lines, so it is told from a ring that is only a
    // color of the system (M5 exit, A16). A double line is drawn from three widths of line.
    forced {
        outline-style double
        outline-width "calc($ring-width * 2)"
    }
}

// Words that are less important than their neighbours.
mixin "quiet-text" {
    color "$fg-muted"
    font-size "$fs-base"
}

// A control that is waiting for an answer.
mixin "busy" {
    cursor progress
    opacity "$opacity-busy"
}

// The fill of a box or a track that is switched on.
mixin "chosen" {
    border-color "$accent"
    background "$accent"
}

// The ring drawn inside the edge of what has the focus, for rows that fill their box.
mixin "ring-inside" {
    use "ring-line"
    outline-offset "calc($ring-width * -1)"
}

// The page of the menu or tree that is open now.
mixin "current-item" {
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

// The chosen or current item: forced colors drop fills, so the item gets an outline to be seen.
mixin "marked" {
    forced {
        use "ring-line"
    }
}

// The edge of anything that is pressed or typed in: a touch target with a line and a raised fill.
mixin "control-box" {
    box-sizing border-box
    min-height "$size-control"
    border "$border-width solid $border-control"
    border-radius "$r-ctl"
    background "$bg-raised"
}

// The hint under a control or beside a row of a list: 13 and muted (UX §7.3: "13 field names, times, counts,
// hints"). The hint of a field and of a picker are this one.
mixin "control-hint" {
    font-size "$fs-sm"
    color "$fg-muted"
    // A hint or a label is one to three lines: balanced, so its last line is never one word alone ("a good password."),
    // where the `pretty` of the page still left one at some widths. The one wrap of every hint and label.
    text-wrap balance
}

// The name of a control, above it: the one muted label of every select, field and group of choices (UX §7.3: 13,
// muted). It is the hint, as regular weight.
mixin "control-label" {
    use "control-hint"
    font-weight "$weight-regular"
}

// A box that is typed in: the field, the box that takes a key, the search box.
mixin "input-box" {
    use "control-box"
    width "100%"
    padding "$space-2 $pad-control"
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-ui"
}

// A row of a list that is picked from: the people, the results of quick search.
mixin "pick-row" {
    display flex
    flex-direction column
    // A row of one line stands in the middle of its height, as a row of two lines does (M2 07).
    justify-content center
    gap "$space-1"
    box-sizing border-box
    min-height "$size-control"
    padding "$space-2 $space-3"
    color "$fg"
    text-decoration none
    cursor pointer
}

// What stands in a button: its icon and its words on one line, in the middle, at the gap of a button.
mixin "button-content" {
    display inline-flex
    align-items center
    justify-content center
    gap "$space-2"
}

// The size and weight of the words of a button, whatever their color.
mixin "button-words" {
    font-size "$fs-ui"
    font-weight "$weight-regular"
    text-decoration none
}

// The words of a button, a menu item or a branch of the tree.
mixin "menu-text" {
    color "$fg"
    use "button-words"
}

// Facts under a name, at the start edge: the row of a list on a phone (a field, a label), whatever the facts say.
mixin "stacked-facts" {
    flex-direction column
    align-items flex-start
    justify-content center
}

// The shadow at an end of a scrolling box: a line of no size that stays at the edge and casts a soft shadow over what scrolls
// under it, there only while the box is scrolled away from that end (the scroll position drives it, `cue-in` and `cue-out`).
// A part says the axis it scrolls along (`edge-block`, `edge-inline`) and the end it is at (`edge-from-start`, `edge-from-end`).
// Where the browser has no scroll-driven animation the box keeps the old cue (`scroll-cue`, under).
mixin "edge-shadow" {
    content "\"\""
    position sticky
    z-index "$z-raised"
    display block
    flex none
    opacity 0
    pointer-events none
    box-shadow "0 0 $space-3 $border-width $cue"
    animation-fill-mode both
    animation-timing-function linear
}

// The box scrolls down: the line is as wide as the box and has no height.
mixin "edge-block" {
    use "edge-shadow"
    height 0
    animation-timeline "scroll(nearest block)"
}

// The box scrolls sideways: the line is as high as the box and has no width.
mixin "edge-inline" {
    use "edge-shadow"
    width 0
    align-self stretch
    animation-timeline "scroll(nearest inline)"
}

// The line at the start of the box: there while the box is scrolled away from its start.
mixin "edge-from-start" {
    animation-name "cue-in"
    animation-range "0% $space-3"
}

// The line at the end of the box: there while the box is scrolled away from its end.
mixin "edge-from-end" {
    animation-name "cue-out"
    animation-range "calc(100% - $space-3) 100%"
}

// A box that scrolls says there is more above and below: a soft shadow at each edge that has more behind it, and none
// where the end is reached (two covers of the colour of the box scroll with the content and hide the shadows). A box
// of another color than the raised surface sets `--cue-cover` to its own.
mixin "scroll-cue" {
    --cue-cover "$bg-raised"
    background-image "linear-gradient(var(--cue-cover), var(--cue-cover)), linear-gradient(var(--cue-cover), var(--cue-cover)), linear-gradient(color-mix(in srgb, $cue 50%, transparent), transparent), linear-gradient(to top, color-mix(in srgb, $cue 50%, transparent), transparent)"
    background-position "top, bottom, top, bottom"
    background-size "100% $space-3, 100% $space-3, 100% $space-1, 100% $space-1"
    background-repeat no-repeat
    background-attachment "local, local, scroll, scroll"
}

// The column the pages are drawn in, centered; what is drawn at its bottom (the offers to undo) uses it too.
mixin "page-column" {
    width "100%"
    max-width "$size-page"
    min-width 0
    margin 0 auto
}

// What the page is drawn in: the centered column, its things under each other with the page gutter between them.
mixin "page-body" {
    use "page-column"
    display flex
    flex-direction column
    gap "$size-page-gutter"
}

// The focus view takes the whole width that the narrowed sidebar leaves.
mixin "page-column-wide" {
    max-width none
}

// Room for the focus ring inside a box that scrolls (it clips what is outside it): padding of the
// size of the ring (also for scrolling), and no margin above or below (a list would get the browser's own).
mixin "ring-room" {
    use "ring-scroll-room"
    margin-block 0
    padding "$ring-room"
}

// What the focus scrolls into view keeps that room from the edge of a box that scrolls: the ring is not cut there.
mixin "ring-scroll-room" {
    scroll-padding "$ring-room"
}

// With the ring room: the box reaches out by the same size at the sides, so the text inside stays on
// the edge of the boxes above and below it. Only for boxes that ask for it.
mixin "ring-room-flush" {
    margin-inline "calc($ring-room * -1)"
}

// What floats over or stands out of the page: a card, a sheet, a panel, an offer.
mixin "floating-box" {
    box-sizing border-box
    border "$border-width solid $border"
    background "$bg-raised"
    box-shadow "$shadow"
}

// A box with no frame, no padding and no fill: what is inside it stands directly on the page (a card or a group on a phone).
mixin "frameless" {
    padding 0
    border-width 0
    border-radius 0
    background transparent
    box-shadow none
}

// A quiet box on a surface: an item of a list.
mixin "surface-box" {
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}

// A box that is sunk into the page: a key, a code, a sample.
mixin "sunken-box" {
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-sunken"
}

// A group of fields without the browser's frame.
mixin "fieldset-reset" {
    min-width 0
    margin 0
    padding 0
    border 0
}

// A list without bullets and without the browser's indent.
mixin "list-reset" {
    margin 0
    padding 0
    list-style none
}

// Words and details under each other, which break anywhere when they are long.
mixin "column-wrap" {
    use "column-tight"
    overflow-wrap anywhere
}

// A row that is pressed: a mark or an icon and its words, as high as a finger.
mixin "touch-row" {
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-control"
    cursor pointer
}

// A link that is a target a finger can hit, and still reads as a link in a line of text.
mixin "touch-link" {
    display inline-flex
    align-items center
    min-height "$size-control"
}

// The name of a tab of a row of tabs: the editor of text, the sections of a form.
mixin "tab-label" {
    padding "$space-2 $space-3"
    min-height "$size-control"
    box-sizing border-box
    color "$fg-muted"
    font-size "$fs-md"
    font-weight "$weight-regular"
    cursor pointer
    border-bottom "$space-1 solid transparent"
}

// A button that is only its words.
mixin "bare-button" {
    border 0
    background transparent
    font-family "$font-ui"
    cursor pointer
}

// A few lines of words in a box.
mixin "note-box" {
    display flex
    flex-direction column
    gap "$space-1"
    margin 0
    padding "$space-3"
}

// Lines under each other with a little room between them.
mixin "column-tight" {
    display flex
    flex-direction column
    gap "$space-1"
    min-width 0
}

// Sentences or details under each other, in the line height of body text.
mixin "quiet-column" {
    display flex
    flex-direction column
    gap "$space-2"
    margin 0
    line-height "$lh-body"
}

// The bar at the top of a phone screen, the same for a page and for a window that is a screen (M5 exit, O13): the height
// of the bar, the room for the notch above it, the canvas behind it, its parts level.
mixin "phone-bar" {
    display flex
    align-items center
    gap "$space-3"
    box-sizing border-box
    min-height "$size-bar"
    padding "calc($space-2 + env(safe-area-inset-top)) $space-4 $space-2"
    background "$bg-canvas"
}

// A button that holds text hangs back by its own padding, so its text stands on the start edge of
// the text around it (R1). Every such button has the padding `pad-control`.
mixin "hang-start" {
    margin-inline-start "calc(-1 * $pad-control)"
}

// The buttons that answer a question or end a form (R6): quiet buttons stand on the start edge
// (R1), the one filled button at the end. On a phone they are stacked, the main one first.
mixin "answer-row" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content flex-end
    gap "$space-3"
}

// Text for screen readers only: out of sight, still read.
mixin "hidden-text" {
    position absolute
    width "$border-width"
    height "$border-width"
    margin "calc($border-width * -1)"
    padding 0
    overflow hidden
    border 0
    clip-path "inset(50%)"
    white-space nowrap
}

// ───────────── Animations ─────────────

keyframes "fade" {
    from {
        opacity 0
    }
}

// The shadows at the ends of a scrolling box that has boxes of its own inside (the question Move): they follow the
// scroll position, so a shadow is there only where more is behind it.
keyframes "cue-in" {
    from {
        opacity 0
    }
    to {
        opacity 1
    }
}

keyframes "cue-out" {
    from {
        opacity 1
    }
    to {
        opacity 0
    }
}

keyframes "from-bottom" {
    from {
        transform "translateY(100%)"
    }
}

keyframes "from-start" {
    from {
        transform "translateX(-100%)"
    }
}

keyframes "from-end" {
    from {
        transform "translateX(100%)"
    }
}

// The placeholder lines pulse while the text is on its way.
keyframes "pulse" {
    from {
        opacity "$opacity-faint"
    }
}

// ───────────── The page ─────────────
//
// `base` rules style elements of the page frame. Everything else is a `part`.

// The page frame is at least as high as the window, so its footer sits at the bottom.
base "html, body, #root" {
    height "100%"
}

// No word alone on the last line of any text (M5 exit: titles, notifications, hints, intros): every element inherits it,
// and a part that must stay on one line says so with its own `white-space`.
base "body" {
    margin 0
    background "$bg-canvas"
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-md"
    text-wrap pretty
}

// Headings and table heads come from the browser in bold; here they are regular, and the parts the
// `bold` list names (UX §7.3, STY-BOLD) turn bold on again.
base "h1" "h2" "h3" "h4" "h5" "h6" "th" "strong" "b" "optgroup" {
    font-weight "$weight-regular"
}

// What a person types wraps as typed: the wrapping of the page that keeps a last word company would move it while typing.
base "textarea" "[contenteditable]" {
    text-wrap wrap
}

// The rule React Aria would add itself: pressing a control does not wait for a double tap.
base "[data-react-aria-pressable]" {
    touch-action "pan-x pan-y pinch-zoom"
}

base ":focus-visible" {
    use "ring"
}

// ───────────── Muted text ─────────────

// Text that is less important than its neighbours (a hint, an empty list), and the introduction of a card: the one
// introduction of every settings page and its sections, small and muted at the full width of the card (UX §5, L3).
part "muted" "card.intro" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
    line-height "$lh-body"
}

// Short texts of one to three lines (an introduction, a line of a preview, the title of an answer) are balanced, so a
// last line is never one word alone ("in turn.", "description", "back"), where the `pretty` of the page still left one
// at some widths. The help of a box is a hint and is balanced by `control-hint`. The words of a switch keep the
// `pretty` of the page: balanced, a label that nearly fits one line ("Two-step sign-in for everybody") was cut in two
// at the hyphen of "sign-in".
part "card.intro" "access.preview-line" "access.subheading" {
    text-wrap balance
}

// Words for screen readers only: the name of a column that holds only an icon.
part "visually-hidden" {
    use "hidden-text"
}

// A button with a box that cannot be pressed: a flat grey chip with quiet words, its edge its fill (F-A9). Forced colors
// draw its edge in the colour of words that cannot be used.
mixin "disabled-chip" {
    border-color "$disabled-fill"
    background "$disabled-fill"
    color "$on-disabled"
    cursor default
    forced {
        border-color GrayText
    }
}

// ───────────── Button (packages/ui: Button, IconButton) ─────────────
//
// The variants come before the states, so that a hovered quiet button is hovered.

part "button" {
    use "button-content"
    use "control-box"
    padding "$space-1" "$pad-control"
    use "menu-text"
    font-family "$font-ui"
    line-height "$lh-tight"
    text-align center
    cursor pointer
}

// A button with a box that cannot be pressed is the flat grey chip of the main one below (its fill and quiet words), so
// it never reads as an outlined button that only fades (M5 exit F-A9: Save search looked active while it waited for a
// mistake to be fixed). It comes before the looks and has no more weight than they: a look without a box (quiet, item)
// keeps none and fades instead (the rule after the looks).
part "button[disabled]" {
    use "disabled-chip"
}

part "button[variant=wide]" {
    width "100%"
}

// A button with only an icon: as wide as it is high.
part "button[variant=square]" {
    width "$size-control"
    padding 0
}

part "icon-button.hit" {
    display inline-flex
    align-items center
    justify-content center
}

part "button[variant=primary]" {
    border-color "$accent"
    background "$accent"
    color "$on-accent"
    // Forced colors keep the label readable: the face and the text of a button, and an edge in the text color.
    forced {
        border-color ButtonText
        background ButtonFace
        color ButtonText
    }
}

part "button[variant=quiet]" {
    border-color transparent
    background transparent
    color "$accent-fg"
    use "hang-start"
    // Forced colors draw the edge that is clear otherwise, so the button no longer hangs back into its neighbour.
    forced {
        margin-inline-start 0
    }
}

// One start edge (R1) and one end edge: a text button hangs back by its own padding, so its words
// stand on the edge of the text around it wherever the button is: first in a row, alone on a line
// that wrapped, or under another button. Where it ends a row it hangs over the end edge by the
// same amount (the review of M4, A3). A row that stands beside text on a computer takes the hang
// away from its quiet buttons (the rule below). This is the one rule; no screen hangs a button back
// by itself.
part "button[variant=quiet]:last-child" {
    margin-inline-end "calc(-1 * $pad-control)"
    forced {
        margin-inline-end 0
    }
}

// An icon has no padding to hang back by.
part "button[variant=quiet][variant=square]" {
    margin-inline 0
}

// Where the buttons stand under text on a phone and beside it on a computer (a file, an item of a list):
// a quiet one hangs back by its padding on a phone only.
part "files.actions button[variant=quiet]" "item.actions button[variant=quiet]" {
    margin-inline-start "$size-phone-hang"
    forced {
        margin-inline-start 0
    }
}

// An entry of a list of actions (the status list, *More*): its words start at the start edge, and it
// has no box until it is pointed at.
part "button[variant=item]" {
    justify-content flex-start
    border-color transparent
    background transparent
    color "$fg"
    text-align start
}

part "button[variant=danger]" {
    border-color "$danger"
    color "$danger"
}

part "button[hovered]" {
    background "$bg-hover"
}

part "button[pressed]" {
    background "$bg-selected"
}

// A button that shows something is open (Customize while its panel is): chosen like a choice of Spacing.
part "button[state=current]" {
    border-color "$accent"
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

// A text button or an entry of a list that cannot be pressed has no box: it fades, its words stay its own color.
part "button[variant=quiet][disabled]" "button[variant=item][disabled]" {
    opacity "$opacity-disabled"
}

// A main button that cannot be pressed yet is a flat grey chip (the color of the dividers) with quiet words and no
// fading: in the dark themes the sunken fill read like an enabled outlined button, and a faded fill like the card. Not a pale copy of the
// filled one, whose white words are hard to read (the review of M4, A14), not an outlined button with grey
// words (the review of M5, S20), and not the soft accent fill either, which a selected segment or menu item
// has and which reads as "chosen". It has no edge of its own (its edge is its fill). The dashed edge
// belongs to the places to drop things on and to *Not started*.
part "button[variant=primary][disabled]" "button[variant=danger][disabled]" {
    use "disabled-chip"
}

part "button[state=busy]" {
    use "busy"
}

part "button[focus-visible]" {
    use "ring"
}

part "button[variant=primary][hovered]" "button[variant=primary][pressed]" {
    background "$accent"
    filter "brightness($hover-brightness)"
}

part "button[variant=danger][hovered]" "button[variant=danger][pressed]" {
    background "$danger-soft"
}

// ───────────── Fields (TextField, SearchField, SelectField) ─────────────

part "field" {
    use "column-tight"
}

part "field.label" {
    use "control-label"
}

// The hint under a control: of a box, and of a setting that is a switch or a group of choices, the same size, colour
// and wrap (control-hint) everywhere.
part "field.description" "settings.help" {
    use "control-hint"
    line-height "$lh-body"
}

part "settings.help" {
    margin 0
}

// A value longer than its box ends in an ellipsis instead of running under the edge of the box (the
// review of M4: "Alder Street Baker|y" in the Details).
// One height for a box of one line and a choice (a select ignores the line height and would be 2 px
// taller): labels and boxes side by side line up (the review of M4).
part "field.input" {
    use "input-box"
    height "$size-control"
    padding-block 0
    line-height "$lh-body"
    text-overflow ellipsis
}

part "field.input[variant=multiline]" {
    height auto
    padding-block "$space-2"
    resize vertical
}

part "field.input[focused]" "field.input:focus-visible" {
    use "ring-line"
    outline-offset 0
    border-color "$accent"
}

part "field.input[invalid]" {
    border-color "$danger"
}

part "field.input[state=busy]" {
    use "busy"
}

part "field.input[disabled]" {
    opacity "$opacity-disabled"
}

part "field.error" {
    font-size "$fs-base"
    color "$danger"
    line-height "$lh-body"
}

// ───────────── Alert ─────────────

part "alert" {
    box-sizing border-box
    padding "$space-3 $space-4"
    border "$border-width solid $border"
    border-left-width "$space-1"
    border-radius "$r-ctl"
    background "$bg-surface"
    color "$fg"
    font-size "$fs-md"
    line-height "$lh-text"
    // A long word (an address) moves to the next line whole and is cut only when it is longer than a line, not
    // before its last letter (M5 exit, O8).
    overflow-wrap break-word
}

// An error has a full border and its icon, not the thick red edge of Critical on a row (R5).
part "alert[variant=danger]" {
    border-color "$danger"
    border-left-width "$border-width"
    background "$danger-soft"
}

part "alert[variant=success]" {
    border-color "$success"
    background "$success-soft"
}

part "alert[variant=warning]" {
    border-color "$warning"
    background "$warning-soft"
}

part "alert[variant=info]" {
    border-color "$accent"
    background "$accent-soft"
}

// ───────────── Link ─────────────

part "link" {
    color "$accent-fg"
    font-weight "$weight-regular"
    text-decoration underline
    text-underline-offset "$space-1"
    cursor pointer
    forced {
        color LinkText
    }
}

part "link[hovered]" {
    text-decoration-thickness "$ring-width"
}

part "link[focus-visible]" {
    use "ring"
}

part "link[current]" {
    color "$fg"
    text-decoration none
}

// The name of a row that opens a page: plain words like every other row, and the whole row is the link (its box
// is the room of the row, which is the first thing above it that is placed).
part "link[variant=row]" {
    color "$fg"
    text-decoration none
}

part "link[variant=row]::after" {
    content "\"\""
    position absolute
    inset 0
}

part "link[variant=row][focus-visible]" {
    outline none
}

part "link[variant=row][focus-visible]::after" {
    use "ring-inside"
}

// ───────────── Switch ─────────────

part "switch" {
    use "touch-row"
    color "$fg"
    font-size "$fs-md"
    font-weight "$weight-regular"
}

part "switch.track" {
    flex none
    box-sizing border-box
    width "calc($space-4 * 2 + $space-1 * 2)"
    height "$space-5"
    padding "$space-1"
    border "$border-width solid $border-control"
    border-radius "$r-card"
    background "$bg-sunken"
}

part "switch.thumb" {
    display block
    width "$space-4"
    height "$space-4"
    border-radius "$r-card"
    background "$fg-muted"
    transform "translateX(0)"
    forced {
        background ButtonText
    }
}

part "switch[selected] switch.track" {
    use "chosen"
}

part "switch[selected] switch.thumb" {
    background "$on-accent"
    transform "translateX($space-4)"
}

part "switch[focus-visible] switch.track" {
    use "ring"
}

// ───────────── Checkbox ─────────────

part "checkbox" {
    use "touch-row"
    color "$fg"
    font-size "$fs-md"
}

part "checkbox.box" {
    position relative
    flex none
    box-sizing border-box
    width "$space-5"
    height "$space-5"
    border "$border-width solid $border-control"
    border-radius "$r-ctl"
    background "$bg-raised"
}

// The box to tick of a row has the edge of the quiet words, a strong line on every tint (the edge of a control
// was hard to see on the dark In progress tint, M5 exit).
part "list-row checkbox.box" {
    border-color "$fg-muted"
}

part "checkbox[hovered] checkbox.box" {
    background "$bg-hover"
}

part "checkbox[selected] checkbox.box" {
    use "chosen"
}

// Some, not all, are ticked (the head of a list): the box is filled and holds a dash.
part "checkbox[indeterminate] checkbox.box" {
    use "chosen"
}

part "checkbox[indeterminate] checkbox.box::after" {
    content "\"\""
    position absolute
    top "50%"
    left "$space-1"
    width "$space-3"
    height 0
    border-top "$ring-width solid $on-accent"
    transform "translateY(-50%)"
}

// The tick: two sides of a box, turned.
part "checkbox[selected] checkbox.box::after" {
    content "\"\""
    position absolute
    top "$space-1"
    left "$space-2"
    width "$space-1"
    height "$space-3"
    border solid "$on-accent"
    border-width 0 "$ring-width" "$ring-width" 0
    transform "rotate($angle-tick)"
}

part "checkbox[focus-visible] checkbox.box" {
    use "ring"
}

part "checkbox[disabled]" {
    opacity "$opacity-disabled"
    cursor default
}

part "checkbox.label" {
    min-width 0
    overflow-wrap anywhere
}

// ───────────── ChoiceGroup ─────────────

part "choice-group" {
    use "fieldset-reset"
}

part "choice-group.legend" {
    use "control-label"
    padding 0
    margin-bottom "$space-1"
}

part "choice-group.choices" {
    display flex
    flex-wrap wrap
    gap "$space-2"
}

part "choice-group.choice" {
    position relative
    display inline-flex
}

part "choice-group.input" {
    position absolute
    inset 0
    margin 0
    opacity 0
    cursor pointer
}

part "choice-group.label" {
    display inline-flex
    align-items center
    box-sizing border-box
    min-height "$size-control"
    padding 0 "$pad-control"
    border "$border-width solid $border-control"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-ui"
}

// The tile of the theme picker (a sample and a name) is chosen, pointed at and focused like a label.
part "theme-picker.tile" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-2"
    border "$border-width solid $border"
    border-radius "$r-card"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-md"
}

// Forced colors drop background colors, so the chosen one needs an outline to be seen.
part "choice-group.input:checked + choice-group.label" "choice-group.input:checked + theme-picker.tile" {
    border-color "$accent"
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

part "choice-group.input:hover + choice-group.label" "choice-group.input:hover + theme-picker.tile" {
    background "$bg-hover"
}

part "choice-group.input:focus-visible + choice-group.label" "choice-group.input:focus-visible + theme-picker.tile" {
    use "ring"
}

// The choices stand side by side while they all fit on one line; when they do not (the component measures it) they stand
// under each other, as wide as the room, and never as ragged buttons on two lines: one rule for every group.
part "choice-group.choices[variant=stacked]" {
    flex-direction column
    align-items stretch
}

part "choice-group.choices[variant=stacked] choice-group.label" {
    flex 1
}

// Many small choices (the colors) stand in a grid that wraps, several in a row, instead of one row or one column.
part "choice-group.choices[variant=grid]" {
    display grid
    grid-template-columns "repeat(auto-fill, minmax($size-swatch, 1fr))"
}

part "choice-group.choices[variant=grid] choice-group.choice" {
    display flex
}

// ───────────── Overlay (sheets, menus, quick search) ─────────────
//
// The variant says where it opens from: center, bottom, start or top.

part "overlay" {
    position fixed
    inset 0
    z-index "$z-overlay"
    display flex
    overflow hidden
}

// The page behind stays in sight but dimmed, so a sheet is clearly a layer above it.
part "overlay::before" {
    content "\"\""
    position absolute
    inset 0
    background "$scrim"
    opacity "$opacity-scrim"
    forced {
        background Canvas
    }
}

part "overlay[variant=center]" {
    align-items flex-start
    justify-content center
    padding "$space-6 $space-4"
}

part "overlay[variant=bottom]" {
    align-items flex-end
}

// A question that needs an answer, and a form that takes the whole screen of a phone.
part "overlay[variant=question]" {
    align-items center
    justify-content center
    padding "$space-4"
    overflow-y auto
}

part "overlay[variant=full]" {
    align-items stretch
}

part "overlay[variant=start]" {
    justify-content flex-start
}

part "overlay[variant=end]" {
    justify-content flex-end
}

part "overlay[variant=top]" {
    align-items flex-start
}

part "overlay.modal" {
    position relative
    use "floating-box"
    display flex
    flex-direction column
    min-width 0
    color "$fg"
}

part "overlay.modal[variant=center]" {
    width "100%"
    max-width "$size-palette"
    max-height "100%"
    border-radius "$r-card"
}

part "overlay.modal[variant=question]" {
    width "100%"
    max-width "$size-dialog"
    max-height "100%"
    border-radius "$r-card"
}

part "overlay.modal[variant=full]" {
    width "100%"
    max-width none
    border 0
    border-radius 0
}

part "overlay.modal[variant=bottom]" {
    width "100%"
    max-height "$size-sheet-share"
    border-radius "$r-card $r-card 0 0"
}

// The menu that slides in on a tablet is as wide as what it holds, the sidebar of a computer, so its items keep the room
// they have there (*Quick search* beside its keys on one line, M2 15).
part "overlay.modal[variant=start]" {
    width fit-content
    max-width "$size-sheet-share"
    height "100%"
    border-radius "0 $r-card $r-card 0"
}

// A panel at the end of the screen, beside the page (the help of the search bar).
part "overlay.modal[variant=end]" {
    width "$size-side-panel"
    max-width "100%"
    height "100%"
    border-radius "$r-card 0 0 $r-card"
}

part "overlay.modal[variant=top]" {
    width "100%"
    max-height "100%"
    border-radius "0 0 $r-card $r-card"
}

// The shadows at the ends of every box that scrolls its own content and has more behind it: a menu or a sheet taller than the
// screen, the options of a picker, the rows of the list of issues (a box of its own, as high as the page lets it be), the body
// of a window or of a question, the list of people, the help of the search, the body of a sheet of a phone and the offers
// of Advanced search and the body of the side panel (L6, L7). The scroll position drives them, where the browser has scroll timelines.
// A box that holds its rows or fields back from its edge (a ring room, a padding) moves them in its own rule.
part "overlay.dialog::before" "picker.options[variant=list]::before" "list-scroll::before" "window.body::before" "confirm.body::before" "people::before" "search-panel::before" "bottom-sheet search-bar::before" "search-suggestions::before" "side-panel.body::before" "list-panel::before" {
    supports "(animation-timeline: scroll())" {
        use "edge-block"
        use "edge-from-start"
        top 0
    }
}

part "overlay.dialog::after" "picker.options[variant=list]::after" "list-scroll::after" "window.body::after" "confirm.body::after" "people::after" "search-panel::after" "bottom-sheet search-bar::after" "search-suggestions::after" "side-panel.body::after" "list-panel::after" {
    supports "(animation-timeline: scroll())" {
        use "edge-block"
        use "edge-from-end"
        bottom 0
    }
}

part "overlay.dialog" {
    display flex
    flex 1
    flex-direction column
    min-height 0
    overflow-y auto
    outline none
}

part "overlay[entering]::before" {
    animation "fade $motion-base $ease-out"
}

part "overlay[exiting]::before" {
    animation "fade $motion-base $ease-in reverse"
}

part "overlay.modal[variant=bottom][entering]" {
    animation "from-bottom $motion-base $ease-out"
}

part "overlay.modal[variant=bottom][exiting]" {
    animation "from-bottom $motion-base $ease-in reverse"
}

part "overlay.modal[variant=start][entering]" {
    animation "from-start $motion-base $ease-out"
}

part "overlay.modal[variant=start][exiting]" {
    animation "from-start $motion-base $ease-in reverse"
}

part "overlay.modal[variant=end][entering]" {
    animation "from-end $motion-base $ease-out"
}

part "overlay.modal[variant=end][exiting]" {
    animation "from-end $motion-base $ease-in reverse"
}

part "overlay.modal[variant=center][entering]" "overlay.modal[variant=top][entering]" "overlay.modal[variant=question][entering]" "overlay.modal[variant=full][entering]" {
    animation "fade $motion-fast $ease-out"
}

part "overlay.modal[variant=center][exiting]" "overlay.modal[variant=top][exiting]" "overlay.modal[variant=question][exiting]" "overlay.modal[variant=full][exiting]" {
    animation "fade $motion-fast $ease-in reverse"
}

// ───────────── SearchPicker ─────────────
//
// Two looks, set on each part as its variant: `list` (plain rows that scroll) and `boxed` (every
// choice a bordered box).

part "picker" {
    display flex
    flex-direction column
    gap "$space-3"
    use "fieldset-reset"
}

part "picker.legend[variant=list]" {
    use "control-label"
    margin-block-end "$space-3"
    padding 0
}

part "picker.legend[variant=boxed]" {
    use "control-label"
    padding 0
}

// Whole rows: seven rows and the gaps between them (the padding, for the focus ring, is added around), so the last row
// that shows is never cut in half (the review of M5, S1). A cue at the foot says there is more.
part "picker.options[variant=list]" {
    display flex
    flex-direction column
    gap "$size-option-gap"
    // The seven rows are the room inside; the padding for the ring is around them, so the last row has room below it.
    box-sizing content-box
    max-height "calc($size-control * 7 + $size-option-gap * 6)"
    use "ring-room"
    list-style none
    overflow-y auto
}

// The gap of the rows is taken back, so the lines at the ends take no room.
part "picker.options[variant=list]::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $ring-room)"
        margin-block-end "calc(-1 * $size-option-gap)"
    }
}

part "picker.options[variant=list]::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $ring-room)"
        margin-block-start "calc(-1 * $size-option-gap)"
    }
}

// Rows that are one button each reach out by the ring room, so their text stands on the edge of the
// box above them (S16); the lists of radio buttons stay as they were.
part "picker.options[variant=list]:has(picker.choice)" {
    use "ring-room-flush"
}

part "picker.option[variant=list]" {
    use "touch-row"
    padding 0 "$space-2"
    border-radius "$r-ctl"
}

part "picker.option[variant=list]:hover" {
    background "$bg-hover"
}

part "picker.option[variant=list]:has(picker.input:focus-visible)" {
    use "ring"
}

part "picker.option[variant=boxed]" {
    use "touch-row"
    padding "$space-1 $space-3"
    use "surface-box"
}

// A radio is drawn by the theme, not by the browser (its own blue, and a grey dot in the dark themes that
// looks switched off): an outlined circle with the edge of a control, and the accent when it is chosen,
// a dot inside a ring of the raised surface. Under forced colors the chosen one is a filled circle.
part "picker.input" {
    appearance none
    flex none
    box-sizing border-box
    width "$size-icon-small"
    height "$size-icon-small"
    margin 0
    border "$border-width solid $border-control"
    border-radius "$r-pill"
    background "$bg-raised"
}

part "picker.input:checked" {
    border-color "$accent"
    background "$accent"
    box-shadow "inset 0 0 0 $space-1 $bg-raised"
}

part "picker.input[variant=boxed]" {
    flex none
}

part "picker.row" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2 $space-3"
    min-height "$size-control"
    padding 0 "$space-2"
    border-radius "$r-ctl"
}

part "picker.row:hover" {
    background "$bg-hover"
}

// A row that is one button: its text starts at the edge of the box above it, and the name is
// underlined when the row is pointed at or has the focus.
part "picker.choice" {
    display flex
    align-items center
    justify-content flex-start
    gap "$space-3"
    width "100%"
    min-height "$size-control"
    padding 0
    border 0
    border-radius "$r-ctl"
    background transparent
    color "$fg"
    font-family inherit
    font-size inherit
    text-align start
    cursor pointer
}

part "picker.id" {
    margin-inline-end "$space-2"
    font-family "$font-mono"
    font-size "$fs-base"
}

part "picker.choice:hover picker.name" "picker.choice:focus-visible picker.name" {
    text-decoration underline
}

part "picker.name[variant=list]" {
    flex 1
    min-width 0
    overflow-wrap anywhere
}

part "picker.name[variant=boxed]" {
    font-weight "$weight-regular"
    color "$fg"
    overflow-wrap anywhere
}

part "picker.hint" {
    use "control-hint"
}

// ───────────── Status and priority (R4, R5, UX §7.2) ─────────────
//
// A status belongs to a status group. The group gives the color and the icon, the status gives
// the word. A priority has its own icon. Color is never alone: the icon and the word, or the
// word as the accessible name, are always there.

part "status-icon" {
    flex none
    width "$size-icon"
    height "$size-icon"
}

part "status-icon[variant=small]" {
    width "$size-icon-small"
    height "$size-icon-small"
}

part "status-icon[variant=not-started]" {
    color "$st-ns"
}

part "status-icon[variant=in-progress]" {
    color "$st-ip"
}

part "status-icon[variant=done]" {
    color "$st-done"
}

// Under forced colors the status is told by the shape of the icon, drawn in the text color.
part "status-icon[variant=not-started]" "status-icon[variant=in-progress]" "status-icon[variant=done]" {
    forced {
        color CanvasText
    }
}

// The small pill that shows a status in lists and in text.
part "status-pill" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding "$space-1 $pad-control"
    border-radius "$r-pill"
    font-size "$fs-sm"
    font-weight "$weight-regular"
    line-height "$lh-tight"
    white-space nowrap
}

part "status-pill[variant=not-started]" {
    use "status-soft-not-started"
}

part "status-pill[variant=in-progress]" {
    use "status-soft-in-progress"
}

part "status-pill[variant=done]" {
    use "status-soft-done"
}

// The big button of the issue page: the status with its group's icon and color, and an arrow that
// says it can be changed.
part "status-button" {
    display inline-flex
    align-items center
    gap "$space-2"
    use "control-box"
    padding 0 "$pad-control"
    border-color currentColor
    font-family "$font-ui"
    font-size "$fs-ui"
    font-weight "$weight-regular"
    line-height "$lh-tight"
    cursor pointer
}

part "status-button[variant=not-started]" {
    use "status-soft-not-started"
}

part "status-button[variant=in-progress]" {
    use "status-soft-in-progress"
}

part "status-button[variant=done]" {
    use "status-soft-done"
}

part "status-button[hovered]" {
    filter "brightness($hover-brightness)"
}

part "status-button[disabled]" {
    opacity "$opacity-disabled"
    cursor default
}

part "status-button[focus-visible]" {
    use "ring"
}

part "priority" {
    display inline-flex
    align-items center
    gap "$space-1"
    font-size "$fs-ui"
    white-space nowrap
}

part "priority[variant=critical]" {
    color "$danger"
    font-weight "$weight-bold"
}

part "priority[variant=high]" {
    color "$warning"
    font-weight "$weight-bold"
}

part "priority[variant=normal]" {
    color "$fg-muted"
}

part "priority[variant=low]" {
    color "$fg-subtle"
}

part "priority-icon" {
    flex none
    width "$size-icon-small"
    height "$size-icon-small"
}

// ───────────── Rows that carry their state (R4) ─────────────
//
// Any row can carry the state of its status group (a tint) and of its priority (an edge of 4 px at
// its start), by the words of `rowStates`. A row of the list, an issue row and a bar of the
// timeline are the rows that do. A hovered, a selected or a current row keeps its tint, so the rows set no fill of their own for
// those states: the hover line, the ring and the ticked box say the state. The rules come after the rows' own, so they win.

part "list-row[state=group-not-started]" "issue-row[state=group-not-started]" "timeline-bar[state=group-not-started]" {
    background "$tint-ns"
}

part "list-row[state=group-in-progress]" "issue-row[state=group-in-progress]" "timeline-bar[state=group-in-progress]" {
    background "$tint-ip"
}

part "list-row[state=group-done]" "issue-row[state=group-done]" "timeline-bar[state=group-done]" {
    background "$tint-done"
}

part "list-row[state=priority-critical]" "issue-row[state=priority-critical]" "timeline-bar[state=priority-critical]" {
    border-inline-start "$size-edge solid $danger"
}

part "list-row[state=priority-high]" "issue-row[state=priority-high]" "timeline-bar[state=priority-high]" {
    border-inline-start "$size-edge solid $edge-high"
}

// Forced colors give every border the color of the system, so the transparent edge that keeps the titles in
// one column (and the one of the head of the list) would be drawn as a bar like the edge of a priority; the row
// and the bar of the timeline say `Canvas` for it. There the edge is told by its pattern (R5, M5 exit A15): Critical a double bar, High a single bar, every other row
// and the head of the list none (the color of the canvas, so the width stays).
part "list-row[state=priority-critical]" "issue-row[state=priority-critical]" "timeline-bar[state=priority-critical]" {
    forced {
        border-inline-start-style double
        border-inline-start-color CanvasText
    }
}

part "list-row[state=priority-high]" "issue-row[state=priority-high]" "timeline-bar[state=priority-high]" {
    forced {
        border-inline-start-color CanvasText
    }
}

// ───────────── The grid of the issue list (UX §4.2) ─────────────
//
// One grid with fixed columns (R1, R9): tick box, status icon, ID, type icon, title, labels,
// priority, assigned person, changed. The header, the rows and the phone's rows are the same part,
// so the columns line up. A column is named by the variant of its cell.

part "list-grid" {
    display flex
    flex-direction column
    min-width 0
}

part "list-row" {
    position relative
    box-sizing border-box
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-row"
    padding 0 "$pad-box"
    border-inline-start "$size-edge solid transparent"
    border-bottom "$border-width solid $divider"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-ui"
}

// A row you can press shows it on hover with a thin line just inside its edge: a shadow draws it, so
// nothing moves and the edge of its priority stays; it is thinner than the rings and another color.
part "list-row:hover" {
    box-shadow "inset 0 0 0 $border-width $hover-line"
}

// A ticked row shows it by its ticked box and by the line under it in the accent color, so a run of ticked rows reads as one run;
// it keeps its tint and has no ring of its own.
part "list-row[state=selected]" {
    border-bottom-color "$accent"
    // The clear outline is drawn only under forced colors, which drop the accent line: there a ticked row has its outline.
    use "ring-clear"
}

// The issue that is open next to the list is ringed inside its edge, so it never relies on the fill alone.
part "list-row[state=current]" "issue-row[state=selected]" "issue-row[variant=current]" "timeline-bar[state=selected]" {
    use "ring-row"
}

// The column names above the rows.
part "list-row[variant=head]" {
    min-height "$size-control"
    background "$bg-surface"
    color "$fg-muted"
    font-size "$fs-sm"
    font-weight "$weight-regular"
}

part "list-row[variant=head]:hover" {
    background "$bg-surface"
    box-shadow none
}

part "list-row.cell" {
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
}

part "list-row.cell[variant=select]" {
    flex none
    display flex
    align-items center
    justify-content center
    width "$size-control"
}

part "list-row.cell[variant=status]" {
    flex none
    display flex
    align-items center
    justify-content center
    width "$size-col-icon"
}

// The type: its icon and its name, so the icon does not read as a second box to tick.
part "list-row.cell[variant=type]" {
    flex none
    display flex
    align-items center
    gap "$space-1"
    width "$size-col-project"
}

part "list-row.cell[variant=key]" {
    flex none
    color "$fg-muted"
    font-family "$font-mono"
}

part "list-row.cell[variant=title]" {
    flex 1
}

// Only the IDs are in the code font; the name of the column is in the font of the interface.
part "list-row[variant=head] list-row.cell[variant=key]" {
    font-family "$font-ui"
}

part "list-row.cell[variant=labels]" {
    flex none
    width "$size-col-labels"
}

part "list-row.cell[variant=priority]" {
    flex none
    width "$size-col-priority"
}

part "list-row.cell[variant=person]" {
    flex none
    width "$size-col-person"
}

part "list-row.cell[variant=project]" {
    flex none
    width "$size-col-project"
}

// The value of a field that has no cell of its own (a field of the organization's, the day it was made).
part "list-row.cell[variant=value]" {
    flex none
    width "$size-col-value"
}

part "list-row.cell[variant=changed]" {
    flex none
    width "$size-col-changed"
    color "$fg-muted"
    font-size "$fs-sm"
}

// The buttons of a row: they take the room they need, at the end.
part "list-row.cell[variant=action]" {
    flex none
    display flex
    align-items center
    justify-content flex-end
}

// A done issue's title turns muted in lists.
part "list-row[state=group-done] list-row.cell[variant=title]" {
    color "$fg-muted"
}

// The whole row is the target of its title (R8): the title is not underlined and not a link color,
// and the link reaches over the row.
part "list-row.cell link" {
    color inherit
    font-weight "$weight-regular"
    text-decoration none
}

part "list-row.cell[variant=title] link::after" {
    content "\"\""
    position absolute
    inset 0
}

// The keyboard focus has the ring of its own (`ring-keyboard`). The row draws it (the link reaches over the row), so the link has no outline of its own.
part "list-row.cell[variant=title] link[focus-visible]" {
    outline none
}

part "list-row.cell[variant=title] link[focus-visible]::after" {
    use "ring-keyboard"
}

// The checkbox and the buttons of a row stay above the link that reaches over it; every other cell is
// part of the row's target.
part "list-row.cell[variant=select]" "list-row.cell[variant=action]" {
    position relative
    z-index "$z-raised"
}

// On a phone the row has two lines: status, ID and priority, then the title, then the person and
// the day (R9: the same order). The other columns are left out. The ID and the person have the room
// that is left; the priority and the day take what they need at the end, so no text meets another.
part "list-row[variant=phone]" "list-row[variant=slim]" {
    display grid
    grid-template-columns "$size-control $size-col-icon minmax(0, 1fr) auto"
    grid-template-areas "\"select status key priority\" \"select title title title\" \"select person person changed\""
    align-items center
    gap "$space-1 $space-3"
    padding "$space-3 $pad-box"
    min-height "$size-row"
}

part "list-row[variant=phone] list-row.cell[variant=type]" "list-row[variant=phone] list-row.cell[variant=labels]" "list-row[variant=phone] list-row.cell[variant=project]" "list-row[variant=phone] list-row.cell[variant=value]" {
    display none
}

part "list-row[variant=phone] list-row.cell" "list-row[variant=slim] list-row.cell" {
    width auto
}

part "list-row[variant=phone] list-row.cell[variant=select]" {
    grid-area select
}

part "list-row[variant=phone] list-row.cell[variant=status]" "list-row[variant=slim] list-row.cell[variant=status]" {
    grid-area status
}

part "list-row[variant=phone] list-row.cell[variant=key]" "list-row[variant=slim] list-row.cell[variant=key]" {
    grid-area key
}

part "list-row[variant=phone] list-row.cell[variant=priority]" "list-row[variant=slim] list-row.cell[variant=priority]" {
    grid-area priority
    justify-self end
}

part "list-row[variant=phone] list-row.cell[variant=title]" "list-row[variant=slim] list-row.cell[variant=title]" {
    grid-area title
    white-space normal
    overflow-wrap anywhere
}

// The people of a row on a phone are written out on as many lines as they need, never cut with dots (M5 exit F-A3); a line
// breaks only between two names. The date beside them stands on the line of the last name.
part "list-row[variant=phone] list-row.cell[variant=person]" {
    grid-area person
    width auto
    white-space normal
    overflow-wrap anywhere
    align-self "last baseline"
}

part "list-row[variant=phone] list-row.cell[variant=action]" {
    grid-area changed
    justify-self end
}

part "list-row[variant=phone] list-row.cell[variant=changed]" {
    grid-area changed
    justify-self end
    align-self "last baseline"
}

// A card without the box to tick (the Search page): the same lines without its column.
part "list-row[variant=phone][variant=plain]" {
    grid-template-columns "$size-col-icon minmax(0, 1fr) auto"
    grid-template-areas "\"status key priority\" \"title title title\" \"person person changed\""
}

// The status icon starts at the start edge of the card, above the title (R1).
part "list-row[variant=phone] list-row.cell[variant=status]" {
    justify-content flex-start
}

// The slim list beside the open issue (UX §3.4): the two lines of a phone, without the tick box.
part "list-row[variant=slim]" {
    grid-template-columns "$size-col-icon minmax(0, 1fr) auto"
    grid-template-areas "\"status key priority\" \"title title title\""
}

// The header of a group of rows: the group's icon and color, its name and how many issues it holds.
part "list-group" {
    box-sizing border-box
    display flex
    align-items center
    gap "$space-2"
    min-height "$size-control"
    margin-block-start "$space-2"
    padding 0 "$pad-box"
    border-inline-start "$size-edge solid transparent"
    border-top "$border-width solid $divider"
    border-bottom "$border-width solid $divider"
    background "$bg-surface"
    font-size "$fs-md"
    font-weight "$weight-regular"
}

// Under forced colors the transparent start edge of a row, of the head of a group and of a bar of the timeline is drawn
// in the color of the canvas: only Critical and High carry a bar (R5; a group head had High's bar, M5 exit F-A8).
part "list-row" "list-group" "timeline-bar" {
    forced {
        border-inline-start-color Canvas
    }
}

// Under forced colors every border is drawn: the line above a group head would stand right under the line of the row
// before it. The head keeps the room of its line and draws it in the color of the canvas.
part "list-group" {
    forced {
        border-top-color Canvas
    }
}

part "list-group.count" {
    color "$fg-muted"
    font-weight "$weight-regular"
}


// ───────────── The issue list with columns a person chose (UX §4.2) ─────────────
//
// The head and every row are a grid with the same columns: the code writes their widths into the
// variable `list-columns` of the list, once for the list. A row that scrolls out of sight is not
// drawn at all (ADR-0009, amendment M5), so the rows are positioned by the list and not by flow.

// The list and its options in one column: beside Customize where there is room for both, above it where there is not.
part "list-main" {
    display flex
    flex 1 1 "$size-list-main"
    flex-direction column
    gap "$space-3"
    min-width 0
    container-type inline-size
}

// The list and the panel of Customize: the panel stands beside the list level with its head, or under it, as wide as the
// list, where the list has no room for it beside (bp-list-beside).
part "list-body" {
    display flex
    flex-wrap nowrap
    align-items flex-start
    gap "$space-4"
    min-width 0
    container "(max-width: $bp-list-beside)" {
        flex-direction column
        align-items stretch
    }
}

part "list-column" {
    display flex
    flex 1000 1 "$size-list-main"
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "list-frame" {
    display flex
    flex-direction column
    min-width 0
    overflow-x auto
}

// Ten characters of the code font that nobody sees: the code measures them, so the ID column is as wide as the font really draws its IDs, whichever font the computer has for it.
part "list-char-probe" {
    position absolute
    inset-block-start 0
    inset-inline-start 0
    height 0
    overflow hidden
    visibility hidden
    white-space pre
    font-family "$font-mono"
    font-size "$fs-ui"
}

// The gap, with the edge and the padding of `list-row`, is what `listNeeds` (ui, list-template.ts) counts to see which columns fit: change them there and here together.
part "list-row[variant=grid]" {
    display grid
    grid-template-columns "$list-columns"
    gap "$space-3"
}

part "list-row[variant=grid] list-row.cell" {
    width auto
}


// The cells of a column keep their alignment; a text column starts at the start edge.
part "list-row[variant=grid] list-row.cell[variant=status]" "list-row[variant=grid] list-row.cell[variant=select]" {
    justify-content center
}

part "list-frame[variant=compact] list-row" {
    min-height "$size-row-compact"
}

part "list-frame[variant=compact] list-row[variant=head]" {
    min-height "$size-row-compact"
}

// Compact: the tick box draws at its least size and keeps its target (24 for a pointer, WCAG 2.5.8; 44 on touch), and the group headers are as low as the rows.
part "list-frame[variant=compact] checkbox" {
    min-width "$size-target-compact"
    min-height "$size-target-compact"
}

// Compact on a phone: the card keeps its two lines with less air around them.
part "list-frame[variant=compact] list-row[variant=phone]" {
    padding "$space-1 $pad-box"
    min-height "$size-row-compact"
}

part "list-frame[variant=compact] checkbox.box" {
    width "$size-icon-small"
    height "$size-icon-small"
}


// The shadow at the end of the rows stands on the edge of the box, over its padding at the end.
part "list-scroll::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $space-3)"
    }
}

// The rows scroll inside this box; the head stays above them. The last row ends the list with its own line; the box
// adds none, so a list whose rows just fit has no double bar.
part "list-scroll" {
    box-sizing border-box
    min-width "$list-width"
    padding-block-end "$space-3"
    overflow auto
}

// The head is as wide as its columns at their least need and at least the frame (the code measures it and gives that width to the rows, `list-width`), and scrolls sideways with them inside the frame.
part "list-head" {
    box-sizing border-box
    width min-content
    min-width "100%"
    padding-inline-end "$list-gutter"
    overflow hidden
}

// The name of a column is a button that sorts by it.
part "list-sort" {
    use "bare-button"
    display inline-flex
    align-items center
    gap "$space-1"
    max-width "100%"
    min-width "$size-target-compact"
    min-height "$size-target-compact"
    padding 0
    color inherit
    font-size inherit
    font-weight inherit
    text-align start
}

part "list-sort[focus-visible]" {
    use "ring"
}

part "list-sort.label" {
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
}

// The edge of a head cell: dragging it, or moving it with the arrow keys, sets the width.
part "list-handle" {
    border 0
    padding 0
    background transparent
    position absolute
    inset-block 0
    inset-inline-end 0
    width "$size-target-compact"
    cursor col-resize
    touch-action none
}

part "list-handle:hover" {
    background "$border"
}

part "list-handle[focus-visible]" {
    use "ring-inside"
}

part "list-row[variant=head] list-row.cell" {
    position relative
}

// The room at the end of a name for the handle that sets its width, so the two never overlap.
part "list-row[variant=head] list-row.cell:has(list-handle)" {
    padding-inline-end "$size-target-compact"
}

// The name "Issue ID" is short and its column is narrow: the edge that sets its width overlaps the end of the cell by little, so the name is not cut on a finger.
part "list-row[variant=head] list-row.cell[variant=key]:has(list-handle)" {
    padding-inline-end "$space-3"
}

// A group of rows can be folded: the whole header is the button.
// The header of a group stands on the columns of the rows (R1): the arrow in the column of the tick box, the icon of
// the group on the status icon, the name on the ID. A list without tick boxes keeps the chevron at the start too (L5),
// in a narrow column of its own, so there the icon and the name stand one column in.
part "list-group.toggle" {
    use "bare-button"
    display grid
    grid-auto-flow column
    grid-template-columns "$size-control $size-col-icon minmax(0, 1fr) auto"
    align-items center
    gap "$space-3"
    flex 1
    min-height "$size-control"
    padding 0
    color inherit
    font-size inherit
    font-weight inherit
    text-align start
}

// One group head in every list (L5): the chevron at the start, then the icon, the name, and the count at the end. A list
// without the box to tick has a narrow first column for the chevron instead of the column of the boxes.
part "list-group.toggle[variant=no-select]" {
    grid-template-columns "$size-col-icon $size-col-icon minmax(0, 1fr) auto"
}

part "list-group.chevron" {
    display flex
    justify-content center
}

part "list-group.kind" {
    display flex
    justify-content center
}

part "list-group.toggle[focus-visible]" {
    use "ring-inside"
}

// A row or a group header that has the focus of the keyboard shows it all round, inside its box.
part "list-row[focus-visible]" "list-group[focus-visible]" {
    use "ring-keyboard"
}

part "list-group.name" {
    min-width 0
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
}

// Compact: the group headers are as low as the rows.
part "list-frame[variant=compact] list-group" "list-frame[variant=compact] list-group.toggle" {
    min-height "$size-row-compact"
}

// The words that say why a group shows no rows.
part "list-group.note" {
    color "$fg-muted"
    font-weight "$weight-regular"
}

// Customize → Columns: a panel beside the list.
part "list-panel" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-3"
    box-sizing border-box
    flex "1 1 $size-list"
    padding "$pad-box"
    // No higher than the line it shares with the list: its columns scroll inside it, under the edge shadow.
    max-height "100%"
    min-height 0
    overflow-y auto
    // Under the list it is as high as its columns.
    container "(max-width: $bp-list-beside)" {
        flex none
    }
}

part "list-panel::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $pad-box)"
        margin-block-end "calc(-1 * $space-3)"
    }
}

part "list-panel::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $pad-box)"
        margin-block-start "calc(-1 * $space-3)"
    }
}

part "list-panel.head" {
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
}

part "list-panel.title" {
    margin 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "list-panel.item" {
    display flex
    align-items center
    justify-content space-between
    gap "$space-2"
    min-height "$size-control"
}

// The checklist stands in as many columns as the panel has room for: one beside the list, two or more under it, as wide as the list.
// The arrows that move a column are quiet buttons of 28 px (44 for a finger).
part "list-panel.item button[variant=square]" {
    width "$size-control-small"
    min-height "$size-control-small"
}

part "list-panel.items" {
    use "list-reset"
    display grid
    grid-template-columns "repeat(auto-fill, minmax($size-list-item, 1fr))"
    gap "$space-1" "$space-4"
}

// What the list says when no issue is found: a sentence and the one thing to do, in the middle of the list (R1).
part "list-nothing" {
    display flex
    flex-direction column
    align-items center
    gap "$space-3"
    padding "$pad-box" "$pad-nothing"
    text-align center
}

// The controls above the list: Group by and Customize.
part "list-options" {
    display flex
    flex-wrap wrap
    align-items flex-start
    gap "$space-3" "$space-5"
}

// The button stands level with the control of Group by, not with its label.
part "list-options button" {
    align-self flex-end
}

// A bar of the timeline (UX §4.7): the same tint and edge as the row of the list.
part "timeline-bar" {
    box-sizing border-box
    display flex
    align-items center
    gap "$space-2"
    min-height "$size-control-small"
    padding 0 "$pad-control"
    border "$border-width solid $border"
    border-inline-start "$size-edge solid transparent"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$fg"
    font-size "$fs-sm"
}

// ───────────── Name and value (Details, UX §4.4) ─────────────

// The rows of the Details share two columns: the names, as wide as the longest name (never wider than
// `size-name`), and the values, which have all the rest (the review of M4: the values had 142 px).
part "name-values" {
    display grid
    grid-template-columns "fit-content($size-name) minmax(0, 1fr)"
    column-gap "$space-3"
    margin 0
}

part "name-value" {
    display grid
    grid-column "1 / -1"
    grid-template-columns subgrid
    align-items start
    min-height "$size-control"
    padding "$space-1 0"
}

// The name stands at the height of the first line of its value: both are as high as a control and
// centered in it (R1, the review of M4: the names sat above the middle of their values).
part "name-value.name" {
    use "control-label"
    display flex
    align-items center
    min-height "$size-control"
    margin 0
}

part "name-value.value" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    min-width 0
    min-height "$size-control"
    margin 0
    font-size "$fs-ui"
}

// A text of the value that runs over more than one line ("This project has no labels yet.") stands
// so that its first line is centered in the height of a control, like the name and like a value of
// one line, and the lines after it follow (the review of M4, B Details).
part "name-value.value > muted" {
    padding "calc(($size-control - $fs-base * $lh-body) / 2) 0"
}

// The *Followers* row is one line on a computer and on a phone: the count (or the words *You follow it*
// where there is no count) and the button for turning it round (the review of M4: *Stop following*
// dropped under the words). Where even the longest count ("20 or more followers") and the button do
// not fit the column, the button as a whole goes to the next line, as a last resort; it never breaks
// its words and never runs out of the column (the review of WP-18).
part "followers-line" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    min-width 0
}

// The button never breaks its words, so *Stop following* stays one line.
part "followers-line button" {
    white-space nowrap
}

// The count and the words stay together on one line.
part "followers-state" {
    display inline-flex
    align-items center
    white-space nowrap
}

// The words *You follow it* are the size of the count.
part "followers-state.words" {
    color "$fg-muted"
    font-size "$fs-ui"
}

// *Website · Offered* with its sign: the sign stays beside the first line of the words, whatever
// the words do.
part "offer-state" {
    display inline-flex
    align-items center
    gap "$space-2"
    min-width 0
}

// A priority is as high as a control, so it is level with the name of its row like the other values.
part "name-value.value > priority" {
    min-height "$size-control"
}

// Why a value cannot be changed stands under the value, on its own line, so the value itself stays
// level with its name whatever length the reason has (the review of M4, demo 07).
part "name-value.reason" {
    display inline-flex
    flex-basis "100%"
    align-items flex-start
    gap "$space-1"
    use "quiet-text"
}

// *Saved* and *Undo* where the change happened (R7).
part "name-value.saved" {
    display inline-flex
    align-items center
    gap "$space-1"
}

// ───────────── Legend ─────────────
//
// The Legend, a small list beside the toolbar: what the row color and the edge mean (UX §4.2, §4.7).

part "legend" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-4"
    margin 0
    padding 0
    color "$fg-muted"
    font-size "$fs-sm"
    list-style none
}

part "legend.item" {
    display inline-flex
    align-items center
    gap "$space-2"
}

part "legend.swatch" {
    flex none
    box-sizing border-box
    width "$size-icon-small"
    height "$size-icon-small"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
}

part "legend.swatch[variant=not-started]" {
    border-color "$st-ns"
    background "$tint-ns"
}

part "legend.swatch[variant=in-progress]" {
    border-color "$st-ip"
    background "$tint-ip"
}

part "legend.swatch[variant=done]" {
    border-color "$st-done"
    background "$tint-done"
}

part "legend.swatch[variant=critical]" "legend.swatch[variant=high]" {
    width "$size-edge"
    border 0
    border-radius 0
}

part "legend.swatch[variant=critical]" {
    background "$danger"
}

part "legend.swatch[variant=high]" {
    background "$edge-high"
}

// Forced colors drop the fill of a bar, so both are drawn in the text color there.
part "legend.swatch[variant=critical]" "legend.swatch[variant=high]" {
    forced {
        background CanvasText
    }
}

// The same two patterns as the edge of a row: Critical a double bar, High a single bar.
part "legend.swatch[variant=critical]" {
    forced {
        width 0
        border-inline-start "$size-edge double CanvasText"
        background Canvas
    }
}

// The row above a list: its main button, what is ticked, and the Legend at the end.
part "list-toolbar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3" "$space-5"
}

part "list-toolbar legend" {
    margin-inline-start "$legend-start"
}

// ───────────── Window (UX §6.3, R10) ─────────────
//
// A form opens as a window over the page, in the one overlay (variant `window`). It can be
// minimized to a bar at the bottom, maximized, and resized at its edges. Its size is two variables
// that the code sets while the person drags (`--window-width`, `--window-height`, the tokens of the
// same names). The form follows the window's own width (container queries), not the screen's.

part "overlay[variant=window]" {
    align-items center
    justify-content center
    padding "$space-4"
}

part "overlay[variant=window][state=maximized]" {
    padding 0
}

part "overlay.modal[variant=window]" {
    container-type inline-size
    width "min($window-width, 100%)"
    height "$window-height"
    min-width "min($size-window-width-min, 100%)"
    max-height "100%"
    border-radius "$r-card"
}

part "overlay.modal[variant=window][state=maximized]" {
    width "100%"
    height "100%"
    border-radius 0
}

part "window" {
    display flex
    flex 1
    flex-direction column
    min-height 0
    outline none
}

// Everything inside the dialog: the keys of the keyboard are heard here.
part "window.content" {
    display flex
    flex 1
    flex-direction column
    min-height 0
}

part "window.title-bar" {
    display flex
    flex none
    align-items stretch
    min-height "$size-control"
    border-bottom "$border-width solid $divider"
    border-radius "$r-card $r-card 0 0"
    background "$bg-surface"
}

part "window.title" {
    flex 1
    min-width 0
    margin 0
    padding "0 $pad-box"
    overflow hidden
    font-size "$fs-lg"
    line-height "$size-control"
    text-overflow ellipsis
    white-space nowrap
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "window.control" {
    display inline-flex
    flex none
    align-items center
    justify-content center
    width "$size-window-button"
    min-height "$size-control"
    padding 0
    border 0
    background transparent
    color "$fg"
    cursor pointer
}

part "window.control[hovered]" {
    background "$bg-hover"
}

part "window.control[pressed]" {
    background "$bg-selected"
}

part "window.control[variant=close][hovered]" "window.control[variant=close][pressed]" {
    background "$danger"
    color "$on-accent"
}

part "window.control[variant=close]" {
    border-start-end-radius "$r-card"
}

// *Back* stands at the start of the title bar, as on a page (R1, UX review of M4, A10).
part "window.control[variant=back]" {
    order -1
    use "button-content"
    width auto
    padding 0 "$pad-control"
}

// On a phone the window is a screen, and its bar is the bar of every other page: the canvas, not the tinted
// surface of the bar of a window (M5 exit, O13).
part "overlay.modal[variant=full] window.title-bar" {
    use "phone-bar"
    border-radius 0
}

// The same bar as every page of a phone: Back in the color of a quiet button, the title at its side, one line (M5 exit, O13).
part "overlay.modal[variant=full] window.title" {
    padding 0
    line-height "$lh-tight"
}

// Back of the bar of a screen is Back of the top bar of a page: the words of a button (M5 exit, share on a phone: 14
// against 16 px, the title further in).
part "overlay.modal[variant=full] window.control[variant=back]" {
    use "hang-start"
    use "button-words"
    color "$accent-fg"
}

part "window.control[focus-visible]" {
    use "ring-inside"
}

// The scrolling part is the form; the title bar and the footer stay in place.
part "window.body" {
    flex 1
    min-height 0
    padding "$pad-dialog"
    overflow-y auto
}

part "window.body::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $pad-dialog)"
    }
}

part "window.body::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $pad-dialog)"
    }
}

// Rows: what is missing (it comes and goes), the buttons in one row at the right, the main one last
// (R6), then the note below them (that the draft is kept, and what belongs to the form; UX §4.5).
part "window.footer" {
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    padding "$pad-box $pad-dialog"
    border-top "$border-width solid $divider"
}

part "window.footer-note" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-3"
    use "quiet-text"
}

// The quiet button of the note stands under its text on a phone, so it hangs back by its padding
// and its text starts where the text of the note starts (R1); beside the note it does not.
part "window.footer-note button[variant=quiet]" {
    margin-inline-start "$size-phone-hang"
}

part "window.footer-actions" {
    use "answer-row"
}

// The places to drag: the four edges and the four corners.
part "window.handle" {
    position absolute
    z-index "$z-raised"
    touch-action none
}

part "window.handle[variant=e]" {
    inset-block "$size-window-handle"
    inset-inline-end 0
    width "$size-window-handle"
    cursor ew-resize
}

part "window.handle[variant=w]" {
    inset-block "$size-window-handle"
    inset-inline-start 0
    width "$size-window-handle"
    cursor ew-resize
}

part "window.handle[variant=s]" {
    inset-inline "$size-window-handle"
    bottom 0
    height "$size-window-handle"
    cursor ns-resize
}

part "window.handle[variant=n]" {
    inset-inline "$size-window-handle"
    top 0
    height "$size-window-handle"
    cursor ns-resize
}

part "window.handle[variant=se]" {
    right 0
    bottom 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nwse-resize
}

part "window.handle[variant=nw]" {
    top 0
    left 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nwse-resize
}

part "window.handle[variant=ne]" {
    top 0
    right 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nesw-resize
}

part "window.handle[variant=sw]" {
    bottom 0
    left 0
    width "$size-window-handle"
    height "$size-window-handle"
    cursor nesw-resize
}

// The form inside: one column below 880, the fields at the side from 880, the text centered with a
// readable width from 1200 (R10).
part "window-layout" {
    display grid
    grid-template-columns "minmax(0, 1fr)"
    gap "$gap-sections" "$space-5"
    container "(min-width: $bp-window-side)" {
        grid-template-columns "minmax(0, 1fr) $size-details"
        align-items start
    }
    container "(min-width: $bp-window-wide)" {
        grid-template-columns "minmax(0, $size-reading) $size-details"
        justify-content center
    }
}

part "window-layout.text" {
    display flex
    flex-direction column
    gap "$gap-fields"
    min-width 0
}

part "window-layout.fields" {
    display flex
    flex-direction column
    gap "$gap-fields"
    min-width 0
}

// A window that is minimized is a bar at the bottom of the page with its title and what it keeps.
// A minimized window is a strip at the bottom of the page: the page has room for it at its end (below), so the strip
// covers no row and crosses no frame of a card; its bar starts where the page column starts and ends before the
// column does (the wide view of the focus has the gutter only). The strip is a surface of its own with a shadow.
part "window-dock" {
    position fixed
    inset-inline-start 0
    inset-inline-end 0
    bottom 0
    z-index "$z-panel"
    box-sizing border-box
    display flex
    align-items center
    justify-content flex-start
    gap "$space-3"
    min-height "$size-dock-strip"
    padding "$size-dock-gap $size-page-gutter"
    border-top "$border-width solid $border-control"
    background "$bg-raised"
    box-shadow "$shadow"
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-ui"
    cursor pointer
}

part "app-layout[variant=side]" {
    --sidebar-width "$size-sidebar"
}

part "app-layout[variant=side-narrow]" {
    --sidebar-width "$size-sidebar-narrow"
}

// The strip starts after the menu and its bar starts where the page column starts (centered where the room is wider).
part "app-layout[variant=side] window-dock" "app-layout[variant=side-narrow] window-dock" {
    inset-inline-start "var(--sidebar-width)"
    padding-inline "max($size-page-gutter, (100% - var(--sidebar-width) - $size-page) / 2)"
}

part "window-dock[hovered]" {
    background "$bg-hover"
}

part "window-dock[focus-visible]" {
    use "ring"
}

part "window-dock.title" {
    overflow hidden
    font-weight "$weight-regular"
    text-overflow ellipsis
    white-space nowrap
}

// A line between the title and its note, so they read as two things in one bar.
part "window-dock.note" {
    padding-inline-start "$space-3"
    border-inline-start "$border-width solid $divider"
    color "$fg"
    font-size "$fs-base"
    white-space nowrap
}

// ───────────── Shared layout parts ─────────────
//
// What several screens say the same way: a column with a gap, a line of text, a row that wraps,
// a list without bullets.

part "stack" {
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
}

// A button that stands in a column on a computer is as wide as its words, not as wide as the column (M5 exit, O6);
// on a phone a form's button is as wide as the screen.
part "stack > button" {
    media "(width >= $bp-tablet)" {
        align-self flex-start
    }
}

// Things under each other on the start edge, with text buttons among them: a button that stands
// in the column hangs back by its padding, so its text starts where the text above starts (R1).
part "start-column" {
    display flex
    flex-direction column
    align-items flex-start
    gap "$space-1"
    min-width 0
}

// A value of a row of the Details that is a column (the people of *Assigned to*): each line is as
// high as a control, so the first one is level with its name.
part "start-column.line" {
    display flex
    align-items center
    min-height "$size-control"
}

part "text" {
    margin 0
    font-size "$fs-md"
    line-height "$lh-text"
}

part "row" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
}

// The last item of a row stands at its end (the button that sends a comment, after the one that adds files).
part "row.end" {
    margin-inline-start auto
}

// A row that does not wrap and keeps its first item level with the first line of the rest (an icon before a sentence that wraps).
part "row[variant=inline]" {
    flex-wrap nowrap
    align-items flex-start
}

// A row whose items are as high as the row.
part "row[variant=stretch]" {
    align-items stretch
}

part "list" {
    display flex
    flex-direction column
    gap "$space-3"
    use "list-reset"
}

part "list[variant=loose]" {
    gap "$space-4"
}

// What several screens share: an item of a list, facts, a heading, a hint.

part "item" {
    position relative
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-3"
    padding "$space-3"
    use "surface-box"
}

// An item whose words and buttons keep more room between them, one that is slim, one whose words
// break anywhere.
part "item[variant=spread]" {
    gap "$space-2 $space-4"
}

part "item[variant=slim]" {
    padding "$space-1 $space-3"
}

part "item[variant=wrap]" {
    overflow-wrap anywhere
}

part "item.text" {
    use "column-wrap"
}

// The words of an item that has a button beside them: they take the room that is left and break
// inside their own box, so the button stays beside them on every line of a list.
part "item.main" {
    use "column-wrap"
    flex "1 1 $size-name"
}

// The buttons of an item whose words are `item.main`: on a phone they stand under the words, so a
// quiet one hangs back by its own padding and its text starts where the words start (R1); beside
// the words, on a computer, it does not. The row itself does not move: a button that is not quiet
// stands where its box begins.
part "item.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "item.title" {
    font-weight "$weight-regular"
}

part "facts" {
    display grid
    grid-template-columns "minmax(0, 1fr)"
    gap "$space-3"
    margin 0
}

part "fact" {
    use "column-wrap"
    padding-bottom "$space-3"
    border-bottom "$border-width solid $divider"
}

// The last of the facts has no line under it: nothing follows it.
part "fact:last-child" {
    padding-bottom 0
    border-bottom none
}

part "term" {
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

part "definition" {
    margin 0
    font-size "$fs-md"
}

part "key-box" {
    display block
    padding "$space-3"
    use "sunken-box"
    font-family "$font-mono"
    font-size "$fs-md"
    // A key has no spaces: it breaks anywhere, in lines of one length, so that a few letters never stand
    // alone on the last one.
    word-break break-all
    text-wrap balance
}

part "key-box[variant=small]" {
    font-size "$fs-base"
}

part "box" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    use "surface-box"
    min-width 0
}

part "strong" {
    font-weight "$weight-regular"
    color "$fg"
}

part "hint" {
    use "quiet-text"
}

part "column" {
    display flex
    flex-direction column
    gap "$space-1"
}

part "column[variant=snug]" {
    gap "$space-2"
}

part "list[variant=tight]" {
    gap "$space-1"
}

part "list[variant=inset]" {
    padding-inline-start "$space-4"
}

part "list[variant=snug]" {
    gap "$space-2"
}

part "wrap" {
    min-width 0
    overflow-wrap anywhere
}

// ───────────── Card, Form, Icon, OrDivider, SaveStatus, Skeleton (packages/ui) ─────────────

part "card" {
    use "floating-box"
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
    padding "$space-5"
    border-radius "$r-card"
    color "$fg"
}

// On a phone a list goes with one gutter: a card of this look has no frame and no padding there.
part "app-layout[variant=phone] card[variant=open-on-phone]" {
    use "frameless"
}

// The head of a page whose sections are cards of their own (Sign-in and security, Labels and tags): its heading and
// introduction stand on the page above the sections, not in a card that holds nothing else (UX §5.1, L3).
part "card[variant=page-head]" {
    use "frameless"
}

// The heading and, at the end of its row, what can be done with the card (R6: at the end of the header).
part "card.header" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-4"
}

part "card.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "card.heading" {
    margin 0
    font-size "$fs-lg"
    line-height "$lh-snug"
    color "$fg"
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "card.heading:focus" {
    outline none
}

part "icon" {
    flex none
    width "$size-icon"
    height "$size-icon"
}

part "icon[variant=small]" {
    width "$size-icon-small"
    height "$size-icon-small"
}

part "or-divider" {
    display flex
    align-items center
    gap "$space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

part "or-divider::before" "or-divider::after" {
    content "\"\""
    flex 1
    border-top "$border-width solid $divider"
}

// The words that say whether the last change reached the server. Its own part: a change of the
// hint must not reach it.
part "save-status" {
    use "quiet-text"
}

// Red means something did not happen (R4); a change that is not saved yet only says so.
part "save-status[state=not-saved]" {
    color "$fg"
    font-weight "$weight-regular"
}

// The bar under an editor: the plain buttons at the start, the one filled button at the end (R6).
part "save-bar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
}

part "save-bar button[variant=primary]" {
    margin-inline-start auto
}

// The main button of a form stands on a row of its own and is as wide as the screen on a phone, whether the form keeps it
// in a row (with a way out beside it) or alone: one width for every form (M5 exit, O: sign-in rules, groups, access keys),
// and the one that stands at the end of its row (*Comment*, after *Upload files*; M5 exit, L1).
part "app-layout[variant=phone] stack > row > button[variant=primary]" "app-layout[variant=phone] stack > row > row.end:has(button[variant=primary])" {
    flex "1 1 100%"
}

part "app-layout[variant=phone] stack > row > row.end > button[variant=primary]" {
    width "100%"
}

part "skeleton.line" {
    display block
    height "$space-4"
    border-radius "$r-ctl"
    background "$bg-sunken"
    animation "pulse $motion-pulse $ease-in-out infinite alternate"
}

part "skeleton.line[variant=medium]" {
    width "$size-line-medium"
}

// The last line is the shortest, also when it is an even one.
part "skeleton.line[variant=short]" {
    width "$size-line-short"
}

// ───────────── SearchField and SelectField ─────────────

part "search-field.box" {
    display flex
    align-items center
    gap "$space-2"
    use "control-box"
    padding "0 $space-3"
    color "$fg-muted"
}

part "search-field.box:focus-within" {
    use "ring"
}

part "search-field.input" {
    flex 1
    min-width 0
    padding "$space-2 0"
    border 0
    background transparent
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-md"
}

// The clear mark has its place at the end of the box whether there is text or not: the box keeps its width as the first
// letter is typed, so the browser's scroll to the end of the text holds (M5 exit F-A7).
part "search-field.clear" {
    display flex
    flex none
    min-width "$size-control"
    justify-content center
}

part "search-field.input:focus" {
    outline none
}

part "search-field.input::placeholder" {
    color "$fg-muted"
    opacity 1
}

// The browser's own clear mark would be a second one.
part "search-field.input::-webkit-search-cancel-button" {
    display none
}

// ───────────── ConfirmDialog (packages/ui) ─────────────
//
// The layer around a question is the one overlay part (the variant `question`, or `full` on a
// phone); only what is inside it has parts of its own.

part "confirm.dialog" {
    display flex
    flex 1
    flex-direction column
    gap "$space-4"
    min-height 0
    padding "$space-5"
    outline none
}

// What the question says and asks for scrolls by itself where the screen is not tall enough (a phone), so
// the answers below it never leave the screen (the review of M4, A1).
part "confirm.body" {
    display flex
    flex-direction column
    flex 1
    gap "$size-body-gap"
    min-height 0
    overflow-y auto
    use "ring-room"
    use "ring-room-flush"
}

// The gap of the body is taken back, so the lines at its ends take no room.
part "confirm.body::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $ring-room)"
        margin-block-end "calc(-1 * $size-body-gap)"
    }
}

part "confirm.body::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $ring-room)"
        margin-block-start "calc(-1 * $size-body-gap)"
    }
}

// The title of a question or of a sheet (the fields, the help): bold, at the top, with no line of its own.
part "confirm.title" {
    margin 0
    font-size "$fs-lg"
    line-height "$lh-snug"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// Only the title of the question itself has the line under it; the same title in the head of a sheet (the fields, the
// help) has its Close beside it and no line.
part "confirm.dialog > confirm.title" {
    flex none
    padding-block-end "$space-2"
    border-bottom "$border-width solid $divider"
}

// A line above the answers, so what scrolls above them ends at a line and not at the buttons.
part "confirm.actions" {
    use "answer-row"
    margin-top "calc(-1 * $space-2)"
    padding-top "$space-3"
    border-top "$border-width solid $divider"
}

// The same foot as every dialog (confirm.actions): the way out on the start edge, the main button at the end;
// the foot of a sheet from the bottom of a phone (the filters, the legend) is the same.
part "search-panel.actions" "bottom-sheet.actions" {
    use "answer-row"
}

// The text buttons of an answer row stand on the start edge, the others at the end.
part "window.footer-actions button[variant=quiet]:first-child" "confirm.actions button[variant=quiet]:first-child" "search-panel.actions button[variant=quiet]:first-child" "bottom-sheet.actions button[variant=quiet]:first-child" {
    margin-inline-end auto
}

// On a phone the question starts at the top and its answers are at the bottom, one under the
// other and as wide as the screen, the main one first (the thumb reaches it); the body takes the room between.
part "overlay.modal[variant=full] confirm.dialog" {
    flex 1
    min-height 0
}

// The foot of a sheet stays at the foot of it, whatever its content adds, and is told from what scrolls above it by
// the divider of the foot of a window (M5 exit F-A6).
part "bottom-sheet.actions" {
    flex none
    margin-block-start auto
    padding-block-start "$space-4"
    border-top "$border-width solid $divider"
}

part "overlay[variant=full] confirm.actions" "overlay[variant=full] window.footer-actions" "overlay[variant=bottom] search-panel.actions" "overlay[variant=bottom] bottom-sheet.actions" {
    flex-direction column-reverse
    align-items stretch
}

part "overlay[variant=full] confirm.actions button[variant=quiet]:first-child" "overlay[variant=full] window.footer-actions button[variant=quiet]:first-child" "overlay[variant=bottom] search-panel.actions button[variant=quiet]:first-child" "overlay[variant=bottom] bottom-sheet.actions button[variant=quiet]:first-child" {
    margin-inline 0
}

// ───────────── Setup ─────────────

part "setup.progress" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
}

// ───────────── Sign-in ─────────────

// ───────────── Admin (the status page) ─────────────

part "admin.detail" {
    use "quiet-column"
    font-size "$fs-md"
}

// ───────────── Account ─────────────

part "account.codes" {
    display grid
    grid-template-columns "repeat(auto-fill, minmax(min(100%, $size-code), 1fr))"
    gap "$space-2"
    margin 0
    padding "$space-3"
    use "sunken-box"
    font-family "$font-mono"
    font-size "$fs-md"
    list-style none
}

part "account.qr" {
    align-self center
    width "$size-qr"
    height "$size-qr"
    max-width "100%"
    border "$border-width solid $border"
    background "$bg-raised"
    image-rendering pixelated
}

// ───────────── Settings ─────────────

// A control of a setting and its hint stand as close as a box and its hint (a field is column-tight too).
part "settings.control" {
    use "column-tight"
}

part "settings.source" {
    use "control-hint"
    margin 0
}

part "settings.locked" {
    use "note-box"
    use "sunken-box"
}

part "settings.locked-value" {
    color "$fg"
}

// ───────────── Access ─────────────

// The title of an answer of *Check access* (a permission, a field): the name of a row, regular weight (UX §7.3:
// bold is for the heading of a section, not for the title of every line).
part "access.subheading" {
    margin 0
    font-size "$fs-md"
    color "$fg"
}

// The matrix: a table of roles by fields that scrolls by itself when the roles do not fit.
part "access.scroll" {
    // The names of the lists that only screen readers read are positioned boxes: this keeps them in the region.
    position relative
    // The table and the two lines of the edge shadows (below) are side by side, so a line is as high as the table.
    display flex
    overflow-x auto
    container-type inline-size
    // A column comes to rest whole, beside the names, where the scrolling stops near it (a control is not left cut).
    scroll-snap-type "x proximity"
    scroll-padding-inline-start "$size-matrix-cell"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}

part "access.scroll:focus-visible" {
    use "ring-line"
    outline-offset 0
}

part "access.matrix" {
    flex none
    border-collapse separate
    border-spacing 0
    width "100%"
}

// The shadows at the sides of the table while columns are hidden at that side (the scroll position drives them); where the
// browser has no scroll-driven animation there is none.
// The start shadow falls beside the names of the rows, which stay at the start (sticky): the roles hide under the names,
// not under the outer edge of the box.
part "access.scroll::before" {
    supports "(animation-timeline: scroll())" {
        use "edge-inline"
        use "edge-from-start"
        inset-inline-start "$size-matrix-cell"
    }
}

part "access.scroll::after" {
    supports "(animation-timeline: scroll())" {
        use "edge-inline"
        use "edge-from-end"
        inset-inline-end 0
    }
}

// A column is as wide as the room allows for a whole number of them beside the names: the box shows 2, 3 or 4
// columns at their least width or more, never a column cut at its edge (M5 exit, O2).
part "access.matrix-cell" {
    box-sizing border-box
    min-width "$size-matrix-cell"
    // Where the browser does not know round() with typed arithmetic, the block below is not read and the column keeps
    // its least width above (then a column may be cut at the edge): a variable in a line that such a browser cannot
    // compute would drop the line to nothing, not to the line before, so the browser is asked first, with plain numbers.
    supports "(width: calc(1px * round(down, 5px / 2px, 1)))" {
        min-width "max($size-matrix-cell, calc((100cqw - $size-matrix-cell) / max(1, round(down, (100cqw - $size-matrix-cell) / $size-matrix-cell, 1))))"
    }
    padding "$space-2 $space-3"
    scroll-snap-align start
    border-bottom "$border-width solid $divider"
    text-align start
    vertical-align top
}

// The column heads stay at the top, the row heads (the name of the field) at the start.
part "access.matrix-cell[variant=head]" {
    position sticky
    top 0
    background "$bg-sunken"
    color "$fg"
    font-weight "$weight-regular"
}

part "access.matrix-cell[variant=row]" {
    position sticky
    inset-inline-start 0
    // The words stand level with the control of the row: the middle of their line is the middle of a control.
    padding-block-start "calc($space-2 + ($size-control - $fs-ui * $lh-body) / 2)"
    background "$bg-surface"
    color "$fg"
    font-size "$fs-ui"
    line-height "$lh-body"
    font-weight "$weight-regular"
    min-width "$size-matrix-cell"
}

part "access.matrix-cell[variant=head]:first-child" {
    min-width "$size-matrix-cell"
    inset-inline-start 0
    z-index "$z-raised"
}

// The column of the role chosen beside the matrix for its preview (UX §5.2): its head is marked like the open page of a
// menu, and its cells carry the same fill, so the column is found at a glance once it is scrolled into view.
part "access.matrix-cell[state=chosen]" {
    background "$bg-selected"
}

part "access.matrix-cell[variant=head][state=chosen]" {
    use "current-item"
}

part "access.matrix-row:last-child access.matrix-cell" {
    border-bottom 0
}

part "access.cell" {
    use "column-tight"
    align-items flex-start
}

// In a matrix a cell is one line: the list of levels and, beside it, the button that takes a level set here away.
part "access.cell[variant=inline]" {
    flex-direction row
    align-items center
    gap "$space-1"
}

part "access.cell > field" {
    width "100%"
    min-width 0
}

part "access.preview-line" {
    font-size "$fs-md"
    color "$fg"
}

part "access.answer" {
    use "column-wrap"
    padding "$space-3"
    use "surface-box"
}

part "access.answer-head" {
    display flex
    flex-wrap wrap
    align-items baseline
    gap "$space-1 $space-3"
}

// The answer *Yes.* or *No.* in front of the reasons.
part "access.answer-verdict" {
    margin-inline-end "$space-1"
}

part "access.answer-verdict[variant=yes]" {
    color "$success"
}

part "access.answer-verdict[variant=no]" {
    color "$danger"
}

part "access.reasons" {
    margin 0
    color "$fg"
    font-size "$fs-base"
    line-height "$lh-text"
}

// A heading inside a card, below its own heading (a topic of access, a form that makes something).
part "access.topic" "card.topic" {
    margin 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
    color "$fg"
}

// The name and what is said about it stand in one box, and the sign that the row opens at the end of the row, in
// every layout (M5 exit, O16). On a phone the facts stand under the name, in the left column.
part "row-main" {
    display flex
    flex 1
    align-items center
    justify-content space-between
    gap "$space-3"
    min-width 0
}

// The sign that a row opens something: at the end of the row, in the middle of its height, never on a line of its own.
part "row-chevron" {
    display inline-flex
    flex none
    align-self center
    color "$fg-muted"
}

// ───────────── People ─────────────

part "people" {
    display block
    // About five rows high, never more than most of the screen: a row is as tall as its words need (nothing is
    // cut with an ellipsis), the list draws only the rows on screen.
    max-block-size "min($size-list-scroll, calc(5 * $size-person-row))"
    margin 0
    padding-block 0
    padding-inline "$ring-width"
    overflow-y auto
    use "surface-box"
}

// Where the browser has no scroll timelines these boxes keep the old cue (covers that scroll with the content). It comes after the six
// boxes, so their own backgrounds do not reset it. The rows of `list-scroll` are opaque and paint over it: there that cue is not seen (accepted).
part "overlay.dialog" "picker.options[variant=list]" "list-scroll" "window.body" "confirm.body" "people" "search-panel" "bottom-sheet search-bar" "search-suggestions" "side-panel.body" "list-panel" {
    supports "not (animation-timeline: scroll())" {
        use "scroll-cue"
    }
}

// The covers of the old cue in the list of people and in Customize are the color of their box, the plain surface.
part "people" "list-panel" {
    supports "not (animation-timeline: scroll())" {
        --cue-cover "$bg-surface"
    }
}

// A row of the list is as tall as its words: the name, the address and the groups and roles under it, each one
// wrapping where the line ends, and the chevron at the end.
part "people.person" {
    use "pick-row"
    position relative
    padding-inline-end "calc($space-3 + $size-icon-small + $space-2)"
    border-bottom "$border-width solid $divider"
}

part "people.person-text" {
    display flex
    flex-direction column
    gap "$space-1"
    min-width 0
}

// The chevron stands at the end of the row, in the middle of its height.
part "people.person row-chevron" {
    position absolute
    inset-inline-end "$space-3"
    top "50%"
    transform "translateY(-50%)"
}

part "people.person[hovered]" {
    background "$bg-hover"
}

part "people.person[focus-visible]" {
    use "ring-inside"
}

part "people.person-name" {
    font-size "$fs-md"
    font-weight "$weight-regular"
    line-height "$lh-body"
    color "$fg"
    overflow-wrap anywhere
}

part "people.person-facts" {
    color "$fg-muted"
    font-size "$fs-base"
    line-height "$lh-body"
    overflow-wrap anywhere
}

// ───────────── Roles ─────────────

part "roles.no-access" {
    margin 0
    color "$danger"
    font-size "$fs-base"
    font-weight "$weight-regular"
    line-height "$lh-body"
}

part "roles.topic" {
    display flex
    flex-direction column
    gap "$space-2"
    use "fieldset-reset"
}

part "roles.legend" {
    use "control-label"
    margin-block-end "$space-2"
    padding 0
}

part "roles.note" {
    use "control-hint"
    padding-inline-start "calc($space-5 + $space-3)"
}

// ───────────── Projects ─────────────

// The short name and the place of a project after its name. The short name has a column of its own,
// as wide as ten capitals need at most; the place stands beside it where there is room and under it
// where there is not, so no word is broken in the middle.
part "projects.details" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    min-width 0
    font-weight "$weight-regular"
    overflow-wrap break-word
}

part "projects.short" {
    flex "0 0 auto"
    min-width "$size-col-short"
}

part "projects.place" {
    flex "1 1 $size-col-place"
    min-width 0
}

part "projects.preview" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "projects.alert-line" {
    margin 0
}

// ───────────── Long previews (M2C-F80) ─────────────

// The preview of a change that touches many things: the sentence on top, then the things grouped
// by issue or by person, a few at a time, with *Show all*.
part "long-preview" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "long-preview.summary" {
    display block
    margin 0
    font-weight "$weight-regular"
}

part "long-preview.groups" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-2"
}

part "long-preview.group" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-2" "$space-3"
    min-width 0
}

part "long-preview.group[state=skipped]" {
    background "$bg-sunken"
}

part "long-preview.group-head" {
    display flex
    flex-wrap wrap
    align-items baseline
    gap "$space-1" "$space-3"
    min-width 0
    overflow-wrap anywhere
}

part "long-preview.lines" {
    use "quiet-column"
    padding-inline-start "$space-4"
}

// ───────────── Tags and labels, and changing many issues ─────────────

// The tags and labels of an issue, side by side.
part "chips" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    use "list-reset"
}

// A tag or label with the button that takes it off.
part "chip" {
    display inline-flex
    align-items center
    gap "$space-1"
}

// The bar of the issues ticked (UX §4.2): under the list, where ticking moves nothing above it; the box of the rows takes
// the rest of the window, so the bar is always in view. With nothing ticked it has no look.
part "selected-bar" {
    display flex
    flex-direction column
    gap "$space-2"
}

// A bar with nothing in it (nothing ticked, no outcome of a change to show) takes no room, so the column of the list has
// no gap for it and the box of the rows ends where the column ends. Whatever it shows (the outcome of a change of many
// issues after the ticks are cleared) stands in the flow, under the last row.
part "selected-bar:empty" {
    display none
}

// At the foot of the list (the box of the rows takes the rest of the window), sticky to the bottom where the page scrolls.
part "selected-bar[state=active]" {
    use "floating-box"
    position sticky
    inset-block-end 0
    z-index "$z-sticky"
    padding "$space-2" "$space-3"
    margin-block-start "$space-3"
    border-radius "$r-card"
}

// On a phone the bar stands in the column of the app above the bottom navigation (like the bar of an issue): fixed there, it covers no card.
part "app-layout[variant=phone] selected-bar[state=active]" {
    position static
    max-height "$size-bar-ticked"
    overflow-y auto
}

// What the bar offers for the issues ticked.
part "many-change-bar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// How far a change that goes on in the background is.
part "many-change-progress" {
    display flex
    flex-direction column
    gap "$space-2"
}

// ───────────── Project tree (sidebar) ─────────────

// What is inside a project stands a little in from it.
part "project-tree.row" {
    display flex
    align-items center
    gap "$space-1"
}

part "project-tree.toggle" "project-tree.spacer" {
    display inline-flex
    flex none
    align-items center
    justify-content center
    box-sizing border-box
    width "$size-control"
    min-height "$size-control"
}

part "project-tree.toggle" {
    padding 0
    border 0
    border-radius "$r-ctl"
    background transparent
    color "$fg"
    cursor pointer
}

part "project-tree.toggle[hovered]" {
    background "$bg-hover"
}

part "project-tree.toggle[focus-visible]" {
    use "ring"
}

// The arrow points down while what is inside is open.
part "project-tree.toggle[state=open] icon" {
    transform "rotate($angle-open)"
}

part "project-tree.link" {
    display flex
    flex 1
    align-items center
    justify-content space-between
    gap "$space-2"
    box-sizing border-box
    min-width 0
    min-height "$size-control"
    // The text of a project starts where the text of the other items of the sidebar starts: the arrow before it takes the room of the icon.
    padding "0 $space-3 0 $space-1"
    border-radius "$r-ctl"
    use "menu-text"
}

part "project-tree.link[hovered]" {
    background "$bg-hover"
}

part "project-tree.link[focus-visible]" {
    use "ring"
}

part "project-tree.link[current]" {
    use "current-item"
}

part "project-tree.short" {
    flex none
    color "$fg-muted"
    font-size "$fs-sm"
    font-weight "$weight-regular"
}

part "project-tree.link[current] project-tree.short" {
    color "$accent-fg"
}

// The one line of a section of the sidebar (or of the sheet More) with nothing in it yet: the projects and the saved
// searches alike, under their heading (UX §3.1).
part "sidebar.note" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

// ───────────── My settings ─────────────

part "region-page.example" {
    use "note-box"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-base"
}

part "theme-picker.name" {
    text-align center
}

part "theme-preview" {
    display flex
    flex-direction column
    gap "$space-1"
    box-sizing border-box
    width "calc($space-6 * 3)"
    padding "$space-2"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-canvas"
}

part "theme-preview.bar" {
    height "$space-2"
    border-radius "$r-ctl"
    background "$accent"
}

part "theme-preview.card" {
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-2"
    use "surface-box"
}

part "theme-preview.line" {
    height "$space-1"
    border-radius "$r-ctl"
    background "$fg-muted"
}

part "theme-preview.line[variant=short]" {
    width "$size-sample-short"
}

part "access-keys.item-text" {
    use "column-wrap"
    flex "1 1 $size-list"
}

part "access-keys.prefix" {
    font-family "$font-mono"
    font-size "$fs-base"
}

part "access-keys.expired" {
    color "$danger"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

part "access-keys.more" {
    padding "$space-3"
    use "surface-box"
}

part "access-keys.more-title" {
    min-height "$size-control"
    display flex
    align-items center
    font-weight "$weight-regular"
    cursor pointer
}

part "access-keys.more-body" {
    display flex
    flex-direction column
    gap "$space-4"
    margin-top "$space-3"
}

part "access-keys.group" {
    display flex
    flex-direction column
    gap "$space-1"
    use "fieldset-reset"
}

part "access-keys.legend" {
    use "control-label"
    padding 0
    margin-bottom "$space-1"
}

// ───────────── Shell ─────────────

// What the sheets, the menus and the panels of the shell have in common.

part "shell.content" {
    display flex
    flex 1
    flex-direction column
    gap "$space-4"
    min-width 0
}

part "shell.section-heading" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

// In the sheet *More* the heading starts where the line *Signed in as* above it starts: the sheet has
// its own padding, and the heading needs none of the one that lines it up with the items of the menu.
part "shell.sheet shell.section-heading" {
    padding-inline 0
}

part "shell.fill" {
    flex 1
    min-width 0
}

part "shell.sheet" {
    display flex
    flex-direction column
    gap "$space-3"
    padding "$space-4"
}

part "shell.sheet-head" {
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
}

part "shell.title" {
    margin 0
    font-size "$fs-lg"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// The pages before sign-in: the name, the narrow content and the choice of theme in one column, in the middle of the window
// (M5 exit: it stood about 70 px left of the middle in a wider frame), each the same gap from the next.
part "shell.page" {
    display flex
    flex-direction column
    gap "$space-5"
    max-width "$size-form"
    margin 0 auto
    padding "$space-4"
}

// The content does not grow to push the choice of theme to the foot of the window: it follows at the gap of the column.
part "shell.page > shell.content" {
    flex none
}

part "shell.header" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-4"
}

part "shell.brand" {
    font-size "$fs-lg"
    font-weight "$weight-regular"
    color "$accent-fg"
}

part "shell.content:focus" {
    outline none
}

// The narrow content of the pages before sign-in starts on the same edge as the name of the product
// above it and the choice of theme below it (R1), not centered between them.
part "shell.narrow" {
    width "100%"
    max-width "$size-form"
}

// As wide as the column of the page, so no wider than the card above it: the choices of theme wrap there as they do on a phone.
part "shell.footer" {
    padding-top "$space-4"
    border-top "$border-width solid $divider"
}

part "app-layout" {
    display flex
    min-height "100%"
    background "$bg-canvas"
}

part "app-layout.column" {
    display flex
    flex 1
    flex-direction column
    min-width 0
}

// The page scrolls inside this frame. It is also where the hidden parts (the box of a switch, a
// choice) are placed, so that one far down the page does not make the document itself taller.
part "app-layout.main" {
    position relative
    display flex
    flex 1
    flex-direction column
    min-width 0
    padding "$size-page-gutter"
}

// What a phone shows under the page and above the bar of the app: the bar of the open issue. It is
// a part of the column, not drawn over the page, so no part of the page is ever under it.
part "app-layout.bar-slot" {
    display flex
    flex-direction column
}

part "app-layout.main:focus" {
    outline none
}

// While a window is minimized to its strip at the bottom of the page, the page has room for the strip under its end, so
// the strip covers no row of a list and no frame of a card at the end of the page (M5 exit, O7). On the page of a list the
// box of the rows takes the rest of the window, so this is the one place the strip's room is taken off.
part "app-layout:has(window-dock) app-layout.main" {
    padding-block-end "calc($size-page-gutter + $size-dock-strip)"
}

// The focus view takes the whole width, so the strip has the gutter only.
part "app-layout:has(app-layout.inner[variant=wide]) window-dock" {
    padding-inline "$size-page-gutter"
}

part "app-layout.inner" {
    use "page-body"
}

// The focus view (M2C-F81) takes the whole width that the narrowed sidebar leaves.
part "app-layout.inner[variant=wide]" {
    use "page-column-wide"
}

// An item of a list on a phone is a screen of its own: the page column and what else the content holds give way to it.
part "item-screen" {
    use "page-body"
}

part "app-layout.main:has(item-screen) app-layout.inner" {
    display none
}

// The link that jumps to the content, in the app and before sign-in: out of sight until it has the focus.
part "skip" {
    position absolute
    left "$space-2"
    top "$space-2"
    z-index "$z-top"
    padding "$space-2 $space-3"
    border-radius "$r-ctl"
    background "$bg-raised"
    color "$accent-fg"
    font-weight "$weight-regular"
    transform "translateY($skip-offset)"
}

part "skip:focus" {
    transform "translateY(0)"
}

part "app-layout[variant=phone]" {
    height "100%"
    min-height 0
}

part "app-layout[variant=phone] app-layout.column" {
    height "100%"
}

part "app-layout[variant=phone] app-layout.main" {
    min-height 0
    overflow-y auto
}

part "sidebar" {
    position sticky
    top 0
    align-self flex-start
    box-sizing border-box
    display flex
    flex none
    flex-direction column
    gap "$space-4"
    width "$size-sidebar"
    height "$size-viewport"
    overflow-y auto
    padding "$space-3"
    border-right "$border-width solid $divider"
    background "$bg-surface"
}

part "sidebar[variant=narrow]" {
    width "$size-sidebar-narrow"
    align-items center
}

part "sidebar[variant=drawer]" {
    position static
    height auto
    overflow-y visible
    border-right 0
    background transparent
}

part "sidebar.brand" {
    padding "$space-2 $space-3"
    color "$accent-fg"
    font-size "$fs-lg"
    font-weight "$weight-regular"
}

part "sidebar.brand[variant=narrow]" {
    padding "$space-2 0"
    font-size "$fs-base"
}

part "sidebar.list" "sidebar.bottom" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
    use "list-reset"
}

part "sidebar.bottom" {
    margin-top auto
}

part "sidebar.section" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
}

part "sidebar.person" {
    display flex
    flex-direction column
    gap "$space-1"
    width "100%"
    padding-top "$space-3"
    border-top "$border-width solid $divider"
}

part "sidebar.who" {
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    overflow-wrap anywhere
}

part "nav-item" {
    position relative
    use "touch-row"
    box-sizing border-box
    width "100%"
    padding "0 $space-3"
    border 0
    border-radius "$r-ctl"
    background transparent
    use "menu-text"
    font-family "$font-ui"
    text-align start
}

part "nav-item[hovered]" {
    background "$bg-hover"
}

part "nav-item[pressed]" {
    background "$bg-selected"
}

part "nav-item[current]" {
    use "current-item"
}

part "nav-item[focus-visible]" {
    use "ring"
}

part "nav-item[state=busy]" {
    use "busy"
}

part "nav-item.label" {
    flex 1
    min-width 0
    overflow-wrap anywhere
}

// Who a shared saved search is by: a second, quiet line under its name.
part "nav-item.by" {
    display block
    font-size "$fs-xs"
    color "$fg-muted"
}

part "nav-item.tooltip" {
    padding "$space-1 $space-3"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-raised"
    box-shadow "$shadow"
    color "$fg"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

part "bottom-bar" {
    border-top "$border-width solid $divider"
    background "$bg-surface"
    padding-bottom "env(safe-area-inset-bottom)"
}

part "bottom-bar.tabs" {
    display flex
    use "list-reset"
}

// A tab is as wide as its words need and shares the rest of the bar: the five tabs of a small phone
// do not have the same width, because *Notifications* is longer than *New*.
part "bottom-bar.tab" {
    display flex
    flex "1 1 auto"
    min-width min-content
}

part "bottom-bar.item" {
    use "column-tight"
    flex 1
    align-items center
    justify-content center
    box-sizing border-box
    min-height "$size-bar"
    padding "$space-2 $space-1"
    use "bare-button"
    color "$fg"
    font-size "$fs-base"
    font-weight "$weight-regular"
    text-decoration none
}

part "bottom-bar.item[hovered]" {
    background "$bg-hover"
}

// A tab of the bar is current where its place is open (isCurrentPlace): a link on its page, the Search tab, a button that
// opens quick search, on the Search page and a saved search, so a phone shows where one is like the sidebar does.
part "bottom-bar.item[state=current]" {
    use "current-item"
}

part "bottom-bar.item[focus-visible]" {
    use "ring-inside"
}

// A word is never broken inside: a tab is at least as wide as its longest word (five tabs, larger text,
// a small phone), and the words of a tab that has several wrap between words only.
part "bottom-bar.label" {
    max-width "100%"
    overflow-wrap normal
    hyphens manual
    text-align center
}

part "top-bar" {
    position sticky
    top 0
    z-index "$z-sticky"
    use "phone-bar"
    border-bottom "$border-width solid $divider"
}

part "top-bar.crumbs" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-1"
    use "list-reset"
}

part "top-bar.crumb" {
    display inline-flex
    align-items center
    gap "$space-1"
    color "$fg-muted"
}

part "top-bar.up" {
    color "$accent-fg"
    font-weight "$weight-regular"
    text-decoration underline
    text-underline-offset "$space-1"
}

part "top-bar.up[focus-visible]" {
    use "ring"
}

part "top-bar.title" {
    flex 1
    min-width 0
    overflow hidden
    font-size "$fs-lg"
    font-family "$font-display"
    font-weight "$weight-bold"
    text-overflow ellipsis
    white-space nowrap
}

part "side-panel" {
    use "floating-box"
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    width "$size-panel"
    max-width "100%"
    padding "$space-4"
    border-radius "$r-card"
}

part "side-panel.head" {
    display flex
    flex none
    align-items center
    gap "$space-3"
}

// What the panel holds scrolls under its head, with room for the rings of what is inside it (L7).
part "side-panel.body" {
    flex "1 1 auto"
    min-height 0
    overflow-y auto
    use "ring-room"
    use "ring-room-flush"
}

part "side-panel.body::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $ring-room)"
    }
}

part "side-panel.body::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $ring-room)"
    }
}

// Beside a list the panel is a box of its own as high as the window at most: it keeps its place under the top bar while
// the page scrolls, and what does not fit scrolls in its body (L7, UX §3.2).
part "list-editor side-panel" {
    position sticky
    top "calc($size-bar + $size-page-gutter)"
    max-height "calc($size-viewport - $size-bar - 2 * $size-page-gutter)"
}

// On the page of a list the page itself does not scroll (its main box does, under the top bar): the panel is as high as
// the line it shares with the list, and keeps a gutter from the top of that box when it does scroll.
part "list-editor:has(list-main) side-panel" {
    top "$size-page-gutter"
    max-height none
}

part "side-panel.title" {
    flex 1
    min-width 0
    margin 0
    font-size "$fs-lg"
    overflow-wrap anywhere
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "side-panel.title:focus" {
    outline none
}

part "more-sheet.who" {
    margin 0
    color "$fg-muted"
    font-size "$fs-base"
    overflow-wrap anywhere
}

part "quick-search" {
    display flex
    flex-direction column
    gap "$space-3"
    min-height 0
    padding "$space-4"
}

part "quick-search.head" {
    display flex
    align-items flex-end
    gap "$space-2"
}

part "quick-search.results" {
    display flex
    flex-direction column
    gap "$space-2"
    margin 0
    padding 0
    outline none
}

part "quick-search.heading" {
    padding "$space-1 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

part "quick-search.item" {
    use "pick-row"
    border-radius "$r-ctl"
    outline none
}

part "quick-search.item[hovered]" {
    background "$bg-hover"
}

part "quick-search.item[disabled]" {
    opacity "$opacity-disabled"
}

part "quick-search.item[focused]" {
    background "$bg-selected"
    use "ring-inside"
}

part "quick-search.title" {
    font-size "$fs-md"
    font-weight "$weight-regular"
}

part "quick-search.empty" {
    margin 0
    padding "$space-3"
    color "$fg-muted"
}

// One sentence of what a screen reader says about the results: each stands on a line of its own.
part "quick-search.said" {
    display block
}

part "quick-search.quiet" {
    margin 0
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
}

part "settings-frame" {
    display flex
    align-items flex-start
    gap "$space-5"
}

part "settings-frame.menu" {
    flex none
    width "$size-menu"
}

part "settings-frame.groups" "settings-frame.topics" {
    display flex
    flex-direction column
    use "list-reset"
}

part "settings-frame.groups" {
    gap "$space-4"
}

part "settings-frame.topics" {
    gap "$space-1"
}

part "settings-frame.heading" {
    padding "0 $space-3"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

// The offers stand over the page at the bottom of the column the page is drawn in, in the middle of
// it, so they follow the sidebar and the window by themselves (the re-check of WP-18). The host is
// the last thing in the column of the page, as high as nothing: it sticks to the bottom of the
// window, and the offers rise from it. What an offer may cover is the page at the bottom of that
// column for its ten seconds; the Details of an issue it never covers.
part "undo-host" {
    display flex
    flex-direction column
    align-items center
    gap "$space-2"
    pointer-events none
}

part "undo-host[variant=over-page]" {
    use "page-column"
    position sticky
    bottom "$space-4"
    z-index "$z-panel"
    justify-content flex-end
    height 0
    margin-top auto
}

// The focus view of an issue has its Details at the end of the column: the offers stand in the room
// the text has (the column less the room of the Details, the same room the page leaves them), so a
// long sentence wraps there and never reaches over them.
part "undo-host[variant=wide]" {
    use "page-column-wide"
    padding-inline-end "$size-details-room"
    box-sizing border-box
}

part "undo-host.offer" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-3"
    use "floating-box"
    max-width "100%"
    padding "$space-3 $space-4"
    border-radius "$r-card"
    pointer-events auto
}

// On a phone the offers are not drawn over the page: they stand in the column of the app between the
// page and the bars at the bottom, so they cover neither the page nor a bar, and the page above
// them is a little shorter while there is one.
part "undo-host[variant=in-flow]" {
    position static
    z-index auto
    align-items stretch
    gap 0
}

part "undo-host[variant=in-flow] undo-host.offer" {
    margin "$space-2 $space-4 0"
    max-width none
}

part "focus-view" {
    display flex
    align-items flex-start
    gap "$space-4"
    min-width 0
}

part "focus-view.list" {
    display flex
    flex none
    flex-direction column
    gap "$space-2"
    box-sizing border-box
    width "$size-list"
    max-width "100%"
}

part "focus-view.bar" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// ───────────── Issues (features/issues, packages/ui: InPlaceText, ActionMenu) ─────────────
//
// The issue page (UX §4.4) and the list of a project's issues (UX §4.2). The layout of the page
// (focus view, side panel, phone) is chosen by the app; the variants here only say which.

// A value that is changed where it stands: it looks like the text around it until it is pressed.
part "in-place.text" {
    font-family inherit
    font-size inherit
    overflow-wrap anywhere
}

part "in-place.button" {
    use "bare-button"
    use "hang-start"
    box-sizing border-box
    max-width "100%"
    min-height "$size-control"
    padding 0 "$pad-control"
    border-radius "$r-ctl"
    color inherit
    font-size inherit
    font-weight inherit
    text-align start
    overflow-wrap anywhere
}

part "in-place.button:hover" {
    background "$bg-hover"
}

part "in-place.button:focus-visible" {
    use "ring"
}

part "in-place.input" {
    use "input-box"
}

part "in-place.input:focus" {
    use "ring"
}

// The list of actions that opens from a button, inside the one overlay.
// The list of an action menu on a computer opens under its button.
part "popover" {
    use "floating-box"
    min-width "$size-name"
    padding "$space-2"
    border-radius "$r-card"
    color "$fg"
}

// Starts where the icon of an entry starts: the entry has a border of its own besides its padding.
part "action-menu.title" {
    margin 0
    padding "$space-2 calc($pad-control + $border-width)"
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
}

part "action-menu" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-1"
}

part "issue-page" {
    display flex
    flex-direction column
    gap "$space-4"
    min-width 0
}

part "issue-head" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

part "issue-head.kind" {
    display inline-flex
    align-items center
    gap "$space-2"
    color "$fg-muted"
    font-size "$fs-md"
}

part "issue-head.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    margin-inline-start auto
}

part "issue-title" {
    width "100%"
    margin 0
    font-size "$fs-xl"
    line-height "$lh-snug"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// The big status button under the title, and what stands beside it.
part "issue-status-line" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// On a smaller screen the Details sit behind a button that still says the main values.
part "issue-details-toggle" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// What the closed button says (who it is assigned to, the priority): one size for the words and the
// priority beside them, which are the size of every row (the review of M4, B issue page).
part "issue-details-summary" {
    display inline-flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    color "$fg-muted"
    font-size "$fs-ui"
}

part "issue-body" {
    display flex
    align-items flex-start
    gap "$gap-details"
}

part "issue-body[variant=stacked]" {
    flex-direction column
    align-items stretch
}

part "issue-main" {
    display flex
    flex 1
    flex-direction column
    gap "$space-5"
    min-width 0
    max-width "$size-main"
}

// Details on wide screens keep their own scroll bar, so long details never push the description away.
part "issue-details" {
    use "surface-box"
    display flex
    flex none
    flex-direction column
    gap "$space-3"
    box-sizing border-box
    width "$size-details"
    max-height "$size-viewport"
    // Room at the sides for the focus ring of a button that hangs back (the box scrolls, so it clips).
    padding "$space-3 $space-4"
    overflow-y auto
}

part "issue-details[variant=stacked]" {
    width "100%"
    max-height none
    overflow-y visible
}

part "issue-details.heading" {
    margin 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "issue-section" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

part "issue-section.head" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2"
}

part "issue-section.title" {
    margin 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
}

part "issue-section.reading" {
    max-width "$size-reading"
    min-width 0
}

part "issue-section.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// The draft a refused save left (`draft-note`) stands like the other notes of the issue.
part "issue-note" "draft-note" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
}

// The two texts of *Compare and save* side by side, paragraph by paragraph.
part "issue-compare" {
    display flex
    flex-direction column
    gap "$space-3"
}

part "issue-compare.row" {
    use "fieldset-reset"
    display grid
    grid-template-columns "repeat(2, minmax(0, 1fr))"
    gap "$space-3"
}

part "issue-compare.row[variant=stacked]" {
    grid-template-columns "minmax(0, 1fr)"
}

part "issue-compare.choice" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
}

part "issue-compare.choice[variant=full]" {
    grid-column "1 / -1"
}

part "issue-compare.paragraph" {
    margin 0
    overflow-wrap anywhere
    white-space pre-wrap
}

// The words that the other text does not have (M3-F54): a fill and an underline, so they are not
// told by color alone.
part "issue-compare.changed" {
    background "$warning-soft"
    color "$fg"
    text-decoration underline
    text-underline-offset "$space-1"
    use "marked"
}

part "issue-row" {
    use "surface-box"
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
    padding "$space-2" "$space-3"
}

// The way to the field permissions next to the note is a target a finger can hit.
part "layout-field.limited link" {
    use "touch-link"
}

// On a phone: the bar with the most used actions of an issue, in the slot above the bar of the app. Its three buttons
// share the width in equal parts, and it has the surface of the bars of the app, not the color of the page (M5 exit, L1).
part "issue-bar" {
    display flex
    gap "$space-2"
    padding "$space-2"
    border-top "$border-width solid $divider"
    background "$bg-surface"
}

part "issue-bar.item" {
    flex "1 1 0"
    min-width 0
}

// The page of an issue scrolls under the bar of actions: a shadow at the end of the page while there is more below it
// (L6; the top of the page scrolls under the top bar and needs none). The line stands at the end of the scrolling
// frame, so the padding of the frame is taken back.
part "app-layout.column:has(issue-bar) app-layout.main::after" {
    supports "(animation-timeline: scroll())" {
        use "edge-block"
        use "edge-from-end"
        bottom "calc(-1 * $size-page-gutter)"
        margin-inline "calc(-1 * $size-page-gutter)"
    }
}

part "key-capture-field.label" {
    use "control-label"
}

part "key-capture-field.box" {
    use "input-box"
    cursor text
}

part "key-capture-field.box:focus" {
    use "ring"
}

// The keys of one shortcut never break inside their combination: "G then H" is one thing.
part "keys" {
    display inline-flex
    align-items center
    gap "$space-1"
    white-space nowrap
}

part "keys.chord" {
    display inline-flex
    align-items center
    gap "$space-1"
}

part "keys.then" {
    color "$fg-muted"
    font-size "$fs-sm"
}

part "keys.key" {
    display inline-block
    min-width "$space-5"
    padding "0 $space-2"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-surface"
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-base"
    line-height "$lh-loose"
    text-align center
}

part "list-editor" {
    display flex
    flex-wrap wrap
    align-items flex-start
    gap "$space-4"
}

part "list-editor.list" {
    display flex
    flex 1
    flex-direction column
    gap "$space-3"
    min-width 0
}

// A row of the list is one button: pointing at it, or having it open, shows it (R8: a whole row is
// clickable and is not underlined; R4: the open one is marked).
part "list-editor.open" {
    use "surface-box"
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
    box-sizing border-box
    width "100%"
    min-height "$size-row"
    padding 0 "$pad-box"
    color "$fg"
    font-family "$font-ui"
    font-size "$fs-md"
    text-align start
    cursor pointer
}

// The name breaks only between its words, and inside a word only when the word alone is wider than its
// column (the review of M4: "Web-site" cut in two). The same two columns in every row line the details up.
// A list whose rows have several columns of their own (the projects: the name, the short name and
// the place) gives the rows the same two columns, so the details line up from row to row.
part "list-editor.open[variant=columns]" {
    display grid
    grid-template-columns "minmax(0, 1fr) auto auto"
    align-items baseline
    column-gap "$space-3"
    row-gap "$space-1"
    padding-block "$space-2"
}

part "app-layout[variant=phone] list-editor.open" {
    padding-block "$space-2"
}

part "app-layout[variant=phone] row-main" {
    use "stacked-facts"
}

part "list-editor.open[variant=columns] row-main" {
    display contents
}

part "list-editor.name" {
    display inline-flex
    align-items center
    gap "$space-2"
    min-width 0
    font-weight "$weight-regular"
    overflow-wrap break-word
}

part "list-editor.details" {
    display inline-flex
    align-items center
    gap "$space-2"
}

// A row with no details (a group) is only its name: nothing is left under it, so the name stands in the middle of the row.
part "list-editor.details:empty" {
    display none
}

// The name and the short name stand on one line; where the project sits stands muted under them; a chevron says the row opens (A13).
part "list-editor.open[variant=columns] list-editor.details" "list-editor.open[variant=columns] projects.details" {
    display contents
}

part "list-editor.open[variant=columns] projects.short" {
    grid-column 2
    grid-row 1
    color "$fg-muted"
    font-family "$font-mono"
}

part "list-editor.open[variant=columns] projects.place" {
    grid-column "1 / 3"
    grid-row 2
}

part "list-editor.open[variant=columns] row-chevron" {
    grid-column 3
    grid-row "1 / span 2"
}

part "list-editor.open[hovered]" {
    background "$bg-hover"
}

part "list-editor.open[focus-visible]" {
    use "ring"
}

part "list-editor.open[state=open]" {
    border-color "$accent"
    background "$bg-selected"
    color "$accent-fg"
    use "marked"
}

part "list-editor.nothing" {
    margin 0
    color "$fg-muted"
}

// The browser hides an element with the attribute, but the part here would show it again.
part "list-editor.list[state=hidden]" {
    display none
}

part "shell-overlays" {
    display flex
    flex-direction column
    align-items flex-end
    gap "$space-2"
    padding "$space-2"
}

// The rows *Keys now* and *Usual keys* share one column for their labels, as wide as the longer of the
// two in the font and the size the person has, so the keys of both rows start on one edge.
part "shortcut-editor.rows" {
    display grid
    grid-template-columns "max-content minmax(0, 1fr)"
    align-items center
    gap "$space-2"
}

part "shortcut-editor.row" {
    display grid
    grid-column "1 / -1"
    grid-template-columns subgrid
    align-items center
    margin 0
}

part "shortcut-editor.keys" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "shortcut-editor.label" {
    font-weight "$weight-regular"
}

part "shortcut-help.intro" {
    margin 0
    color "$fg-muted"
}

part "shortcut-help.change" {
    align-self flex-start
    color "$accent-fg"
    font-weight "$weight-regular"
    text-decoration underline
    text-underline-offset "$space-1"
}

part "shortcut-help.change[focus-visible]" {
    use "ring"
}

part "shortcut-list.what" {
    use "column-tight"
    flex 1
}

part "shortcut-list.name" {
    font-weight "$weight-regular"
}

part "shortcut-list.keys" {
    display inline-flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "shortcut-list.alternative" {
    display inline-flex
    align-items center
    gap "$space-2"
}

part "shortcuts-page.keys" {
    display inline-flex
    flex none
    align-items center
    justify-content flex-end
    gap "$space-2"
    white-space nowrap
}


// ───────────── Markdown (packages/ui: MarkdownView, MarkdownEditor) ─────────────
//
// The text of a person is HTML that `bb-markdown` wrote (ADR-0011): plain elements, a `span` for
// each issue ID and mention, and no class names. `markdown` is the part that holds it; the rules
// below style what the renderer writes inside it, with tokens only.

part "markdown" {
    font-family "$font-reader"
    min-width 0
    color "$fg"
    font-size "$fs-md"
    line-height "$lh-text"
    overflow-wrap anywhere
}

base "[data-part=markdown] p" "[data-part=markdown] ul" "[data-part=markdown] ol" "[data-part=markdown] pre" "[data-part=markdown] blockquote" "[data-part=markdown] table" "[data-part=markdown] hr" "[data-part=markdown] h1" "[data-part=markdown] h2" "[data-part=markdown] h3" "[data-part=markdown] h4" "[data-part=markdown] h5" "[data-part=markdown] h6" {
    margin 0 0 "$space-3"
}

base "[data-part=markdown] > :last-child" {
    margin-bottom 0
}

base "[data-part=markdown] h1" "[data-part=markdown] h2" "[data-part=markdown] h3" "[data-part=markdown] h4" "[data-part=markdown] h5" "[data-part=markdown] h6" {
    font-size "$fs-md"
    font-weight "$weight-bold"
    line-height "$lh-snug"
}

base "[data-part=markdown] h1" {
    font-size "$fs-xl"
}

base "[data-part=markdown] h2" {
    font-size "$fs-lg"
}

base "[data-part=markdown] ul" "[data-part=markdown] ol" {
    padding-left "$space-5"
}

// What a person writes in bold in a description or a comment stays bold: it is their own emphasis.
base "[data-part=markdown] strong" "[data-part=markdown] b" {
    font-weight "$weight-bold"
}

base "[data-part=markdown] a" {
    color "$accent-fg"
    text-decoration underline
    text-underline-offset "$space-1"
}

base "[data-part=markdown] code" {
    font-family "$font-mono"
    font-size "$fs-base"
    padding 0 "$space-1"
    border-radius "$r-ctl"
    background "$bg-sunken"
}

base "[data-part=markdown] pre" {
    use "sunken-box"
    padding "$space-3"
    overflow-x auto
}

base "[data-part=markdown] pre code" {
    padding 0
    background none
}

base "[data-part=markdown] blockquote" {
    margin-left 0
    padding-left "$space-3"
    border-left "$space-1 solid $border"
    color "$fg-muted"
}

base "[data-part=markdown] table" {
    border-collapse collapse
}

base "[data-part=markdown] th" "[data-part=markdown] td" {
    padding "$space-1 $space-3"
    border "$border-width solid $border"
    text-align left
}

base "[data-part=markdown] hr" {
    border 0
    border-top "$border-width solid $divider"
}

base "[data-part=markdown] img" {
    max-width "100%"
    height auto
}

// An issue ID or a mention. The server resolves it with the viewer's rights and the page shows it
// as a chip; until then, and where it cannot be resolved, it is marked text.
base "[data-part=markdown] [data-token]" {
    // No room inside at the ends: a comma or a full stop after a mention stands against it, as in the text it was written in.
    padding 0
    border-radius "$r-ctl"
    background "$accent-soft"
    color "$accent-fg"
    font-weight "$weight-regular"
    white-space nowrap
    forced {
        text-decoration underline
    }
}

part "markdown.editor" {
    display flex
    flex-direction column
    gap "$space-2"
    min-width 0
}

// The row of formatting buttons wraps where it is too narrow: nothing is cut off or hidden at the
// edge (the review of M4, B issue page).
part "markdown.toolbar" {
    display flex
    flex-wrap wrap
    gap 0
}

part "markdown.preview" {
    use "surface-box"
    min-height "$size-control"
    padding "$space-3"
}

// ───────────── Sub-issues, related issues, history and followers (M3 WP-07) ─────────────
//
// The blocks of the issue page that WP-07 adds: a line for an issue with its status, how far the
// sub-issues are, the tabs of the history and one entry of it. The rest uses the shared parts.

part "issue-ref" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    min-width 0
}

// How far the sub-issues are: the browser's own bar, in the accent color.
part "progress" {
    inline-size "$size-line-medium"
    max-inline-size "100%"
    accent-color "$accent"
}

// One entry of the history: who, when, and what happened.
part "history.entry" {
    display flex
    flex-direction column
    gap "$space-1"
    padding "$space-3"
    use "surface-box"
}

part "history.entry[variant=comment]" {
    background "$bg-raised"
}

part "history.when" {
    use "quiet-text"
}

// ───────────── Files (features/files, M4 WP-05) ─────────────
//
// The Files block of the issue page and the files under a comment (UX §4.4): the place that takes
// files dropped on it, a row for each file and for each upload on its way, and the larger preview. The
// rest uses the shared parts (buttons, alerts, the bar of `progress`).

part "files.drop" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    padding "$space-3"
    // The place takes a press like a control, so its edge is the edge of a control (3:1, F-A11).
    border "$border-width dashed $border-control"
    border-radius "$r-card"
    color "$fg-muted"
    font-size "$fs-md"
}

// Files are being dragged over the place (React Aria marks it `drop-target`): it says "here" in the color of what is chosen.
part "files.drop[drop-target]" {
    border-color "$accent"
    background "$accent-soft"
    color "$accent-fg"
    use "marked"
}

part "files.row" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
    padding "$space-3"
    min-width 0
    use "surface-box"
}

part "files.tile" {
    display flex
    align-items center
    justify-content center
    flex-shrink 0
    box-sizing border-box
    inline-size "$size-file-tile"
    block-size "$size-file-tile"
    overflow hidden
    padding 0
    color "$fg-muted"
    font-size "$fs-base"
    font-weight "$weight-regular"
    text-transform uppercase
    use "sunken-box"
}

part "files.tile[variant=picture]" {
    cursor zoom-in
}

part "files.tile[hovered]" {
    background "$bg-hover"
}

part "files.tile[focus-visible]" {
    use "ring"
}

// The whole picture in the square, never cropped: a page of a PDF has its heading at the edge.
part "files.picture" {
    display block
    inline-size "100%"
    block-size "100%"
    object-fit contain
}

part "files.info" {
    display flex
    flex-direction column
    gap "$space-1"
    flex "1 1 $size-col-labels"
    min-width 0
    overflow-wrap anywhere
}

// Words that stay one piece in a sentence: a file name that never breaks at a hyphen, a name in a line of people, an
// example in brackets ("(a Team member)"). The piece goes to the next line as a whole, and is cut anywhere only where it
// is longer than the line itself (like an issue ID).
part "unbroken-word" {
    display inline-block
    max-width "100%"
    word-break break-all
}

// In a cell of the grid of a computer a line does not wrap: the pieces are plain words there, so a line too long for its
// column ends in the dots of the cell instead of a name clipped whole (the people of a row).
part "list-row[variant=grid] unbroken-word" {
    display inline
}

part "files.name" {
    font-weight "$weight-regular"
    font-size "$fs-md"
}

part "files.meta" {
    use "quiet-text"
}

// The words of a refusal and its buttons: side by side when they fit, the buttons at the end like in
// the rows of files; when they do not, the buttons come under the words, at their left edge.
part "files.refusal" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2 $space-4"
}

// The bar of an upload: as wide as the row lets it be, with the words about it after it when they
// fit and under it when they do not, so it never stops short on a narrow screen.
part "files.progress" {
    flex "1 1 $size-line-medium"
    min-inline-size 0
    accent-color "$accent"
}

part "files.actions" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

// The larger preview: as big as it is, never wider than the window.
part "files.large" {
    display block
    max-inline-size "100%"
    block-size auto
    margin-inline auto
    border-radius "$r-ctl"
}

// ───────────── Own fields (features/fields, packages/ui: FieldValue) ─────────────
//
// How the value of an own field is shown (CF-04): a badge, a pill, plain text, a progress bar or an
// avatar. A choice carries one of the twelve category colors as its variant (`cat1`…`cat12`); each
// pair is a text color on its own background, which STY-CONTRAST checks in every theme.

part "field-badge" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding 0 "$space-2"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
    font-weight "$weight-regular"
    line-height "$lh-snug"
    white-space nowrap
}

part "field-pill" {
    display inline-flex
    align-items center
    gap "$space-1"
    padding 0 "$space-3"
    border-radius "$r-pill"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
    line-height "$lh-snug"
    white-space nowrap
}

// A label in a list (UX §7.5): a small square in its color and its name in the plain text color, so the label does not compete with the priority.
part "label-chip" {
    display inline-flex
    align-items center
    gap "$space-1"
    color "$fg"
    white-space nowrap
}

// The square of a label (UX §7.5) is drawn like a swatch of its color: the fill, told apart from the other fills at a
// glance (the `distinct` rule), and an edge in the text color, seen on every surface. The text colors of two choice
// colors can look alike at this size; the fills cannot.
part "label-mark" {
    flex none
    box-sizing border-box
    width "$space-3"
    height "$space-3"
    border "$border-width solid currentColor"
}

part "field-text" {
    margin 0
    color "$fg"
    overflow-wrap anywhere
}

part "field-progress" {
    display flex
    align-items center
    gap "$space-2"
    min-width "$size-sample-short"
}

part "field-progress.bar" {
    flex 1
    width "100%"
    accent-color "$accent"
}

part "field-avatar" {
    display inline-flex
    align-items center
    gap "$space-2"
    color "$fg"
}

part "field-avatar.face" {
    display inline-flex
    align-items center
    justify-content center
    width "$space-5"
    height "$space-5"
    border-radius "$r-pill"
    background "$accent-soft"
    color "$accent-fg"
    font-size "$fs-xs"
    font-weight "$weight-regular"
}

part "field-swatch" {
    display inline-flex
    align-items center
    justify-content center
    min-width "$size-control"
    min-height "$size-control"
    padding 0 "$space-2"
    // The edge is the text color of the swatch, seen at 3:1 on every surface (the `lines` rule of the choice colors).
    border "$border-width solid currentColor"
    border-radius "$r-ctl"
    background "$bg-sunken"
    color "$fg"
    font-size "$fs-sm"
}

// The choice of a color (of a label, a tag, a choice of an own field) is a choice group of the grid look with a swatch
// for each choice. The chosen swatch has a ring and a tick, so it is told by more than its color.
part "choice-group.choice field-swatch" {
    flex 1
    gap "$space-1"
}

// The tick takes no room until its swatch is chosen.
part "field-swatch.tick" {
    display none
}

part "choice-group.input:checked + field-swatch field-swatch.tick" {
    display inline-flex
}

part "choice-group.input:checked + field-swatch" {
    border "$border-width solid $accent"
    box-shadow "0 0 0 $border-width $accent"
    use "marked"
}

part "choice-group.input:focus-visible + field-swatch" {
    use "ring"
}

part "field-sample" {
    use "fieldset-reset"
    display flex
    flex-wrap wrap
    gap "$space-3"
}

part "field-sample.theme" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    border "$border-width solid $border"
    border-radius "$r-ctl"
    background "$bg-canvas"
    color "$fg"
    font-size "$fs-sm"
}

part "field-choice" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    padding "$space-2"
    border "$border-width solid $border-subtle"
    border-radius "$r-ctl"
    background "$bg-surface"
}


part "field-badge[variant=cat1]" "field-pill[variant=cat1]" "field-swatch[variant=cat1]" "label-mark[variant=cat1]" {
    background "$cat1-bg"
    color "$cat1-fg"
}

part "field-badge[variant=cat2]" "field-pill[variant=cat2]" "field-swatch[variant=cat2]" "label-mark[variant=cat2]" {
    background "$cat2-bg"
    color "$cat2-fg"
}

part "field-badge[variant=cat3]" "field-pill[variant=cat3]" "field-swatch[variant=cat3]" "label-mark[variant=cat3]" {
    background "$cat3-bg"
    color "$cat3-fg"
}

part "field-badge[variant=cat4]" "field-pill[variant=cat4]" "field-swatch[variant=cat4]" "label-mark[variant=cat4]" {
    background "$cat4-bg"
    color "$cat4-fg"
}

part "field-badge[variant=cat5]" "field-pill[variant=cat5]" "field-swatch[variant=cat5]" "label-mark[variant=cat5]" {
    background "$cat5-bg"
    color "$cat5-fg"
}

part "field-badge[variant=cat6]" "field-pill[variant=cat6]" "field-swatch[variant=cat6]" "label-mark[variant=cat6]" {
    background "$cat6-bg"
    color "$cat6-fg"
}

part "field-badge[variant=cat7]" "field-pill[variant=cat7]" "field-swatch[variant=cat7]" "label-mark[variant=cat7]" {
    background "$cat7-bg"
    color "$cat7-fg"
}

part "field-badge[variant=cat8]" "field-pill[variant=cat8]" "field-swatch[variant=cat8]" "label-mark[variant=cat8]" {
    background "$cat8-bg"
    color "$cat8-fg"
}

part "field-badge[variant=cat9]" "field-pill[variant=cat9]" "field-swatch[variant=cat9]" "label-mark[variant=cat9]" {
    background "$cat9-bg"
    color "$cat9-fg"
}

part "field-badge[variant=cat10]" "field-pill[variant=cat10]" "field-swatch[variant=cat10]" "label-mark[variant=cat10]" {
    background "$cat10-bg"
    color "$cat10-fg"
}

part "field-badge[variant=cat11]" "field-pill[variant=cat11]" "field-swatch[variant=cat11]" "label-mark[variant=cat11]" {
    background "$cat11-bg"
    color "$cat11-fg"
}

part "field-badge[variant=cat12]" "field-pill[variant=cat12]" "field-swatch[variant=cat12]" "label-mark[variant=cat12]" {
    background "$cat12-bg"
    color "$cat12-fg"
}

// ───────────── The design pages (docs/design) ─────────────
//
// `docs/design/components.css` and `docs/design/docpage.css` style the documents and mockups in
// `docs/`, not the app. They are written here as `rule`s with plain CSS selectors (the pages use
// class names and elements) and use tokens only. Their own tokens are named `doc-…` and are written
// to `docs/design/theme.css` only: `doc-space-N` is a length of N pixels on the scale of the pages.
// With less motion (the device setting, or the person's choice) the motion tokens are 0, so the one
// animation of the pages stops without a rule of its own.

docs "components" description="Bugaboo shared components: base elements, buttons, chips, status pills, tags, people and fields. Used by every design page and mockup; needs theme.css." {
    tokens {
        line-height "doc-lh-page" "1.45"
        number "doc-brightness-down" 0.97
        number "doc-brightness-up" 1.08
        number "doc-stroke-width" 2
        opacity "doc-opacity-pulse" 0.35
        size "doc-font-11" "11px"
        size "doc-r-pill" "999px"
        size "doc-r-small" "4px"
        size "doc-space-1" "1px"
        size "doc-space-10" "10px"
        size "doc-space-110" "110px"
        size "doc-space-130" "130px"
        size "doc-space-18" "18px"
        size "doc-space-2" "2px"
        size "doc-space-20" "20px"
        size "doc-space-22" "22px"
        size "doc-space-5" "5px"
        size "doc-space-6" "6px"
        size "doc-space-7" "7px"
        size "doc-space-9" "9px"
        weight "doc-weight-medium" 500
        weight "doc-weight-semibold" 600
    }

    rule "html" {
        box-sizing border-box
    }

    rule "*" "*::before" "*::after" {
        box-sizing inherit
    }

    rule "body" {
        margin 0
        background "$bg-canvas"
        color "$fg"
        font-family "$font-ui"
        font-size "$fs-base"
        line-height "$doc-lh-page"
        -webkit-font-smoothing antialiased
    }

    rule "button" "input" "select" "textarea" {
        font-family inherit
        font-size inherit
        font-weight inherit
        font-style inherit
        line-height inherit
        color inherit
    }

    rule "button" {
        cursor pointer
    }

    rule ":focus-visible" {
        use "ring"
    }

    rule ".ico" {
        width "$space-4"
        height "$space-4"
        flex none
        fill none
        stroke currentColor
        stroke-width "$doc-stroke-width"
        stroke-linecap round
        stroke-linejoin round
    }

    rule ".ico.lg" {
        width "$doc-space-20"
        height "$doc-space-20"
    }

    rule ".mono" {
        font-family "$font-mono"
        font-variant-numeric tabular-nums
    }

    rule ".num" {
        font-variant-numeric tabular-nums
    }

    rule ".muted" {
        color "$fg-muted"
    }

    rule ".sr" {
        position absolute
        width "$doc-space-1"
        height "$doc-space-1"
        overflow hidden
        clip-path "inset(50%)"
        white-space nowrap
    }

    rule ".subtle" {
        color "$fg-subtle"
    }

    rule "kbd" {
        font-family "$font-mono"
        font-size "$doc-font-11"
        padding "$doc-space-1 $doc-space-5"
        border "$border-width solid $border"
        border-bottom-width "$doc-space-2"
        border-radius "$doc-r-small"
        color "$fg-muted"
        background "$bg-surface"
    }

    rule ".dot-live" {
        width "$space-2"
        height "$space-2"
        border-radius "50%"
        background "$accent"
        animation "doc-pulse $motion-pulse infinite"
    }

    keyframes "doc-pulse" {
        "50%" {
            opacity "$doc-opacity-pulse"
        }
    }

    rule ".btn" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-7 $space-3"
        border-radius "$r-ctl"
        border "$border-width solid $border"
        background "$bg-raised"
        color "$fg"
        font-weight "$doc-weight-medium"
        white-space nowrap
    }

    rule ".btn:hover" {
        background "$bg-hover"
    }

    rule ".btn.primary" {
        background "$accent"
        border-color "$accent"
        color "$on-accent"
    }

    rule ".btn.primary:hover" {
        filter "brightness($doc-brightness-up)"
    }

    rule ".btn.ghost" {
        border-color transparent
        background transparent
    }

    rule ".btn.ghost:hover" {
        background "$bg-hover"
    }

    rule ".btn.sm" {
        padding "$space-1 $doc-space-9"
        font-size "$fs-sm"
    }

    rule ".btn.danger" {
        color "$danger"
    }

    rule ".seg" {
        display inline-flex
        border "$border-width solid $border"
        border-radius "$r-ctl"
        overflow hidden
        background "$bg-surface"
    }

    rule ".seg button" {
        border 0
        background none
        padding "$doc-space-6 $space-3"
        display flex
        align-items center
        gap "$doc-space-6"
        color "$fg-muted"
    }

    rule ".seg button[aria-pressed=\"true\"]" {
        background "$bg-raised"
        color "$fg"
        font-weight "$doc-weight-semibold"
        box-shadow "inset 0 calc($doc-space-2 * -1) 0 $accent"
    }

    rule ".chips" {
        display flex
        flex-wrap wrap
        gap "$doc-space-6"
        flex 1
        min-width 0
    }

    rule ".chip" {
        display inline-flex
        align-items center
        gap "$space-1"
        padding "$space-1 $space-1 $space-1 $doc-space-10"
        border-radius "$doc-r-pill"
        border "$border-width solid $border"
        background "$bg-surface"
        font-size "$fs-sm"
    }

    rule ".chip > button" {
        border 0
        background none
        padding 0
        display inline-flex
        align-items center
        gap "$space-1"
    }

    rule ".chip .x" {
        width "$doc-space-22"
        height "$doc-space-22"
        border-radius "50%"
        justify-content center
        color "$fg-muted"
    }

    rule ".chip .x:hover" {
        background "$bg-hover"
        color "$fg"
    }

    rule ".chip b" {
        font-weight "$doc-weight-semibold"
    }

    rule ".chip.raw" {
        font-family "$font-mono"
        background "$bg-sunken"
        border-style dashed
    }

    rule ".chip.add" {
        padding "$space-1 $doc-space-10"
        border-style dashed
        color "$fg-muted"
        background transparent
    }

    rule ".key" {
        font-family "$font-mono"
        font-size "$fs-sm"
        color "$fg-muted"
        white-space nowrap
    }

    rule ".pill" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-2 $doc-space-9"
        border-radius "$doc-r-pill"
        font-size "$fs-sm"
        font-weight "$doc-weight-semibold"
        border 0
        white-space nowrap
    }

    rule ".pill::before" {
        content "\"\""
        width "$doc-space-7"
        height "$doc-space-7"
        border-radius "50%"
        background currentColor
    }

    rule ".st-ns" {
        use "status-soft-not-started"
    }

    rule ".st-ip" {
        use "status-soft-in-progress"
    }

    rule ".st-done" {
        use "status-soft-done"
    }

    rule "button.pill:hover" {
        filter "brightness($doc-brightness-down)"
        box-shadow "0 0 0 $border-width currentColor"
    }

    rule ".prio" {
        display inline-flex
        align-items center
        gap "$doc-space-5"
        white-space nowrap
    }

    rule ".prio.Critical" {
        color "$danger"
        font-weight "$doc-weight-semibold"
    }

    rule ".prio.High" {
        color "$warning"
        font-weight "$doc-weight-semibold"
    }

    rule ".prio.Medium" {
        color "$fg-muted"
    }

    rule ".prio.Low" {
        color "$fg-subtle"
    }

    rule ".tag" {
        display inline-block
        padding "$doc-space-1 $space-2"
        border-radius "$doc-r-pill"
        font-size "$fs-xs"
        font-weight "$doc-weight-semibold"
        margin-right "$space-1"
    }

    rule ".c1" {
        background "$cat1-bg"
        color "$cat1-fg"
    }

    rule ".c2" {
        background "$cat2-bg"
        color "$cat2-fg"
    }

    rule ".c3" {
        background "$cat3-bg"
        color "$cat3-fg"
    }

    rule ".c4" {
        background "$cat4-bg"
        color "$cat4-fg"
    }

    rule ".c5" {
        background "$cat5-bg"
        color "$cat5-fg"
    }

    rule ".c6" {
        background "$cat6-bg"
        color "$cat6-fg"
    }

    rule ".who" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        white-space nowrap
    }

    rule ".av" {
        width "$doc-space-22"
        height "$doc-space-22"
        border-radius "50%"
        display inline-grid
        place-items center
        font-size "$doc-font-11"
        font-weight "$weight-bold"
        flex none
    }

    rule ".type" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
    }

    rule ".type.bug" {
        color "$danger"
    }

    rule ".type.task" {
        color "$st-ip"
    }

    rule ".type.feature" {
        color "$success"
    }

    rule ".type.goal" {
        color "$accent-fg"
    }

    rule ".cb" {
        width "$doc-space-18"
        height "$doc-space-18"
        accent-color "$accent"
    }

    rule ".fields" {
        display grid
        grid-template-columns "$doc-space-130 minmax(0, 1fr)"
        gap "$doc-space-2 $doc-space-10"
        align-items center
    }

    rule ".fields dt" {
        color "$fg-muted"
        font-size "$fs-sm"
        padding "$doc-space-6 0"
    }

    rule ".fields dd" {
        margin 0
        min-width 0
    }

    rule ".tabs" {
        display flex
        gap "$space-1"
        border-bottom "$border-width solid $border"
        margin-bottom "$doc-space-10"
        overflow-x auto
    }

    rule ".tabs button" {
        border 0
        background none
        padding "$doc-space-6 $doc-space-10"
        color "$fg-muted"
        border-bottom "$doc-space-2 solid transparent"
        white-space nowrap
    }

    rule ".tabs button[aria-selected=\"true\"]" {
        color "$fg"
        border-bottom-color "$accent"
        font-weight "$doc-weight-semibold"
    }

    rule ".field" {
        display flex
        flex-direction column
        gap "$doc-space-5"
    }

    rule ".field label" {
        font-weight "$doc-weight-semibold"
        font-size "$fs-sm"
    }

    rule ".field .req" {
        font-weight "$weight-regular"
        color "$fg-muted"
    }

    rule ".field input" ".field select" ".field textarea" {
        padding "$doc-space-9 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-canvas"
    }

    rule ".field textarea" {
        min-height "$doc-space-110"
        resize vertical
        line-height "$lh-text"
    }
}

docs "docpage" description="Bugaboo document pages: header, contents, section numbers, reading type and tables. Shared by every design document; needs theme.css and components.css." {
    tokens {
        layer "doc-z-copied" 50
        line-height "doc-lh-code" "1.55"
        line-height "doc-lh-reading" "1.65"
        line-height "doc-lh-title" "1.15"
        line-height "doc-lh-toc" "1.35"
        size "doc-bp-narrow" "1023px"
        size "doc-bp-phone" "600px"
        size "doc-font-12" "12px"
        size "doc-font-12-5" "12.5px"
        size "doc-font-18" "18px"
        size "doc-font-21" "21px"
        size "doc-font-28" "28px"
        size "doc-font-34" "34px"
        size "doc-font-inline-code" "0.92em"
        size "doc-measure-body" "70ch"
        size "doc-measure-lede" "68ch"
        size "doc-measure-note" "72ch"
        size "doc-menu-height" "60vh"
        size "doc-popup-width" "calc(100vw - 32px)"
        size "doc-safe-top" "env(safe-area-inset-top, 0px)"
        size "doc-space-1260" "1260px"
        size "doc-space-14" "14px"
        size "doc-space-230" "230px"
        size "doc-space-28" "28px"
        size "doc-space-3" "3px"
        size "doc-space-30" "30px"
        size "doc-space-36" "36px"
        size "doc-space-44" "44px"
        size "doc-space-56" "56px"
        size "doc-space-64" "64px"
        size "doc-space-72" "72px"
        size "doc-space-96" "96px"
        size "doc-toc-height" "calc(100vh - 80px)"
        size "doc-tracking-mid" "0.05em"
        size "doc-tracking-tight" "-0.01em"
        size "doc-tracking-wide" "0.07em"
    }

    rule "html" {
        scroll-padding-top "$doc-space-72"
    }

    rule "a" {
        color "$accent-fg"
    }

    rule ".top" {
        position sticky
        top "$doc-safe-top"
        z-index "$z-panel"
        background "$bg-canvas"
        border-bottom "$border-width solid $border"
    }

    rule ".top-in" {
        max-width "$doc-space-1260"
        margin 0 auto
        padding "$doc-space-10 $space-4"
        display flex
        align-items center
        gap "$space-3"
        flex-wrap wrap
    }

    rule ".brand" {
        display flex
        align-items center
        gap "$space-2"
        font-weight "$weight-bold"
        font-size "$fs-md"
    }

    rule ".brand svg" {
        width "$space-5"
        height "$space-5"
    }

    rule ".brand small" {
        font-weight "$doc-weight-medium"
        color "$fg-muted"
        font-size "$fs-sm"
    }

    rule ".look-pick" {
        margin-left auto
        display flex
        align-items center
        gap "$doc-space-6"
        font-size "$fs-sm"
        color "$fg-muted"
    }

    rule ".look-pick select" {
        padding "$doc-space-6 $space-2"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".layout" {
        max-width "$doc-space-1260"
        margin 0 auto
        padding "0 $space-4"
        display grid
        grid-template-columns "$doc-space-230 minmax(0, 1fr)"
        gap "$doc-space-44"
    }

    rule ".toc" {
        position sticky
        top "$doc-space-64"
        align-self start
        max-height "$doc-toc-height"
        overflow auto
        padding "$doc-space-28 0 $space-5"
        font-size "$fs-sm"
    }

    rule ".toc-h" {
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        font-weight "$weight-bold"
        padding "0 $space-2 $doc-space-6"
    }

    rule ".toc a" {
        display flex
        gap "$doc-space-6"
        padding "$space-1 $space-2"
        border-radius "$r-ctl"
        color "$fg-muted"
        text-decoration none
        line-height "$doc-lh-toc"
    }

    rule ".toc a:hover" {
        background "$bg-hover"
        color "$fg"
    }

    rule ".toc a.on" {
        color "$accent-fg"
        background "$bg-selected"
        font-weight "$doc-weight-semibold"
    }

    rule ".toc a .n" {
        font-family "$font-mono"
        font-size "$doc-font-11"
        min-width "$doc-space-30"
        color "$fg-subtle"
    }

    rule ".toc a.l3" {
        padding-left "$doc-space-18"
    }

    rule ".toc-phone" {
        display none
        margin "$space-4 0 0"
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-surface"
    }

    rule ".toc-phone summary" {
        padding "$space-3 $doc-space-14"
        font-weight "$weight-bold"
        cursor pointer
    }

    rule ".toc-phone nav" {
        padding "0 $doc-space-6 $doc-space-10"
        max-height "$doc-menu-height"
        overflow auto
    }

    rule ".doc" {
        padding "$doc-space-28 0 $doc-space-96"
        min-width 0
    }

    rule ".layout" {
        media "(max-width: $doc-bp-narrow)" {
            grid-template-columns "minmax(0, 1fr)"
        }
    }

    rule ".toc" {
        media "(max-width: $doc-bp-narrow)" {
            display none
        }
    }

    rule ".toc-phone" {
        media "(max-width: $doc-bp-narrow)" {
            display block
        }
    }

    rule ".doc h1" {
        font-size "$doc-font-34"
        line-height "$doc-lh-title"
        margin "$space-1 0 $space-2"
        text-wrap balance
        letter-spacing "$doc-tracking-tight"
    }

    rule ".doc h2" {
        font-size "$fs-xl"
        margin "$doc-space-56 0 $space-3"
        padding-top "$doc-space-20"
        border-top "$border-width solid $border"
        text-wrap balance
    }

    rule ".doc h3" {
        font-size "$doc-font-18"
        margin "$doc-space-36 0 $space-2"
        text-wrap balance
    }

    rule ".doc h4" {
        font-size "$fs-md"
        margin "$doc-space-22 0 $doc-space-6"
    }

    rule ".doc p" ".doc li" {
        line-height "$doc-lh-reading"
        max-width "$doc-measure-body"
    }

    rule ".doc ul" ".doc ol" {
        padding-left "$doc-space-22"
    }

    rule ".doc li" {
        margin "$space-1 0"
    }

    rule ".doc code" {
        font-family "$font-mono"
        font-size "$doc-font-inline-code"
        background "$bg-sunken"
        padding "$doc-space-1 $doc-space-5"
        border-radius "$doc-r-small"
    }

    rule ".lede" {
        font-size "$fs-md"
        color "$fg-muted"
        max-width "$doc-measure-lede"
    }

    rule ".status-line" {
        font-size "$fs-sm"
        color "$fg-muted"
        display flex
        gap "$space-2"
        flex-wrap wrap
        align-items center
    }

    rule ".sec" {
        font-family "$font-mono"
        font-size "$doc-font-12"
        font-weight "$doc-weight-semibold"
        color "$accent-fg"
        background "$accent-soft"
        padding "$doc-space-2 $space-2"
        border-radius "$doc-r-pill"
        text-decoration none
        vertical-align "$space-1"
        margin-right "$space-2"
        border 0
        cursor pointer
        white-space nowrap
    }

    rule ".sec:hover" {
        box-shadow "0 0 0 $border-width $accent"
    }

    rule ".ids" {
        font-family "$font-mono"
        font-size "$doc-font-11"
        color "$fg-subtle"
        font-weight "$weight-regular"
        margin-left "$doc-space-6"
        vertical-align "$doc-space-3"
    }

    rule ".note" {
        border "$border-width solid $border"
        background "$bg-surface"
        border-radius "$r-card"
        padding "$doc-space-14 $space-4"
        margin "$doc-space-18 0"
        max-width "$doc-measure-note"
    }

    rule ".note.feedback" {
        border-color "$accent"
        background "$accent-soft"
    }

    rule ".note b:first-child" {
        display block
        margin-bottom "$space-1"
    }

    rule ".tbl-wrap" {
        overflow-x auto
        margin "$doc-space-14 0"
        border "$border-width solid $border"
        border-radius "$r-card"
    }

    rule ".dtable" {
        border-collapse collapse
        width "100%"
        font-size "$fs-sm"
    }

    rule ".dtable th" ".dtable td" {
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
        text-align left
        vertical-align top
    }

    rule ".dtable th" {
        background "$bg-surface"
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-muted"
    }

    rule ".dtable tr:last-child td" {
        border-bottom 0
    }

    rule ".copied" {
        position fixed
        left "50%"
        bottom "$space-5"
        transform "translateX(-50%)"
        z-index "$doc-z-copied"
        background "$fg"
        color "$bg-canvas"
        border-radius "$r-card"
        padding "$doc-space-10 $doc-space-14"
        font-size "$fs-sm"
        box-shadow "$shadow"
        max-width "$doc-popup-width"
    }

    rule ".doc h1" {
        media "(max-width: $doc-bp-phone)" {
            font-size "$doc-font-28"
        }
    }

    rule ".doc h2" {
        media "(max-width: $doc-bp-phone)" {
            font-size "$doc-font-21"
            margin-top "$doc-space-44"
        }
    }

    rule ".doc pre" {
        background "$bg-sunken"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        overflow-x auto
        font-family "$font-mono"
        font-size "$doc-font-12-5"
        line-height "$doc-lh-code"
    }

    rule ".doc pre code" {
        background none
        padding 0
    }

    rule ".doc pre.mermaid" {
        background "$bg-raised"
        text-align center
        font-family "$font-ui"
    }

    rule ".doc blockquote" {
        margin "$doc-space-14 0"
        padding "$doc-space-6 $doc-space-14"
        border-left "$doc-space-3 solid $accent"
        color "$fg-muted"
    }

    // The logo of the page header, and what the page builder used to write as inline styles.
    rule ".logo-fill-accent" {
        fill "$accent"
    }

    rule ".logo-fill-canvas" {
        fill "$bg-canvas"
    }

    rule ".logo-stroke-accent" {
        stroke "$accent"
    }

    rule ".logo-stroke-canvas" {
        stroke "$bg-canvas"
    }

    // The list of contents inside the page on a phone: it is not the rail of the wide layout.
    rule ".toc-phone .toc" {
        display block
        position static
        max-height none
        padding 0
    }

    rule ".feedback .sec" {
        vertical-align 0
    }

    // The alignment of a column of a table.
    rule ".dtable .align-left" {
        text-align left
    }

    rule ".dtable .align-center" {
        text-align center
    }

    rule ".dtable .align-right" {
        text-align right
    }
}

docs "ux-design" description="The design page of the user experience: its reading type, the demo frames, the mini screens and the diagrams. Needs theme.css, components.css and docpage.css." {
    tokens {
        line-height "doc-lh-1-1" "1.1"
        line-height "doc-lh-1-3" "1.3"
        number "doc-stroke-1-2" 1.2
        number "doc-stroke-2-5" 2.5
        number "doc-stroke-3-4" 3.4
        opacity "doc-opacity-0-2" 0.2
        opacity "doc-opacity-0-4" 0.4
        size "doc-deg-45" "45deg"
        size "doc-deg-n2" "-2deg"
        size "doc-em-0-06" "0.06em"
        size "doc-font-10" "10px"
        size "doc-font-10-5" "10.5px"
        size "doc-font-11-5" "11.5px"
        size "doc-font-13" "13px"
        size "doc-font-15" "15px"
        size "doc-font-16" "16px"
        size "doc-font-19" "19px"
        size "doc-font-20" "20px"
        size "doc-font-30" "30px"
        size "doc-space-13" "13px"
        size "doc-space-15" "15px"
        size "doc-space-150" "150px"
        size "doc-space-160" "160px"
        size "doc-space-17" "17px"
        size "doc-space-170" "170px"
        size "doc-space-190" "190px"
        size "doc-space-200" "200px"
        size "doc-space-220" "220px"
        size "doc-space-240" "240px"
        size "doc-space-26" "26px"
        size "doc-space-260" "260px"
        size "doc-space-280" "280px"
        size "doc-space-300" "300px"
        size "doc-space-31" "31px"
        size "doc-space-320" "320px"
        size "doc-space-330" "330px"
        size "doc-space-340" "340px"
        size "doc-space-360" "360px"
        size "doc-space-46" "46px"
        size "doc-space-460" "460px"
        size "doc-space-48" "48px"
        size "doc-space-520" "520px"
        size "doc-space-560" "560px"
        size "doc-space-600" "600px"
        size "doc-space-640" "640px"
        size "doc-space-1040" "1040px"
        size "doc-space-70" "70px"
        size "doc-space-78" "78px"
        size "doc-space-80" "80px"
        size "doc-space-90" "90px"
        size "doc-space-n10" "-10px"
        size "doc-space-n2" "-2px"
        size "doc-space-n6" "-6px"
    }

    rule ".target" {
        border-left "$doc-space-3 solid $accent"
        padding "$space-1 0 $space-1 $doc-space-14"
        margin "$doc-space-20 0"
        max-width "$doc-measure-body"
    }

    rule ".doc .principles" {
        list-style none
        padding 0
        display grid
        grid-template-columns "repeat(auto-fill, minmax($doc-space-260, 1fr))"
        gap "$space-3"
        counter-reset p
    }

    rule ".principles li" {
        counter-increment p
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14 $space-3 $doc-space-46"
        position relative
        background "$bg-raised"
        margin 0
        max-width none
    }

    rule ".principles li::before" {
        content "counter(p)"
        position absolute
        left "$space-3"
        top "$space-3"
        width "$space-5"
        height "$space-5"
        border-radius "50%"
        background "$accent-soft"
        color "$accent-fg"
        font-weight "$weight-bold"
        font-size "$doc-font-12"
        display grid
        place-items center
        font-family "$font-mono"
    }

    rule ".doc .tree" {
        list-style none
        font-size "$fs-sm"
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        background "$bg-surface"
        max-width "$doc-space-560"
    }

    rule ".tree ul" {
        list-style none
        padding-left "$doc-space-18"
        border-left "$border-width dashed $border"
        margin "$doc-space-2 0 $doc-space-2 $doc-space-7"
    }

    rule ".tree li" {
        display block
        margin "$doc-space-3 0"
        max-width none
    }

    rule ".tree .lbl" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        font-weight "$doc-weight-semibold"
    }

    rule ".tree .d" {
        color "$fg-muted"
        font-weight "$weight-regular"
    }

    rule ".demo" {
        margin "$doc-space-18 0 $doc-space-22"
        display flex
        gap "$space-4"
        flex-wrap wrap
        align-items flex-start
    }

    rule ".frame" {
        border "$border-width solid $border"
        border-radius "$space-3"
        background "$bg-canvas"
        box-shadow "$shadow"
        overflow hidden
        min-width 0
        flex "1 1 $doc-space-520"
        max-width "100%"
    }

    rule ".frame-cap" {
        font-size "$doc-font-11"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        font-weight "$weight-bold"
        padding "$doc-space-6 $space-3"
        border-bottom "$border-width solid $border-subtle"
        background "$bg-surface"
        display flex
        gap "$space-2"
        align-items center
    }

    rule ".frame-body" {
        overflow-x auto
    }

    rule ".scr" {
        font-size "$doc-font-13"
        background "$bg-canvas"
        color "$fg"
    }

    rule ".frame-body > .scr" {
        min-width "$doc-space-640"
    }

    // The issue list has fixed columns that need room; the frame scrolls when the page is narrower.
    rule ".frame-body > .scr.wide" {
        min-width "$doc-space-1040"
    }

    // The page behind a window in the pictures. The window is the part of the app, drawn in place.
    rule ".win-stage" {
        display flex
        flex-direction column
        align-items center
        gap "$space-4"
        padding "$space-4"
        background "$bg-sunken"
    }

    rule ".win-stage .win-wide" {
        width "min(calc($size-window * 1.2), 100%)"
    }

    // The issue page: the text, and the Details at the side (300 to 340).
    rule ".issue-grid" {
        display grid
        grid-template-columns "minmax(0, 1fr) $size-details"
    }

    rule ".win-stage .dock-flat" {
        position static
    }

    rule ".frame.phone" {
        flex "0 0 $doc-space-300"
        border-radius "$doc-space-28"
        border "$doc-space-7 solid $border"
    }

    rule ".frame.phone .frame-body > .scr" {
        min-width 0
    }

    rule ".frame.narrow" {
        flex "1 1 $doc-space-340"
    }

    rule ".frame.narrow .frame-body > .scr" {
        min-width 0
    }

    rule ".cap-note" {
        font-size "$fs-sm"
        color "$fg-muted"
        margin "$doc-space-n10 0 $doc-space-18"
        max-width "$doc-measure-body"
    }

    rule ".scr .btn" {
        padding "$doc-space-5 $doc-space-10"
        font-size "$doc-font-12-5"
    }

    rule ".scr .btn.sm" {
        padding "$doc-space-3 $space-2"
        font-size "$doc-font-12"
    }

    rule ".scr .seg button" {
        padding "$space-1 $doc-space-9"
        font-size "$doc-font-12"
    }

    rule ".scr .pill" {
        font-size "$doc-font-12"
        padding "$doc-space-1 $space-2"
    }

    rule ".scr .key" {
        font-size "$doc-font-12"
    }

    rule ".scr .chip" {
        font-size "$doc-font-12"
        padding "$doc-space-3 $doc-space-3 $doc-space-3 $doc-space-9"
    }

    rule ".scr .chip.add" {
        padding "$doc-space-3 $doc-space-9"
    }

    rule ".app3" {
        display grid
        grid-template-columns "$doc-space-150 minmax(0, 1fr) $doc-space-230"
        min-height "$doc-space-320"
    }

    rule ".app2" {
        display grid
        grid-template-columns "$doc-space-150 minmax(0, 1fr)"
        min-height "$doc-space-280"
    }

    rule ".sb" {
        background "$bg-surface"
        border-right "$border-width solid $border"
        padding "$doc-space-10 $space-2"
        display flex
        flex-direction column
        gap "$doc-space-1"
    }

    rule ".sb .ttl" {
        display flex
        align-items center
        gap "$doc-space-6"
        font-weight "$weight-bold"
        padding "$doc-space-2 $doc-space-6 $space-2"
    }

    rule ".ni" {
        display flex
        align-items center
        gap "$doc-space-7"
        padding "$doc-space-5 $doc-space-7"
        border-radius "$r-ctl"
    }

    rule ".ni.on" {
        background "$bg-selected"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
    }

    rule ".ni .cnt" {
        margin-left auto
        font-size "$doc-font-10"
        background "$accent"
        color "$on-accent"
        border-radius "$doc-r-pill"
        padding "0 $doc-space-6"
        font-weight "$weight-bold"
    }

    rule ".nl" {
        font-size "$doc-font-10"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        padding "$space-2 $doc-space-7 $doc-space-2"
        font-weight "$weight-bold"
    }

    rule ".timer-mini" {
        margin-top auto
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-6 $space-2"
        border-radius "$r-ctl"
        background "$accent-soft"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
        font-size "$doc-font-12"
    }

    rule ".mainc" {
        display flex
        flex-direction column
        min-width 0
    }

    rule ".tb" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $space-3"
        border-bottom "$border-width solid $border"
        flex-wrap wrap
    }

    rule ".tb .crumb" {
        color "$fg-muted"
    }

    rule ".dodont b" {
        display block
        font-size "$doc-font-11"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        margin-bottom "$space-1"
    }

    rule ".cards-pick b" {
        display block
        font-size "$doc-font-12-5"
    }

    rule ".tb .crumb b" {
        color "$fg"
    }

    rule ".sbar" {
        display flex
        gap "$doc-space-6"
        padding "$space-2 $space-3"
        border-bottom "$border-width solid $border-subtle"
        flex-wrap wrap
        align-items center
    }

    rule ".r" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-7 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".r .t" {
        flex 1
        min-width 0
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
        font-weight "$doc-weight-medium"
    }

    rule ".r.sel" {
        background "$bg-selected"
    }

    rule ".r.hd" {
        background "$bg-surface"
        font-size "$doc-font-11"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-subtle"
        font-weight "$weight-bold"
    }

    rule ".pn" {
        border-left "$border-width solid $border"
        padding "$space-3"
        display flex
        flex-direction column
        gap "$doc-space-10"
        min-width 0
    }

    rule ".pn h5" {
        margin 0
        font-size "$doc-font-15"
        line-height "$doc-lh-1-3"
    }

    rule ".mini-fields" {
        display grid
        grid-template-columns "auto minmax(0, 1fr)"
        gap "$space-1 $doc-space-10"
        font-size "$doc-font-12"
        align-items center
    }

    rule ".mini-fields dt" {
        color "$fg-muted"
    }

    rule ".mini-fields dd" {
        margin 0
        min-width 0
    }

    rule ".sh" {
        font-size "$doc-font-10-5"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-muted"
        font-weight "$weight-bold"
        margin "$space-1 0 $space-1"
    }

    rule ".blk" {
        border "$border-width solid $border"
        border-radius "$space-2"
        overflow hidden
    }

    rule ".blk .r:last-child" {
        border-bottom 0
    }

    rule ".rel-kind" {
        min-width "$doc-space-96"
        color "$fg-muted"
        font-size "$doc-font-12"
    }

    rule ".ph-top" {
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-10 $space-3"
        border-bottom "$border-width solid $border"
        font-weight "$doc-weight-semibold"
    }

    rule ".ph-body" {
        min-height "$doc-space-300"
    }

    rule ".bb" {
        display grid
        grid-template-columns "repeat(5, 1fr)"
        border-top "$border-width solid $border"
        background "$bg-surface"
    }

    rule ".bb span" {
        display flex
        flex-direction column
        align-items center
        font-size "$doc-font-10"
        padding "$doc-space-6 0 $space-2"
        color "$fg-muted"
        gap "$doc-space-2"
    }

    rule ".bb .on" {
        color "$accent-fg"
        font-weight "$weight-bold"
    }

    rule ".bb .new .ico" {
        background "$accent"
        color "$on-accent"
        border-radius "50%"
        padding "$doc-space-3"
        width "$doc-space-22"
        height "$doc-space-22"
    }

    rule ".actbar" {
        display grid
        grid-template-columns "repeat(4, 1fr)"
        border-top "$border-width solid $border"
        background "$bg-surface"
        text-align center
        font-size "$doc-font-11"
    }

    rule ".actbar span" {
        padding "$space-2 0"
        display flex
        flex-direction column
        align-items center
        gap "$doc-space-2"
    }

    rule ".lrow" {
        padding "$doc-space-10 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".lrow .t" {
        font-weight "$doc-weight-semibold"
        margin "$doc-space-2 0 $space-1"
    }

    rule ".lrow .m" {
        display flex
        gap "$space-2"
        flex-wrap wrap
        align-items center
        font-size "$doc-font-12"
        color "$fg-muted"
    }

    rule ".banner" {
        display flex
        gap "$space-2"
        align-items center
        flex-wrap wrap
        padding "$space-2 $doc-space-10"
        border-radius "$space-2"
        background "$warning-soft"
        color "$fg"
        border "$border-width solid $warning"
        font-size "$doc-font-12"
    }

    rule ".bubble" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$doc-space-7 $doc-space-10"
        font-size "$doc-font-12"
    }

    rule ".box" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
    }

    rule ".box-h" {
        display flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
        font-weight "$weight-bold"
    }

    rule ".box-h .muted" {
        margin-left auto
        font-weight "$weight-regular"
        font-size "$doc-font-11"
    }

    rule ".grid2" {
        display grid
        grid-template-columns "repeat(2, minmax(0, 1fr))"
        gap "$space-3"
        padding "$space-3"
    }

    rule ".timer-card" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$doc-space-10 $space-3"
        border "$border-width solid $accent"
        background "$accent-soft"
        border-radius "$r-card"
        margin "$space-3 $space-3 0"
        flex-wrap wrap
    }

    rule ".timer-card .clock" {
        font-family "$font-mono"
        font-size "$doc-font-20"
        font-weight "$doc-weight-semibold"
        color "$accent-fg"
    }

    rule ".checklist" {
        display flex
        gap "$doc-space-10"
        flex-wrap wrap
        align-items center
        margin "$space-3 $space-3 0"
        padding "$doc-space-10 $space-3"
        border "$border-width dashed $border"
        border-radius "$r-card"
    }

    rule ".okmark" {
        width "$doc-space-18"
        height "$doc-space-18"
        border-radius "50%"
        background "$success"
        color "$bg-canvas"
        display inline-grid
        place-items center
        font-size "$doc-font-11"
        font-weight "$weight-bold"
    }

    rule ".many-change" {
        display flex
        gap "$doc-space-6"
        flex-wrap wrap
        align-items center
        margin "$doc-space-10 auto"
        width max-content
        max-width "calc(100% - $space-5)"
        background "$bg-raised"
        border "$border-width solid $border"
        box-shadow "$shadow"
        border-radius "$r-card"
        padding "$doc-space-7 $doc-space-9"
    }

    rule ".preview-msg" {
        margin "0 $space-3 $space-3"
        border "$border-width solid $border"
        border-radius "$r-card"
        padding "$doc-space-10 $space-3"
        background "$bg-raised"
        font-size "$doc-font-12-5"
    }

    rule ".adv-box" {
        font-family "$font-mono"
        font-size "$doc-font-12-5"
        line-height "$lh-loose"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$space-2 $doc-space-10"
        background "$bg-raised"
        white-space pre-wrap
    }

    rule ".adv-box .err" {
        text-decoration "underline wavy $danger"
        text-underline-offset "$doc-space-3"
    }

    rule ".errline" {
        color "$danger"
        font-size "$doc-font-12"
        display flex
        gap "$doc-space-6"
        align-items center
        margin-top "$doc-space-6"
    }

    rule ".ask-res" {
        border "$border-width solid $border"
        background "$accent-soft"
        border-radius "$r-ctl"
        padding "$space-2 $doc-space-10"
        display flex
        flex-wrap wrap
        gap "$space-2"
        align-items center
        font-size "$doc-font-12"
    }

    rule ".ask-res code" {
        flex 1
        min-width 0
        font-family "$font-mono"
    }

    rule ".pop-demo" {
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
        box-shadow "$shadow"
        padding "$doc-space-5"
        min-width "$doc-space-200"
        font-size "$doc-font-12-5"
    }

    rule ".pop-demo .h" {
        font-size "$doc-font-10-5"
        text-transform uppercase
        letter-spacing "$doc-tracking-wide"
        color "$fg-subtle"
        font-weight "$weight-bold"
        padding "$doc-space-5 $space-2 $doc-space-3"
    }

    rule ".pop-demo .it" {
