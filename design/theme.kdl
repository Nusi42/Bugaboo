        gap "$space-2"
        align-items center
    }

    rule ".ask-result code" {
        font-family "$font-mono"
        font-size "$fs-sm"
        flex 1
        min-width 0
    }

    rule ".tbl" {
        width "100%"
        border-collapse collapse
    }

    rule ".tbl th" {
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-subtle"
        text-align left
        padding "$space-2 $doc-space-10"
        border-bottom "$border-width solid $border"
        font-weight "$doc-weight-semibold"
        white-space nowrap
    }

    rule ".tbl td" {
        padding "$doc-space-9 $doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        vertical-align middle
    }

    rule ".tbl tr.row" {
        cursor pointer
    }

    rule ".group-h td" {
        background "$bg-surface"
        font-weight "$doc-weight-semibold"
        font-size "$fs-sm"
        color "$fg-muted"
    }

    rule ".ts th" ".ts td" {
        padding "$space-2 $space-2"
        border-bottom "$border-width solid $border-subtle"
        text-align center
        font-variant-numeric tabular-nums
    }

    rule ".perm th" ".perm td" {
        padding "$doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        text-align left
    }

    rule ".ts tfoot td" {
        font-weight "$weight-bold"
        background "$bg-surface"
    }

    rule ".perm th" {
        font-size "$fs-xs"
        color "$fg-muted"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        background "$bg-surface"
    }

    rule ".ts th" {
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-semibold"
        background "$bg-surface"
    }

    rule ".ts td:first-child" ".ts th:first-child" {
        text-align left
    }

    rule ".ts tr.wh td" {
        background "$bg-surface"
        font-weight "$weight-bold"
    }

    rule ".tbl tr.row:hover td" {
        background "$bg-hover"
    }

    rule ".tbl tr.row.sel td" {
        background "$bg-selected"
    }

    rule ".tbl .title" {
        font-weight "$doc-weight-medium"
    }

    rule ".cards" {
        display none
    }

    rule ".many-change-bar" {
        position sticky
        bottom "$space-3"
        margin "$space-3 auto 0"
        width max-content
        max-width "100%"
        display flex
        flex-wrap wrap
        gap "$doc-space-6"
        align-items center
        background "$bg-raised"
        border "$border-width solid $border"
        box-shadow "$shadow"
        border-radius "$r-card"
        padding "$space-2 $doc-space-10"
    }

    rule ".board" {
        display grid
        grid-auto-flow column
        grid-auto-columns "minmax($doc-space-240, 1fr)"
        gap "$doc-space-14"
        overflow-x auto
        padding "$space-4 $space-5 $space-5"
        min-height "100%"
        align-items start
    }

    rule ".col" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        display flex
        flex-direction column
        min-height "$doc-space-200"
    }

    rule ".col.drop-ok" {
        outline "$doc-space-2 dashed $accent"
        outline-offset "$doc-space-n2"
    }

    rule ".col.drop-no" {
        opacity "$doc-opacity-0-45"
    }

    rule ".col-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-10 $space-3"
        font-weight "$doc-weight-semibold"
    }

    rule ".col-h .lim" {
        margin-left auto
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-medium"
    }

    rule ".col-h .lim.over" {
        color "$warning"
        font-weight "$weight-bold"
    }

    rule ".col-b" {
        display flex
        flex-direction column
        gap "$space-2"
        padding "0 $doc-space-10 $space-3"
    }

    rule ".card" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$space-2"
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$space-2"
        cursor grab
        box-shadow "0 $border-width $border-width $border-subtle"
    }

    rule ".card:hover" {
        border-color "$accent"
    }

    rule ".card .title" {
        font-weight "$doc-weight-medium"
    }

    rule ".card .meta" {
        display flex
        align-items center
        gap "$space-2"
        flex-wrap wrap
        font-size "$fs-sm"
    }

    rule ".card .move" {
        margin-left auto
    }

    rule ".board-tabs" {
        display none
    }

    rule ".tl-wrap" {
        overflow-x auto
        padding "$space-4 $space-5 $space-5"
    }

    rule ".tl" {
        min-width "$doc-space-760"
        display grid
        grid-template-columns "$doc-space-260 1fr"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
        background "$bg-raised"
    }

    rule ".tl-h" {
        display contents
    }

    rule ".tl-h > div" {
        background "$bg-surface"
        border-bottom "$border-width solid $border"
        padding "$space-2 $doc-space-10"
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-semibold"
    }

    rule ".tl-h > .tl-weeks" {
