// ───────────── Layouts and the forms they make (M3 WP-09) ─────────────
//
// The editor of a layout: sections of fields, each field with the roles it is shown to, buttons for
// everything a drag does and the places a field can be dropped. And the sections and tabs of a
// form as a person sees them.

part "layout-editor" {
    use "fieldset-reset"
    display flex
    flex-direction column
    gap "$space-4"
}

part "layout-section.head" {
    display flex
    flex-wrap wrap
    align-items flex-end
    gap "$space-3"
}

part "layout-section.fields" {
    use "list-reset"
    display flex
    flex-direction column
}

part "layout-field" {
    use "sunken-box"
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-2 $space-3"
}

part "draggable[state=dragging]" {
    opacity "$opacity-busy"
}

part "draggable" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "layout-field.name" {
    flex 1
    min-width 0
    font-weight "$weight-regular"
    overflow-wrap anywhere
}

part "draggable.handle" {
    border 0
    background transparent
    display inline-flex
    align-items center
    justify-content center
    min-width "$size-control"
    min-height "$size-control"
    border-radius "$r-ctl"
    color "$fg-muted"
    cursor grab
}

part "draggable.handle:hover" {
    background "$bg-hover"
}

part "draggable.handle[focus-visible]" {
    use "ring"
}

part "layout-field.roles" {
    use "fieldset-reset"
    display flex
    flex-wrap wrap
    gap "$space-1 $space-4"
}

part "layout-field.limited" {
    margin 0
    color "$warning"
    font-size "$fs-sm"
}

part "layout-field.actions" {
    display flex
    flex-wrap wrap
    align-items flex-end
    gap "$space-2"
}

// The thin place between two fields where a dragged field can be dropped.
part "drop-slot" {
    width "100%"
    min-height "$space-2"
    border-radius "$r-ctl"
}

part "drop-slot[state=over]" {
    min-height "$size-control"
    border "$border-width dashed $accent"
    background "$accent-soft"
}

// ───────────── Tabs (packages/ui) ─────────────
//
// The row of tabs and the panel of the open tab: the history, the notifications and the sections
// of a form all use these.

part "tabs" {
    display flex
    flex-wrap wrap
    gap "$space-1"
    border-bottom "$border-width solid $divider"
}

part "tab" {
    use "tab-label"
}

part "tab[hovered]" {
    background "$bg-hover"
}

part "tab[selected]" {
    color "$fg"
    border-bottom-color "$accent"
}

part "tab[focus-visible]" {
    use "ring-inside"
}

part "tab-panel" "form-panel" {
    display flex
    flex-direction column
    gap "$space-3"
    padding-top "$space-3"
    min-width 0
}

part "form-section" {
    display flex
    flex-direction column
    gap "$space-2"
    min-width 0
}

part "form-section.title" {
    margin 0
    color "$fg"
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// ───────────── Notifications, Customize and the mail server (M4 WP-08) ─────────────
//
// The page of notifications: a bar with the filters, then one box for each issue with its
// notifications in it. An unread notification has the soft accent color and an accent edge: color
// says state (R4), and the word *New* says it too (R5). The count on the menu is the one filled
// pill of the menu.

part "notification-group" {
    display flex
    flex-direction column
    gap "$space-3"
    padding "$pad-box"
    use "surface-box"
    min-width 0
}

part "notification-group.head" {
    display flex
    flex-wrap wrap
    align-items baseline
    gap "$space-1 $space-3"
    margin 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
    min-width 0
    overflow-wrap anywhere
}

// On a phone the group of notifications of an issue has no frame of its own inside the card: card, group and notification
// were three boxes inside each other and left the words little of the width.
part "app-layout[variant=phone] notification-group" {
    use "frameless"
}

part "notification" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    border-inline-start "$size-edge solid transparent"
    border-radius "$r-ctl"
    background "$bg-raised"
    min-width 0
}

part "notification[state=unread]" {
    border-inline-start-color "$accent"
    background "$accent-soft"
}

part "notification.head" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2 $space-3"
}

part "notification.new" {
    color "$accent-fg"
    font-size "$fs-sm"
    font-weight "$weight-regular"
}

part "notification.sentences" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-2"
    line-height "$lh-body"
    color "$fg"
    font-size "$fs-md"
    overflow-wrap anywhere
}

part "notification.actions" {
    display flex
    flex-wrap wrap
    gap "$space-2"
}

// The number of unread notifications on the menu and on the bar of a phone.
part "nav-item.count" "bottom-bar.count" {
    display inline-flex
    align-items center
    justify-content center
    box-sizing border-box
    min-width "$size-target-least"
    padding "0 $space-2"
    border-radius "$r-pill"
    background "$accent"
    color "$on-accent"
    font-size "$fs-sm"
    font-weight "$weight-regular"
    line-height "$lh-snug"
    forced {
        border "$border-width solid"
    }
}

// In the narrow menu there is no room after the icon: the number stands under the icon, inside the
// item, so it covers neither the bell nor the item above it (UX review of M4, A5, and the final check).
part "sidebar[variant=narrow] nav-item" {
    flex-direction column
    align-items flex-start
    justify-content center
    gap 0
}

part "sidebar[variant=narrow] nav-item.count" {
    min-width 0
    padding 0 "$space-1"
    font-size "$fs-xs"
}

// The icon of a tab of the bar, with the number after it.
part "bottom-bar.icon" {
    order -1
    display inline-flex
    align-items center
    gap "$space-1"
}

// Customize: one row for each kind of event, with its two switches.
part "customize-row" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2 $space-5"
    padding "$space-3"
    margin 0
    use "surface-box"
}

part "customize-row.kind" {
    flex-grow 1
    flex-basis "$size-menu"
    min-width 0
    font-weight "$weight-regular"
    overflow-wrap anywhere
}

part "customize-row.ways" {
    use "fieldset-reset"
    display flex
    flex-wrap wrap
    gap "$space-2 $space-5"
}

// The mail server: the fields in a row that wraps, and the answer to the test e-mail.
part "mail-server.fields" {
    display grid
    grid-template-columns "repeat(auto-fit, minmax(min(100%, $size-menu), 1fr))"
    gap "$gap-fields"
}

// The entry of the history that *Open* of a notification came to: the same soft color and edge as an
// unread notification, so the person finds it at once.
part "history.entry[state=highlighted]" {
    border-inline-start "$size-edge solid $accent"
    background "$accent-soft"
}

// The row with *Use the standard choices*: its first button hangs back like every text button (R1).
part "customize-actions" {
    display flex
    flex-wrap wrap
}

// ───────────── Workflows (M4 WP-07) ─────────────
//
// The editor of a workflow (UX §5.4): the plain list of statuses with their status changes, the
// rules of a change, the drawing of boxes and arrows, and the answers of *Try it*.

part "workflow-editor" {
    use "fieldset-reset"
    display flex
    flex-direction column
    gap "$space-4"
}

part "workflow-statuses" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-4"
}

// A status of the plain list: its group's color on the start edge (R4) with its icon in front of the
// name (R5), then what is changed about it, then the status changes that start in it. One box
// (R3, the review of M4 A9): the status changes inside it are rows with a line between, not boxes.
part "workflow-status" {
    use "surface-box"
    display flex
    flex-direction column
    gap "$space-3"
    padding "$pad-box"
    border-inline-start "$size-edge solid $border"
}

part "workflow-status[state=group-not-started]" {
    border-inline-start-color "$st-ns"
}

part "workflow-status[state=group-in-progress]" {
    border-inline-start-color "$st-ip"
}

part "workflow-status[state=group-done]" {
    border-inline-start-color "$st-done"
}

part "workflow-status.title" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "workflow-status.name" {
    display inline-flex
    align-items center
    gap "$space-2"
    margin 0
    color "$fg"
    font-size "$fs-md"
    font-weight "$weight-regular"
    overflow-wrap anywhere
}

// The name and the group side by side where there is room, under each other on a phone.
part "workflow-status.head" {
    display grid
    grid-template-columns "repeat(auto-fit, minmax(min($size-name, 100%), 1fr))"
    align-items end
    gap "$space-3"
}

// What moves or takes away a status: buttons with words, as wide as a finger on a phone.
part "workflow-status.tools" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
}

part "workflow-changes" {
    use "list-reset"
    display flex
    flex-direction column
}

// One status change: where it leads, the words of its button, its rules and a way to take it away.
// The columns are the same in every row, so *Rules* and *Remove* stand in a line down the list.
part "workflow-change" {
    display grid
    grid-template-columns "minmax(0, 1fr) minmax(0, 2fr) $size-col-rules $size-col-remove"
    align-items end
    gap "$space-2" "$space-3"
    padding "$space-3 0"
    border-top "$border-width solid $divider"
}

part "app-layout[variant=phone] workflow-change" {
    grid-template-columns "minmax(0, 1fr) auto"
    align-items center
}

// The last row of a card has no padding below it, and its button (as high as a finger) hangs a little
// below the words: the space under *Rules* is the space above the card's head (the review of M4).
part "app-layout[variant=phone] workflow-change:last-child" {
    padding-bottom 0
    margin-bottom "calc(-1 * $space-2)"
}

part "workflow-change.to" {
    min-width 0
    padding-bottom "$space-2"
}

part "workflow-change.field" {
    min-width 0
}

part "app-layout[variant=phone] workflow-change.field" {
    grid-column "1 / -1"
    grid-row 2
}

part "app-layout[variant=phone] workflow-change.remove" {
    grid-column 2
    grid-row 1
}

part "workflow-change.rules" {
    position relative
    display flex
    flex-direction column
    align-items flex-start
}

// *Has rules* stands under *Rules* without making the cell taller, so *Rules* is on the same line
// in every row of the list whether the change has rules or not.
part "workflow-change.has-rules" {
    position absolute
    top "100%"
    inset-inline-start 0
    white-space nowrap
}

part "app-layout[variant=phone] workflow-change.has-rules" {
    position static
}

part "app-layout[variant=phone] workflow-change.rules" {
    grid-column "1 / -1"
    grid-row 3
    flex-direction row
    align-items center
    gap "$space-3"
}

part "workflow-add" {
    use "fieldset-reset"
    display flex
    flex-wrap wrap
    align-items flex-end
    gap "$space-3"
}

// Where a field stands beside another one, the message under it stands in room kept for it (only
// while there is a message), so it never moves the fields beside it (the review of M4: the group and
// the button dropped 22 px). Where the fields are stacked, on a phone, nothing stands beside it: the
// message takes its own space and pushes the next field down.
part "workflow-add[variant=error]" "workflow-status.head[variant=error]" {
    padding-bottom "$space-5"
}

part "workflow-add field" "workflow-status.head field" {
    position relative
}

part "workflow-add field.error" "workflow-status.head field.error" {
    position absolute
    top "100%"
    inset-inline-start 0
    width max-content
}

part "app-layout[variant=phone] workflow-add[variant=error]" "app-layout[variant=phone] workflow-status.head[variant=error]" {
    padding-bottom 0
}

part "app-layout[variant=phone] workflow-add field.error" "app-layout[variant=phone] workflow-status.head field.error" {
    position static
    width auto
}

part "workflow-rules" {
    use "fieldset-reset"
    display flex
    flex-direction column
    gap "$space-2"
}

// The name of a group of rules is the one label of a control, and starts where its hint starts: a legend has a
// padding of its own that would push it 2 px in (the review of M4, B rules).
part "workflow-rules.legend" {
    use "control-label"
    padding 0
}

part "workflow-condition" {
    display flex
    flex-wrap wrap
    align-items flex-end
    gap "$space-3"
}

part "workflow-tried" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-2"
}

// One result of *Try it*: the sign at the start edge, and beside it the button with its status and,
// under them, why. The sign is level with the first line, whatever the words do below.
part "workflow-try" {
    use "sunken-box"
    display grid
    grid-template-columns "auto minmax(0, 1fr)"
    align-items start
    gap "$space-1" "$space-3"
    padding "$space-3"
}

part "workflow-try.sign" {
    display flex
    align-items center
    min-height "$size-control-small"
}

part "workflow-try.title" {
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2" "$space-3"
    min-height "$size-control-small"
}

part "workflow-try.reason" {
    grid-column 2
}

// The drawing: a column for each status group, the boxes in them, and the arrows over them.
part "workflow-drawing" {
    position relative
    padding "$space-4"
    use "surface-box"
}

part "drawing-columns" {
    position relative
    display grid
    grid-auto-flow column
    grid-auto-columns "minmax(0, 1fr)"
    gap "$space-7"
}

part "drawing-column" {
    use "list-reset"
    display flex
    flex-direction column
    align-content flex-start
    gap "$space-5"
}

part "drawing-box" {
    display flex
    flex-direction column
    gap "$space-2"
    padding "$space-3"
    border "$border-width solid currentColor"
    border-radius "$r-ctl"
    overflow-wrap anywhere
}

part "drawing-box.name" {
    display flex
    align-items center
    gap "$space-2"
    font-weight "$weight-regular"
}

part "drawing-box.changes" {
    use "list-reset"
    display flex
    flex-direction column
    align-items flex-start
}

part "drawing-box[variant=not-started]" {
    use "status-soft-not-started"
}

part "drawing-box[variant=in-progress]" {
    use "status-soft-in-progress"
}

part "drawing-box[variant=done]" {
    use "status-soft-done"
}

part "drawing-arrows" {
    position absolute
    top 0
    left 0
    width "100%"
    height "100%"
    overflow visible
    pointer-events none
}

part "drawing-line" {
    stroke "$fg-muted"
    stroke-width "$border-width"
    fill none
}

part "drawing-head" {
    fill "$fg-muted"
}

// ───────────── Search bar (features/search) ─────────────
//
// One bar above every list (UX design section 4.3): the filter buttons of Simple search, or the
// box of Advanced search, with the words marked under the text and the mistakes listed below.

part "search-bar" {
    display flex
    flex-direction column
    gap "$space-3"
    min-width 0
}

// The buttons at the end stand level with the first row of the filters, not centered against a
// block of several rows.
part "search-bar.head" {
    display flex
    flex-wrap wrap
    align-items flex-start
    gap "$space-2" "$space-3"
}

part "search-bar.actions" {
    display flex
    flex-wrap wrap
    align-items flex-start
    gap "$space-2"
    margin-inline-start auto
}

part "search-filters" {
    use "list-reset"
    display flex
    flex-wrap wrap
    align-items center
    gap "$space-2"
    // As wide as its chips want: the buttons beside it move to the next line before a chip is cut short.
    flex "1 1 auto"
    min-width 0
}

// A filter: the button that changes it and the button that takes it away, in one outline.
part "search-filter" {
    use "control-box"
    font-size "$fs-ui"
    display inline-flex
    align-items center
    flex none
    max-width "100%"
    white-space nowrap
}

// The text of the button of a filter starts a little in from the edge of its outline (R3).
part "search-filter > button" {
    min-width 0
    overflow hidden
    // The same room before and after the words, inside the outline: a button does not hang back over the edge here.
    padding-inline "$space-3"
    margin-inline 0
    justify-content flex-start
    border-color transparent
    min-height "calc($size-control - $border-width * 2)"
    text-overflow ellipsis
}

// What opens over the page for the search: a window of the bar on a phone, the list of fields.
part "search-panel" "bottom-sheet" {
    use "ring-scroll-room"
    display flex
    flex-direction column
    gap "$space-4"
    box-sizing border-box
    padding "$space-5"
    overflow-y auto
}

// A sheet from the bottom of a phone (the filters, the legend) has the look of a panel (above), never taller than the screen.
part "bottom-sheet" {
    max-height "100%"
    overflow-y hidden
}

// What the sheet holds scrolls inside it; its foot (the title row above and the button below) stays
// where it is, whatever the offers or the mistakes add.
part "bottom-sheet search-bar" {
    flex "1 1 auto"
    min-height 0
    overflow-y auto
    // It clips what is outside it: room for the ring of the box and the buttons at every side (F-A6).
    use "ring-room"
    use "ring-room-flush"
}

// The shadows of the boxes of the search that scroll stand at the edge of the box, over its padding, and take no gap
// of the column they stand in.
part "bottom-sheet search-bar::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $ring-room)"
        margin-block-end "calc(-1 * $space-3)"
    }
}

part "bottom-sheet search-bar::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $ring-room)"
        margin-block-start "calc(-1 * $space-3)"
    }
}

part "search-panel::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $space-5)"
        margin-block-end "calc(-1 * $space-4)"
    }
}

part "search-panel::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $space-5)"
        margin-block-start "calc(-1 * $space-4)"
    }
}

part "search-suggestions::before" {
    supports "(animation-timeline: scroll())" {
        top "calc(-1 * $space-1)"
    }
}

part "search-suggestions::after" {
    supports "(animation-timeline: scroll())" {
        bottom "calc(-1 * $space-1)"
    }
}

// The sheet of the filters has a fixed height (see size-bar-sheet), so it does not jump as the filters change.
part "bottom-sheet[variant=tall]" {
    height "$size-bar-sheet"
}

// The name of what the sheet is for (Filters), as the title of a page is.
part "bottom-sheet.title" {
    margin 0
    font-size "$fs-lg"
    line-height "$lh-snug"
    color "$fg"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// The head of a panel: its title, and the button that closes it at the end of the same row.
part "search-panel.head" {
    display flex
    align-items center
    justify-content space-between
    gap "$space-3"
}

// The chosen name and the finder of a filter on a person, a group or a project.
part "search-choice" {
    display flex
    flex-direction column
    gap "$space-3"
}

// In the sheet of a phone the filters stand under each other, as wide as the sheet.
part "bottom-sheet search-bar.head" {
    flex-direction column
    align-items stretch
}

part "bottom-sheet search-filters" {
    flex-direction column
    align-items stretch
}

part "bottom-sheet search-filter" {
    justify-content space-between
    white-space normal
}

// *+ Add filter* and *Any of* are as wide as the sheet, like the filters above them.
part "search-filters.action" {
    display flex
    flex-direction column
}

part "search-filters.action > button" {
    width "100%"
}

// The button that takes the filter away stays whole inside the border; the words before it give way, with an ellipsis (the
// sign was outside the border and touched Advanced search, M5 exit).
part "search-filter > button:last-child" {
    flex none
    margin-inline-end 0
}

// In a dialog (the filters inside an *Any of*) the list is as high as its filters, not the free height.
part "confirm.body search-filters" {
    flex none
}

// *+ Add a filter* of an *Any of* stands on a row of its own, not beside the last filter.
part "confirm.body search-filters.action" {
    flex "1 1 100%"
    align-items flex-start
}

part "confirm.body search-filters.action > button" {
    width auto
}

// On a phone it is as wide as the screen, like the main button.
part "overlay[variant=full] confirm.body search-filters.action > button" {
    width "100%"
}

part "bottom-sheet search-bar.actions" {
    margin-inline-start 0
}

part "search-filter[variant=text]" {
    border-style dashed
}

part "search-filter.name" {
    color "$fg-muted"
}

part "search-filter.value" {
    font-weight "$weight-regular"
    overflow-wrap anywhere
}

// The box of Advanced search: the marked words are drawn under the text of the box, so both are
// one grid cell and have to keep exactly the same type.
part "search-text" {
    use "input-box"
    display grid
    position relative
    height auto
    line-height "$lh-text"
}

part "search-text:focus-within" {
    use "ring-line"
    outline-offset 0
    border-color "$accent"
}

part "search-text[state=mistake]" {
    border-color "$danger"
}

part "search-text.marks" "search-text.input" {
    grid-area "1 / 1"
    box-sizing border-box
    min-width 0
    margin 0
    padding 0
    border 0
    font-family "$font-mono"
    font-size inherit
    letter-spacing inherit
    line-height inherit
    white-space pre-wrap
    overflow-wrap anywhere
    tab-size 4
}

part "search-text.marks" {
    color transparent
    pointer-events none
    user-select none
}

part "search-text.input" {
    resize none
    overflow hidden
    background transparent
    color "$fg"
    outline none
}

part "search-mark[variant=field]" {
    border-radius "$r-ctl"
    background "$accent-soft"
}

part "search-mark[variant=value]" {
    border-radius "$r-ctl"
    background "$bg-hover"
}

part "search-mark[variant=mistake]" {
    text-decoration underline wavy
    text-decoration-color "$danger"
    text-underline-offset "$space-1"
}

// The offers stand under the box in the flow of the page and push what follows down, so they never
// cover words (S4); on a phone the sheet scrolls and its foot stays, so a long list never pushes
// the button off the screen (S3).
part "search-suggestions" {
    use "floating-box"
    max-height "calc($size-row * 6)"
    overflow-y auto
    margin 0
    padding "$space-1"
    list-style none
    border-radius "$r-card"
}

part "search-suggestion" {
    display flex
    align-items baseline
    gap "$space-3"
    box-sizing border-box
    min-height "$size-control"
    padding "$space-2 $space-3"
    color "$fg"
    cursor pointer
    border-radius "$r-ctl"
    font-size "$fs-ui"
}

part "search-suggestion:hover" {
    background "$bg-hover"
}

part "search-suggestion[state=active]" {
    background "$bg-selected"
    use "ring-inside"
}

// The words that are offered are words of the language: in the same font as the box they go into (S8).
part "search-suggestion.name" {
    font-family "$font-mono"
}

part "search-suggestion.kind" {
    color "$fg-muted"
    font-size "$fs-base"
}

// The box, the words about what is wrong with it and the offers stand 8 apart (S5).
part "search-wrap" {
    display flex
    flex-direction column
    gap "$space-2"
    position relative
}

part "search-mistakes" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-1"
}

part "search-mistake" {
    color "$danger"
    font-size "$fs-base"
    line-height "$lh-body"
    overflow-wrap anywhere
}

part "search-held-actions" {
    display flex
    flex none
    align-items center
    gap "$space-2"
}

part "search-held-actions[state=held]" {
    visibility hidden
}

// The line under the name of a saved search says who made it, and what is done with a change stands
// at its end. The line is always as high as the buttons, so nothing under the name moves when
// *Changed, not saved* appears (S29).
part "search-made-by" {
    display grid
    align-items center
    min-height "$size-control"
}

// The words and the buttons share one cell, so the buttons that are held (and not seen) take no
// width from the words: they are one line on a phone too. The held height (the control height) holds
// for words up to two lines long.
part "search-made-by > muted" {
    grid-area "1 / 1"
    min-width 0
}

part "search-made-by > search-held-actions" {
    grid-area "1 / 1"
    justify-self end
}

// Once changed, the words and the buttons are side by side, and the words give way (they wrap) so
// the two never overlap.
part "search-made-by[state=changed]" {
    display flex
    justify-content space-between
    gap "$space-2"
}

part "search-made-by[state=changed] > muted" {
    flex "1 1 auto"
}

// While the person is still typing at the end of the text, what is missing is a hint, not a fault (S6).
part "search-mistake[variant=hint]" {
    color "$fg-muted"
}

// What a search finds.
part "search-results" {
    display flex
    flex-direction column
    gap "$space-2"
}

// The results of the search that was fixed last stay while the text has a mistake. They keep their
// full contrast (a dimmed list fails AA, 4.5:1); the blue note above the list says that they are the
// last ones (UX design section 6.1), so the list itself has no edge of its own.

// The lists of the Share window and of Saved searches.
part "search-list" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-1"
}

part "search-list.item" {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-3"
    min-height "$size-control"
    padding 0 "$space-2"
    border-radius "$r-ctl"
}

// One project of the Share window: its tick box, and under it the quiet button that makes it the project's list.
part "share-choice" {
    display flex
    flex-direction column
    align-items flex-start
    gap "$space-1"
    flex 1
    min-width 0
}

// The body of the Share window starts where its title starts (the title bar is padded by pad-box,
// the body by pad-dialog), and a row of it has no padding of its own: title, groups and tick boxes
// stand on one edge (S31).
part "share-body" {
    display flex
    flex-direction column
    gap "$space-5"
    margin-inline "calc(($pad-dialog - $pad-box) * -1)"
}

part "share-row" {
    display flex
    align-items center
    gap "$space-3"
    min-height "$size-control"
}

part "search-help.title" {
    margin 0
    margin-block-end "$space-2"
    padding 0
    font-size "$fs-md"
    font-family "$font-display"
    font-weight "$weight-bold"
}

// The sub-groups of Saved searches (Mine, Shared with me): a smaller muted name over a thin line, so they read as groups and not as a second header.
part "nav-subgroup" {
    use "list-reset"
    display flex
    flex-direction column
    gap "$space-1"
    padding-inline-start "$space-3"
}

part "nav-subheading" {
    margin 0
    padding "$space-3 $space-3 $space-1"
    border-top "$border-width solid $divider"
    color "$fg-muted"
    font-size "$fs-sm"
    font-weight "$weight-regular"
}

// An example of the help sheet that can be put into the search with one click.
part "search-example" {
    use "sunken-box"
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap "$space-2" "$space-3"
    padding "$space-2" "$space-3"
    font-family "$font-mono"
    font-size "$fs-base"
    overflow-wrap anywhere
}

part "search-help" {
    font-family "$font-reader"
    display flex
    flex-direction column
    gap "$space-5"
}

part "search-help.group" {
    use "fieldset-reset"
    display flex
    flex-direction column
    gap "$space-2"
}

// ───────────── Boxes in the Details ─────────────
//
// At the end of the file, after the parts they reach into.

// A box for a value of one line (a text, a choice) fills the column of the value (the review of M4: "Alder
// Street Baker|y" ended under the edge of a box of its own width).
part "name-value.value > field" "name-value.value > value-frame" "name-value.value > stack" "name-value.value > row" {
    flex "1 1 100%"
    min-width 0
}

// A box beside an icon (the priority) takes what the icon leaves, so every box ends at the same edge.
part "name-value.value > row > field" {
    flex "1 1 auto"
    min-width 0
}

// At the end of the file, after the parts they reach into.

part "search-panel search-suggestions" {
    position static
    margin-block-start "$space-1"
}

// A page of a list gives the box of its rows the rest of the window, on a computer as on a phone: the page column is a
// full-height column, and every box between it and the list gives the list the room that is left. So the list ends above
// the bar of the ticked issues and the navigation of a phone, and above the strip of a minimized window, whose room the
// page takes off once (app-layout.main above). Where the boxes above the list leave it less than its least height, the
// page scrolls. Only the page of a list (list-main): the slim list of the focus view stays in its page.
part "app-layout:has(list-main)" {
    height "100%"
    min-height 0
}

part "app-layout:has(list-main) app-layout.column" {
    height "100%"
}

part "app-layout:has(list-main) app-layout.main" {
    min-height 0
    overflow-y auto
}

// A phone has one scroller where the list is: the list. The page does not scroll.
part "app-layout[variant=phone] app-layout.main:has(list-scroll)" {
    overflow-y hidden
}

part "app-layout app-layout.inner:has(list-main)" "app-layout card:has(list-main)" "app-layout card > stack:has(list-main)" "app-layout list-editor.list:has(list-main)" "app-layout list-main" "app-layout list-frame:has(list-scroll)" "app-layout search-results:has(list-scroll)" {
    display flex
    flex-direction column
    flex-wrap nowrap
    align-items stretch
    flex "1 1 0"
}

// Only where there are rows that scroll does every box give way below its content; a page without rows (nothing found,
// a mistake) keeps the room of its content, with the padding of its card, and the page scrolls.
part "app-layout app-layout.inner:has(list-scroll)" "app-layout card:has(list-scroll)" "app-layout card > stack:has(list-scroll)" "app-layout list-editor.list:has(list-scroll)" "app-layout list-main:has(list-scroll)" "app-layout list-frame:has(list-scroll)" "app-layout search-results:has(list-scroll)" {
    min-height 0
}

// On a computer the list and the open issue stand side by side in one line as high as the room; the list and Customize
// too, or Customize under the list where the room is narrow (each line as high as the room it is given).
part "list-editor:has(list-main)" "list-body:has(list-scroll)" {
    flex "1 1 0"
    align-items stretch
}

part "list-editor:has(list-scroll)" "list-body:has(list-scroll)" {
    min-height 0
}

part "list-editor:has(list-main)" {
    flex-wrap nowrap
}

// The list column fills the line it stands in, and its frame the column. With Customize under it the list takes the
// room the panel's columns leave.
part "list-column:has(list-scroll)" {
    min-height 0
    container "(max-width: $bp-list-beside)" {
        flex "1 1 0"
    }
}

part "app-layout[variant=phone] list-editor:has(list-main)" "app-layout[variant=phone] list-body:has(list-scroll)" {
    flex-direction column
    flex-wrap nowrap
}

// The box of the rows is as high as its rows, and no higher than the rest of the window: min(its rows, the rest).
part "list-main list-scroll" {
    flex "0 1 auto"
    min-height "$size-list-scroll-least"
}
