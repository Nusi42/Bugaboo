        font-size "$fs-md"
        letter-spacing "$doc-em-0-01"
    }

    rule ".brand svg" {
        width "$doc-space-26"
        height "$doc-space-26"
    }

    rule ".side-scroll" {
        flex 1
        overflow auto
        padding "$space-1 $doc-space-10 $doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-2"
    }

    rule ".side-search" {
        display flex
        align-items center
        gap "$space-2"
        margin "$doc-space-6 $doc-space-10 $space-2"
        padding "$space-2 $doc-space-10"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        color "$fg-muted"
        text-align left
        width "calc(100% - $doc-space-20)"
    }

    rule ".side-search kbd" {
        margin-left auto
    }

    rule ".nav-item" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$doc-space-7 $doc-space-10"
        border-radius "$r-ctl"
        border 0
        background none
        text-align left
        width "100%"
        color "$fg"
    }

    rule ".nav-item:hover" {
        background "$bg-hover"
    }

    rule ".nav-item[aria-current=\"true\"]" {
        background "$bg-selected"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-item .count" {
        margin-left auto
        font-size "$fs-xs"
        background "$accent"
        color "$on-accent"
        border-radius "$doc-r-pill"
        padding "0 $doc-space-7"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-label" {
        font-size "$fs-xs"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        padding "$doc-space-14 $doc-space-10 $space-1"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-sub" {
        padding-left "$doc-space-30"
    }

    rule ".side-foot" {
        border-top "$border-width solid $border"
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".timer-chip" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $doc-space-10"
        border-radius "$r-ctl"
        background "$accent-soft"
        color "$accent-fg"
        border 0
        width "100%"
        text-align left
    }

    rule ".timer-chip .t" {
        margin-left auto
        font-weight "$doc-weight-semibold"
    }

    rule ".timer-chip.off" {
        background transparent
        color "$fg-muted"
        border "$border-width dashed $border"
    }

    rule ".main" {
        display flex
        flex-direction column
        min-width 0
        min-height 0
        background "$bg-canvas"
    }

    rule ".topbar" {
        display flex
        align-items center
        gap "$space-3"
        padding "$doc-space-10 $doc-space-20"
        border-bottom "$border-width solid $border"
        min-height "$doc-space-56"
        flex-wrap wrap
    }

    rule ".crumbs" {
        display flex
        align-items center
        gap "$doc-space-6"
        color "$fg-muted"
        min-width 0
        flex 1 1 auto
    }

    rule ".crumbs b" {
        color "$fg"
        font-weight "$doc-weight-semibold"
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
    }

    rule ".top-actions" {
        display flex
        align-items center
        gap "$space-2"
        margin-left auto
    }

    rule "select.look" {
        padding "$doc-space-6 $space-2"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".content" {
        flex 1
        overflow auto
        padding "$doc-space-20 $space-5 $doc-space-40"
        min-height 0
    }

    rule ".content.flush" {
        padding 0
    }

    rule ".searchbar" {
        display flex
        align-items flex-start
        gap "$space-2"
        padding "$space-3 $space-5"
        border-bottom "$border-width solid $border-subtle"
        background "$bg-canvas"
        flex-wrap wrap
    }

    rule ".adv" {
        flex 1
        min-width 0
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".adv textarea" {
        width "100%"
        min-height "$doc-space-62"
        resize vertical
        padding "$doc-space-10 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        font-family "$font-mono"
        font-size "$fs-sm"
        line-height "$doc-lh-code"
    }

    rule ".adv .err" {
        color "$danger"
        font-size "$fs-sm"
        display flex
        gap "$doc-space-6"
        align-items center
    }

    rule ".adv .hint" {
        color "$fg-muted"
        font-size "$fs-xs"
    }

    rule ".ask" {
        display flex
        gap "$space-2"
        flex 1
        min-width 0
        flex-wrap wrap
    }

    rule ".ask input" {
        flex 1
        min-width "$doc-space-180"
        padding "$space-2 $space-3"
        border "$border-width solid $accent"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".ask-result" {
        flex-basis "100%"
        border "$border-width solid $border"
        background "$accent-soft"
        border-radius "$r-ctl"
