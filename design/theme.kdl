    }

    rule ".setting-tabs button[aria-selected=\"true\"]" {
        color "$fg"
        font-weight "$doc-weight-semibold"
        border-bottom-color "$accent"
    }

    rule ".help" {
        font-size "$fs-sm"
        color "$fg-muted"
        margin "$doc-space-n6 0 $doc-space-14"
        max-width "$doc-measure-body"
    }

    rule ".pop" {
        position fixed
        z-index "$doc-z-50"
        min-width "$doc-space-220"
        max-width "min($doc-space-320, $doc-popup-width)"
        max-height "$doc-menu-height"
        overflow auto
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$r-card"
        box-shadow "$shadow"
        padding "$doc-space-6"
    }

    rule ".pop-h" {
        font-size "$fs-xs"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        padding "$doc-space-6 $doc-space-10 $space-1"
        font-weight "$doc-weight-semibold"
    }

    rule ".pop-item" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $doc-space-10"
        border 0
        background none
        width "100%"
        text-align left
        border-radius "$r-ctl"
    }

    rule ".pop-item:hover" ".pop-item:focus-visible" {
        background "$bg-hover"
