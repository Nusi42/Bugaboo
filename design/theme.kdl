    }

    rule ".perm th" ".perm td" {
        padding "$space-2 $doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        text-align left
    }

    rule ".ts tfoot td" {
        font-weight "$weight-bold"
        background "$bg-surface"
    }

    rule ".ts td:first-child" ".ts th:first-child" {
        text-align left
    }

    rule ".ts .cell" {
        display inline-block
        min-width "$doc-space-44"
        padding "$doc-space-3 $space-1"
        border "$border-width solid $border-subtle"
        border-radius "$doc-space-5"
        font-family "$font-mono"
        background "$bg-canvas"
    }

    rule ".ts .cell.focus" {
        border-color "$accent"
        box-shadow "0 0 0 $doc-space-2 $accent-soft"
    }

    rule ".ts th.today" {
        color "$accent-fg"
    }

    rule ".bars" {
        display flex
        flex-direction column
        gap "$doc-space-6"
        padding "$space-3"
        font-size "$doc-font-12"
    }

    rule ".bars div" {
