        background "$warning-soft"
        border "$border-width solid $warning"
        color "$fg"
    }

    rule ".ni-grid" {
        display grid
        grid-template-columns "repeat(auto-fit, minmax($doc-space-180, 1fr))"
        gap "$space-3"
    }

    rule ".app.focus" {
