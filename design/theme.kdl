        margin "$space-3"
    }

    rule ".wfrow" {
        display flex
        gap "$space-2"
        align-items center
        flex-wrap wrap
        padding "$doc-space-9 $space-3"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".te" {
        display grid
        grid-template-columns "$doc-space-200 minmax(0, 1fr)"
        min-height "$doc-space-260"
    }

    rule ".te-l" {
        border-right "$border-width solid $border"
        padding "$doc-space-10"
        font-size "$doc-font-12"
        display flex
        flex-direction column
        gap "$space-1"
        background "$bg-surface"
    }

    rule ".te-l .g" {
        font-weight "$weight-bold"
        margin-top "$doc-space-6"
    }

    rule ".te-l .row" {
        display flex
        align-items center
        gap "$doc-space-6"
    }

    rule ".sw" {
        width "$doc-space-14"
        height "$doc-space-14"
        border-radius "$doc-r-small"
        border "$border-width solid $border"
