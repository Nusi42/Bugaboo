        inset 0 auto 0 0
        background "$accent-fg"
        opacity "$doc-opacity-0-55"
    }

    rule ".ms" {
        position absolute
        top "$doc-space-11"
        width "$space-4"
        height "$space-4"
        transform "translateX($doc-space-n8) rotate($doc-deg-45)"
        background "$warning"
        border-radius "$doc-space-2"
    }

    rule ".today" {
        position absolute
        top 0
        bottom 0
        width "$doc-space-2"
        background "$danger"
        opacity "$opacity-busy"
        pointer-events none
    }

    rule ".today-label" {
        position absolute
        top "$doc-space-2"
        font-size "$doc-font-10"
        color "$danger"
        font-weight "$weight-bold"
        transform "translateX($space-1)"
    }

    rule ".tl-list" {
