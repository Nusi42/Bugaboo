        min-height 0
        display grid
        grid-template-columns "$doc-space-270 minmax(0, 1fr)"
    }

    rule ".focus-wrap.no-rail" {
        grid-template-columns "minmax(0, 1fr)"
    }

    rule ".rail" {
        border-right "$border-width solid $border"
        overflow auto
        background "$bg-surface"
        display flex
        flex-direction column
    }

    rule ".rail-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-10 $doc-space-10 $doc-space-6"
