        grid-template-columns "$doc-space-70 1fr $doc-space-30"
        gap "$space-2"
        align-items center
    }

    rule ".bars i" {
        display block
        height "$doc-space-10"
        border-radius "$doc-space-3"
    }

    rule ".msg" {
        max-width "92%"
        padding "$space-2 $doc-space-10"
        border-radius "$r-card"
        line-height "$lh-text"
        font-size "$doc-font-12-5"
    }

    rule ".msg.me" {
        align-self flex-end
        background "$accent"
        color "$on-accent"
    }

    rule ".msg.ai" {
        align-self flex-start
