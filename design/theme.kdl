        flex-direction column
        gap "$doc-space-10"
    }

    rule ".cal-top" {
        display flex
        gap "$space-3"
        align-items baseline
        flex-wrap wrap
    }

    rule ".cal" {
        display grid
        grid-template-columns "repeat(7, minmax(0, 1fr))"
