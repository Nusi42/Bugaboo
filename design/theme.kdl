        flex-direction column
        gap "$space-2"
        padding "$space-4"
        border "$border-width solid $border"
        border-radius "$doc-space-14"
        background "$bg-raised"
    }

    rule ".signin .or" {
        text-align center
        font-size "$doc-font-11"
