    }

    rule ".app.focus .sidebar .timer-chip" ".app.focus .sidebar .wd-chip" {
        font-size 0
        justify-content center
        padding "$doc-space-9 0"
    }

    rule ".wd-chip .t" {
        margin-left auto
        font-weight "$doc-weight-semibold"
    }

    rule ".rail-i .t" {
