    rule ".pop-note" {
        font-size "$fs-xs"
        color "$fg-muted"
        padding "$doc-space-6 $doc-space-10"
        border-top "$border-width solid $border-subtle"
        margin-top "$space-1"
    }

    rule ".scrim" {
        position fixed
        inset 0
        background "color-mix(in srgb, $scrim calc($opacity-scrim*100%), transparent)"
        z-index "$doc-z-60"
        display grid
        place-items start center
        padding "$doc-vh-10 $space-4 $space-4"
    }

    rule ".dialog" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$doc-space-14"
        box-shadow "$shadow"
        width "min($doc-space-560, 100%)"
        max-height "$doc-vh-80"
        overflow auto
        display flex
        flex-direction column
    }

    rule ".dialog-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-14 $doc-space-18"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".dialog-h h2" {
        margin 0
        font-size "$fs-md"
    }

    rule ".dialog-b" {
        padding "$space-4 $doc-space-18"
        display flex
        flex-direction column
        gap "$doc-space-14"
    }

    rule ".dialog-f" {
        padding "$space-3 $doc-space-18"
        border-top "$border-width solid $border-subtle"
