        display inline-flex
        gap "$doc-space-3"
        align-items center
        font-size "$doc-font-10-5"
        color "$warning"
    }

    rule ".ts" {
        border-collapse collapse
        width "100%"
        font-size "$doc-font-12"
    }

    rule ".ts th" ".ts td" {
        padding "$doc-space-6"
        border-bottom "$border-width solid $border-subtle"
