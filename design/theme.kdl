        color "$danger"
        font-weight "$weight-bold"
    }

    rule ":root:root:root .u-margin-top-8px--display-flex--gap-6px--flex-wrap-wrap" {
        margin-top "$space-2"
        display flex
        gap "$doc-space-6"
        flex-wrap wrap
    }

    rule ":root:root:root .u-margin-6px-auto-10px" {
        margin "$doc-space-6 auto $doc-space-10"
    }

    rule ":root:root:root .u-font-size-11px--margin-top-8px" {
        font-size "$doc-font-11"
        margin-top "$space-2"
    }

    rule ":root:root:root .u-padding-0--overflow-hidden--text-align-left" {
        padding 0
        overflow hidden
        text-align left
    }

    rule ":root:root:root .u-padding-10px-12px" {
        padding "$doc-space-10 $space-3"
    }

    rule ":root:root:root .u-margin-6px-0-0--font-size-12-5px" {
        margin "$doc-space-6 0 0"
        font-size "$doc-font-12-5"
    }

    rule ":root:root:root .u-font-weight-400--font-size-11px" {
        font-weight "$weight-regular"
        font-size "$doc-font-11"
    }

    rule ":root:root:root .u-width-4px--height-4px" {
        width "$space-1"
        height "$space-1"
    }

    rule ":root:root:root .u-width-8px--height-8px" {
        width "$space-2"
        height "$space-2"
    }

    rule ":root:root:root .u-width-16px--height-16px" {
        width "$space-4"
        height "$space-4"
    }

    rule ":root:root:root .u-width-24px--height-24px" {
        width "$space-5"
        height "$space-5"
    }

    rule ":root:root:root .u-width-32px--height-32px" {
        width "$space-6"
        height "$space-6"
    }

    rule ":root:root:root .u-width-48px--height-48px" {
        width "$doc-space-48"
        height "$doc-space-48"
    }

    rule ":root:root:root .u-display-flex--gap-14px--flex-wrap-wrap--align-items-center" {
        display flex
        gap "$doc-space-14"
        flex-wrap wrap
        align-items center
    }

    rule ":root:root:root .u-position-absolute" {
        position absolute
    }

    rule ":root:root:root .u-font-size-13px" {
        font-size "$doc-font-13"
    }

    rule ":root:root:root .u-border-radius-4px" {
        border-radius "$doc-r-small"
    }
}

docs "mockup" description="The clickable mockup: the layout of the app, its screens and its overlays. Needs theme.css and components.css." {
    tokens {
        layer "doc-z-50" 50
        layer "doc-z-60" 60
        layer "doc-z-70" 70
        line-height "doc-lh-1-7" "1.7"
        number "doc-stroke-2-2" 2.2
        number "doc-stroke-3-5" 3.5
        opacity "doc-opacity-0-45" 0.45
        opacity "doc-opacity-0-55" 0.55
        size "doc-bp-1279" "1279px"
        size "doc-bp-899" "899px"
        size "doc-bp-900" "900px"
        size "doc-ch-65" "65ch"
        size "doc-ch-75" "75ch"
        size "doc-em-0-01" "0.01em"
        size "doc-em-1-5" "1.5em"
        size "doc-font-26" "26px"
        size "doc-safe-bottom" "env(safe-area-inset-bottom,0px)"
        size "doc-space-104" "104px"
        size "doc-space-11" "11px"
        size "doc-space-180" "180px"
        size "doc-space-236" "236px"
        size "doc-space-270" "270px"
        size "doc-space-290" "290px"
        size "doc-space-38" "38px"
        size "doc-space-40" "40px"
        size "doc-space-42" "42px"
        size "doc-space-440" "440px"
        size "doc-space-52" "52px"
        size "doc-space-62" "62px"
        size "doc-space-620" "620px"
        size "doc-space-720" "720px"
        size "doc-space-76" "76px"
        size "doc-space-760" "760px"
        size "doc-space-900" "900px"
        size "doc-space-980" "980px"
        size "doc-space-n4" "-4px"
        size "doc-space-n7" "-7px"
        size "doc-space-n8" "-8px"
        size "doc-vh-10" "10vh"
        size "doc-vh-70" "70vh"
        size "doc-vh-72" "72vh"
        size "doc-vh-80" "80vh"
        size "doc-vh-92" "92vh"
        size "doc-vw-70" "70vw"
    }

    rule "html" "body" {
        height "100%"
    }

    rule ".app" {
        height "100%"
        display grid
        grid-template-columns "$doc-space-236 minmax(0, 1fr) auto"
        overflow hidden
        position relative
    }

    rule ".sidebar" {
        background "$bg-surface"
        border-right "$border-width solid $border"
        display flex
        flex-direction column
        min-height 0
    }

    rule ".brand" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$space-4 $space-4 $space-2"
        font-weight "$weight-bold"
        font-size "$fs-md"
        letter-spacing "$doc-em-0-01"
    }

    rule ".brand svg" {
        width "$doc-space-26"
        height "$doc-space-26"
    }

    rule ".side-scroll" {
        flex 1
        overflow auto
        padding "$space-1 $doc-space-10 $doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-2"
    }

    rule ".side-search" {
        display flex
        align-items center
        gap "$space-2"
        margin "$doc-space-6 $doc-space-10 $space-2"
        padding "$space-2 $doc-space-10"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        color "$fg-muted"
        text-align left
        width "calc(100% - $doc-space-20)"
    }

    rule ".side-search kbd" {
        margin-left auto
    }

    rule ".nav-item" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$doc-space-7 $doc-space-10"
        border-radius "$r-ctl"
        border 0
        background none
        text-align left
        width "100%"
        color "$fg"
    }

    rule ".nav-item:hover" {
        background "$bg-hover"
    }

    rule ".nav-item[aria-current=\"true\"]" {
        background "$bg-selected"
        color "$accent-fg"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-item .count" {
        margin-left auto
        font-size "$fs-xs"
        background "$accent"
        color "$on-accent"
        border-radius "$doc-r-pill"
        padding "0 $doc-space-7"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-label" {
        font-size "$fs-xs"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        padding "$doc-space-14 $doc-space-10 $space-1"
        font-weight "$doc-weight-semibold"
    }

    rule ".nav-sub" {
        padding-left "$doc-space-30"
    }

    rule ".side-foot" {
        border-top "$border-width solid $border"
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".timer-chip" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $doc-space-10"
        border-radius "$r-ctl"
        background "$accent-soft"
        color "$accent-fg"
        border 0
        width "100%"
        text-align left
    }

    rule ".timer-chip .t" {
        margin-left auto
        font-weight "$doc-weight-semibold"
    }

    rule ".timer-chip.off" {
        background transparent
        color "$fg-muted"
        border "$border-width dashed $border"
    }

    rule ".main" {
        display flex
        flex-direction column
        min-width 0
        min-height 0
        background "$bg-canvas"
    }

    rule ".topbar" {
        display flex
        align-items center
        gap "$space-3"
        padding "$doc-space-10 $doc-space-20"
        border-bottom "$border-width solid $border"
        min-height "$doc-space-56"
        flex-wrap wrap
    }

    rule ".crumbs" {
        display flex
        align-items center
        gap "$doc-space-6"
        color "$fg-muted"
        min-width 0
        flex 1 1 auto
    }

    rule ".crumbs b" {
        color "$fg"
        font-weight "$doc-weight-semibold"
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
    }

    rule ".top-actions" {
        display flex
        align-items center
        gap "$space-2"
        margin-left auto
    }

    rule "select.look" {
        padding "$doc-space-6 $space-2"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".content" {
        flex 1
        overflow auto
        padding "$doc-space-20 $space-5 $doc-space-40"
        min-height 0
    }

    rule ".content.flush" {
        padding 0
    }

    rule ".searchbar" {
        display flex
        align-items flex-start
        gap "$space-2"
        padding "$space-3 $space-5"
        border-bottom "$border-width solid $border-subtle"
        background "$bg-canvas"
        flex-wrap wrap
    }

    rule ".adv" {
        flex 1
        min-width 0
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".adv textarea" {
        width "100%"
        min-height "$doc-space-62"
        resize vertical
        padding "$doc-space-10 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        font-family "$mono"
        font-size "$fs-sm"
        line-height "$doc-lh-code"
    }

    rule ".adv .err" {
        color "$danger"
        font-size "$fs-sm"
        display flex
        gap "$doc-space-6"
        align-items center
    }

    rule ".adv .hint" {
        color "$fg-muted"
        font-size "$fs-xs"
    }

    rule ".ask" {
        display flex
        gap "$space-2"
        flex 1
        min-width 0
        flex-wrap wrap
    }

    rule ".ask input" {
        flex 1
        min-width "$doc-space-180"
        padding "$space-2 $space-3"
        border "$border-width solid $accent"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".ask-result" {
        flex-basis "100%"
        border "$border-width solid $border"
        background "$accent-soft"
        border-radius "$r-ctl"
        padding "$doc-space-10 $space-3"
        display flex
        flex-wrap wrap
        gap "$space-2"
        align-items center
    }

    rule ".ask-result code" {
        font-family "$mono"
        font-size "$fs-sm"
        flex 1
        min-width 0
    }

    rule ".tbl" {
        width "100%"
        border-collapse collapse
    }

    rule ".tbl th" {
        font-size "$fs-xs"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        color "$fg-subtle"
        text-align left
        padding "$space-2 $doc-space-10"
        border-bottom "$border-width solid $border"
        font-weight "$doc-weight-semibold"
        white-space nowrap
    }

    rule ".tbl td" {
        padding "$doc-space-9 $doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        vertical-align middle
    }

    rule ".tbl tr.row" {
        cursor pointer
    }

    rule ".group-h td" {
        background "$bg-surface"
        font-weight "$doc-weight-semibold"
        font-size "$fs-sm"
        color "$fg-muted"
    }

    rule ".ts th" ".ts td" {
        padding "$space-2 $space-2"
        border-bottom "$border-width solid $border-subtle"
        text-align center
        font-variant-numeric tabular-nums
    }

    rule ".perm th" ".perm td" {
        padding "$doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        text-align left
    }

    rule ".ts tfoot td" {
        font-weight "$weight-bold"
        background "$bg-surface"
    }

    rule ".perm th" {
        font-size "$fs-xs"
        color "$fg-muted"
        text-transform uppercase
        letter-spacing "$doc-tracking-mid"
        background "$bg-surface"
    }

    rule ".ts th" {
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-semibold"
        background "$bg-surface"
    }

    rule ".ts td:first-child" ".ts th:first-child" {
        text-align left
    }

    rule ".ts tr.wh td" {
        background "$bg-surface"
        font-weight "$weight-bold"
    }

    rule ".tbl tr.row:hover td" {
        background "$bg-hover"
    }

    rule ".tbl tr.row.sel td" {
        background "$bg-selected"
    }

    rule ".tbl .title" {
        font-weight "$doc-weight-medium"
    }

    rule ".cards" {
        display none
    }

    rule ".many-change-bar" {
        position sticky
        bottom "$space-3"
        margin "$space-3 auto 0"
        width max-content
        max-width "100%"
        display flex
        flex-wrap wrap
        gap "$doc-space-6"
        align-items center
        background "$bg-raised"
        border "$border-width solid $border"
        box-shadow "$shadow"
        border-radius "$r-card"
        padding "$space-2 $doc-space-10"
    }

    rule ".board" {
        display grid
        grid-auto-flow column
        grid-auto-columns "minmax($doc-space-240, 1fr)"
        gap "$doc-space-14"
        overflow-x auto
        padding "$space-4 $space-5 $space-5"
        min-height "100%"
        align-items start
    }

    rule ".col" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        display flex
        flex-direction column
        min-height "$doc-space-200"
    }

    rule ".col.drop-ok" {
        outline "$doc-space-2 dashed $accent"
        outline-offset "$doc-space-n2"
    }

    rule ".col.drop-no" {
        opacity "$doc-opacity-0-45"
    }

    rule ".col-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-10 $space-3"
        font-weight "$doc-weight-semibold"
    }

    rule ".col-h .lim" {
        margin-left auto
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-medium"
    }

    rule ".col-h .lim.over" {
        color "$warning"
        font-weight "$weight-bold"
    }

    rule ".col-b" {
        display flex
        flex-direction column
        gap "$space-2"
        padding "0 $doc-space-10 $space-3"
    }

    rule ".card" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$space-2"
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$space-2"
        cursor grab
        box-shadow "0 $border-width $border-width $border-subtle"
    }

    rule ".card:hover" {
        border-color "$accent"
    }

    rule ".card .title" {
        font-weight "$doc-weight-medium"
    }

    rule ".card .meta" {
        display flex
        align-items center
        gap "$space-2"
        flex-wrap wrap
        font-size "$fs-sm"
    }

    rule ".card .move" {
        margin-left auto
    }

    rule ".board-tabs" {
        display none
    }

    rule ".tl-wrap" {
        overflow-x auto
        padding "$space-4 $space-5 $space-5"
    }

    rule ".tl" {
        min-width "$doc-space-760"
        display grid
        grid-template-columns "$doc-space-260 1fr"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
        background "$bg-raised"
    }

    rule ".tl-h" {
        display contents
    }

    rule ".tl-h > div" {
        background "$bg-surface"
        border-bottom "$border-width solid $border"
        padding "$space-2 $doc-space-10"
        font-size "$fs-xs"
        color "$fg-muted"
        font-weight "$doc-weight-semibold"
    }

    rule ".tl-h > .tl-weeks" {
        display grid
        grid-template-columns "repeat(5, 1fr)"
        padding 0
    }

    rule ".tl-weeks span" {
        padding "$space-2 $doc-space-10"
        border-left "$border-width solid $border-subtle"
    }

    rule ".tl-name" {
        padding "$space-2 $doc-space-10"
        border-bottom "$border-width solid $border-subtle"
        display flex
        align-items center
        gap "$space-2"
        min-width 0
        cursor pointer
    }

    rule ".tl-name:hover" {
        background "$bg-hover"
    }

    rule ".tl-name .t" {
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
    }

    rule ".tl-name.goal" {
        font-weight "$doc-weight-semibold"
        background "$bg-surface"
    }

    rule ".tl-name.child" {
        padding-left "$doc-space-28"
    }

    rule ".tl-lane" {
        position relative
        border-bottom "$border-width solid $border-subtle"
        min-height "$doc-space-38"
        background-image "repeating-linear-gradient(to right, transparent 0, transparent calc(20% - $doc-space-1), $border-subtle calc(20% - $doc-space-1), $border-subtle 20%)"
    }

    rule ".bar" {
        position absolute
        top "$doc-space-9"
        height "$doc-space-20"
        border-radius "$doc-space-5"
        background "$st-ip"
        color "$on-accent"
        font-size "$doc-font-11"
        padding "0 $doc-space-6"
        display flex
        align-items center
        overflow hidden
        white-space nowrap
        cursor pointer
        border 0
    }

    rule ".bar.ns" {
        background "$fg-subtle"
    }

    rule ".bar.done" {
        background "$st-done"
    }

    rule ".bar.goal" {
        background "$accent"
        height "$doc-space-10"
        top "$doc-space-14"
        border-radius "$doc-space-3"
    }

    rule ".bar.goal .prog" {
        position absolute
        inset 0 auto 0 0
        background "$accent-fg"
        opacity "$doc-opacity-0-55"
    }

    rule ".ms" {
        position absolute
        top "$doc-space-11"
        width "$space-4"
        height "$space-4"
        transform "translateX($doc-space-n8) rotate($doc-deg-45)"
        background "$warning"
        border-radius "$doc-space-2"
    }

    rule ".today" {
        position absolute
        top 0
        bottom 0
        width "$doc-space-2"
        background "$danger"
        opacity "$opacity-busy"
        pointer-events none
    }

    rule ".today-label" {
        position absolute
        top "$doc-space-2"
        font-size "$doc-font-10"
        color "$danger"
        font-weight "$weight-bold"
        transform "translateX($space-1)"
    }

    rule ".tl-list" {
        display none
    }

    rule ".tl-legend" {
        display flex
        gap "$space-4"
        flex-wrap wrap
        margin-top "$doc-space-10"
        font-size "$fs-sm"
        color "$fg-muted"
        align-items center
    }

    rule ".tl-legend i" {
        display inline-block
        width "$space-3"
        height "$space-3"
        border-radius "$doc-space-3"
        vertical-align "$doc-space-n2"
        margin-right "$space-1"
    }

    rule ".panel" {
        width "$doc-space-440"
        border-left "$border-width solid $border"
        background "$bg-canvas"
        display flex
        flex-direction column
        min-height 0
    }

    rule ".panel[hidden]" {
        display none
    }

    rule ".panel-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-10 $doc-space-14"
        border-bottom "$border-width solid $border"
        min-height "$doc-space-56"
    }

    rule ".panel-tabs" {
        display flex
        gap "$space-1"
    }

    rule ".panel-b" {
        flex 1
        overflow auto
        padding "$doc-space-18 $doc-space-20 $space-6"
        display flex
        flex-direction column
        gap "$doc-space-18"
        min-height 0
    }

    rule ".issue-title" {
        font-size "$fs-lg"
        font-weight "$weight-bold"
        line-height "$doc-lh-1-3"
        border "$border-width solid transparent"
        border-radius "$r-ctl"
        padding "$space-1 $doc-space-6"
        margin "$doc-space-n4 $doc-space-n6"
        background none
        width "calc(100% + $space-3)"
        text-wrap balance
    }

    rule ".issue-title:hover" {
        border-color "$border"
    }

    rule ".fval" {
        border "$border-width solid transparent"
        background none
        border-radius "$r-ctl"
        padding "$doc-space-5 $doc-space-7"
        margin-left "$doc-space-n7"
        text-align left
        display inline-flex
        align-items center
        gap "$doc-space-6"
        max-width "100%"
    }

    rule ".fval:hover" {
        border-color "$border"
        background "$bg-raised"
    }

    rule ".fval.add" {
        color "$fg-subtle"
    }

    rule ".ro" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-5 0"
    }

    rule ".ro .lock" {
        color "$fg-subtle"
    }

    rule ".ro-note" {
        font-size "$fs-xs"
        color "$fg-muted"
        grid-column 2
        margin-top "$doc-space-n4"
    }

    rule ".section-h" {
        font-size "$fs-sm"
        font-weight "$weight-bold"
        color "$fg-muted"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        margin "0 0 $space-2"
    }

    rule ".desc" {
        line-height "$lh-loose"
        max-width "$doc-ch-65"
    }

    rule ".desc ol" {
        padding-left "$doc-space-20"
        margin "$doc-space-6 0"
    }

    rule ".subs" {
        display flex
        flex-direction column
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
    }

    rule ".subs button" {
        display flex
        gap "$doc-space-10"
        align-items center
        padding "$space-2 $doc-space-10"
        border 0
        border-bottom "$border-width solid $border-subtle"
        background "$bg-raised"
        text-align left
    }

    rule ".toast button" {
        background none
        border 0
        color inherit
        font-weight "$weight-bold"
        text-decoration underline
        padding "$space-1 $doc-space-6"
    }

    rule ".setting-tabs button" {
        border 0
        background none
        padding "$space-2 $space-3"
        color "$fg-muted"
        border-bottom "$doc-space-2 solid transparent"
        white-space nowrap
    }

    rule ".doc-toolbar button" {
        border 0
        background none
        padding "$space-1 $space-2"
        border-radius "$doc-r-small"
        font-size "$fs-sm"
    }

    rule ".subs button:last-child" {
        border-bottom 0
    }

    rule ".subs button:hover" {
        background "$bg-hover"
    }

    rule ".activity" {
        display flex
        flex-direction column
        gap "$space-3"
    }

    rule ".act" {
        display flex
        gap "$doc-space-10"
    }

    rule ".act .body" {
        flex 1
        min-width 0
    }

    rule ".act .bubble" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$space-2 $space-3"
        margin-top "$space-1"
    }

    rule ".act.change" {
        color "$fg-muted"
        font-size "$fs-sm"
        align-items center
    }

    rule ".comment-box" {
        display flex
        gap "$space-2"
        align-items flex-end
    }

    rule ".comment-box textarea" {
        flex 1
        min-height "$doc-space-42"
        padding "$doc-space-9 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        resize vertical
    }

    rule ".back-btn" {
        display none
    }

    rule ".ai-ctx" {
        display flex
        flex-wrap wrap
        gap "$doc-space-6"
        align-items center
        font-size "$fs-sm"
    }

    rule ".ai-src" {
        font-size "$fs-sm"
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-ctl"
        padding "$space-2 $doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-2"
    }

    rule ".msg" {
        max-width "92%"
        padding "$doc-space-10 $space-3"
        border-radius "$space-3"
        line-height "$doc-lh-code"
    }

    rule ".msg.me" {
        align-self flex-end
        background "$accent"
        color "$on-accent"
        border-bottom-right-radius "$space-1"
    }

    rule ".msg.ai" {
        align-self flex-start
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-bottom-left-radius "$space-1"
    }

    rule ".msg ul" {
        margin "$doc-space-6 0"
        padding-left "$doc-space-18"
    }

    rule ".ai-label" {
        font-size "$fs-xs"
        color "$fg-subtle"
        display flex
        gap "$space-1"
        align-items center
    }

    rule ".proposal" {
        border "$border-width solid $accent"
        border-radius "$r-card"
        padding "$space-3"
        background "$bg-raised"
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".proposal .diff" {
        display flex
        align-items center
        gap "$space-2"
        flex-wrap wrap
    }

    rule ".proposal .old" {
        text-decoration line-through
        color "$fg-muted"
    }

    rule ".ai-input" {
        display flex
        gap "$space-2"
        border-top "$border-width solid $border"
        padding "$space-3 $doc-space-14"
    }

    rule ".ai-input input" {
        flex 1
        min-width 0
        padding "$doc-space-9 $space-3"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
    }

    rule ".page-h" {
        display flex
        align-items baseline
        gap "$space-3"
        flex-wrap wrap
        margin "0 0 $doc-space-18"
    }

    rule ".page-h h1" {
        font-size "$fs-xl"
        margin 0
        text-wrap balance
    }

    rule ".grid2" {
        display grid
        grid-template-columns "repeat(auto-fit, minmax($doc-space-320, 1fr))"
        gap "$doc-space-18"
        align-items start
    }

    rule ".box" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
    }

    rule ".box-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-3 $doc-space-14"
        border-bottom "$border-width solid $border-subtle"
        font-weight "$weight-bold"
    }

    rule ".box-h .muted" {
        font-weight "$weight-regular"
        margin-left auto
        font-size "$fs-sm"
    }

    rule ".box-row" {
        display flex
        align-items center
        gap "$doc-space-10"
        padding "$doc-space-9 $doc-space-14"
        border 0
        border-bottom "$border-width solid $border-subtle"
        background none
        width "100%"
        text-align left
    }

    rule ".box-row:last-child" {
        border-bottom 0
    }

    rule ".box-row:hover" {
        background "$bg-hover"
    }

    rule ".box-row .t" {
        flex 1
        min-width 0
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
    }

    rule ".timer-big" {
        display flex
        align-items center
        gap "$doc-space-14"
        padding "$space-4"
        background "$accent-soft"
        border "$border-width solid $accent"
        border-radius "$r-card"
        margin-bottom "$doc-space-18"
        flex-wrap wrap
    }

    rule ".timer-big .clock" {
        font-family "$mono"
        font-size "$doc-font-28"
        font-weight "$doc-weight-semibold"
        color "$accent-fg"
    }

    rule ".checklist" {
        display flex
        gap "$doc-space-10"
        flex-wrap wrap
        margin-bottom "$doc-space-18"
        padding "$doc-space-14"
        border "$border-width dashed $border"
        border-radius "$r-card"
    }

    rule ".checklist .step" {
        display flex
        align-items center
        gap "$space-2"
    }

    rule ".done-mark" {
        width "$doc-space-20"
        height "$doc-space-20"
        border-radius "50%"
        background "$success"
        color "$bg-canvas"
        display grid
        place-items center
        font-size "$doc-font-12"
        font-weight "$weight-bold"
    }

    rule ".docs" {
        display grid
        grid-template-columns "$doc-space-240 minmax(0, 1fr) $doc-space-240"
        min-height "100%"
    }

    rule ".doc-tree" {
        border-right "$border-width solid $border"
        padding "$doc-space-14 $doc-space-10"
        background "$bg-surface"
        display flex
        flex-direction column
        gap "$doc-space-2"
    }

    rule ".doc-tree .nav-item" {
        font-size "$fs-sm"
    }

    rule ".doc-page" {
        padding "$doc-space-28 $doc-space-36 $doc-space-48"
        min-width 0
    }

    rule ".doc-page h1" {
        font-size "$doc-font-30"
        margin "$space-1 0 $doc-space-6"
        text-wrap balance
    }

    rule ".doc-page h2" {
        font-size "$fs-lg"
        margin "$space-5 0 $space-2"
    }

    rule ".doc-page p" ".doc-page li" {
        max-width "$doc-measure-lede"
        line-height "$doc-lh-reading"
    }

    rule ".doc-toolbar" {
        display flex
        gap "$space-1"
        flex-wrap wrap
        border "$border-width solid $border"
        border-radius "$r-ctl"
        padding "$space-1"
        margin "$space-3 0 $doc-space-20"
        width max-content
        max-width "100%"
        background "$bg-surface"
    }

    rule ".doc-toolbar button:hover" {
        background "$bg-hover"
    }

    rule ".live-chip" {
        display inline-flex
        align-items center
        gap "$doc-space-6"
        padding "$doc-space-2 $space-2 $doc-space-2 $doc-space-6"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-raised"
        vertical-align "$doc-space-1"
        font-size "$fs-sm"
    }

    rule ".doc-side" {
        border-left "$border-width solid $border"
        padding "$space-4 $doc-space-14"
        display flex
        flex-direction column
        gap "$doc-space-18"
        font-size "$fs-sm"
    }

    rule ".ver" {
        display flex
        gap "$space-2"
        align-items center
        padding "$space-1 0"
    }

    rule ".lockbadge" {
        display inline-flex
        gap "$space-1"
        align-items center
        font-size "$fs-xs"
        color "$warning"
        margin-left auto
    }

    rule ".ts-wrap" {
        overflow-x auto
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
    }

    rule ".ts" {
        border-collapse collapse
        width "100%"
        min-width "$doc-space-720"
    }

    rule ".ts th.today" {
        color "$accent-fg"
    }

    rule ".ts input" {
        width "$doc-space-64"
        padding "$doc-space-6"
        text-align center
        border "$border-width solid $border-subtle"
        border-radius "$r-ctl"
        background "$bg-canvas"
        font-family "$mono"
    }

    rule ".ts input:focus" {
        border-color "$accent"
    }

    rule ".ts input.bad" {
        border-color "$danger"
        background "$danger-soft"
    }

    rule ".perm" {
        border-collapse collapse
        width "100%"
        min-width "$doc-space-640"
    }

    rule ".perm select" {
        padding "$doc-space-5 $space-2"
        border-radius "$r-ctl"
        border "$border-width solid $border"
        background "$bg-raised"
        font-size "$fs-sm"
    }

    rule ".perm select.hid" {
        color "$fg-subtle"
    }

    rule ".perm select.see" {
        color "$st-ip"
    }

    rule ".perm select.chg" {
        color "$success"
        font-weight "$doc-weight-semibold"
    }

    rule ".explain" {
        background "$bg-surface"
        border "$border-width solid $border-subtle"
        border-radius "$r-card"
        padding "$space-3 $doc-space-14"
        line-height "$lh-loose"
    }

    rule ".wf" {
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".wf-row" {
        display flex
        gap "$doc-space-10"
        align-items center
        flex-wrap wrap
        padding "$space-3 $doc-space-14"
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-raised"
    }

    rule ".wf-row .arrow" {
        color "$fg-subtle"
    }

    rule ".themes" {
        display grid
        grid-template-columns "repeat(auto-fill, minmax($doc-space-200, 1fr))"
        gap "$doc-space-14"
    }

    rule ".theme-card" {
        border "$doc-space-2 solid $border"
        border-radius "$r-card"
        padding 0
        overflow hidden
        background none
        text-align left
    }

    rule ".theme-card[aria-pressed=\"true\"]" {
        border-color "$accent"
    }

    rule ".theme-card .pv" {
        height "$doc-space-96"
        display grid
        grid-template-columns "30% 1fr"
    }

    rule ".theme-card .pv i" {
        display block
    }

    rule ".theme-card .pv .s" {
        padding "$space-2 $doc-space-6"
        display flex
        flex-direction column
        gap "$doc-space-5"
    }

    rule ".theme-card .pv .m" {
        padding "$doc-space-10"
        display flex
        flex-direction column
        gap "$doc-space-6"
    }

    rule ".theme-card .pv span" {
        display block
        height "$doc-space-6"
        border-radius "$doc-space-3"
    }

    rule ".theme-card .cap" {
        padding "$space-2 $doc-space-10"
        display flex
        flex-direction column
        background "$bg-raised"
    }

    rule ".pop-item small" {
        color "$fg-muted"
        margin-left auto
    }

    rule ".theme-card .cap small" {
        color "$fg-muted"
    }

    rule ".setting-tabs" {
        display flex
        gap "$space-1"
        margin-bottom "$doc-space-18"
        border-bottom "$border-width solid $border"
        overflow-x auto
    }

    rule ".setting-tabs button[aria-selected=\"true\"]" {
        color "$fg"
        font-weight "$doc-weight-semibold"
        border-bottom-color "$accent"
    }

    rule ".help" {
        font-size "$fs-sm"
        color "$fg-muted"
        margin "$doc-space-n6 0 $doc-space-14"
        max-width "$doc-measure-body"
    }

    rule ".pop" {
        position fixed
        z-index "$doc-z-50"
        min-width "$doc-space-220"
        max-width "min($doc-space-320, $doc-popup-width)"
        max-height "$doc-menu-height"
        overflow auto
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$r-card"
        box-shadow "$shadow"
        padding "$doc-space-6"
    }

    rule ".pop-h" {
        font-size "$fs-xs"
        color "$fg-subtle"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
        padding "$doc-space-6 $doc-space-10 $space-1"
        font-weight "$doc-weight-semibold"
    }

    rule ".pop-item" {
        display flex
        align-items center
        gap "$space-2"
        padding "$space-2 $doc-space-10"
        border 0
        background none
        width "100%"
        text-align left
        border-radius "$r-ctl"
    }

    rule ".pop-item:hover" ".pop-item:focus-visible" {
        background "$bg-hover"
    }

    rule ".pop-note" {
        font-size "$fs-xs"
        color "$fg-muted"
        padding "$doc-space-6 $doc-space-10"
        border-top "$border-width solid $border-subtle"
        margin-top "$space-1"
    }

    rule ".scrim" {
        position fixed
        inset 0
        background "color-mix(in srgb, $bg-sunken calc($opacity-scrim*100%), transparent)"
        z-index "$doc-z-60"
        display grid
        place-items start center
        padding "$doc-vh-10 $space-4 $space-4"
    }

    rule ".dialog" {
        background "$bg-raised"
        border "$border-width solid $border"
        border-radius "$doc-space-14"
        box-shadow "$shadow"
        width "min($doc-space-560, 100%)"
        max-height "$doc-vh-80"
        overflow auto
        display flex
        flex-direction column
    }

    rule ".dialog-h" {
        display flex
        align-items center
        gap "$space-2"
        padding "$doc-space-14 $doc-space-18"
        border-bottom "$border-width solid $border-subtle"
    }

    rule ".dialog-h h2" {
        margin 0
        font-size "$fs-md"
    }

    rule ".dialog-b" {
        padding "$space-4 $doc-space-18"
        display flex
        flex-direction column
        gap "$doc-space-14"
    }

    rule ".dialog-f" {
        padding "$space-3 $doc-space-18"
        border-top "$border-width solid $border-subtle"
        display flex
        gap "$space-2"
        justify-content flex-end
        flex-wrap wrap
    }

    rule ".qs-input" {
        width "100%"
        padding "$doc-space-14 $doc-space-18"
        border 0
        border-bottom "$border-width solid $border"
        background none
        font-size "$fs-md"
    }

    rule ".qs-input:focus" {
        outline none
    }

    rule ".toast" {
        position fixed
        left "50%"
        bottom "$space-5"
        transform "translateX(-50%)"
        z-index "$doc-z-70"
        background "$fg"
        color "$bg-canvas"
        border-radius "$r-card"
        padding "$doc-space-10 $space-3 $doc-space-10 $space-4"
        display flex
        align-items center
        gap "$space-3"
        box-shadow "$shadow"
        max-width "$doc-popup-width"
    }

    rule ".mock-note" {
        font-size "$fs-xs"
        color "$fg-subtle"
        padding "$space-2 $space-5"
        border-top "$border-width solid $border-subtle"
    }

    rule ".bottombar" {
        display none
    }

    rule ".seg" {
        max-width "100%"
        overflow-x auto
    }

    rule ".rel-ph" {
        min-width "$doc-space-104"
        font-size "$fs-sm"
    }

    rule ".pop-find" {
        width "100%"
        padding "$space-2 $doc-space-10"
        border "$border-width solid $border"
        border-radius "$r-ctl"
        background "$bg-canvas"
        margin "$doc-space-2 0 $doc-space-6"
    }

    rule ".map-head" {
        display flex
        gap "$space-3"
        align-items center
        flex-wrap wrap
        padding "$doc-space-14 $space-5 0"
    }

    rule ".map-wrap" {
        padding "$doc-space-14 $space-5 $space-5"
        display flex
        flex-direction column
        gap "$space-3"
    }

    rule ".map-ctl" {
        display flex
        flex-wrap wrap
        gap "$space-2"
        align-items center
    }

    rule ".chip.kind-chip" {
        padding "$space-1 $doc-space-10"
        gap "$space-2"
    }

    rule ".kind-chip[aria-pressed=\"false\"]" {
        opacity "$doc-opacity-0-55"
    }

    rule ".kind-chip[aria-pressed=\"false\"] .lbl" {
        text-decoration line-through
    }

    rule ".sw" {
        width "$doc-space-20"
        height 0
        border-top "$doc-space-3 solid $fg-muted"
        display inline-block
    }

    rule ".sw.k-blocks" {
        border-color "$warning"
    }

    rule ".sw.k-cause" {
        border-color "$danger"
    }

    rule ".sw.k-dup" {
        border-top-style dashed
        border-color "$fg-subtle"
    }

    rule ".sw.k-rel" {
        border-color "$fg-muted"
    }

    rule ".sw.k-part" {
        border-color "$accent"
    }

    rule ".map-canvas" {
        border "$border-width solid $border"
        border-radius "$r-card"
        background "$bg-surface"
        overflow auto
    }

    rule ".map-canvas svg" {
        display block
        width "100%"
        min-width "$doc-space-620"
        height auto
        max-height "$doc-vh-72"
    }

    rule ".edge" {
        stroke-width "$doc-stroke-width"
        fill none
        transition "opacity $motion-fast,stroke-width $motion-fast"
    }

    rule ".edge.k-blocks" {
        stroke "$warning"
    }

    rule ".edge.k-cause" {
        stroke "$danger"
    }

    rule ".edge.k-dup" {
        stroke "$fg-subtle"
        stroke-dasharray 6 5
    }

    rule ".edge.k-rel" {
        stroke "$fg-muted"
    }

    rule ".edge.k-part" {
        stroke "$accent"
    }

    rule ".mk-blocks" {
        fill "$warning"
    }

    rule ".mk-cause" {
        fill "$danger"
    }

    rule ".mk-dup" {
        fill "$fg-subtle"
    }

    rule ".mk-part" {
        fill "$accent"
    }

    rule ".elabel" {
        font-size "$doc-font-12"
        fill "$fg-muted"
        paint-order stroke
        stroke "$bg-surface"
        stroke-width "$doc-space-5"
        stroke-linejoin round
        font-family "$font"
        transition "opacity $motion-fast"
    }

    rule ".node" {
        cursor pointer
        transition "opacity $motion-fast"
    }

    rule ".node rect" {
        fill "$bg-raised"
        stroke "$border"
        stroke-width "$doc-stroke-1-2"
    }

    rule ".node:hover rect" ".node:focus rect" {
        stroke "$accent"
        stroke-width "$doc-stroke-2-2"
    }

    rule ".node:focus" {
        outline none
    }

    rule ".node.center rect" {
        fill "$accent-soft"
        stroke "$accent"
        stroke-width "$doc-stroke-2-5"
    }

    rule ".nkey" {
        font-family "$mono"
        font-size "$doc-font-12"
        fill "$fg-muted"
    }

    rule ".ntitle" {
        font-family "$font"
        font-size "$doc-font-13"
        font-weight "$doc-weight-semibold"
        fill "$fg"
    }

    rule ".nd-ns" {
        fill "$st-ns"
    }

    rule ".nd-ip" {
        fill "$st-ip"
    }

    rule ".nd-done" {
        fill "$st-done"
    }

    rule ".map-canvas.hl-on .edge:not(.hl)" ".map-canvas.hl-on .elabel:not(.hl)" ".map-canvas.hl-on .node:not(.hl)" {
        opacity "$doc-opacity-0-2"
    }

    rule ".edge.hl" {
        stroke-width "$doc-stroke-3-5"
    }

    rule ".map-info" {
        margin 0
        min-height "$doc-em-1-5"
        line-height "$lh-loose"
    }

    rule ".chains" {
        display flex
        flex-direction column
        gap "$doc-space-14"
    }

    rule ".chains h4" {
        margin "0 0 $doc-space-6"
        font-size "$fs-sm"
        color "$fg-muted"
        text-transform uppercase
        letter-spacing "$doc-em-0-06"
    }

    rule ".chains li" {
        margin "$space-1 0"
        line-height "$lh-loose"
    }

    rule ".cal-wrap" {
        padding "$space-4 $space-5 $space-5"
        display flex
        flex-direction column
        gap "$doc-space-10"
    }

    rule ".cal-top" {
        display flex
        gap "$space-3"
        align-items baseline
        flex-wrap wrap
    }

    rule ".cal" {
        display grid
        grid-template-columns "repeat(7, minmax(0, 1fr))"
        gap "$doc-space-1"
        background "$border-subtle"
        border "$border-width solid $border"
        border-radius "$r-card"
        overflow hidden
    }

    rule ".cal-h" {
        background "$bg-surface"
        padding "$doc-space-6 $space-2"
        font-size "$fs-xs"
        font-weight "$weight-bold"
        color "$fg-muted"
    }

    rule ".cal-d" {
        background "$bg-raised"
        min-height "$doc-space-96"
        padding "$doc-space-6"
        display flex
        flex-direction column
        gap "$space-1"
        min-width 0
    }

    rule ".cal-d.other" {
        background "$bg-surface"
    }

    rule ".cal-d.drop-ok" {
        outline "$doc-space-2 dashed $accent"
        outline-offset "$doc-space-n2"
    }

    rule ".cal-d .n" {
        font-size "$fs-sm"
        font-weight "$doc-weight-semibold"
        color "$fg-muted"
        align-self flex-start
        padding "0 $doc-space-6"
        border-radius "$doc-r-pill"
    }

    rule ".cal-d.today .n" {
        background "$accent"
        color "$on-accent"
    }

    rule ".cal-i" {
        display block
        border 0
        text-align left
        font-size "$doc-font-12"
        padding "$doc-space-3 $doc-space-6"
        border-radius "$doc-r-small"
        white-space nowrap
        overflow hidden
        text-overflow ellipsis
        width "100%"
        cursor grab
        font-weight "$doc-weight-semibold"
    }

    rule ".cal-agenda" {
        display none
    }

    rule ".editing-note" {
        display flex
        gap "$space-2"
        align-items center
        padding "$space-2 $doc-space-10"
        border "$border-width dashed $accent"
        background "$accent-soft"
        border-radius "$r-ctl"
        font-size "$fs-sm"
    }

    rule ".desc-edit" {
        width "100%"
        min-height "$doc-space-150"
        padding "$doc-space-10 $space-3"
        border "$border-width solid $accent"
        border-radius "$r-ctl"
        background "$bg-raised"
        line-height "$doc-lh-code"
        resize vertical
    }

    rule ".savestate" {
        display flex
        gap "$space-2"
        align-items center
        font-size "$fs-sm"
        color "$fg-muted"
        flex-wrap wrap
    }

    rule ".ss-dot" {
        width "$space-2"
        height "$space-2"
        border-radius "50%"
        display inline-block
        flex none
    }

    rule ".ss-dot.ip" {
        background "$st-ip"
    }

    rule ".ss-dot.ok" {
        background "$success"
    }

    rule ".banner" {
        display flex
        gap "$space-2"
        align-items center
        flex-wrap wrap
        padding "$space-2 $doc-space-10"
        border-radius "$r-ctl"
        background "$warning-soft"
        border "$border-width solid $warning"
        color "$fg"
    }

    rule ".ni-grid" {
        display grid
        grid-template-columns "repeat(auto-fit, minmax($doc-space-180, 1fr))"
        gap "$space-3"
    }

    rule ".app.focus" {
        grid-template-columns "$doc-space-64 minmax(0, 1fr) auto"
    }

    rule ".app.focus .sidebar .brand" {
        font-size 0
        justify-content center
        padding "$space-4 0 $space-2"
    }

    rule ".app.focus .sidebar .side-search" {
        font-size 0
        justify-content center
        width "$doc-space-44"
        margin "$doc-space-6 auto $space-2"
        padding "$space-2"
    }

    rule ".app.focus .sidebar .side-search kbd" ".app.focus .sidebar .nav-label" ".app.focus .sidebar .nav-item .count" {
        display none
