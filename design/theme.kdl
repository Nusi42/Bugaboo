        gap "$space-2"
        justify-content flex-end
        flex-wrap wrap
    }

    rule ".qs-input" {
        width "100%"
        padding "$doc-space-14 $doc-space-18"
        border 0
        border-bottom "$border-width solid $border"
        background none
        font-size "$fs-md"
    }

    rule ".qs-input:focus" {
        outline none
    }

    rule ".toast" {
        position fixed
        left "50%"
        bottom "$space-5"
        transform "translateX(-50%)"
        z-index "$doc-z-70"
        background "$fg"
        color "$bg-canvas"
        border-radius "$r-card"
        padding "$doc-space-10 $space-3 $doc-space-10 $space-4"
        display flex
        align-items center
        gap "$space-3"
        box-shadow "$shadow"
        max-width "$doc-popup-width"
    }

    rule ".mock-note" {
