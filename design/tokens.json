          }
        ],
        "exclusions": [
          {
            "text": [
              "fg",
              "fg-*",
              "accent-fg",
              "danger",
              "warning",
              "success",
              "st-ns",
              "st-ip",
              "st-done"
            ],
            "on": ["accent"],
            "reason": "The accent fill carries only on-accent text."
          },
          {
            "text": ["fg-subtle"],
            "on": [
              "accent-soft",
              "danger-soft",
              "warning-soft",
              "success-soft",
              "st-*-soft",
              "cat*-bg"
            ],
            "reason": "Hint text sits on plain surfaces, never on tinted backgrounds."
          },
          {
            "text": ["accent-fg"],
            "on": ["danger-soft", "warning-soft", "success-soft", "st-*-soft", "cat*-bg"],
            "reason": "Accent text sits on plain surfaces or the accent tint, not on status or category tints."
          },
          {
            "text": ["danger"],
            "on": ["accent-soft", "warning-soft", "success-soft", "st-*-soft", "cat*-bg"],
            "reason": "Danger text sits on plain surfaces or the danger tint."
          },
          {
            "text": ["warning"],
            "on": ["accent-soft", "danger-soft", "success-soft", "st-*-soft", "cat*-bg"],
            "reason": "Warning text sits on plain surfaces or the warning tint."
          },
          {
            "text": ["success"],
            "on": ["accent-soft", "danger-soft", "warning-soft", "st-*-soft", "cat*-bg"],
            "reason": "Success text sits on plain surfaces or the success tint."
          },
          {
            "text": ["st-ns"],
            "on": [
              "accent-soft",
              "danger-soft",
              "warning-soft",
              "success-soft",
              "st-ip-soft",
              "st-done-soft",
              "cat*-bg"
            ],
            "reason": "Status text sits on plain surfaces or its own status tint."
          },
          {
            "text": ["st-ip"],
            "on": [
              "accent-soft",
              "danger-soft",
              "warning-soft",
              "success-soft",
              "st-ns-soft",
              "st-done-soft",
              "cat*-bg"
            ],
            "reason": "Status text sits on plain surfaces or its own status tint."
          },
          {
            "text": ["st-done"],
            "on": [
              "accent-soft",
              "danger-soft",
              "warning-soft",
              "success-soft",
              "st-ns-soft",
              "st-ip-soft",
              "cat*-bg"
            ],
            "reason": "Status text sits on plain surfaces or its own status tint."
          }
        ],
        "nonText": [
          {
            "colors": ["border", "border-subtle"],
            "reason": "Borders and dividers are decorative lines, not text; they are not part of the text contrast rules."
          }
        ]
      }
    }
  }
}
