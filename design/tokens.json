  "$extensions": {
    "bugaboo": {
      "defaultThemes": {
        "light": "daylight",
        "dark": "dusk"
      },
      "contrast": {
        "min": 4.5,
        "text": [
          "fg",
          "fg-muted",
          "fg-subtle",
          "accent-fg",
          "on-accent",
          "danger",
          "warning",
          "success",
          "st-ns",
          "st-ip",
          "st-done",
          "cat1-fg",
          "cat2-fg",
          "cat3-fg",
          "cat4-fg",
          "cat5-fg",
          "cat6-fg"
        ],
        "backgrounds": [
          "bg-canvas",
          "bg-surface",
          "bg-raised",
          "bg-sunken",
          "bg-hover",
          "bg-selected",
          "accent",
          "accent-soft",
          "danger-soft",
          "warning-soft",
          "success-soft",
          "st-ns-soft",
          "st-ip-soft",
          "st-done-soft",
          "cat1-bg",
          "cat2-bg",
          "cat3-bg",
          "cat4-bg",
          "cat5-bg",
          "cat6-bg"
        ],
        "restricted": [
          {
            "text": "on-accent",
            "on": ["accent"],
            "reason": "On-accent text is only ever drawn on the accent fill."
          },
          {
            "text": "cat1-fg",
            "on": ["cat1-bg"],
            "reason": "Category 1 text is only ever drawn on its own category 1 background."
          },
          {
            "text": "cat2-fg",
            "on": ["cat2-bg"],
            "reason": "Category 2 text is only ever drawn on its own category 2 background."
          },
          {
            "text": "cat3-fg",
            "on": ["cat3-bg"],
            "reason": "Category 3 text is only ever drawn on its own category 3 background."
          },
          {
            "text": "cat4-fg",
            "on": ["cat4-bg"],
            "reason": "Category 4 text is only ever drawn on its own category 4 background."
          },
          {
            "text": "cat5-fg",
            "on": ["cat5-bg"],
            "reason": "Category 5 text is only ever drawn on its own category 5 background."
          },
          {
            "text": "cat6-fg",
