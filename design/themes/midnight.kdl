// Bugaboo built-in theme: Midnight (dark).
//
// Colors (and the shadow) only: everything else, and every color this file does not set,
// comes from the base, design/theme.kdl, whose colors are Daylight's. `more=` is the color
// when the device asks for more contrast. The file name is the theme's ID (ADR-0026).

theme "midnight" extends="default" kind="dark" {
    tokens {
        color "bg-canvas" "#000000"
        color "bg-surface" "#0c0d10"
        color "bg-raised" "#16181d"
        color "bg-sunken" "#050506"
        color "bg-hover" "#1e2127"
        color "bg-selected" "#242046"
        color "border" "#272a31" more="#828388"
        color "border-control" "#757a85" more="#828388"
        color "cue" "#9aa2b3"
        color "border-subtle" "#1a1c21" more="#66676a"
        color "divider" "#454b57" more="#828388"
        color "fg" "#f2f3f5"
        color "fg-muted" "#9ca3af" more="#b2b7c1"
        color "fg-subtle" "#9198a4" more="#afb4bd"
        color "accent" "#9483ff" more="#9b8cff"
        color "accent-soft" "#221d47"
        color "accent-fg" "#b7abff"
        color "disabled-fill" "#30333a"
        color "on-disabled" "#9ca3af" more="#c4c9d2"
        color "on-accent" "#0b0820"
        color "danger" "#ff7a70" more="#ff928a"
        color "danger-soft" "#3a1414"
        color "warning" "#ffb547"
        color "warning-soft" "#382810"
        color "success" "#5fd38f"
        color "success-soft" "#0f2e1e"
        color "st-ns" "$fg-muted" more="#abb1bb"
        color "st-ns-soft" "#262a31" more="#1a1c21"
        color "st-ip" "#74a8ff" more="#82b1ff"
        color "st-ip-soft" "#10244a"
        color "st-done" "#5fd38f"
        color "st-done-soft" "#0f2e1e"
        color "tint-ns" "#252525"
        color "tint-ip" "#0a2350"
        color "tint-done" "#082b1a"
        color "edge-high" "#ffb547"
        color "hover-line" "#8e95a2" more="#9a9ca2"
        color "scrim" "#000000"
        color "cat1-bg" "#4d1934" more="#491831"
        color "cat1-fg" "#c487a2"
        color "cat2-bg" "#022e4f" more="#052c4b"
        color "cat2-fg" "#749bcd"
        color "cat3-bg" "#002b15"
        color "cat3-fg" "#6f9a7d"
        color "cat4-bg" "#532a01" more="#422305"
        color "cat4-fg" "#c99873"
        color "cat5-bg" "#311f49"
        color "cat5-fg" "#a289bc"
        color "cat6-bg" "#0a3e3a" more="#102f2c"
        color "cat6-fg" "#7daea8"
        color "cat7-bg" "#4a160f"
        color "cat7-fg" "#c58275"
        color "cat8-bg" "#403507" more="#332a0a"
        color "cat8-fg" "#b4a270"
        color "cat9-bg" "#012631"
        color "cat9-fg" "#5297b1"
        color "cat10-bg" "#2a3e0f" more="#222e10"
        color "cat10-fg" "#99ae78"
        color "cat11-bg" "#38393a" more="#2a2b2b"
        color "cat11-fg" "#a7a8aa"
        color "cat12-bg" "#2c2009"
        color "cat12-fg" "#9d8b73"
        color "cat1-mark" "#f05a9e"
        color "cat2-mark" "#7a9cff"
        color "cat3-mark" "#3fbf6a"
        color "cat4-mark" "#f59a2a"
        color "cat5-mark" "#b57cf0"
        color "cat6-mark" "#33c4b8"
        color "cat7-mark" "#ff6f4f"
        color "cat8-mark" "#e7c03a"
        color "cat9-mark" "#4cb8f0"
        color "cat10-mark" "#a2d23c"
        color "cat11-mark" "#9a9ea6"
        color "cat12-mark" "#d4b483"
        shadow "shadow" "0 0 0 1px #272a31, 0 8px 24px 0 #00000099"
        color "area-issues" "$fg-muted"
        color "area-issues-soft" "$bg-surface"
        color "area-time" "$fg-muted"
        color "area-time-soft" "$bg-surface"
        color "area-agents" "$fg-muted"
        color "area-agents-soft" "$bg-surface"
        color "area-settings" "$fg-muted"
        color "area-settings-soft" "$bg-surface"
    }
}
