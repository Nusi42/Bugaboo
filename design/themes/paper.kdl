// Bugaboo built-in theme: Paper (light).
//
// Colors (and the shadow) only: everything else, and every color this file does not set,
// comes from the base, design/theme.kdl, whose colors are Daylight's. `more=` is the color
// when the device asks for more contrast. The file name is the theme's ID (ADR-0026).

theme "paper" extends="default" kind="light" {
    tokens {
        color "bg-canvas" "#fbf8f3"
        color "bg-surface" "#f4efe7"
        color "bg-raised" "#fffdf9"
        color "bg-sunken" "#ede6da"
        color "bg-hover" "#ede6db"
        color "bg-selected" "#dce3eb"
        color "border" "#e1d8ca" more="#6e6a63"
        color "border-control" "#7a7366" more="#6e6a63"
        color "cue" "#4f4638"
        color "border-subtle" "#eae3d7" more="#8c8881"
        color "divider" "#b2a795" more="#6e6a63"
        color "fg" "#2b2620"
        color "fg-muted" "#5f564d" more="#4d4740"
        color "fg-subtle" "#645b51" more="#4d4741"
        color "accent" "#2f5d8a" more="#244b78"
        color "accent-soft" "#e4ecf4"
        color "accent-fg" "#284f75" more="#264a6e"
        color "disabled-fill" "#d3d1ce"
        color "on-disabled" "#564e45" more="#3d3731"
        color "danger" "#b23a2e" more="#802a21"
        color "danger-soft" "#f8e6e1"
        color "warning" "#925611" more="#693e0c"
        color "warning-soft" "#f6ead5"
        color "success" "#3f6e3a" more="#2e502a"
        color "success-soft" "#e5eedf"
        color "st-ns-soft" "#ece5da"
        color "st-ip" "#1d6b80" more="#14495a"
        color "st-ip-soft" "#dfeef1"
        color "st-done" "#3f6e3a" more="#2e502a"
        color "st-done-soft" "#e5eedf"
        color "tint-ns" "#e3e1dd"
        color "tint-ip" "#c4e9ef"
        color "tint-done" "#cdeabf"
        color "edge-high" "#cb6300"
        color "scrim" "#2a2826"
        color "cat1-bg" "#ffe1ef"
        color "cat1-fg" "#83586e"
        color "cat2-bg" "#bdd8ff" more="#d0e4ff"
        color "cat2-fg" "#375b81"
        color "cat3-bg" "#b5edc2" more="#bbefc7"
        color "cat4-bg" "#ffc39d" more="#ffdbc2"
        color "cat4-fg" "#7b4722"
        color "cat5-bg" "#ecd2ff" more="#f1daff"
        color "cat5-fg" "#6a537d"
        color "cat6-bg" "#abe8e3" more="#b7ece8"
        color "cat6-fg" "#2b6663"
        color "cat7-bg" "#ffc5c0" more="#ffdad6"
        color "cat7-fg" "#844541"
        color "cat8-bg" "#ffe99c"
        color "cat8-fg" "#736518"
        color "cat9-bg" "#91e2fd" more="#b2ecff"
        color "cat9-fg" "#016176"
        color "cat10-bg" "#e9febe"
        color "cat10-fg" "#60733c"
        color "cat11-bg" "#cdd5db" more="#dde3e7"
        color "cat11-fg" "#51575c"
        color "cat12-bg" "#e7d6bc" more="#eee0cb"
        color "cat12-fg" "#655741"
        shadow "shadow" "0 1px 2px 0 #3c2d190f, 0 6px 20px 0 #3c2d1914"
    }
}
